# Variables d'environnement du site public caelestis.fr.
# Copier ce fichier en .env pour le développement, et reporter les mêmes clés
# dans les variables d'environnement du projet sur Vercel.
# Ne jamais committer .env : il contient des secrets de production.

# ── Envoi des emails ───────────────────────────────────────────────────────
# Mot de passe de la boîte contact@caelestis.fr chez OVH, utilisé par les
# formulaires de contact, de devis et de brief.
OVH_SMTP_PASSWORD=

# ── Transmission des prospects au hub interne ──────────────────────────────
# Adresse de la route d'ingestion du hub.
HUB_LEADS_URL=https://admin.caelestis.fr/api/leads
# Secret partagé, identique à la variable LEADS_INGEST_SECRET du hub.
#
# Générer une valeur solide :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Si l'une des deux variables manque, le formulaire du diagnostic continue de
# fonctionner pour le visiteur, mais la demande n'est transmise nulle part :
# elle est seulement tracée dans les journaux du serveur.
HUB_LEADS_SECRET=

# ── Publicité ──────────────────────────────────────────────────────────────
# Identifiant du pixel Meta. Tant qu'il est vide, aucun script publicitaire
# n'est présent dans la page : ni balise, ni requête, ni cookie.
PUBLIC_META_PIXEL_ID=
