---
/* PAGE DE TRAVAIL, À SUPPRIMER APRÈS ARBITRAGE.
   Trois présentations des quatre abonnements, dans le vrai style du site.
   Sert à choisir sur pièce plutôt que sur description. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAINTENANCE, MAINTENANCE_MOIS_OFFERTS, MAINTENANCE_MOIS_OFFERTS_LETTRES, MAINTENANCE_RETOUCHES_MIN, euros } from '../utils/tarifs';

/* Le socle est le même pour les quatre : c'est la réalité du travail. Le RGPD
   s'applique dès qu'un formulaire existe, donc dès la page unique : il n'a rien
   à faire dans une carte comme argument différenciant. */
const SOCLE = [
  'Hébergement et nom de domaine compris',
  'Sauvegardes et certificat de sécurité',
  'Mises à jour de sécurité',
  'Liens et formulaires testés',
  `${MAINTENANCE_RETOUCHES_MIN} min de retouches par mois`,
];

/* Les ajouts sont CUMULATIFS : le sur mesure affiche les quatre, donc quatre
   lignes d'écart avec la page unique. Chacun correspond à un travail réellement
   fait, jamais à une promesse de fréquence. */
const A1 = 'Menu et navigation testés sur toutes vos pages';
const A2 = 'Tunnel de commande et paiement testés';
const A3 = 'Vos outils et e-mails automatiques testés : réservation, configurateur, confirmations';
const A4 = 'Panne majeure résolue sous 24 heures';

const FORMULES = [
  { type: 'Page unique',       prix: euros(MAINTENANCE['page-unique']),       etendue: 'Une page',                    enPlus: [] },
  { type: 'Vitrine',           prix: euros(MAINTENANCE['site-vitrine']),      etendue: 'Cinq à huit pages',           enPlus: [A1] },
  { type: 'Boutique en ligne', prix: euros(MAINTENANCE['boutique-en-ligne']), etendue: 'Catalogue et paiements',      enPlus: [A1, A2, A4] },
  { type: 'Sur mesure',        prix: euros(MAINTENANCE['site-sur-mesure']),   etendue: 'Vos fonctionnalités propres', enPlus: [A1, A2, A3, A4] },
];

/* La dernière ligne existe pour une raison : sans elle, la boutique et le sur
   mesure affichent exactement les mêmes coches, pour cinq euros d'écart. Elle
   nomme les fonctionnalités que seul un site sur mesure possède, plutôt que de
   décrire un service en termes vagues. */
const criteres = [
  { c: 'Hébergement et nom de domaine', v: [1, 1, 1, 1] },
  { c: 'Sauvegardes et certificat de sécurité', v: [1, 1, 1, 1] },
  { c: 'Mises à jour de sécurité', v: [1, 1, 1, 1] },
  { c: 'Liens et formulaires testés', v: [1, 1, 1, 1] },
  { c: `${MAINTENANCE_RETOUCHES_MIN} min de retouches par mois`, v: [1, 1, 1, 1] },
  { c: 'Menu et navigation testés', v: [0, 1, 1, 1] },
  { c: 'Tunnel de commande et paiement testés', v: [0, 0, 1, 1] },
  { c: 'Réservation, configurateur, espace client suivis', v: [0, 0, 0, 1] },
  { c: 'Panne majeure résolue sous 48 heures', v: [0, 0, 1, 1] },
];
---

<BaseLayout
  title="Variantes des cartes de maintenance, page de travail"
  description="Page de travail interne, trois présentations des abonnements de maintenance."
  noindex={true}
>
  <section class="pt-20 pb-10 px-6 md:px-10 lg:px-20">
    <div class="max-w-6xl mx-auto text-center">
      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-4">Page de travail</p>
      <h1 class="font-display font-light text-brun leading-[1.1] mb-4" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">
        Quatre lignes d'écart entre la première et la dernière.
      </h1>
      <p class="font-body text-base text-brun-mid max-w-2xl mx-auto">
        Le socle et les pastilles sont identiques dans les trois. Seule change la
        manière d'afficher ce qui s'ajoute d'une formule à l'autre.
      </p>
    </div>
  </section>

  <!-- ═══════════ VARIANTE 1 ═══════════ -->
  <section class="py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Variante 1, les ajouts détachés sous un filet
      </h2>
      <p class="font-body text-sm text-brun-mid mb-8 max-w-2xl">
        Le socle en gris, puis ce qui s'ajoute, détaché et marqué d'un « + ».
        L'écart se voit au premier coup d'œil, sans lire.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 items-stretch">
        {FORMULES.map((f) => (
          <div class="bg-cream border-2 border-sauge/30 rounded-2xl p-6 lg:p-7 flex flex-col text-center">
            <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">{f.type}</p>
            <p class="v1-etendue font-body text-sm font-medium text-brun mb-4">{f.etendue}</p>
            <div class="mb-5">
              <p class="font-display font-light text-brun leading-none" style="font-size: 2.2rem; letter-spacing: -0.02em;">
                {f.prix}<span class="text-bois-mid text-lg ml-1">€</span>
              </p>
              <p class="font-body text-xs text-brun-mid mt-2">par mois après les {MAINTENANCE_MOIS_OFFERTS_LETTRES} mois offerts</p>
            </div>
            <ul class="flex flex-col gap-2.5 mb-4 text-left">
              {SOCLE.map((s) => (
                <li class="vv-li font-body text-sm text-brun-mid leading-snug">{s}</li>
              ))}
            </ul>
            <div class="flex-1 text-left">
              {f.enPlus.length > 0 && (
                <div class="v1-plus">
                  <p class="v1-plus-titre font-body text-xs tracking-[0.14em] uppercase text-sauge-text">En plus</p>
                  <ul class="flex flex-col gap-2.5 mt-3">
                    {f.enPlus.map((s) => (
                      <li class="vp-li font-body text-sm text-brun font-medium leading-snug">{s}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            <a href="/contact" class="mt-6 inline-flex items-center justify-center font-body font-medium text-sm min-h-[44px] border border-sauge/70 text-[#2E7452] px-6 py-3 rounded-full">En parler</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ VARIANTE 2 ═══════════ -->
  <section class="py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark bg-sauge-pale/25">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Variante 2, une seule liste continue
      </h2>
      <p class="font-body text-sm text-brun-mid mb-8 max-w-2xl">
        Socle et ajouts fondus dans la même liste, sans séparation. La carte la plus
        chère est simplement la plus longue. Plus doux, mais l'écart se lit moins vite.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 items-stretch">
        {FORMULES.map((f) => (
          <div class="bg-cream border-2 border-sauge/30 rounded-2xl p-6 lg:p-7 flex flex-col text-center">
            <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">{f.type}</p>
            <p class="v1-etendue font-body text-sm font-medium text-brun mb-4">{f.etendue}</p>
            <div class="mb-5">
              <p class="font-display font-light text-brun leading-none" style="font-size: 2.2rem; letter-spacing: -0.02em;">
                {f.prix}<span class="text-bois-mid text-lg ml-1">€</span>
              </p>
              <p class="font-body text-xs text-brun-mid mt-2">par mois après les {MAINTENANCE_MOIS_OFFERTS_LETTRES} mois offerts</p>
            </div>
            <ul class="flex flex-col gap-2.5 flex-1 mb-6 text-left">
              {[...SOCLE, ...f.enPlus].map((s) => (
                <li class="vv-li font-body text-sm text-brun-mid leading-snug">{s}</li>
              ))}
            </ul>
            <a href="/contact" class="inline-flex items-center justify-center font-body font-medium text-sm min-h-[44px] border border-sauge/70 text-[#2E7452] px-6 py-3 rounded-full">En parler</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ VARIANTE 3 ═══════════ -->
  <section class="py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Variante 3, le tableau comparatif
      </h2>
      <p class="font-body text-sm text-brun-mid mb-8 max-w-2xl">
        Neuf critères en lignes, quatre colonnes. Les tirets montrent exactement où
        s'arrête chaque formule.
      </p>

      <div class="v3-wrap">
        <table class="v3-table">
          <thead>
            <tr>
              <th scope="col" class="v3-vide"></th>
              {FORMULES.map((f) => (
                <th scope="col">
                  <span class="v3-nom">{f.type}</span>
                  <span class="v3-prix">{f.prix}&nbsp;€</span>
                  <span class="v3-mois">par mois</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {criteres.map((li) => (
              <tr>
                <th scope="row">{li.c}</th>
                {li.v.map((val) => (
                  <td>
                    {val === 1 && <span class="v3-oui" aria-label="compris">✓</span>}
                    {val === 0 && <span class="v3-non" aria-label="non compris">—</span>}
                    {typeof val === 'string' && <span class="v3-txt">{val}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="font-body text-base font-semibold text-brun mt-6 text-center">
        Les {MAINTENANCE_MOIS_OFFERTS} premiers mois sont offerts dans les quatre cas.
      </p>
      <p class="font-body text-xs text-brun-mid mt-3 text-center max-w-2xl mx-auto">
        Le délai de 48 heures court à compter du signalement, en jours ouvrés. Il ne
        s'applique pas aux interruptions dont la cause est extérieure au site
        (hébergeur, service de paiement, fournisseur d'accès), traitées dès leur
        rétablissement par le prestataire concerné.
      </p>
    </div>
  </section>

  <style>
    .vv-li, .vp-li { position: relative; padding-left: 1.5rem; }
    .vv-li::before {
      content: '';
      position: absolute; left: 0; top: 0.45em;
      width: 0.55rem; height: 0.3rem;
      border-left: 1.5px solid #2E7452;
      border-bottom: 1.5px solid #2E7452;
      transform: rotate(-45deg);
    }
    .vp-li::before {
      content: '+';
      position: absolute; left: 0.15rem; top: 0;
      color: #2E7452;
      font-weight: 700;
      font-size: 1.05rem;
      line-height: 1.35;
    }
    .v1-etendue {
      display: inline-block;
      background: var(--color-sauge-pale);
      border-radius: 999px;
      padding: 0.25rem 0.9rem;
    }
    .v1-plus {
      border-top: 1px solid var(--color-sauge);
      padding-top: 1rem;
      margin-top: 0.25rem;
    }

    /* Le tableau déborde sur petit écran : il défile dans son propre cadre,
       jamais la page. */
    .v3-wrap { overflow-x: auto; }
    .v3-table { width: 100%; border-collapse: collapse; min-width: 46rem; }
    .v3-table th, .v3-table td {
      padding: 0.8rem 1rem;
      border-bottom: 1px solid var(--color-cream-dark);
      font-family: var(--font-body);
      font-size: 0.875rem;
    }
    .v3-table thead th { border-bottom: 2px solid var(--color-sauge); vertical-align: bottom; }
    .v3-table tbody th {
      text-align: left; font-weight: 400; color: var(--color-brun-mid);
      width: 38%;
    }
    .v3-table td { text-align: center; }
    .v3-vide { border-bottom: 2px solid var(--color-sauge) !important; }
    .v3-nom { display: block; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-sauge-text); margin-bottom: 0.4rem; }
    .v3-prix { display: block; font-family: var(--font-display); font-size: 1.5rem; font-weight: 300; color: #255C41; line-height: 1; }
    .v3-mois { display: block; font-size: 0.7rem; color: var(--color-brun-mid); margin-top: 0.25rem; }
    .v3-oui { color: #2E7452; font-size: 1.05rem; }
    .v3-non { color: var(--color-sauge); }
    .v3-txt { color: var(--color-brun-mid); }
    .v3-table tbody tr:nth-child(odd) { background: rgba(227, 239, 232, 0.28); }
    .v3-table tfoot td { border-bottom: none; padding-top: 1.4rem; }
    .v3-vide-pied { border-bottom: none; }
    .v3-cta {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 44px; padding: 0.6rem 1.4rem;
      border: 1px solid rgba(184, 196, 187, 0.7);
      border-radius: 999px;
      color: #2E7452; font-weight: 500; font-size: 0.875rem;
      transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .v3-cta:hover { background: #255C41; color: var(--color-cream); border-color: #255C41; }
  </style>
</BaseLayout>
