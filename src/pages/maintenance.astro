---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { MAINTENANCE, MAINTENANCE_MIN, MAINTENANCE_MOIS_OFFERTS, euros, MAINTENANCE_RETOUCHES_MIN, TARIF_HORAIRE } from '../utils/tarifs';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Maintenance mensuelle de site internet, Caelestis',
  description: 'Abonnement mensuel de maintenance technique de site internet pour artisans, indépendants et petites entreprises en France : sécurité, sauvegardes et surveillance.',
  provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
  offers: [
    { '@type': 'Offer', name: 'Maintenance site une page',      priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['page-unique']),      priceCurrency: 'EUR', unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Maintenance site vitrine',       priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['site-vitrine']),     priceCurrency: 'EUR', unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Maintenance boutique en ligne',  priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['boutique-en-ligne']), priceCurrency: 'EUR', unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Maintenance site sur mesure',    priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['site-sur-mesure']),  priceCurrency: 'EUR', unitText: 'MONTH' } },
  ],
};

/* Un abonnement obligatoire soulève naturellement de la méfiance. Ces cinq
   questions sont celles qui décident : à quoi il sert vraiment, ce qui se
   passe si on refuse, et comment en sortir. Les taire les laisserait
   travailler en silence contre la signature. */
const faq = [
  {
    q: "Pourquoi la maintenance est-elle obligatoire ?",
    a: "Parce qu'un site vit sur des serveurs et des logiciels qui évoluent en permanence. Un suivi régulier garde le site en état : sécurité à jour, formulaires qui partent, affichage intact après les mises à jour de navigateur. L'abonnement couvre l'hébergement, le nom de domaine, les sauvegardes et la surveillance technique. Il protège l'investissement que représente le site, plusieurs centaines d'euros.",
  },
  {
    q: "Que comprend exactement l'abonnement ?",
    a: "L'hébergement du site, le renouvellement de votre nom de domaine, le certificat de sécurité, les sauvegardes automatiques, la surveillance technique et les petites modifications de contenu : changer un horaire, un tarif, une photo, un paragraphe. Une refonte ou l'ajout d'une page entière sortent du forfait et font l'objet d'un devis.",
  },
  {
    q: "Que se passe-t-il si mon site tombe en panne ?",
    a: "Nous intervenons dès votre signalement, ou dès que nous constatons nous-mêmes l'incident. Les formules Boutique en ligne et Site sur mesure bénéficient d'un délai garanti : le site est rétabli sous 48 heures ouvrées. Pour une page unique ou un site vitrine, nous intervenons avec le même soin, sans durée garantie. Dans tous les cas, une panne dont la cause est extérieure, chez l'hébergeur ou un service de paiement par exemple, relève de ce prestataire : nous vous en donnons la cause et nous suivons le rétablissement auprès de lui. Le détail figure à l'article 10.6 de nos conditions générales de vente.",
  },
  {
    q: "Puis-je résilier quand je veux ?",
    a: "Oui, avec un mois de préavis, librement et gratuitement. Le site et le nom de domaine restent votre propriété : nous vous transmettons l'ensemble des fichiers et des accès pour que vous puissiez les confier à quelqu'un d'autre.",
  },
  {
    q: "Les modifications de contenu sont-elles comprises ?",
    a: `L'abonnement comprend ${MAINTENANCE_RETOUCHES_MIN} minutes de retouches par mois, à utiliser dans le mois : changer un horaire, un tarif, une photo, corriger une coquille. De quoi couvrir largement les ajustements courants. Au-delà, ou pour une nouvelle page, nous chiffrons le travail avant de le faire, à ${TARIF_HORAIRE} € de l'heure. Vous ne découvrez jamais une facture après coup.`,
  },
  {
    q: "Et si mon site est déjà en ligne, créé par quelqu'un d'autre ?",
    a: "C'est possible dans la plupart des cas. Nous examinons d'abord comment le site est construit, puis nous vous disons si nous pouvons en assurer le suivi. Certaines technologies anciennes ne se maintiennent pas sérieusement, et mieux vaut le savoir avant.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil',     item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://caelestis.fr/services' },
    { '@type': 'ListItem', position: 3, name: 'Maintenance mensuelle', item: 'https://caelestis.fr/maintenance' },
  ],
};

/* Abonnement de maintenance, un tarif par type de site.
   Les montants viennent de tarifs.ts : ils étaient écrits en dur ici et à cinq
   autres endroits du site, et la grille arrêtée le 31/07/2026 n'y était jamais
   arrivée. Le prix vit désormais à un seul endroit.

   Le bouton mène au contact et non à un paiement direct : la maintenance est
   offerte les premiers mois, personne ne s'abonne le jour de la livraison,
   et le récurrent est piloté depuis Tiime (facture conforme et prélèvement),
   pas par un lien de paiement isolé. */
/* Un tableau plutôt que quatre cartes : le visiteur compare d'un regard et voit
   exactement où s'arrête chaque formule. Les cartes alignaient des listes
   presque identiques, ce qui donnait à lire quatre fois la même chose pour des
   prix allant du simple au triple.

   Les cinq premiers critères sont le socle, communs aux quatre. Les suivants
   marquent la progression, et chacun correspond à un travail réellement fait,
   jamais à une promesse de fréquence. La dernière ligne existe parce que sans
   elle la boutique et le sur mesure afficheraient exactement les mêmes coches. */
const colonnes = [
  { type: 'Page unique',       prix: euros(MAINTENANCE['page-unique']) },
  { type: 'Vitrine',           prix: euros(MAINTENANCE['site-vitrine']) },
  { type: 'Boutique en ligne', prix: euros(MAINTENANCE['boutique-en-ligne']) },
  { type: 'Sur mesure',        prix: euros(MAINTENANCE['site-sur-mesure']) },
];

const criteres = [
  { c: 'Hébergement et nom de domaine', v: [1, 1, 1, 1] },
  { c: 'Sauvegardes et certificat de sécurité', v: [1, 1, 1, 1] },
  { c: 'Mises à jour de sécurité', v: [1, 1, 1, 1] },
  { c: 'Liens et formulaires testés', v: [1, 1, 1, 1] },
  { c: `${MAINTENANCE_RETOUCHES_MIN} min de retouches par mois`, v: [1, 1, 1, 1] },
  { c: 'Menu et navigation testés', v: [0, 1, 1, 1] },
  { c: 'Tunnel de commande et paiement testés', v: [0, 0, 1, 1] },
  { c: 'Réservation, configurateur, espace client suivis', v: [0, 0, 0, 1] },
  { c: 'Panne majeure résolue sous 48 heures', v: [0, 0, 1, 1] },
];


// Ce que couvre la maintenance (liste de la section distinction)
// Socle commun aux quatre formules, et rien d'autre : le délai de rétablissement
// de 48 h ouvrées a été retiré de cette liste le 02/08/2026, car il n'est attaché
// qu'à Boutique en ligne et Site sur mesure (décision de Célestin, article 10.6
// des CGV). Il se lit dans le tableau, colonne par colonne, là où il est vrai.
const couvert = [
  'Mises à jour régulières',
  'Site protégé et sécurisé',
  'Sauvegardes régulières',
  'Toujours en ligne',
];
---

<BaseLayout
  title={`Maintenance de site internet dès ${euros(MAINTENANCE_MIN)} €/mois, Caelestis`}
  description={`${MAINTENANCE_MOIS_OFFERTS} mois offerts, puis dès ${euros(MAINTENANCE_MIN)} € par mois : hébergement, sécurité, sauvegardes et surveillance de votre site. Résiliable avec un mois de préavis.`}
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- ── Hero ── -->
  <section class="pt-20 pb-14 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">

    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-20 w-[400px] h-[400px]"></div>
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/3 w-56 h-56"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <div class="inline-flex items-center gap-2 mb-6" data-reveal>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Maintenance mensuelle</p>
      </div>
      <h1
        class="font-display font-light text-brun leading-[1.05] tracking-tight max-w-3xl mx-auto"
        style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
        data-reveal data-delay="1"
      >
        Votre site reste entre<br class="hidden sm:block"> <span class="text-sauge">de bonnes mains.</span>
      </h1>
      <p class="font-body text-lg text-brun-mid mt-8 max-w-2xl leading-relaxed mx-auto" data-reveal data-delay="2">
        La mise en ligne ouvre une nouvelle étape. Un site internet reste vivant : les technologies évoluent, des failles de sécurité apparaissent, et l&rsquo;entretien le garde solide. Chaque semaine, nous veillons à ce que le vôtre reste rapide, sécurisé et toujours en ligne, en coulisses, sans que vous ayez à y penser. Un service pensé pour les indépendants, TPE et PME qui n'ont pas de service technique en interne.
      </p>
    </div>
  </section>

  <!-- ── Maintenance et modifications, l'explication, en premier ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20">
    <div class="max-w-4xl mx-auto" data-reveal>

      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="block w-8 h-px bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">À ne pas confondre</p>
          <span class="block w-8 h-px bg-sauge"></span>
        </div>
        <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Deux choses bien distinctes.
        </h2>
      </div>

      <!-- La ligne de partage. Posée le 07/08/2026 à la place de deux cartes
           arrondies symétriques : à contenu opposé, forme identique, la section
           annonçait « deux choses bien distinctes » et les donnait à voir
           pareilles. Le partage est maintenant porté par le fond, teinté à
           gauche pour ce qui tourne seul, crème à droite pour ce qui se demande,
           et par un filet vertical. Les deux colonnes portent désormais chacune
           leur liste : c'est ce qui permet à un client de savoir de quel côté
           tombe sa demande sans lire un paragraphe. -->
      <div class="prt">

        <div class="prt-col prt-col-inclus">
          <p class="prt-etiquette font-body">Compris dans l'abonnement</p>
          <h3 class="font-display text-brun">La maintenance</h3>
          <p class="prt-intro font-body">
            Le socle technique qui garde votre site en ligne, rapide et protégé.
            Il tourne tout seul, en fond, pendant que vous travaillez.
          </p>
          <ul class="prt-liste prt-liste-inclus font-body" role="list">
            {couvert.map((c) => <li>{c}</li>)}
          </ul>
          <p class="prt-prix font-body">
            {MAINTENANCE_MOIS_OFFERTS} mois offerts, puis dès {euros(MAINTENANCE_MIN)}&nbsp;€ par mois selon votre site.
          </p>
        </div>

        <div class="prt-filet" aria-hidden="true"></div>

        <div class="prt-col prt-col-devis">
          <p class="prt-etiquette font-body">À la demande, sur devis</p>
          <h3 class="font-display text-brun">Les modifications</h3>
          <p class="prt-intro font-body">
            Tout ce qui change le contenu ou ajoute des fonctions. Un service à
            part : vous ne payez que ce dont vous avez besoin, quand vous le
            décidez.
          </p>
          <ul class="prt-liste prt-liste-devis font-body" role="list">
            <li>Réécrire un texte</li>
            <li>Remplacer une photo</li>
            <li>Ajouter une page</li>
            <li>Ajouter une fonctionnalité</li>
          </ul>
          <p class="prt-prix font-body">
            Sur devis, vous décidez ensuite.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ── L'abonnement maintenance, les cartes, en second ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark relative overflow-hidden">

    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute top-40 -left-24 w-72 h-72"></div>

    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12" data-reveal>
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="block w-8 h-px bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">L'abonnement maintenance</p>
          <span class="block w-8 h-px bg-sauge"></span>
        </div>
        <h2 class="font-display font-light text-brun leading-[1.1] mb-4" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Un tarif selon votre site.
        </h2>
        <p class="font-body text-base text-brun-mid max-w-2xl mx-auto leading-relaxed">
          Le tarif suit ce qu'il y a à maintenir. Une page à surveiller demande moins de suivi qu'une boutique qui encaisse ou qu'un site aux fonctionnalités uniques. L'abonnement se résilie quand vous le voulez, avec un mois de préavis, librement et gratuitement.
        </p>
      </div>

      <!-- Tableau comparatif : une colonne par formule -->
      <div class="mnt-tableau-wrap" data-reveal data-delay="1">
        <table class="mnt-tableau">
          <caption class="sr-only">Comparatif des quatre abonnements de maintenance</caption>
          <thead>
            <tr>
              <th scope="col" class="mnt-vide"></th>
              {colonnes.map((c) => (
                <th scope="col">
                  <span class="mnt-nom">{c.type}</span>
                  <span class="mnt-prix">{c.prix}&nbsp;€</span>
                  <span class="mnt-mois">par mois</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {criteres.map((li) => (
              <tr>
                <th scope="row">{li.c}</th>
                {li.v.map((val, i) => (
                  <td>
                    {val === 1
                      ? <span class="mnt-oui"><span class="sr-only">{`Compris dans la formule ${colonnes[i].type}`}</span><span aria-hidden="true">✓</span></span>
                      : <span class="mnt-non"><span class="sr-only">{`Non compris dans la formule ${colonnes[i].type}`}</span><svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="4" y1="8" x2="12" y2="8"/></svg></span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="font-body text-base font-semibold text-brun mt-8 text-center" data-reveal data-delay="2">
        Les {MAINTENANCE_MOIS_OFFERTS} premiers mois sont offerts dans les quatre cas.
      </p>
      <p class="font-body text-xs text-brun-mid mt-3 text-center max-w-2xl mx-auto" data-reveal data-delay="2">
        Le délai de 48&nbsp;heures est attaché aux deux dernières formules et court à
        compter du signalement, en jours ouvrés. Il couvre les interruptions qui
        viennent du site. Celles qui viennent d'un tiers (hébergeur, service de
        paiement, fournisseur d'accès) sont traitées dès leur rétablissement par le
        prestataire concerné. Sur les deux premières formules, nous intervenons
        avec le même soin, au fil de l'eau.
      </p>

      <!-- Rappel modifications -->
      <div class="mt-8 text-center" data-reveal data-delay="2">
        <p class="font-body text-sm text-brun-mid leading-relaxed">
          Au-delà des {MAINTENANCE_RETOUCHES_MIN}&nbsp;minutes comprises chaque mois, modifier le contenu de votre site reste un service à la demande, chiffré avant d'être réalisé.
        </p>
      </div>

    </div>
  </section>

  <!-- ── FAQ : un abonnement obligatoire se justifie, sinon il inquiète ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="faq-maintenance">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Questions fréquentes</p>
        <h2 id="faq-maintenance" class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Ce qu'on nous demande souvent.
        </h2>
      </div>

      <div class="seo-faq" data-reveal data-delay="1">
        {faq.map((f) => (
          <details class="seo-faq-item">
            <summary class="seo-faq-q">
              <span>{f.q}</span>
              <span class="seo-faq-marque" aria-hidden="true"></span>
            </summary>
            <p class="seo-faq-a">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="font-body text-sm text-brun-mid text-center mt-10" data-reveal data-delay="1">
        Une autre question ? <a href="/contact" class="text-sauge underline underline-offset-2 hover:text-brun transition-colors">Posez-la directement</a>, réponse sous 48h.
      </p>
    </div>
  </section>

  <!-- ── CTA ── -->
  <AppelFinal
    titre="On garde votre site"
    titreAccent="entre de bonnes mains."
    href="/contact"
    libelle="Prendre contact"
  />

</BaseLayout>

<style>
  /* ═══ La ligne de partage : ce qui tourne seul, ce qui se demande ═══
     Deux colonnes sans carte ni bordure arrondie : c'est le fond qui distingue
     l'abonnement (teinté, permanent) du devis (crème, à la demande), et un
     filet qui les sépare. Empilées en mobile, où le filet devient horizontal. */
  .prt {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-cream-dark);
    border-bottom: 1px solid var(--color-cream-dark);
  }
  @media (min-width: 760px) {
    .prt { grid-template-columns: 1fr 1px 1fr; }
  }

  .prt-col { padding: 34px 28px 36px; }
  .prt-col-inclus { background: var(--color-sauge-pale); }

  .prt-filet { background: var(--color-cream-dark); }
  @media (max-width: 759px) {
    .prt-filet { height: 1px; }
  }

  .prt-etiquette {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: 11px;
  }
  .prt-col h3 {
    font-size: 1.42rem;
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 12px;
  }
  .prt-intro {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    margin-bottom: 22px;
  }

  .prt-liste { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 10px; }
  .prt-liste li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-brun);
  }
  /* Puce pleine à gauche, ce qui est acquis. Puce en creux à droite, ce qui
     reste à demander : la forme dit le statut avant que le mot ne le dise. */
  .prt-liste li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
  }
  .prt-liste-inclus li::before { background: var(--color-sauge-text); }
  .prt-liste-devis li::before { border: 1px solid var(--color-pierre); }

  .prt-prix {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-brun);
    padding-top: 16px;
    border-top: 1px solid rgba(37, 92, 65, 0.14);
  }
</style>


<style>
  .seo-faq { border-top: 1px solid var(--color-cream-dark); }
  .seo-faq-item { border-bottom: 1px solid var(--color-cream-dark); }
  .seo-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--color-brun);
    transition: color 0.2s ease;
  }
  .seo-faq-q::-webkit-details-marker { display: none; }
  .seo-faq-q:hover { color: var(--color-sauge-text); }
  .seo-faq-marque {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .seo-faq-marque::before,
  .seo-faq-marque::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-sauge-text);
    transition: transform 0.3s ease;
  }
  .seo-faq-marque::before { width: 14px; height: 1.5px; }
  .seo-faq-marque::after  { width: 1.5px; height: 14px; }
  .seo-faq-item[open] .seo-faq-marque::after { transform: rotate(90deg); }
  .seo-faq-a {
    padding: 0 4px 20px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    max-width: 60ch;
  }
  .seo-faq-q:focus-visible {
    outline: 2px solid var(--color-sauge-text);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Icône check des fonctionnalités */
  .feat-std::before {
    content: '';
    display: block;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
