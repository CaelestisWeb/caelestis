---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { MAINTENANCE, MAINTENANCE_MIN, MAINTENANCE_MOIS_OFFERTS, euros, MAINTENANCE_MOIS_OFFERTS_LETTRES } from '../utils/tarifs';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Maintenance mensuelle de site internet, Caelestis',
  description: 'Abonnement mensuel de maintenance technique de site internet pour artisans, indépendants et petites entreprises en France : sécurité, sauvegardes et surveillance.',
  provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
  offers: [
    { '@type': 'Offer', name: 'Maintenance site une page',      priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['page-unique']),      priceCurrency: 'EUR', unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Maintenance site vitrine',       priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['site-vitrine']),     priceCurrency: 'EUR', unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Maintenance boutique en ligne',  priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['boutique-en-ligne']), priceCurrency: 'EUR', unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Maintenance site sur mesure',    priceSpecification: { '@type': 'PriceSpecification', price: String(MAINTENANCE['site-sur-mesure']),  priceCurrency: 'EUR', unitText: 'MONTH' } },
  ],
};

/* Un abonnement obligatoire soulève naturellement de la méfiance. Ces cinq
   questions sont celles qui décident : à quoi il sert vraiment, ce qui se
   passe si on refuse, et comment en sortir. Les taire les laisserait
   travailler en silence contre la signature. */
const faq = [
  {
    q: "Pourquoi la maintenance est-elle obligatoire ?",
    a: "Parce qu'un site vit sur des serveurs et des logiciels qui évoluent en permanence. Sans suivi, un site se dégrade en quelques mois : failles de sécurité, formulaire qui cesse d'envoyer, affichage cassé après une mise à jour de navigateur. L'abonnement couvre l'hébergement, le nom de domaine, les sauvegardes et la surveillance technique. Il évite qu'un site payé plusieurs centaines d'euros devienne inutilisable.",
  },
  {
    q: "Que comprend exactement l'abonnement ?",
    a: "L'hébergement du site, le renouvellement de votre nom de domaine, le certificat de sécurité, les sauvegardes automatiques, la surveillance technique et les petites modifications de contenu : changer un horaire, un tarif, une photo, un paragraphe. Une refonte ou l'ajout d'une page entière sortent du forfait et font l'objet d'un devis.",
  },
  {
    q: "Puis-je résilier quand je veux ?",
    a: "Oui, avec un mois de préavis, sans justification ni frais. Le site et le nom de domaine restent votre propriété : nous vous transmettons l'ensemble des fichiers et des accès pour que vous puissiez les confier à quelqu'un d'autre.",
  },
  {
    q: "Combien de modifications puis-je demander par mois ?",
    a: "Il n'y a pas de compteur. Les demandes courantes sont traitées au fil de l'eau, généralement sous quarante-huit heures. Nous fonctionnons à la confiance, et cela se passe bien tant que les demandes restent des ajustements de contenu.",
  },
  {
    q: "Et si mon site est déjà en ligne, créé par quelqu'un d'autre ?",
    a: "C'est possible dans la plupart des cas. Nous examinons d'abord comment le site est construit, puis nous vous disons franchement si nous pouvons en assurer le suivi. Certaines technologies anciennes ne se maintiennent pas sérieusement, et mieux vaut le savoir avant.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil',     item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://caelestis.fr/services' },
    { '@type': 'ListItem', position: 3, name: 'Maintenance mensuelle', item: 'https://caelestis.fr/maintenance' },
  ],
};

/* Abonnement de maintenance, un tarif par type de site.
   Les montants viennent de tarifs.ts : ils étaient écrits en dur ici et à cinq
   autres endroits du site, et la grille arrêtée le 31/07/2026 n'y était jamais
   arrivée. Le prix vit désormais à un seul endroit.

   Le bouton mène au contact et non à un paiement direct : la maintenance est
   offerte les six premiers mois, personne ne s'abonne le jour de la livraison,
   et le récurrent est piloté depuis Tiime (facture conforme et prélèvement),
   pas par un lien de paiement isolé. */
const formules = [
  {
    type: 'Page unique',
    prix: euros(MAINTENANCE['page-unique']),
    desc: 'Pour garder votre Page unique en ligne, rapide et sécurisée.',
    feats: [
      '1 mise à jour par mois',
      'Site protégé et sécurisé',
      'Sauvegardes régulières',
      'Toujours en ligne',
    ],
  },
  {
    type: 'Vitrine',
    prix: euros(MAINTENANCE['site-vitrine']),
    desc: 'Pour garder votre site vitrine en ligne, rapide et sécurisé.',    feats: [
      '1 mise à jour par semaine',
      'Site protégé et sécurisé',
      'Sauvegardes régulières',
      'Toujours en ligne',
    ],
  },
  {
    type: 'Boutique en ligne',
    prix: euros(MAINTENANCE['boutique-en-ligne']),
    desc: 'La tranquillité pour votre boutique : paiements et données surveillés.',    feats: [
      '3 mises à jour par semaine',
      'Boutique et paiements sécurisés',
      'Sauvegardes régulières',
      'Toujours en ligne',
    ],
  },
  {
    type: 'Sur mesure',
    prix: euros(MAINTENANCE['site-sur-mesure']),
    desc: 'Pour les sites complexes ou les boutiques avancées qui demandent une veille poussée.',    feats: [
      'Mises à jour 7 jours sur 7',
      'Surveillance permanente',
      'Site protégé et sécurisé',
      'Sauvegardes régulières',
    ],
  },
];

// Ce que couvre la maintenance (liste de la section distinction)
const couvert = [
  'Mises à jour régulières',
  'Site protégé et sécurisé',
  'Sauvegardes régulières',
  'Toujours en ligne',
];
---

<BaseLayout
  title={`Maintenance de site internet dès ${euros(MAINTENANCE_MIN)} €/mois, Caelestis`}
  description={`${MAINTENANCE_MOIS_OFFERTS} mois offerts, puis dès ${euros(MAINTENANCE_MIN)} € par mois : hébergement, sécurité, sauvegardes et surveillance de votre site. Sans engagement.`}
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- ── Hero ── -->
  <section class="pt-20 pb-14 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">

    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-20 w-[400px] h-[400px]"></div>
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/3 w-56 h-56"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <div class="inline-flex items-center gap-2 mb-6" data-reveal>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Maintenance mensuelle</p>
      </div>
      <h1
        class="font-display font-light text-brun leading-[1.05] tracking-tight max-w-3xl mx-auto"
        style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
        data-reveal data-delay="1"
      >
        Votre site reste entre<br class="hidden sm:block"> <span class="text-sauge">de bonnes mains.</span>
      </h1>
      <p class="font-body text-lg text-brun-mid mt-8 max-w-2xl leading-relaxed mx-auto" data-reveal data-delay="2">
        La mise en ligne n'est pas une fin. Un site internet n'est jamais figé : les technologies évoluent, des failles de sécurité apparaissent, et sans entretien il se fragilise avec le temps. Chaque semaine, nous veillons à ce que le vôtre reste rapide, sécurisé et toujours en ligne, en coulisses, sans que vous ayez à y penser.
      </p>
    </div>
  </section>

  <!-- ── Maintenance vs Modifications — l'explication, en premier ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20">
    <div class="max-w-4xl mx-auto" data-reveal>

      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="block w-8 h-px bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">À ne pas confondre</p>
          <span class="block w-8 h-px bg-sauge"></span>
        </div>
        <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Deux choses bien distinctes.
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-5 lg:gap-6 items-stretch">

        <!-- 1. Maintenance -->
        <div class="relative bg-cream rounded-2xl p-7 lg:p-8 border-2 border-sauge/40 flex flex-col text-center">
          <span class="absolute -top-3 right-5 inline-block font-body text-[11px] font-semibold tracking-[0.16em] uppercase px-3 py-1 rounded-full bg-[#255C41] text-cream shadow-[0_2px_8px_rgba(27, 71, 51,0.22)]">Obligatoire</span>
          <span class="self-center inline-block font-body text-[11px] tracking-[0.18em] uppercase px-3 py-1 rounded-full bg-sauge/15 text-sauge mb-5">Abonnement, en continu</span>
          <h3 class="font-display text-xl font-light text-brun mb-3">La maintenance</h3>
          <p class="font-body text-sm text-brun-mid leading-relaxed mb-5">
            Le socle technique qui garde votre site en ligne, rapide et protégé. Il tourne tout seul, en fond, sans rien vous demander.
          </p>
          <ul class="flex flex-col gap-2.5 flex-1 mb-5">
            {couvert.map((c) => (
              <li class="feat-std flex items-start justify-center gap-3 font-body text-sm text-brun leading-snug">{c}</li>
            ))}
          </ul>
          <p class="font-body text-sm font-semibold text-sauge">{MAINTENANCE_MOIS_OFFERTS} mois offerts, puis dès {euros(MAINTENANCE_MIN)} € par mois selon votre site.</p>
        </div>

        <!-- 2. Modifications -->
        <div class="bg-cream rounded-2xl p-7 lg:p-8 border border-cream-dark flex flex-col text-center">
          <span class="self-center inline-block font-body text-[11px] tracking-[0.18em] uppercase px-3 py-1 rounded-full bg-ocre/12 text-ocre-dark mb-5">À la demande, sur devis</span>
          <h3 class="font-display text-xl font-light text-brun mb-3">Les modifications et retouches</h3>
          <p class="font-body text-sm text-brun-mid leading-relaxed mb-5">
            Tout ce qui change le contenu ou ajoute des fonctions : modifier un texte, remplacer une photo, ajouter une page ou une nouvelle fonctionnalité.
          </p>
          <p class="font-body text-sm text-brun-mid leading-relaxed flex-1">
            Un service à part, facturé sur devis. Vous ne payez que ce dont vous avez besoin, quand vous le décidez.
          </p>
          <p class="font-body text-sm font-semibold text-brun mt-5">Sur devis, sans engagement.</p>
        </div>

      </div>

    </div>
  </section>

  <!-- ── L'abonnement maintenance — les cartes, en second ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark relative overflow-hidden">

    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute top-40 -left-24 w-72 h-72"></div>

    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12" data-reveal>
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="block w-8 h-px bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">L'abonnement maintenance</p>
          <span class="block w-8 h-px bg-sauge"></span>
        </div>
        <h2 class="font-display font-light text-brun leading-[1.1] mb-4" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Un tarif selon votre site.
        </h2>
        <p class="font-body text-base text-brun-mid max-w-xl mx-auto leading-relaxed">
          Un abonnement qui garde votre site en ligne, sécurisé et sauvegardé, sans engagement.
          <strong class="text-brun font-semibold">Les {MAINTENANCE_MOIS_OFFERTS_LETTRES} premiers mois sont offerts</strong>, l'abonnement ne commence qu'ensuite.
        </p>
      </div>

      <!-- 4 cartes : une par type de site -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 items-stretch" data-reveal data-delay="1">
        {formules.map((f) => (
          <div class="bg-cream border-2 border-sauge/30 rounded-2xl p-6 lg:p-8 flex flex-col text-center">
            <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-4">{f.type}</p>
            <div class="mb-5">
              <p class="font-display font-light text-brun leading-none" style="font-size: clamp(2rem, 4vw, 2.6rem); letter-spacing: -0.02em;">
                {f.prix}<span class="text-bois-mid text-lg ml-1">€</span>
              </p>
              <p class="font-body text-xs text-brun-mid mt-2">par mois après les {MAINTENANCE_MOIS_OFFERTS_LETTRES} mois offerts</p>
            </div>
            <p class="font-body text-sm text-brun-mid mb-6 leading-relaxed">{f.desc}</p>
            <ul class="flex flex-col gap-3 flex-1 mb-7">
              {f.feats.map((feat) => (
                <li class="feat-std flex items-start justify-center gap-3 font-body text-sm text-brun-mid leading-snug">{feat}</li>
              ))}
            </ul>
            <a
              href="/contact"
              class="inline-flex items-center justify-center font-body font-medium text-sm tracking-[0.04em] transition-all duration-300 min-h-[44px] border border-sauge/70 text-[#2E7452] px-6 py-3 rounded-full hover:bg-[#255C41] hover:text-cream hover:border-[#255C41] btn-magnetic"
              aria-label={`Poser une question sur la maintenance ${f.type}`}
            >
              En parler
            </a>
          </div>
        ))}
      </div>

      <!-- Rappel modifications -->
      <div class="mt-8 text-center" data-reveal data-delay="2">
        <p class="font-body text-sm text-brun-mid leading-relaxed">
          Pour rappel, modifier le contenu de votre site reste un service à la demande, facturé sur devis.
        </p>
      </div>

    </div>
  </section>

  <!-- ── FAQ : un abonnement obligatoire se justifie, sinon il inquiète ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="faq-maintenance">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Questions fréquentes</p>
        <h2 id="faq-maintenance" class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Ce qu'on nous demande souvent.
        </h2>
      </div>

      <div class="seo-faq" data-reveal data-delay="1">
        {faq.map((f) => (
          <details class="seo-faq-item">
            <summary class="seo-faq-q">
              <span>{f.q}</span>
              <span class="seo-faq-marque" aria-hidden="true"></span>
            </summary>
            <p class="seo-faq-a">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="font-body text-sm text-brun-mid text-center mt-10" data-reveal data-delay="1">
        Une question qui n'est pas là ? <a href="/contact" class="text-sauge underline underline-offset-2 hover:text-brun transition-colors">Posez-la directement</a>, réponse sous 48h.
      </p>
    </div>
  </section>

  <!-- ── CTA ── -->
  <AppelFinal
    titre="Votre site mérite d'être"
    titreAccent="entre de bonnes mains."
    href="/contact"
    libelle="Prendre contact"
  />

</BaseLayout>

<style>
  .seo-faq { border-top: 1px solid var(--color-cream-dark); }
  .seo-faq-item { border-bottom: 1px solid var(--color-cream-dark); }
  .seo-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--color-brun);
    transition: color 0.2s ease;
  }
  .seo-faq-q::-webkit-details-marker { display: none; }
  .seo-faq-q:hover { color: var(--color-sauge-text); }
  .seo-faq-marque {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .seo-faq-marque::before,
  .seo-faq-marque::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-sauge-text);
    transition: transform 0.3s ease;
  }
  .seo-faq-marque::before { width: 14px; height: 1.5px; }
  .seo-faq-marque::after  { width: 1.5px; height: 14px; }
  .seo-faq-item[open] .seo-faq-marque::after { transform: rotate(90deg); }
  .seo-faq-a {
    padding: 0 4px 20px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    max-width: 60ch;
  }
  .seo-faq-q:focus-visible {
    outline: 2px solid var(--color-sauge-text);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Icône check des fonctionnalités */
  .feat-std::before {
    content: '';
    display: block;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='8' cy='8' r='7.25' stroke='%23889063' stroke-width='1.5'/%3E%3Cpath d='M4.5 8.2 L6.8 10.5 L11.5 5.5' stroke='%23889063' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-size: contain;
  }
</style>
