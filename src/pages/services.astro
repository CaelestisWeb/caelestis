---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { Image } from 'astro:assets';
import { euros, formule, FORMULES, MAINTENANCE_MIN, MAINTENANCE_MOIS_OFFERTS, MAINTENANCE_MOIS_OFFERTS_LETTRES } from '../utils/tarifs';

/* Aperçus des quatre formules. Sites de démonstration créés pour illustrer
   la différence entre les offres : aucune de ces entreprises n'existe.
   Captures, légendes et adresses vivent dans utils/demos.ts, partagé avec le
   bloc ApercuDemo des quatre pages de formule. */
import { DEMOS as apercus } from '../utils/demos';

/* Capture du site livré, affichée dans l'écran du mockup du premier écran. */
import captureFeeDesOngles from '../assets/images/realisations/fee-des-ongles-accueil.jpg';

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Services Caelestis',
  description: 'Sites web sur mesure et référencement naturel pour artisans, indépendants et petites entreprises en Auvergne-Rhône-Alpes. Agence basée à Crest, dans la Drôme.',
  url: 'https://caelestis.fr/services',
  numberOfItems: 7,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        name: 'Site vitrine',
        description: "Votre activité présentée clairement, visible sur Google, lisible sur tout type d'écran.",
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '2000',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        name: 'Boutique en ligne',
        description: 'Catalogue en ligne, paiement sécurisé, connecté à votre logiciel de gestion.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '2500',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        name: 'Référencement naturel (SEO)',
        description: "Apparaître en tête des résultats quand vos clients vous cherchent. Référencement local et national.",
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 4,
      item: {
        '@type': 'Service',
        name: 'Refonte de site existant',
        description: 'Votre site date ou ne vous ressemble plus ? On repart proprement sur de bonnes bases.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 5,
      item: {
        '@type': 'Service',
        name: 'Maintenance & accompagnement',
        description: 'Évolutions, mises à jour, nouvelles pages, forfait mensuel ou à la tâche.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 6,
      item: {
        '@type': 'Service',
        name: 'Page unique',
        description: "L'essentiel de votre activité sur une seule page. La solution accessible pour démarrer simplement et être visible sur Google.",
        url: 'https://caelestis.fr/services/site-une-page',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '1000',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 7,
      item: {
        '@type': 'Service',
        name: 'Site sur mesure',
        description: 'Un site entièrement adapté à votre projet, avec davantage de contenu, de fonctionnalités et un travail de référencement approfondi.',
        url: 'https://caelestis.fr/services/site-sur-mesure',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '3500',
            priceCurrency: 'EUR',
          },
        },
      },
    },
  ],
};

const breadcrumbServices = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://caelestis.fr/services' },
  ],
};

---
<BaseLayout
  title="Tarifs et formules de création de site, Caelestis"
  description="Page unique dès 1 000 €, vitrine dès 2 000 €, boutique dès 2 500 €, sur mesure dès 3 500 €. Prix nets sans TVA, devis gratuit sous 48h."
  schema={[servicesSchema, breadcrumbServices]}
>

  <!-- En-tête de page -->
  <section class="pt-20 pb-10 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">

    <!-- Blob sauge atmosphérique -->
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-20 w-[420px] h-[420px]"></div>
    <!-- Blob doré secondaire -->
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/3 w-64 h-64"></div>

    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_480px] gap-12 lg:gap-16 items-center relative">

      <!-- Texte -->
      <div class="text-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 mb-6" data-reveal>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Création de site internet</p>
        </div>
        <h1
          class="font-display font-light text-brun leading-[1.05] tracking-tight max-w-3xl mx-auto"
          style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
          data-reveal data-delay="1"
        >
          Un site internet qui reflète vraiment<br class="hidden sm:block"> <span class="text-sauge">votre activité.</span>
        </h1>
        <p class="font-body text-lg text-brun-mid mt-8 max-w-xl leading-relaxed mx-auto" data-reveal data-delay="2">
          En 2 à 8 semaines, nous construisons ensemble un site sobre, authentique et durable. Un site qui raconte votre histoire, met en lumière votre travail et transforme les visiteurs en futurs clients.
        </p>

        <!-- CTA + ligne d'info discrète -->
        <div class="mt-10 flex flex-col sm:flex-row sm:items-center justify-center gap-5 sm:gap-7" data-reveal data-delay="3">
          <Button href="/contact#devis" variant="primary">Demander un devis</Button>
          <div class="flex items-center justify-center gap-3 flex-wrap">
            <span class="font-body text-xs tracking-[0.18em] uppercase text-brun-mid">Devis gratuit</span>
            <span class="font-body text-xs tracking-[0.18em] uppercase text-brun-mid">Réponse sous 48h</span>
          </div>
        </div>
      </div>


      <!-- Mockup laptop. L'écran ne dessine plus une maquette de site, il montre
           un site réellement livré : le salon Fée des Ongles, à Crest.
           Jusqu'au 07/08/2026 il affichait une miniature en HTML reprenant une
           ancienne version de caelestis.fr, slogan compris (« Votre site devrait
           vous ressembler », « Développeur web indépendant »), donc un discours
           que le site ne tient plus nulle part ailleurs, et l'adresse
           caelestis.fr sur une page qui parle du site du visiteur. Une preuve
           remplace une illustration : c'est le premier écran d'une page de vente.
           Réserve de pixels : source 1440 px pour 418 px d'affichage, soit 3,4,
           suffisant pour un écran à densité double (836 px demandés). -->
      <div class="hidden lg:flex items-end justify-center py-4">
        <figure class="mk-wrap m-0">

          <!-- Écran -->
          <div class="mk-lid">

            <!-- Chrome navigateur -->
            <div class="mk-chrome" aria-hidden="true">
              <div class="mk-dots">
                <span style="background:#ff5f57"></span>
                <span style="background:#febc2e"></span>
                <span style="background:#28c840"></span>
              </div>
              <div class="mk-url">
                <svg width="5" height="6" viewBox="0 0 5 6" fill="none" aria-hidden="true"><path d="M.8 3C.8 1.6 4.2 1.6 4.2 3v1.6C4.2 5 3.8 5.3 2.5 5.3 1.2 5.3.8 5 .8 4.6Z" stroke="rgba(184, 196, 187,.6)" stroke-width=".8"/><path d="M1.6 3V2.4C1.6 1.6 3.4 1.6 3.4 2.4V3" stroke="rgba(184, 196, 187,.6)" stroke-width=".8"/></svg>
                feedesongles.fr
              </div>
            </div>

            <!-- Le site livré, en clair -->
            <a href="/realisations/fee-des-ongles" class="mk-screen mk-screen-photo">
              <Image
                src={captureFeeDesOngles}
                alt="Page d'accueil du site de Fée des Ongles, salon de prothésie ongulaire à Crest, affichée sur un ordinateur portable."
                widths={[418, 836]}
                sizes="418px"
                quality={78}
                loading="eager"
              />
            </a>
          </div>

          <!-- Charnière -->
          <div class="mk-hinge" aria-hidden="true"></div>

          <!-- Base -->
          <div class="mk-base" aria-hidden="true">
            <div class="mk-trackpad"></div>
          </div>

          <!-- Ombre sol -->
          <div class="mk-shadow" aria-hidden="true"></div>

          <figcaption class="mk-legende font-body">
            Fée des Ongles, à Crest. <span>Voir l'étude de cas</span>
          </figcaption>
        </figure>
      </div>

    </div>
  </section>

  <style>
    /* ═══════════════════════════════════════
       Mockup laptop — style épuré / design
    ═══════════════════════════════════════ */

    /* Wrapper + perspective légère */
    .mk-wrap {
      position: relative;
      width: 420px;
      perspective: 1200px;
      perspective-origin: 50% 30%;
    }

    /* ════════════════════════════════════════
       Mockup device — style épuré Caelestis
    ════════════════════════════════════════ */

    /* Le laptop tourne légèrement, animation flottante */
    .mk-lid, .mk-base {
      transform: rotateX(2deg) rotateY(-12deg);
      animation: mk-float 7s ease-in-out infinite;
    }
    @keyframes mk-float {
      0%,100% { transform: rotateX(2deg) rotateY(-12deg) translateY(0); }
      50%      { transform: rotateX(3deg) rotateY(-11deg) translateY(-8px); }
    }

    /* ── ÉCRAN ── */
    .mk-lid {
      width: 420px;
      background: #f0f0ee;
      border-radius: 14px 14px 4px 4px;
      border: 1.5px solid #d8d8d4;
      box-shadow:
        0 2px 0 #c8c8c4,
        0 8px 32px rgba(27, 71, 51,0.14),
        0 2px 8px rgba(27, 71, 51,0.08);
      overflow: hidden;
    }

    /* Chrome navigateur */
    .mk-chrome {
      height: 26px;
      background: #e8e8e4;
      border-bottom: 1px solid #d0d0cc;
      display: flex;
      align-items: center;
      padding: 0 10px;
      gap: 8px;
      flex-shrink: 0;
    }
    .mk-dots {
      display: flex; gap: 4px; align-items: center;
      flex-shrink: 0;
    }
    .mk-dots span {
      display: block;
      width: 7px; height: 7px;
      border-radius: 50%;
      box-shadow: inset 0 0.5px 0 rgba(255,255,255,0.4);
    }
    .mk-url {
      flex: 1; max-width: 200px; margin: 0 auto;
      height: 15px;
      background: rgba(255,255,255,0.80);
      border: 1px solid #c8c8c4;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-family: var(--font-body);
      font-size: 6px;
      color: rgba(27, 71, 51,0.50);
      letter-spacing: 0.01em;
    }

    /* Contenu du site */
    .mk-screen {
      background: #FCFBF8;
      height: 252px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* L'écran porte une capture, plus une maquette dessinée. Le lien couvre
       toute la surface : la vignette mène à l'étude de cas. */
    .mk-screen-photo {
      display: block;
      position: relative;
      overflow: hidden;
      transition: filter 0.25s ease;
    }
    .mk-screen-photo img {
      display: block;
      width: 100%;
      height: 252px;
      object-fit: cover;
      object-position: top center;
    }
    .mk-wrap:hover .mk-screen-photo { filter: brightness(1.04); }

    /* Légende sous la machine : elle nomme le site montré, sans quoi la
       capture passerait pour une illustration de plus. */
    .mk-legende {
      margin-top: 18px;
      text-align: center;
      font-size: 0.78rem;
      color: var(--color-brun-mid);
    }
    .mk-legende span {
      color: #2E7452;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(46, 116, 82, 0.4);
    }
    .mk-wrap:hover .mk-legende span { text-decoration-color: #2E7452; }

    .mk-hinge {
      width: 100%;
      height: 3px;
      background: #d0d0cc;
      border-top: 1px solid #c0c0bc;
      border-bottom: 1px solid #e0e0dc;
    }

    /* ── BASE ── */
    .mk-base {
      width: 440px;
      height: 18px;
      background: linear-gradient(to bottom, #f0f0ee 0%, #e4e4e0 100%);
      border-radius: 0 0 10px 10px;
      border: 1.5px solid #d8d8d4;
      border-top: none;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow:
        0 4px 16px rgba(27, 71, 51,0.10),
        0 1px 3px rgba(27, 71, 51,0.06);
    }

    /* Trackpad */
    .mk-trackpad {
      width: 80px; height: 10px;
      background: #e0e0dc;
      border: 1px solid #c8c8c4;
      border-radius: 3px;
    }

    /* ── OMBRE SOL ── */
    .mk-shadow {
      position: absolute;
      bottom: -14px; left: 8%; right: 8%;
      height: 20px;
      background: radial-gradient(ellipse at center,
        rgba(27, 71, 51,0.20) 0%, rgba(27, 71, 51,0.06) 60%, transparent 80%);
      filter: blur(5px);
      pointer-events: none;
    }

    /* ── Aperçus des formules, présentés dans un cadre de navigateur ── */
    .apercu-ouvrir { cursor: pointer; text-decoration: none; color: inherit; }
    .fenetre {
      border: 1px solid var(--cream-dark, #E4DED2);
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      transition: box-shadow 0.3s ease, transform 0.3s ease;
    }
    .apercu-ouvrir:hover .fenetre {
      box-shadow: 0 10px 28px rgba(37, 92, 65, 0.14);
      transform: translateY(-2px);
    }
    .apercu-ouvrir:focus-visible .fenetre {
      outline: 2px solid #255C41;
      outline-offset: 2px;
    }
    .fenetre-barre {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 8px 11px;
      background: #F2EFE8;
      border-bottom: 1px solid var(--cream-dark, #E4DED2);
    }
    .fenetre-barre > span {
      width: 7px; height: 7px; border-radius: 50%;
      background: #CFC8B8; flex: none;
    }
    .fenetre-url {
      flex: 1;
      margin-left: 6px;
      font-size: 9px;
      letter-spacing: 0.08em;
      /* Pierre chaude plutôt que #8A8375 : ce libellé porte une information
         (le métier illustré par l'aperçu), il ne relève donc pas de l'exception
         accordée au texte décoratif. L'ancienne teinte tombait à 3,27:1. */
      color: var(--color-pierre);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: left;
      /* Sans ce min-width, l'ellipsis ne sert à rien : un enfant flex garde par
         défaut `min-width: auto`, donc il refuse de descendre sous la largeur de
         son texte insécable. La barre imposait alors 279 px de large, la carte
         montait à 325 px dans un conteneur de 268, et son bord droit était rogné
         sur un écran de 320 px. Mesuré le 03/08/2026 sur /services. */
      min-width: 0;
    }
    /* 9 px tient sur un écran d'ordinateur où la fausse fenêtre est petite ;
       sur mobile la carte occupe toute la largeur et l'étiquette, qui porte le
       métier illustré, devenait illisible. La barre a la place de l'agrandir.
       La condition porte sur le pointeur autant que sur la largeur : une
       tablette de 768px est tenue à bout de bras, pas posée sur un bureau. */
    @media (max-width: 767px), (hover: none) and (pointer: coarse) {
      .fenetre-url { font-size: 11px; }
    }
    /* La capture cadre le haut du site en 16/9 depuis le 03/08/2026 : elle
       s'affiche entière. L'ancienne hauteur de 186 px découpait au hasard une
       capture pleine longueur, ce que le nouveau cadrage rend inutile. */
    .fenetre-ecran :global(img) { width: 100%; height: auto; display: block; }
    /* Carte large : on borne la largeur pour garder la même échelle que les colonnes. */
    .apercu-large .fenetre { max-width: 460px; margin: 0 auto; }

    /* ════════════════════════════════════════
       TARIFS — quatre blocs de même taille.
       Le bloc accent (site vitrine) inverse la palette : fond forêt, texte crème.
       Toutes les couleurs sont reprises de la charte, aucune valeur inventée.
    ════════════════════════════════════════ */
    /* Les deux rangées font la même hauteur : les quatre blocs sont identiques. */
    @media (min-width: 640px) {
      .tf-grille { grid-auto-rows: 1fr; }
    }
    .tf-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      /* Un item de grille garde par défaut `min-width: auto` : il refuse de
         descendre sous la taille min-content de son contenu. La barre d'adresse
         de la vignette, en `white-space: nowrap`, imposait ainsi 325 px à la
         carte dans un conteneur de 268, et son bord droit sortait de l'écran à
         320 px de large. Mesuré le 03/08/2026. Le `min-width: 0` de
         `.fenetre-url` ne suffit pas seul : il fait rétrécir la barre une fois
         que la carte, elle, a le droit de rétrécir. Les deux vont ensemble. */
      min-width: 0;
      background: #FCFBF8;
      border: 1px solid #E6E4DC;
      border-radius: 18px;
      padding: 30px 28px;
      transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }
    .tf-card:hover {
      border-color: rgba(46, 116, 82, 0.45);
      box-shadow: 0 12px 30px rgba(37, 92, 65, 0.10);
      transform: translateY(-2px);
    }
    .tf-card-accent {
      background: #255C41;
      border-color: #255C41;
    }
    .tf-card-accent:hover {
      border-color: #1B4733;
      box-shadow: 0 14px 34px rgba(27, 71, 51, 0.24);
    }

    .tf-kicker {
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 500;
      color: #2E7452;
    }
    .tf-card-accent .tf-kicker { color: rgba(252, 251, 248, 0.74); }

    .tf-nom {
      font-family: var(--font-display, 'Satoshi', system-ui, sans-serif);
      font-weight: 300;
      font-size: 1.6rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: #255C41;
      margin-top: 10px;
    }
    .tf-card-accent .tf-nom { color: #FCFBF8; }

    .tf-prix {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
      padding-top: 18px;
      border-top: 1px solid #E6E4DC;
    }
    .tf-card-accent .tf-prix { border-top-color: rgba(252, 251, 248, 0.2); }
    .tf-num {
      font-family: var(--font-display, 'Satoshi', system-ui, sans-serif);
      font-weight: 300;
      font-size: clamp(2rem, 3.6vw, 2.5rem);
      line-height: 1;
      letter-spacing: -0.03em;
      font-variant-numeric: lining-nums tabular-nums;
      color: #255C41;
    }
    .tf-card-accent .tf-num { color: #FCFBF8; }
    .tf-from {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #5C6259;
    }
    .tf-card-accent .tf-from { color: rgba(252, 251, 248, 0.72); }
    /* 0,68rem tombe à 10,88px, trop peu pour un écran tenu en main. Placé après
       la règle de base : à spécificité égale, une media query ne l'emporte pas,
       seul l'ordre compte. */
    @media (max-width: 767px), (hover: none) and (pointer: coarse) {
      .tf-from { font-size: 0.75rem; }
    }

    .tf-desc {
      font-size: 0.92rem;
      line-height: 1.65;
      color: #5C6259;
      margin-top: 16px;
    }
    .tf-card-accent .tf-desc { color: rgba(252, 251, 248, 0.84); }

    .tf-ul {
      list-style: none;
      display: grid;
      gap: 10px;
      margin-top: 18px;
    }
    .tf-ul li {
      display: flex;
      gap: 11px;
      font-size: 0.88rem;
      line-height: 1.55;
      color: #5C6259;
    }
    .tf-card-accent .tf-ul li { color: rgba(252, 251, 248, 0.88); }
    .tf-check {
      flex: 0 0 auto;
      width: 16px;
      height: 16px;
      margin-top: 4px;
      border-radius: 50%;
      border: 1px solid rgba(46, 116, 82, 0.55);
      position: relative;
    }
    .tf-check::after {
      content: '';
      position: absolute;
      inset: 0;
      margin: auto;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #2E7452;
    }
    .tf-card-accent .tf-check { border-color: rgba(252, 251, 248, 0.45); }
    .tf-card-accent .tf-check::after { background: rgba(252, 251, 248, 0.8); }

    /* L'aperçu pousse le lien en bas : les quatre blocs gardent la même hauteur. */
    .tf-apercu {
      display: block;
      width: 100%;
      margin-top: 24px;
      text-align: left;
    }
    .tf-legende {
      font-size: 0.78rem;
      line-height: 1.5;
      color: #5C6259;
      margin-top: 10px;
    }
    .tf-card-accent .tf-legende { color: rgba(252, 251, 248, 0.76); }

    /* Signale que l'aperçu est cliquable et qu'il mène au site lui-même. */
    .tf-visiter {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 9px;
      font-size: 0.72rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: #2E7452;
      transition: gap 0.25s ease;
    }
    .tf-visiter svg { width: 11px; height: 11px; flex: none; }
    .apercu-ouvrir:hover .tf-visiter { gap: 12px; }
    .tf-card-accent .tf-visiter { color: #FCFBF8; }

    .tf-lien {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      padding-top: 22px;
      font-size: 0.88rem;
      font-weight: 500;
      color: #2E7452;
      transition: gap 0.25s ease;
    }
    .tf-lien:hover { gap: 14px; }
    .tf-card-accent .tf-lien { color: #FCFBF8; }
    .tf-lien:focus-visible {
      outline: 2px solid #255C41;
      outline-offset: 3px;
      border-radius: 3px;
    }
    .tf-card-accent .tf-lien:focus-visible { outline-color: #FCFBF8; }

    @media (max-width: 640px) {
      .tf-card { padding: 26px 22px; }
    }

    /* ── Les quatre gages, liste éditoriale (variante C) ──
       Chaque repère sur sa ligne, icône en pastille, libellé en gras et une
       phrase qui le justifie. Filet horizontal entre chaque, aucun fond de
       carte. Colonne de droite d'une grille à deux colonnes. */
    .reassur { list-style: none; padding: 0; margin: 0; }
    .reassur li {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 20px 0;
      border-bottom: 1px solid var(--color-cream-dark, #E6E4DC);
    }
    .reassur li:first-child { padding-top: 0; }
    .reassur li:last-child { border-bottom: 0; padding-bottom: 0; }
    .reassur-i {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-sauge-pale, #E3EFE8);
      color: var(--color-sauge-vif, #2E7452);
      flex: none;
      margin-top: 2px;
    }
    .reassur-i svg { width: 22px; height: 22px; }
    /* min-width: 0 sur le corps : sans lui, un libellé insécable empêcherait la
       colonne de rétrécir sur petit écran (piège min-width auto des flex). */
    .reassur-corps { min-width: 0; }
    .reassur-titre {
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-brun, #255C41);
      line-height: 1.3;
      margin: 0 0 4px;
    }
    /* Le seul repère cliquable : sans marque visible, « vérifiables » promettrait
       un clic inexistant. Soulignement discret, plus marqué au survol. */
    .reassur-preuve {
      text-decoration: underline;
      text-decoration-color: rgba(37, 92, 65, 0.3);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.25s ease;
    }
    .reassur-preuve:hover { text-decoration-color: var(--color-brun, #255C41); }
    .reassur-sous {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--color-brun-mid, #5C6259);
      margin: 0;
    }
  </style>

  <!-- ── Tarif — trois typologies ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 relative overflow-hidden">

    <!-- Blob sauge atmosphérique gauche -->
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute top-32 -left-24 w-80 h-80"></div>

    <div class="max-w-6xl mx-auto">

      <!-- Bloc tarif — trois typologies éditoriales -->
      <div data-reveal>

        <!-- Famille 1 : créer votre site -->
        <div class="text-center mb-12 lg:mb-14">
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Le site</p>
          <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
            Créer votre site.
          </h2>
          <p class="font-body text-base text-brun-mid mt-4 max-w-xl mx-auto leading-relaxed">
            Quatre formules, de la plus simple au sur mesure. Toutes livrées prêtes à l'emploi, avec les bases du référencement déjà en place.
          </p>
        </div>

        <!-- Quatre formules, quatre blocs de même taille.
             Le site vitrine porte l'accent (fond forêt) : c'est la formule la plus demandée.
             Les id servent d'ancres depuis la planche des formules en page d'accueil. -->
        <div class="tf-grille grid sm:grid-cols-2 gap-4 lg:gap-5 max-w-5xl mx-auto" data-reveal data-delay="1">
          {FORMULES.map((f) => (
            <div id={f.id} class={'tf-card scroll-mt-28' + (f.accent ? ' tf-card-accent' : '')}>
              <p class="tf-kicker">{f.kicker}</p>
              <h3 class="tf-nom">{f.nom}</h3>
              <div class="tf-prix">
                <span class="tf-from">à partir de</span>
                <span class="tf-num">{euros(f.prix)}&nbsp;€</span>
              </div>
              <p class="tf-desc">{f.resume}</p>
              <ul class="tf-ul">
                {f.points.map((p) => (
                  <li><span class="tf-check" aria-hidden="true"></span><span>{p}</span></li>
                ))}
              </ul>
              {/* L'aperçu mène directement au site de démonstration, dans un nouvel onglet :
                  le site vivant convainc mieux qu'une capture, et l'ancienne visionneuse
                  imposait un clic de plus avant d'y arriver. */}
              <a
                class="apercu-ouvrir tf-apercu"
                href={apercus[f.apercu].href}
                target="_blank"
                rel="noopener"
                aria-label={"Visiter le site de démonstration, " + f.nom + " : " + apercus[f.apercu].titre + " (nouvel onglet)"}
              >
                <div class="fenetre">
                  <div class="fenetre-barre" aria-hidden="true">
                    <span></span><span></span><span></span>
                    <p class="fenetre-url">{apercus[f.apercu].url}</p>
                  </div>
                  <div class="fenetre-ecran">
                    <Image src={apercus[f.apercu].img} alt={apercus[f.apercu].alt} widths={[420, 700, 880]} sizes="(max-width: 640px) 90vw, 440px" loading="lazy" />
                  </div>
                </div>
                <p class="tf-legende">{apercus[f.apercu].detail}</p>
                <span class="tf-visiter" aria-hidden="true">
                  Visiter le site de démonstration
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
                </span>
              </a>
              <a href={f.action.href} class="tf-lien">{f.action.libelle} <span aria-hidden="true">→</span></a>
            </div>
          ))}
        </div>

        <!-- Mention : les aperçus sont des démonstrations, pas des références clientes -->
        <p class="font-body text-xs text-brun-mid text-center mt-8 max-w-2xl mx-auto leading-relaxed" data-reveal>
          Les quatre aperçus ci-dessus sont des sites de démonstration, créés pour montrer
          ce que change une formule par rapport à une autre. Les entreprises représentées n'existent pas.
          Nos réalisations pour de vrais clients sont <a href="/realisations" class="text-sauge font-medium underline underline-offset-2">dans la page réalisations</a>.
        </p>

        <!-- Note philosophie -->
        <div class="mt-10 pt-10 border-t border-cream-dark text-center max-w-2xl mx-auto" data-reveal data-delay="2">
          <p class="font-body text-sm text-brun-mid leading-relaxed">
            Après avoir échangé sur votre projet, nous vous transmettons un devis détaillé et personnalisé. Le tarif dépend de la structure du site, du nombre de pages, du contenu à mettre en valeur et des fonctionnalités envisagées.
          </p>
          <p class="font-body text-sm font-semibold text-sauge leading-relaxed mt-5">
            30&nbsp;% d'acompte à la signature, solde à la mise en ligne.
          </p>
          <!-- Franchise de TVA (article 293 B du CGI) : les montants annoncés sont
               ceux réellement facturés. Les agences affichent des prix hors taxes,
               auxquels s'ajoutent 20 %. La mention n'apparaît qu'ici et dans la FAQ,
               pour rester une information et non un argument martelé. -->
          <p class="font-body text-sm text-brun-mid leading-relaxed mt-4">
            Les prix indiqués sont <strong class="text-brun font-medium">nets, sans TVA à ajouter</strong>. C'est le montant que vous réglez.
          </p>
        </div>

      </div>

    </div>
  </section>

