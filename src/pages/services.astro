---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { Image } from 'astro:assets';
import { euros, formule, FORMULES, MAINTENANCE_MIN, MAINTENANCE_MOIS_OFFERTS, MAINTENANCE_MOIS_OFFERTS_LETTRES } from '../utils/tarifs';

/* Icône fine monochrome par formule, à gauche du titre dans la liste.
   Traits seuls, aucun aplat, aucun emoji : conformes à la charte. Les
   sites de démonstration restent accessibles depuis chaque page de formule
   (bloc ApercuDemo), où le visiteur arrive en cliquant une ligne. */
const ICONES: Record<string, string> = {
  'page-unique':
    '<rect x="5" y="3" width="14" height="18" rx="2"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>',
  'site-vitrine':
    '<rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="9" x2="9" y2="20"/>',
  'boutique-en-ligne':
    '<path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  'site-sur-mesure':
    '<line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="9" cy="7" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="8" cy="17" r="2"/>',
};

/* Capture du site livré, affichée dans l'écran du mockup du premier écran. */
import captureFeeDesOngles from '../assets/images/realisations/fee-des-ongles-accueil.jpg';

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Services Caelestis',
  description: 'Sites web sur mesure et référencement naturel pour artisans, indépendants et petites entreprises en Auvergne-Rhône-Alpes. Agence basée à Crest, dans la Drôme.',
  url: 'https://caelestis.fr/services',
  numberOfItems: 7,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        name: 'Site vitrine',
        description: "Votre activité présentée clairement, visible sur Google, lisible sur tout type d'écran.",
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '2000',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        name: 'Boutique en ligne',
        description: 'Catalogue en ligne, paiement sécurisé, connecté à votre logiciel de gestion.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '2500',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        name: 'Référencement naturel (SEO)',
        description: "Apparaître en tête des résultats quand vos clients vous cherchent. Référencement local et national.",
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 4,
      item: {
        '@type': 'Service',
        name: 'Refonte de site existant',
        description: 'Votre site date ou ne vous ressemble plus ? On repart proprement sur de bonnes bases.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 5,
      item: {
        '@type': 'Service',
        name: 'Maintenance & accompagnement',
        description: 'Évolutions, mises à jour, nouvelles pages, forfait mensuel ou à la tâche.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 6,
      item: {
        '@type': 'Service',
        name: 'Page unique',
        description: "L'essentiel de votre activité sur une seule page. La solution accessible pour démarrer simplement et être visible sur Google.",
        url: 'https://caelestis.fr/services/site-une-page',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '1000',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 7,
      item: {
        '@type': 'Service',
        name: 'Site sur mesure',
        description: 'Un site entièrement adapté à votre projet, avec davantage de contenu, de fonctionnalités et un travail de référencement approfondi.',
        url: 'https://caelestis.fr/services/site-sur-mesure',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '3500',
            priceCurrency: 'EUR',
          },
        },
      },
    },
  ],
};

const breadcrumbServices = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://caelestis.fr/services' },
  ],
};

---
<BaseLayout
  title="Tarifs et formules de création de site, Caelestis"
  description="Page unique dès 1 000 €, vitrine dès 2 000 €, boutique dès 2 500 €, sur mesure dès 3 500 €. Prix nets sans TVA, devis gratuit sous 48h."
  schema={[servicesSchema, breadcrumbServices]}
>

  <!-- En-tête de page -->
  <section class="pt-20 pb-10 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">

    <!-- Blob sauge atmosphérique -->
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-20 w-[420px] h-[420px]"></div>
    <!-- Blob doré secondaire -->
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/3 w-64 h-64"></div>

    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_480px] gap-12 lg:gap-16 items-center relative">

      <!-- Texte -->
      <div class="text-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 mb-6" data-reveal>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Création de site internet</p>
        </div>
        <h1
          class="font-display font-light text-brun leading-[1.05] tracking-[-0.03em] max-w-3xl mx-auto hero-title"
          style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
          data-reveal data-delay="1"
        >
          <!-- Trois blocs .sl et non deux : « Un site internet qui reflète
               vraiment » mesure 855 px à 62,4 px (canvas), le conteneur
               max-w-3xl en fait 768 : en un seul bloc, « vraiment » tombait
               seul sur sa ligne. Segments mesurés : 370 / 470 / 318 px en
               desktop, 199 / 253 / 171 px à 320 px de fenêtre. -->
          <span class="sl"><span>Un site internet</span></span>
          <span class="sl"><span>qui reflète vraiment</span></span>
          <span class="sl"><span class="text-sauge">votre activité.</span></span>
        </h1>
        <p class="font-body text-lg text-brun-mid mt-8 max-w-xl leading-relaxed mx-auto" data-reveal data-delay="2">
          En 2 à 8 semaines, nous construisons ensemble un site sobre, authentique et durable. Un site qui raconte votre histoire, met en lumière votre travail et transforme les visiteurs en futurs clients.
        </p>

        <!-- CTA + ligne d'info discrète -->
        <div class="mt-10 flex flex-col sm:flex-row sm:items-center justify-center gap-5 sm:gap-7" data-reveal data-delay="3">
          <Button href="/contact#devis" variant="primary">Demander un devis</Button>
          <div class="flex items-center justify-center gap-3 flex-wrap">
            <span class="font-body text-xs tracking-[0.18em] uppercase text-brun-mid">Devis gratuit</span>
            <span class="font-body text-xs tracking-[0.18em] uppercase text-brun-mid">Réponse sous 48h</span>
          </div>
        </div>
      </div>


      <!-- Mockup laptop. L'écran ne dessine plus une maquette de site, il montre
           un site réellement livré : le salon Fée des Ongles, à Crest.
           Jusqu'au 07/08/2026 il affichait une miniature en HTML reprenant une
           ancienne version de caelestis.fr, slogan compris (« Votre site devrait
           vous ressembler », « Développeur web indépendant »), donc un discours
           que le site ne tient plus nulle part ailleurs, et l'adresse
           caelestis.fr sur une page qui parle du site du visiteur. Une preuve
           remplace une illustration : c'est le premier écran d'une page de vente.
           Réserve de pixels : source 1440 px pour 418 px d'affichage, soit 3,4,
           suffisant pour un écran à densité double (836 px demandés). -->
      <div class="hidden lg:flex items-end justify-center py-4">
        <figure class="mk-wrap m-0">

          <!-- Écran -->
          <div class="mk-lid">

            <!-- Chrome navigateur -->
            <div class="mk-chrome" aria-hidden="true">
              <div class="mk-dots">
                <span style="background:#ff5f57"></span>
                <span style="background:#febc2e"></span>
                <span style="background:#28c840"></span>
              </div>
              <div class="mk-url">
                <svg width="5" height="6" viewBox="0 0 5 6" fill="none" aria-hidden="true"><path d="M.8 3C.8 1.6 4.2 1.6 4.2 3v1.6C4.2 5 3.8 5.3 2.5 5.3 1.2 5.3.8 5 .8 4.6Z" stroke="rgba(184, 196, 187,.6)" stroke-width=".8"/><path d="M1.6 3V2.4C1.6 1.6 3.4 1.6 3.4 2.4V3" stroke="rgba(184, 196, 187,.6)" stroke-width=".8"/></svg>
                feedesongles.fr
              </div>
            </div>

            <!-- Le site livré, en clair -->
            <a href="/realisations/fee-des-ongles" class="mk-screen mk-screen-photo">
              <Image
                src={captureFeeDesOngles}
                alt="Page d'accueil du site de Fée des Ongles, salon de prothésie ongulaire à Crest, affichée sur un ordinateur portable."
                widths={[418, 836]}
                sizes="418px"
                quality={78}
                loading="eager"
              />
            </a>
          </div>

          <!-- Charnière -->
          <div class="mk-hinge" aria-hidden="true"></div>

          <!-- Base -->
          <div class="mk-base" aria-hidden="true">
            <div class="mk-trackpad"></div>
          </div>

          <!-- Ombre sol -->
          <div class="mk-shadow" aria-hidden="true"></div>

          <figcaption class="mk-legende font-body">
            Fée des Ongles, à Crest. <span>Voir l'étude de cas</span>
          </figcaption>
        </figure>
      </div>

    </div>
  </section>

  <style>
    /* ═══════════════════════════════════════
       Mockup laptop — style épuré / design
    ═══════════════════════════════════════ */

    /* Wrapper + perspective légère */
    .mk-wrap {
      position: relative;
      width: 420px;
      perspective: 1200px;
      perspective-origin: 50% 30%;
    }

    /* ════════════════════════════════════════
       Mockup device — style épuré Caelestis
    ════════════════════════════════════════ */

    /* Le laptop tourne légèrement, animation flottante */
    .mk-lid, .mk-base {
      transform: rotateX(2deg) rotateY(-12deg);
      animation: mk-float 7s ease-in-out infinite;
    }
    @keyframes mk-float {
      0%,100% { transform: rotateX(2deg) rotateY(-12deg) translateY(0); }
      50%      { transform: rotateX(3deg) rotateY(-11deg) translateY(-8px); }
    }

    /* ── ÉCRAN ── */
    .mk-lid {
      width: 420px;
      background: #f0f0ee;
      border-radius: 14px 14px 4px 4px;
      border: 1.5px solid #d8d8d4;
      box-shadow:
        0 2px 0 #c8c8c4,
        0 8px 32px rgba(27, 71, 51,0.14),
        0 2px 8px rgba(27, 71, 51,0.08);
      overflow: hidden;
    }

    /* Chrome navigateur */
    .mk-chrome {
      height: 26px;
      background: #e8e8e4;
      border-bottom: 1px solid #d0d0cc;
      display: flex;
      align-items: center;
      padding: 0 10px;
      gap: 8px;
      flex-shrink: 0;
    }
    .mk-dots {
      display: flex; gap: 4px; align-items: center;
      flex-shrink: 0;
    }
    .mk-dots span {
      display: block;
      width: 7px; height: 7px;
      border-radius: 50%;
      box-shadow: inset 0 0.5px 0 rgba(255,255,255,0.4);
    }
    .mk-url {
      flex: 1; max-width: 200px; margin: 0 auto;
      height: 15px;
      background: rgba(255,255,255,0.80);
      border: 1px solid #c8c8c4;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-family: var(--font-body);
      font-size: 6px;
      color: rgba(27, 71, 51,0.50);
      letter-spacing: 0.01em;
    }

    /* Contenu du site */
    .mk-screen {
      background: #FCFBF8;
      height: 252px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* L'écran porte une capture, plus une maquette dessinée. Le lien couvre
       toute la surface : la vignette mène à l'étude de cas. */
    .mk-screen-photo {
      display: block;
      position: relative;
      overflow: hidden;
      transition: filter 0.25s ease;
    }
    .mk-screen-photo img {
      display: block;
      width: 100%;
      height: 252px;
      object-fit: cover;
      object-position: top center;
    }
    .mk-wrap:hover .mk-screen-photo { filter: brightness(1.04); }

    /* Légende sous la machine : elle nomme le site montré, sans quoi la
       capture passerait pour une illustration de plus. */
    .mk-legende {
      margin-top: 18px;
      text-align: center;
      font-size: 0.78rem;
      color: var(--color-brun-mid);
    }
    .mk-legende span {
      color: #2E7452;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(46, 116, 82, 0.4);
    }
    .mk-wrap:hover .mk-legende span { text-decoration-color: #2E7452; }

    .mk-hinge {
      width: 100%;
      height: 3px;
      background: #d0d0cc;
      border-top: 1px solid #c0c0bc;
      border-bottom: 1px solid #e0e0dc;
    }

    /* ── BASE ── */
    .mk-base {
      width: 440px;
      height: 18px;
      background: linear-gradient(to bottom, #f0f0ee 0%, #e4e4e0 100%);
      border-radius: 0 0 10px 10px;
      border: 1.5px solid #d8d8d4;
      border-top: none;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow:
        0 4px 16px rgba(27, 71, 51,0.10),
        0 1px 3px rgba(27, 71, 51,0.06);
    }

    /* Trackpad */
    .mk-trackpad {
      width: 80px; height: 10px;
      background: #e0e0dc;
      border: 1px solid #c8c8c4;
      border-radius: 3px;
    }

    /* ── OMBRE SOL ── */
    .mk-shadow {
      position: absolute;
      bottom: -14px; left: 8%; right: 8%;
      height: 20px;
      background: radial-gradient(ellipse at center,
        rgba(27, 71, 51,0.20) 0%, rgba(27, 71, 51,0.06) 60%, transparent 80%);
      filter: blur(5px);
      pointer-events: none;
    }

    /* ════════════════════════════════════════════════════════════════
       Les quatre formules, en liste éditoriale.
       Une ligne cliquable par formule, séparées par un filet, menant à sa
       page de détail. Icône fine à gauche du titre. La vitrine porte
       l'accent : fond lin-mousse, puce, et pastille d'icône en vert forêt
       pour rester lisible sur le fond teinté. Couleurs de la charte.
    ════════════════════════════════════════════════════════════════ */
    .ff-liste { border-top: 1px solid #E6E4DC; }

    .ff-ligne {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 20px 16px;
      border-bottom: 1px solid #E6E4DC;
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      transition: background 0.25s ease, padding-left 0.25s ease;
    }
    .ff-ligne:hover { background: #F5F2EA; padding-left: 22px; }
    .ff-ligne:focus-visible { outline: 2px solid #255C41; outline-offset: -2px; }
    .ff-ligne-accent { background: #E3EFE8; }
    .ff-ligne-accent:hover { background: #DAEBE0; }

    .ff-icone {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: #FFFFFF;
      border: 1px solid #E6E4DC;
      color: #2E7452;
    }
    .ff-icone svg { width: 24px; height: 24px; }
    /* Sur la ligne accentuée, la pastille passe en vert forêt : sur le fond
       lin-mousse, une pastille blanche à peine contrastée s'effacerait. */
    .ff-ligne-accent .ff-icone { background: #255C41; border-color: #255C41; color: #FCFBF8; }

    /* min-width: 0 : sans lui, une baseline insécable empêcherait la colonne de
       rétrécir sur petit écran (piège min-width auto des flex). */
    .ff-corps { flex: 1; min-width: 0; }
    .ff-tete { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .ff-nom {
      font-family: var(--font-display, 'Satoshi', system-ui, sans-serif);
      font-weight: 300;
      font-size: 1.3rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: #255C41;
    }
    .ff-chip {
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 600;
      color: #FCFBF8;
      background: #255C41;
      padding: 3px 9px;
      border-radius: 999px;
    }
    .ff-base {
      font-size: 0.9rem;
      line-height: 1.5;
      color: #5C6259;
      margin-top: 5px;
    }
    .ff-prix {
      flex: none;
      font-family: var(--font-display, 'Satoshi', system-ui, sans-serif);
      font-size: 1.3rem;
      color: #255C41;
      text-align: right;
      font-variant-numeric: lining-nums tabular-nums;
    }
    .ff-prix span {
      display: block;
      font-size: 0.64rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #5C6259;
      margin-bottom: 2px;
    }
    /* 0,64rem tombe sous 11px : trop peu pour un écran tenu en main. */
    @media (max-width: 767px), (hover: none) and (pointer: coarse) {
      .ff-prix span { font-size: 0.72rem; }
    }
    .ff-fleche {
      flex: none;
      display: inline-flex;
      color: #2E7452;
      transition: transform 0.25s ease;
    }
    .ff-fleche svg { width: 20px; height: 20px; }
    .ff-ligne:hover .ff-fleche { transform: translateX(4px); }

    /* Écran étroit : icône et prix sur une première ligne, le corps (nom +
       baseline) en dessous sur toute la largeur. Le chevron disparaît. */
    @media (max-width: 560px) {
      .ff-ligne { flex-wrap: wrap; gap: 12px 16px; padding: 18px 14px; }
      .ff-ligne:hover { padding-left: 14px; }
      .ff-icone { order: 1; }
      .ff-prix { order: 1; margin-left: auto; text-align: right; }
      .ff-corps { order: 2; flex: 1 1 100%; }
      .ff-fleche { display: none; }
    }

    /* ── Les quatre gages, liste éditoriale (variante C) ──
       Chaque repère sur sa ligne, icône en pastille, libellé en gras et une
       phrase qui le justifie. Filet horizontal entre chaque, aucun fond de
       carte. Colonne de droite d'une grille à deux colonnes. */
    .reassur { list-style: none; padding: 0; margin: 0; }
    .reassur li {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 20px 0;
      border-bottom: 1px solid var(--color-cream-dark, #E6E4DC);
    }
    .reassur li:first-child { padding-top: 0; }
    .reassur li:last-child { border-bottom: 0; padding-bottom: 0; }
    .reassur-i {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-sauge-pale, #E3EFE8);
      color: var(--color-sauge-vif, #2E7452);
      flex: none;
      margin-top: 2px;
    }
    .reassur-i svg { width: 22px; height: 22px; }
    /* min-width: 0 sur le corps : sans lui, un libellé insécable empêcherait la
       colonne de rétrécir sur petit écran (piège min-width auto des flex). */
    .reassur-corps { min-width: 0; }
    .reassur-titre {
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-brun, #255C41);
      line-height: 1.3;
      margin: 0 0 4px;
    }
    /* Le seul repère cliquable : sans marque visible, « vérifiables » promettrait
       un clic inexistant. Soulignement discret, plus marqué au survol. */
    .reassur-preuve {
      text-decoration: underline;
      text-decoration-color: rgba(37, 92, 65, 0.3);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.25s ease;
    }
    .reassur-preuve:hover { text-decoration-color: var(--color-brun, #255C41); }
    .reassur-sous {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--color-brun-mid, #5C6259);
      margin: 0;
    }
  </style>

  <!-- ── Tarif — trois typologies ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 relative overflow-hidden">

    <!-- Blob sauge atmosphérique gauche -->
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute top-32 -left-24 w-80 h-80"></div>

    <div class="max-w-6xl mx-auto">

      <!-- Bloc tarif — trois typologies éditoriales -->
      <div data-reveal>

        <!-- Famille 1 : créer votre site -->
        <div class="text-center mb-12 lg:mb-14">
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Le site</p>
          <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
            Créer votre site.
          </h2>
          <p class="font-body text-base text-brun-mid mt-4 max-w-xl mx-auto leading-relaxed">
            Quatre formules, de la plus simple au sur mesure. Toutes livrées prêtes à l'emploi, avec les bases du référencement déjà en place.
          </p>
        </div>

        <!-- Quatre formules en liste éditoriale : une ligne cliquable chacune,
             menant à sa page de détail où le visiteur approfondit (et retrouve
             le site de démonstration). L'icône fine à gauche donne un repère par
             type. Le site vitrine porte l'accent (fond lin-mousse + puce), c'est
             la formule la plus demandée. Les id servent d'ancres depuis la
             planche des formules en page d'accueil. -->
        <div class="ff-liste max-w-3xl mx-auto" data-reveal data-delay="1">
          {FORMULES.map((f) => (
            <a
              id={f.id}
              href={f.href}
              class={'ff-ligne scroll-mt-28' + (f.accent ? ' ff-ligne-accent' : '')}
              aria-label={'Découvrir la formule ' + f.nom + ', à partir de ' + euros(f.prix) + ' euros'}
            >
              <span class="ff-icone" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[f.id]} />
              </span>
              <div class="ff-corps">
                <div class="ff-tete">
                  <h3 class="ff-nom">{f.nom}</h3>
                  {f.accent && <span class="ff-chip">Le plus demandé</span>}
                </div>
                <p class="ff-base">{f.baseline}</p>
              </div>
              <p class="ff-prix"><span>à partir de</span> {euros(f.prix)}&nbsp;€</p>
              <span class="ff-fleche" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>

        <!-- Note philosophie -->
        <div class="mt-10 pt-10 border-t border-cream-dark text-center max-w-2xl mx-auto" data-reveal data-delay="2">
          <p class="font-body text-sm text-brun-mid leading-relaxed">
            Après avoir échangé sur votre projet, nous vous transmettons un devis détaillé et personnalisé. Le tarif dépend de la structure du site, du nombre de pages, du contenu à mettre en valeur et des fonctionnalités envisagées.
          </p>
          <p class="font-body text-sm font-semibold text-sauge leading-relaxed mt-5">
            30&nbsp;% d'acompte à la signature, solde à la mise en ligne.
          </p>
          <!-- Franchise de TVA (article 293 B du CGI) : les montants annoncés sont
               ceux réellement facturés. Les agences affichent des prix hors taxes,
               auxquels s'ajoutent 20 %. La mention n'apparaît qu'ici et dans la FAQ,
               pour rester une information et non un argument martelé. -->
          <p class="font-body text-sm text-brun-mid leading-relaxed mt-4">
            Les prix indiqués sont <strong class="text-brun font-medium">nets, sans TVA à ajouter</strong>. C'est le montant que vous réglez.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ── Ce sur quoi vous pouvez compter : les quatre gages ──
       Déplacés du hero de l'accueil le 04/08/2026, où ils alourdissaient le
       premier écran. Posés ici, juste après les tarifs : c'est le moment où le
       visiteur a vu le prix et cherche de quoi se rassurer avant d'écrire.
       Format « liste éditoriale » (variante C validée par Célestin) : chaque
       repère est justifié par une phrase, ce qui transforme quatre étiquettes
       en quatre arguments. Deux colonnes pour remplir la largeur.
       « Réponse sous 48h » figure aussi en micro-label dans le hero de cette
       page ; ici il est développé, ce n'est pas un doublon d'affichage. -->
  <!-- Fond lin-mousse depuis le 07/08/2026. Le retrait de la frise de méthode,
       qui portait le seul fond sombre de la page, laissait six sections crème
       à la suite. Une section sur deux est désormais teintée, comme sur
       l'accueil : le rythme revient sans toucher aux couleurs de texte, toutes
       prévues pour ce fond clair. -->
  <section class="bg-sauge-pale py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="engagements-title">
    <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_1.25fr] gap-10 md:gap-16 items-center">

      <div data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-4">Nos engagements</p>
        <h2 id="engagements-title" class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Ce sur quoi vous pouvez compter.
        </h2>
        <p class="font-body text-base text-brun-mid leading-relaxed mt-5 max-w-sm">
          Quatre repères simples, tenus, qui valent avant même le premier échange.
        </p>
      </div>

      <ul class="reassur font-body" role="list" data-reveal data-delay="1">
        <li>
          <span class="reassur-i" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.2l2.4 2.4 4.6-4.9"/></svg></span>
          <div class="reassur-corps">
            <a href="/realisations" class="reassur-titre reassur-preuve">Des sites livrés, vérifiables</a>
            <p class="reassur-sous">Pas des maquettes : des sites en ligne que vous pouvez visiter.</p>
          </div>
        </li>
        <li>
          <span class="reassur-i" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13.3l-7.2 7.2a2 2 0 0 1-2.8 0l-7-7A2 2 0 0 1 3 12V4.5A1.5 1.5 0 0 1 4.5 3H12a2 2 0 0 1 1.4.6l7.1 7.1a1.8 1.8 0 0 1 0 2.6z"/><circle cx="7.6" cy="7.6" r="1.2"/></svg></span>
          <div class="reassur-corps">
            <p class="reassur-titre">Tarifs affichés, dès {euros(formule('page-unique').prix)}&nbsp;€</p>
            <p class="reassur-sous">Le prix est sur le site, pas au bout d'un rendez-vous.</p>
          </div>
        </li>
        <li>
          <span class="reassur-i" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H8l-4 3.5z"/></svg></span>
          <div class="reassur-corps">
            <p class="reassur-titre">Réponse sous 48h</p>
            <p class="reassur-sous">Un vrai délai de réponse, pas un formulaire sans retour.</p>
          </div>
        </li>
        <li>
          <span class="reassur-i" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="5" width="17.6" height="15.5" rx="2"/><path d="M3.2 9.8h17.6M8 3v4M16 3v4"/></svg></span>
          <div class="reassur-corps">
            <p class="reassur-titre">En ligne en 2 à 8 semaines</p>
            <p class="reassur-sous">Selon la formule, le délai est annoncé dès le devis.</p>
          </div>
        </li>
      </ul>

    </div>

    <!-- CTA intermédiaire. La page comptait ~780 lignes entre le devis du hero
         et l'appel final, sans une seule occasion de convertir au milieu. Posé
         ici, après les tarifs ET les gages : c'est le pic de décision, un
         visiteur convaincu ne doit pas remonter la page pour agir. Enfant direct
         de la section, hors de la grille des gages, et sur le même fond
         sauge-pale pour ne pas rompre l'alternance. Ajouté le 07/08/2026. -->
    <div class="max-w-5xl mx-auto mt-14 md:mt-16 pt-10 border-t border-cream-dark/70 text-center" data-reveal>
      <p class="font-body text-lg text-brun leading-relaxed mb-6">Une formule correspond à votre projet&nbsp;?</p>
      <Button href="/contact#devis" variant="primary">Demander un devis</Button>
      <p class="font-body text-xs text-brun-mid mt-5">Gratuit, réponse sous 48h, sans engagement.</p>
    </div>

  </section>

