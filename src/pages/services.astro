  <style>
    /* ═══════════════════════════════════════════
       Section méthode : cartes en frise sur fond forêt.
       Au défilement, une vague horizontale parcourt les étapes (voir le
       script plus bas). Le fond sombre est la seule rupture franche de la
       page Services, ce qui casse l'enchaînement de sections crème.
    ═══════════════════════════════════════════ */
    .mth-bloc {
      background: #255C41;
      border-radius: 24px;
      padding: 52px 46px;
      color: #FCFBF8;
      /* Contient le décalage horizontal de la vague : aucune barre de scroll. */
      overflow: hidden;
    }
    .mth-eyebrow {
      font-family: var(--font-body);
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-indent: 0.11em;
      text-transform: uppercase;
      color: rgba(252, 251, 248, 0.72);
    }
    .mth-titre {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: clamp(1.7rem, 2.8vw, 2.3rem);
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: #FCFBF8;
      margin-top: 10px;
    }
    .mth-intro {
      font-family: var(--font-body);
      font-size: 0.95rem;
      color: rgba(252, 251, 248, 0.8);
      margin-top: 12px;
      max-width: 56ch;
    }
    .mth-fil {
      list-style: none;
      margin: 34px 0 0;
      padding: 0 0 0 40px;
      position: relative;
    }
    .mth-fil::before {
      content: '';
      position: absolute;
      left: 11px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: linear-gradient(rgba(184, 196, 187, 0.6), rgba(184, 196, 187, 0.16));
    }
    .mth-etape {
      position: relative;
      margin-bottom: 14px;
      padding: 22px 26px;
      border-radius: 16px;
      background: rgba(252, 251, 248, 0.06);
      border: 1px solid rgba(252, 251, 248, 0.12);
      will-change: transform;
    }
    .mth-etape:last-child { margin-bottom: 0; }
    .mth-point {
      position: absolute;
      left: -33px;
      top: 26px;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: #B8C4BB;
      border: 3px solid #255C41;
    }
    .mth-row {
      display: flex;
      align-items: baseline;
      gap: 12px;
      flex-wrap: wrap;
    }
    .mth-num {
      font-family: var(--font-body);
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      /* Lin-mousse et non sauge : sur le vert forêt, #B8C4BB plafonne à 4,34:1,
         sous le seuil AA de 4,5 même à pleine opacité. C'est la règle déjà posée
         dans global.css (`.bg-brun .text-sauge`), que cette section contournait
         en codant sa couleur en dur. #E3EFE8 monte à 6,6:1. */
      color: var(--color-sauge-pale);
      font-variant-numeric: lining-nums tabular-nums;
    }
    .mth-t {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 1.08rem;
      color: #FCFBF8;
    }
    .mth-d {
      font-family: var(--font-body);
      font-size: 0.88rem;
      line-height: 1.65;
      color: rgba(252, 251, 248, 0.78);
      margin-top: 6px;
      max-width: 60ch;
    }
    @media (max-width: 720px) {
      .mth-bloc { padding: 38px 24px; }
    }
  </style>

  <script>
    /* Vague de la section méthode, en autonomie totale.

       Chaque carte suit un aller-retour horizontal doux (une demi-sinusoïde :
       0 → droite → 0, vitesse nulle aux extrémités, donc aucun à-coup). Le
       départ de chaque carte est décalé, si bien qu'à tout instant plusieurs
       cartes ondulent à des phases différentes : une vague qui descend la liste
       au fil du défilement.

       On ne dépend ni de GSAP ni de ScrollTrigger ni du smooth scroll du site :
       à chaque frame on lit la position réelle du bloc (getBoundingClientRect),
       qui reflète déjà le défilement lissé. Une inertie (lerp) ajoute la
       douceur. Actif seulement sur desktop à pointeur fin et hors « animations
       réduites » ; sinon la frise reste simplement immobile. */
    const AMPLITUDE = 80;   // écart maximal de chaque carte, en pixels
    const PAS = 0.8;        // décalage de phase entre deux cartes voisines
    const INERTIE = 0.10;   // douceur du suivi (petit = plus traînant)

    function initMethodeVague() {
      const finPointeur = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!finPointeur || reduit) return;

      const bloc = document.querySelector<HTMLElement>('.mth-bloc');
      if (!bloc) return;
      const cartes = Array.from(bloc.querySelectorAll<HTMLElement>('.mth-etape'));
      if (!cartes.length) return;

      const TOTAL = (cartes.length - 1) * PAS + 2; // longueur de la vague, en unités
      let lisse = 0;
      let rafId: number | null = null;

      /* Progression du bloc dans l'écran : 0 quand son haut arrive vers le bas
         du viewport, 1 quand son bas s'apprête à sortir par le haut. */
      function cible() {
        const r = bloc!.getBoundingClientRect();
        const vh = window.innerHeight || 1;
        const p = (0.80 * vh - r.top) / (0.65 * vh + r.height);
        return Math.min(1, Math.max(0, p));
      }

      function applique(p: number) {
        const t = p * TOTAL;
        for (let i = 0; i < cartes.length; i++) {
          let local = (t - i * PAS) / 2;          // position sur l'aller-retour de la carte i
          local = Math.min(1, Math.max(0, local));
          const x = Math.sin(local * Math.PI) * AMPLITUDE; // 0 → AMPLITUDE → 0
          cartes[i].style.transform = 'translateX(' + x.toFixed(2) + 'px)';
        }
      }

      function boucle() {
        lisse += (cible() - lisse) * INERTIE;
        applique(lisse);
        rafId = requestAnimationFrame(boucle);
      }

      /* La boucle ne tourne que lorsque la section est proche de l'écran. */
      const io = new IntersectionObserver((entrees) => {
        entrees.forEach((e) => {
          if (e.isIntersecting && rafId === null) {
            boucle();
          } else if (!e.isIntersecting && rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
            applique(cible());
          }
        });
      }, { rootMargin: '35% 0px 35% 0px' });
      io.observe(bloc);
    }

    document.addEventListener('astro:page-load', initMethodeVague);
  </script>

