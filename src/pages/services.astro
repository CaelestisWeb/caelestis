---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { Image } from 'astro:assets';
import { euros, formule, FORMULES } from '../utils/tarifs';

/* Aperçus des quatre formules. Sites de démonstration créés pour illustrer
   la différence entre les offres : aucune de ces entreprises n'existe. */
import apercuPageUnique from '../assets/images/apercus/page-unique-ferme.jpg';
import apercuVitrine from '../assets/images/apercus/vitrine-ecurie.jpg';
import apercuBoutique from '../assets/images/apercus/boutique-miellerie.jpg';
import apercuSurMesure from '../assets/images/apercus/sur-mesure-ebeniste.jpg';

/* Les quatre sites de démonstration, un par formule. `url` s'affiche dans la
   barre de la fenêtre dessinée, `alt` décrit l'image aux lecteurs d'écran. */
const apercus = {
  'page-unique': {
    img: apercuPageUnique,
    titre: 'Une micro-ferme maraîchère',
    url: 'exemple, une micro-ferme maraîchère',
    alt: "Aperçu du site d'une micro-ferme maraîchère, réalisé en page unique",
    detail: 'Tout sur une page : les légumes de saison, les horaires de vente, le contact.',
  },
  'vitrine': {
    img: apercuVitrine,
    titre: 'Un centre équestre',
    url: 'exemple, un centre équestre',
    alt: "Aperçu du site d'un centre équestre, réalisé en site vitrine",
    detail: 'Sept pages : pension, cours, installations, équipe, tarifs, contact.',
  },
  'boutique': {
    img: apercuBoutique,
    titre: 'Une miellerie',
    url: 'exemple, une miellerie',
    alt: "Aperçu du site d'une miellerie, réalisé en boutique en ligne",
    detail: 'Catalogue, filtres, panier et calcul des frais de livraison.',
  },
  'sur-mesure': {
    img: apercuSurMesure,
    titre: 'Un atelier d’ébénisterie',
    url: "exemple, un atelier d'ébénisterie",
    alt: "Aperçu du site d'un atelier d'ébénisterie, réalisé sur mesure",
    detail: 'Configurateur de mobilier avec estimation du prix et du délai en direct.',
  },
};

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Services Caelestis',
  description: 'Sites web sur mesure et référencement naturel pour artisans, indépendants et petites entreprises en Auvergne-Rhône-Alpes. Agence basée à Crest, dans la Drôme.',
  url: 'https://caelestis.fr/services',
  numberOfItems: 6,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        name: 'Site vitrine',
        description: "Votre activité présentée clairement, visible sur Google, lisible sur tout type d'écran.",
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '1499.99',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        name: 'Boutique en ligne',
        description: 'Catalogue en ligne, paiement sécurisé, connecté à votre logiciel de gestion.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '2499.99',
            priceCurrency: 'EUR',
          },
        },
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        name: 'Référencement naturel (SEO)',
        description: "Apparaître en tête des résultats quand vos clients vous cherchent. Référencement local et national.",
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 4,
      item: {
        '@type': 'Service',
        name: 'Refonte de site existant',
        description: 'Votre site date ou ne vous ressemble plus ? On repart proprement sur de bonnes bases.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 5,
      item: {
        '@type': 'Service',
        name: 'Maintenance & accompagnement',
        description: 'Évolutions, mises à jour, nouvelles pages, forfait mensuel ou à la tâche.',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
      },
    },
    {
      '@type': 'ListItem',
      position: 6,
      item: {
        '@type': 'Service',
        name: 'Page unique',
        description: "L'essentiel de votre activité sur une seule page. La solution accessible pour démarrer simplement et être visible sur Google.",
        url: 'https://caelestis.fr/services/site-une-page',
        provider: { '@type': 'LocalBusiness', '@id': 'https://caelestis.fr/#business', name: 'Caelestis', url: 'https://caelestis.fr' },
        areaServed: [{ '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' }, { '@type': 'Country', name: 'France' }],
        offers: {
          '@type': 'Offer',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '999.99',
            priceCurrency: 'EUR',
          },
        },
      },
    },
  ],
};

const breadcrumbServices = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://caelestis.fr/services' },
  ],
};

const etapes = [
  {
    num: '01',
    title: 'Faire connaissance',
    desc: "Tout commence par un échange. Nous prenons le temps de découvrir votre activité, votre parcours et vos objectifs afin de bien comprendre votre projet et ce qui le rend unique."
  },
  {
    num: '02',
    title: 'Définir vos besoins',
    desc: "À partir de nos échanges, nous vous proposons une solution adaptée à votre activité. Le devis détaille simplement ce qui sera réalisé et vous permet d'avancer en toute sérénité. Après signature du devis, un acompte de 30 % permet de lancer la création de votre site. Le reste est réglé une fois le site terminé et validé ensemble."
  },
  {
    num: '03',
    title: 'Concevoir votre site',
    desc: "Nous réalisons une première version du site que nous faisons évoluer ensemble. Chaque détail est ajusté jusqu'à obtenir un résultat fidèle à votre image et à vos attentes."
  },
  {
    num: '04',
    title: 'Mettre en ligne et valider',
    desc: "Une fois le site finalisé, il est mis en ligne. Nous effectuons ensemble les derniers contrôles, testons et validons le résultat. Quand tout est en place et que vous êtes satisfait, le projet est clôturé et la facturation intervient."
  },
  {
    num: '05',
    title: 'Rester à vos côtés',
    desc: "La mise en ligne ne marque pas la fin du projet. Nous restons disponibles pour répondre à vos questions, effectuer les modifications nécessaires et accompagner l'évolution de votre site au fil du temps."
  },
];
---
<BaseLayout
  title="Création de site internet, Tarifs & Services, Caelestis"
  description="Site une page dès 999,99 €, vitrine dès 1 499,99 €, boutique dès 2 499,99 €, sur mesure dès 3 499,99 €. Devis gratuit sous 48h."
  schema={[servicesSchema, breadcrumbServices]}
>

  <!-- En-tête de page -->
  <section class="pt-20 pb-10 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">

    <!-- Blob sauge atmosphérique -->
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-20 w-[420px] h-[420px]"></div>
    <!-- Blob doré secondaire -->
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/3 w-64 h-64"></div>

    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_480px] gap-12 lg:gap-16 items-center relative">

      <!-- Texte -->
      <div class="text-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 mb-6" data-reveal>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Création de site internet</p>
        </div>
        <h1
          class="font-display font-light text-brun leading-[1.05] tracking-tight max-w-3xl mx-auto"
          style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
          data-reveal data-delay="1"
        >
          Un site internet qui reflète vraiment<br class="hidden sm:block"> <span class="text-sauge">votre activité.</span>
        </h1>
        <p class="font-body text-lg text-brun-mid mt-8 max-w-xl leading-relaxed mx-auto" data-reveal data-delay="2">
          En 2 à 8 semaines, nous construisons ensemble un site sobre, authentique et durable. Un site qui raconte votre histoire, met en lumière votre travail et transforme les visiteurs en futurs clients.
        </p>

        <!-- CTA + ligne d'info discrète -->
        <div class="mt-10 flex flex-col sm:flex-row sm:items-center justify-center gap-5 sm:gap-7" data-reveal data-delay="3">
          <Button href="/contact" variant="primary">Parler de mon projet</Button>
          <div class="flex items-center justify-center gap-3 flex-wrap">
            <span class="font-body text-xs tracking-[0.18em] uppercase text-brun-mid">Devis gratuit</span>
            <span class="font-body text-xs tracking-[0.18em] uppercase text-brun-mid">Réponse sous 48h</span>
          </div>
        </div>
      </div>


      <!-- Mockup laptop épuré : illustration, son texte miniature n'est pas du contenu -->
      <div class="hidden lg:flex items-end justify-center py-4" aria-hidden="true">
        <div class="mk-wrap">

          <!-- Écran -->
          <div class="mk-lid">

            <!-- Chrome navigateur -->
            <div class="mk-chrome">
              <div class="mk-dots">
                <span style="background:#ff5f57"></span>
                <span style="background:#febc2e"></span>
                <span style="background:#28c840"></span>
              </div>
              <div class="mk-url">
                <svg width="5" height="6" viewBox="0 0 5 6" fill="none" aria-hidden="true"><path d="M.8 3C.8 1.6 4.2 1.6 4.2 3v1.6C4.2 5 3.8 5.3 2.5 5.3 1.2 5.3.8 5 .8 4.6Z" stroke="rgba(184, 196, 187,.6)" stroke-width=".8"/><path d="M1.6 3V2.4C1.6 1.6 3.4 1.6 3.4 2.4V3" stroke="rgba(184, 196, 187,.6)" stroke-width=".8"/></svg>
                caelestis.fr
              </div>
            </div>

            <!-- Contenu du site -->
            <div class="mk-screen">

              <!-- Nav -->
              <div class="mk-nav">
                <span class="mk-brand">Caelestis<em style="color:#B8C4BB;font-style:normal">.</em></span>
                <div class="mk-links">
                  <span>Accueil</span><span>Services</span><span>À propos</span><span>Contact</span>
                </div>
                <div class="mk-cta-nav">Lancer mon projet</div>
              </div>

              <!-- Hero -->
              <div class="mk-hero">
                <div class="mk-hero-text">
                  <div class="mk-eyebrow">Développeur web indépendant, Drôme</div>
                  <div class="mk-h1">Votre site devrait</div>
                  <div class="mk-h1 mk-h1i">vous ressembler.</div>
                  <div class="mk-body">Un bon site internet devient un outil de croissance.</div>
                  <div class="mk-body mk-body-s">Il renforce votre image et contribue au développement de votre entreprise.</div>
                  <div class="mk-btns">
                    <div class="mk-btn-p">Lancer mon projet</div>
                    <div class="mk-btn-g">Nos services</div>
                  </div>
                  <div class="mk-meta">
                    <span>Réponse sous 48h</span>
                    <span>Devis gratuit</span>
                    <span>À partir de 999,99 €</span>
                  </div>
                </div>
                <div class="mk-hero-img">
                  <div class="mk-img-inner"></div>
                  <div class="mk-img-over"></div>
                </div>
              </div>

              <!-- Cartes -->
              <div class="mk-cards">
                {[{n:'01',t:'Votre projet au centre'},{n:'02',t:'Clair dès la première seconde'},{n:'03',t:'Construit pour durer'}].map(({n,t})=>(
                  <div class="mk-card">
                    <span class="mk-card-n">{n}</span>
                    <span class="mk-card-t">{t}</span>
                    <div class="mk-card-bar"></div>
                    <div class="mk-card-bar mk-card-bar-s"></div>
                  </div>
                ))}
              </div>

            </div>
          </div>

          <!-- Charnière -->
          <div class="mk-hinge"></div>

          <!-- Base -->
          <div class="mk-base">
            <div class="mk-trackpad"></div>
          </div>

          <!-- Ombre sol -->
          <div class="mk-shadow"></div>

        </div>
      </div>

    </div>
  </section>

  <style>
    /* ═══════════════════════════════════════
       Mockup laptop — style épuré / design
    ═══════════════════════════════════════ */

    /* Wrapper + perspective légère */
    .mk-wrap {
      position: relative;
      width: 420px;
      perspective: 1200px;
      perspective-origin: 50% 30%;
    }

    /* ════════════════════════════════════════
       Mockup device — style épuré Caelestis
    ════════════════════════════════════════ */

    /* Le laptop tourne légèrement, animation flottante */
    .mk-lid, .mk-base {
      transform: rotateX(2deg) rotateY(-12deg);
      animation: mk-float 7s ease-in-out infinite;
    }
    @keyframes mk-float {
      0%,100% { transform: rotateX(2deg) rotateY(-12deg) translateY(0); }
      50%      { transform: rotateX(3deg) rotateY(-11deg) translateY(-8px); }
    }

    /* ── ÉCRAN ── */
    .mk-lid {
      width: 420px;
      background: #f0f0ee;
      border-radius: 14px 14px 4px 4px;
      border: 1.5px solid #d8d8d4;
      box-shadow:
        0 2px 0 #c8c8c4,
        0 8px 32px rgba(27, 71, 51,0.14),
        0 2px 8px rgba(27, 71, 51,0.08);
      overflow: hidden;
    }

    /* Chrome navigateur */
    .mk-chrome {
      height: 26px;
      background: #e8e8e4;
      border-bottom: 1px solid #d0d0cc;
      display: flex;
      align-items: center;
      padding: 0 10px;
      gap: 8px;
      flex-shrink: 0;
    }
    .mk-dots {
      display: flex; gap: 4px; align-items: center;
      flex-shrink: 0;
    }
    .mk-dots span {
      display: block;
      width: 7px; height: 7px;
      border-radius: 50%;
      box-shadow: inset 0 0.5px 0 rgba(255,255,255,0.4);
    }
    .mk-url {
      flex: 1; max-width: 200px; margin: 0 auto;
      height: 15px;
      background: rgba(255,255,255,0.80);
      border: 1px solid #c8c8c4;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-family: var(--font-body);
      font-size: 6px;
      color: rgba(27, 71, 51,0.50);
      letter-spacing: 0.01em;
    }

    /* Contenu du site */
    .mk-screen {
      background: #FCFBF8;
      height: 252px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Nav site */
    .mk-nav {
      height: 24px;
      background: rgba(252, 251, 248,0.98);
      border-bottom: 1px solid rgba(37, 92, 65,0.08);
      display: flex; align-items: center;
      padding: 0 12px;
      flex-shrink: 0;
    }
    .mk-brand {
      font-family: var(--font-display);
      font-size: 8px; font-weight: 500;
      color: #1B4733; letter-spacing: -0.02em;
      margin-right: auto;
    }
    .mk-links {
      display: flex; gap: 10px;
      font-family: var(--font-body);
      font-size: 5.5px; color: rgba(27, 71, 51,0.55);
    }
    .mk-cta-nav {
      font-family: var(--font-body);
      font-size: 5px; font-weight: 600;
      background: #1B4733; color: #FCFBF8;
      padding: 3px 7px; border-radius: 10px;
      margin-left: 10px;
    }

    /* Hero */
    .mk-hero {
      display: grid;
      grid-template-columns: 1fr 100px;
      gap: 8px;
      padding: 14px 12px 10px;
      flex: 1;
    }
    .mk-hero-text { display: flex; flex-direction: column; gap: 3px; }
    .mk-eyebrow {
      font-family: var(--font-body);
      font-size: 4.5px; letter-spacing: 0.18em; text-transform: uppercase;
      color: #B8C4BB; margin-bottom: 3px;
    }
    .mk-h1 {
      font-family: var(--font-display);
      font-size: 12px; font-weight: 700;
      color: #1B4733; line-height: 1.15; letter-spacing: -0.02em;
    }
    .mk-h1i { color: #4a5630; }
    .mk-body {
      font-family: var(--font-body);
      font-size: 5px; color: rgba(37, 92, 65,0.55); line-height: 1.5;
    }
    .mk-body-s { width: 75%; }
    .mk-btns { display: flex; gap: 5px; margin-top: 7px; }
    .mk-btn-p {
      font-family: var(--font-body);
      font-size: 5px; font-weight: 600;
      background: #1B4733; color: #FCFBF8;
      padding: 4px 9px; border-radius: 10px;
    }
    .mk-btn-g {
      font-family: var(--font-body);
      font-size: 5px; color: #1B4733;
      padding: 4px 9px; border-radius: 10px;
      border: 1px solid rgba(27, 71, 51,0.20);
    }
    .mk-meta {
      display: flex; gap: 4px; margin-top: 5px;
      font-family: var(--font-body);
      font-size: 4.5px; color: rgba(37, 92, 65,0.30);
    }
    .mk-sep { opacity: 0.4; }

    /* Image hero */
    .mk-hero-img { border-radius: 12px; overflow: hidden; position: relative; }
    .mk-img-inner {
      width: 100%; height: 100%;
      background: linear-gradient(145deg, #c5cc9f 0%, #a4b07e 45%, #788a55 100%);
    }
    .mk-img-over {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, transparent 55%, rgba(27, 71, 51,0.22) 100%);
    }

    /* Cartes */
    .mk-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 5px;
      padding: 7px 12px 9px;
      border-top: 1px solid rgba(37, 92, 65,0.07);
      flex-shrink: 0;
    }
    .mk-card {
      background: rgba(255,255,255,0.52);
      border: 1px solid rgba(37, 92, 65,0.08);
      border-radius: 5px;
      padding: 6px 7px;
      display: flex; flex-direction: column; gap: 3px;
    }
    .mk-card-n {
      font-family: var(--font-display);
      font-size: 9px; color: rgba(184, 196, 187,0.35); line-height: 1;
    }
    .mk-card-t {
      font-family: var(--font-display);
      font-size: 5.5px; color: #1B4733; line-height: 1.3;
    }
    .mk-card-bar {
      height: 2.5px;
      background: rgba(37, 92, 65,0.10);
      border-radius: 1.5px;
    }
    .mk-card-bar-s { width: 62%; }

    /* ── CHARNIÈRE ── */
    .mk-hinge {
      width: 100%;
      height: 3px;
      background: #d0d0cc;
      border-top: 1px solid #c0c0bc;
      border-bottom: 1px solid #e0e0dc;
    }

    /* ── BASE ── */
    .mk-base {
      width: 440px;
      height: 18px;
      background: linear-gradient(to bottom, #f0f0ee 0%, #e4e4e0 100%);
      border-radius: 0 0 10px 10px;
      border: 1.5px solid #d8d8d4;
      border-top: none;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow:
        0 4px 16px rgba(27, 71, 51,0.10),
        0 1px 3px rgba(27, 71, 51,0.06);
    }

    /* Trackpad */
    .mk-trackpad {
      width: 80px; height: 10px;
      background: #e0e0dc;
      border: 1px solid #c8c8c4;
      border-radius: 3px;
    }

    /* ── OMBRE SOL ── */
    .mk-shadow {
      position: absolute;
      bottom: -14px; left: 8%; right: 8%;
      height: 20px;
      background: radial-gradient(ellipse at center,
        rgba(27, 71, 51,0.20) 0%, rgba(27, 71, 51,0.06) 60%, transparent 80%);
      filter: blur(5px);
      pointer-events: none;
    }

    /* ── Aperçus des formules, présentés dans un cadre de navigateur ── */
    .apercu-ouvrir { cursor: zoom-in; background: none; border: 0; padding: 0; }
    .fenetre {
      border: 1px solid var(--cream-dark, #E4DED2);
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      transition: box-shadow 0.3s ease, transform 0.3s ease;
    }
    .apercu-ouvrir:hover .fenetre {
      box-shadow: 0 10px 28px rgba(37, 92, 65, 0.14);
      transform: translateY(-2px);
    }
    .apercu-ouvrir:focus-visible .fenetre {
      outline: 2px solid #255C41;
      outline-offset: 2px;
    }
    .fenetre-barre {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 8px 11px;
      background: #F2EFE8;
      border-bottom: 1px solid var(--cream-dark, #E4DED2);
    }
    .fenetre-barre > span {
      width: 7px; height: 7px; border-radius: 50%;
      background: #CFC8B8; flex: none;
    }
    .fenetre-url {
      flex: 1;
      margin-left: 6px;
      font-size: 9px;
      letter-spacing: 0.08em;
      color: #8A8375;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: left;
    }
    /* La capture est haute : on n'en montre que le haut, sans la déformer. */
    .fenetre-ecran { height: 186px; overflow: hidden; }
    .fenetre-ecran :global(img) { width: 100%; height: auto; display: block; }
    /* Carte large : on borne la largeur pour garder la même échelle que les colonnes. */
    .apercu-large .fenetre { max-width: 460px; margin: 0 auto; }

    /* Visionneuse */
    .visionneuse {
      position: fixed; inset: 0; z-index: 9999;
      background: rgba(28, 26, 21, 0.94);
      display: none; flex-direction: column;
    }
    .visionneuse[open] { display: flex; }
    .visionneuse-tete {
      display: flex; align-items: center; justify-content: space-between;
      gap: 20px; padding: 16px 22px; flex: none;
      background: #1C1A15;
      border-bottom: 1px solid rgba(246, 242, 231, 0.14);
    }
    .visionneuse-titre { color: #F6F2E7; font-size: 14px; letter-spacing: 0.04em; }
    .visionneuse-titre b { display: block; font-size: 12px; opacity: 0.62; font-weight: 400; margin-top: 3px; }
    .visionneuse-fermer {
      background: none; border: 1px solid rgba(246, 242, 231, 0.4); color: #F6F2E7;
      padding: 9px 17px; cursor: pointer; font-size: 12px; letter-spacing: 0.14em;
      text-transform: uppercase; flex: none;
    }
    .visionneuse-fermer:hover { background: #F6F2E7; color: #1C1A15; }
    .visionneuse-corps { flex: 1; overflow-y: auto; padding: 0 22px 30px; }
    .visionneuse-corps img {
      display: block; width: 100%; max-width: 980px; margin: 0 auto;
      border-radius: 6px;
    }
    @media (max-width: 640px) {
      .fenetre-ecran { height: 150px; }
    }

