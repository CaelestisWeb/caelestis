  <style>
    /* ═══════════════════════════════════════════
       Timeline « Comment se déroule un projet »
       Mobile : fil botanique vertical + nœuds.
       Desktop : grille 2 colonnes en relief.
    ═══════════════════════════════════════════ */
    .proc-list {
      position: relative;
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 600px;
      margin-inline: auto;
    }

    /* Étape — serpentin : impaires à gauche, paires à droite */
    .proc-step {
      position: relative;
      display: flex;
      margin-bottom: 16px;
    }
    .proc-step:last-child { margin-bottom: 0; }
    .proc-step:nth-of-type(odd)  { justify-content: flex-start; }
    .proc-step:nth-of-type(even) { justify-content: flex-end; }

    /* Nœud numéroté — ancré au coin extérieur, alterne de côté */
    .proc-num {
      position: absolute;
      top: -14px;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--color-cream);
      border: 1.5px solid rgba(184, 196, 187, 0.75);
      font-family: var(--font-display);
      font-size: 1rem;
      letter-spacing: 0.04em;
      color: #2E7452;
      box-shadow: 0 6px 16px rgba(37, 92, 65, 0.16);
      z-index: 2;
    }
    .proc-step:nth-of-type(odd)  .proc-num { left: -8px; }
    .proc-step:nth-of-type(even) .proc-num { right: -8px; }

    /* Carte large, relief par l'ombre, accent du côté extérieur */
    .proc-card {
      position: relative;
      width: 87%;
      background: #F4F2EC;
      border-radius: 14px;
      padding: 36px 22px 20px;
      text-align: left;
      box-shadow:
        0 12px 30px rgba(37, 92, 65, 0.11),
        0 3px 8px rgba(37, 92, 65, 0.06),
        inset 0 1px 0 rgba(255, 255, 255, 0.45);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.35s ease;
    }
    .proc-step:nth-of-type(odd)  .proc-card { border-left: 3px solid rgba(184, 196, 187, 0.6); }
    .proc-step:nth-of-type(even) .proc-card { border-right: 3px solid rgba(184, 196, 187, 0.6); }
    .proc-card:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(37, 92, 65, 0.15),
        0 4px 10px rgba(37, 92, 65, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }

    .proc-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.18rem;
      color: var(--color-sauge-text);
      margin-bottom: 8px;
      line-height: 1.3;
    }
    .proc-desc {
      font-family: var(--font-body);
      font-size: 0.9rem;
      color: #255C41;
      line-height: 1.65;
    }

    /* Dernière étape — touche de clôture plus chaleureuse */
    .proc-step--last .proc-num {
      background: linear-gradient(140deg, #2E7452, #255C41);
      border-color: transparent;
      color: #F4F2EC;
    }
    .proc-step--last .proc-card {
      border-left-color: rgba(184, 196, 187, 0.85);
    }

    /* ── Desktop ≥ 640px : grille 2 colonnes en relief, fil masqué ── */
    @media (min-width: 640px) {
      .proc-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px 18px;
        max-width: none;
        align-items: stretch;
      }
      .proc-step {
        margin-bottom: 0;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
      }
      .proc-num,
      .proc-step:nth-of-type(odd) .proc-num,
      .proc-step:nth-of-type(even) .proc-num {
        position: static;
        margin: 0 0 16px;
        left: auto;
        right: auto;
        top: 0;
        width: 56px;
        height: 56px;
        font-size: 1.05rem;
        flex-shrink: 0;
      }
      .proc-card,
      .proc-step:nth-of-type(odd) .proc-card,
      .proc-step:nth-of-type(even) .proc-card {
        text-align: center;
        width: 100%;
        flex: 1;
        border-left: none;
        border-right: none;
        border-top: 3px solid rgba(184, 196, 187, 0.5);
        padding: 30px 28px 26px;
      }
      .proc-title { font-size: 1.25rem; }
      .proc-desc { font-size: 0.92rem; }
      .proc-step--last {
        grid-column: 1 / -1;
      }
      .proc-step--last .proc-card {
        border-top-color: rgba(184, 196, 187, 0.85);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .proc-card { transition: none; }
    }
  </style>

  <!-- ── CTA ── -->
  <AppelFinal
    titre="Vous avez un projet ?"
    titreAccent="Parlons-en."
    texte="Décrivez votre activité en quelques lignes. Nous revenons vers vous sous 48h."
    href="/contact"
    libelle="Nous contacter"
  />

  <!-- ── Visionneuse des aperçus ── -->
  <div class="visionneuse" id="visionneuse" role="dialog" aria-modal="true" aria-labelledby="visionneuseTitre">
    <div class="visionneuse-tete">
      <p class="visionneuse-titre" id="visionneuseTitre">
        <span id="visionneuseNom">Aperçu</span>
        <b id="visionneuseDetail">Site de démonstration</b>
      </p>
      <button type="button" class="visionneuse-fermer" id="visionneuseFermer">Fermer</button>
    </div>
    <div class="visionneuse-corps">
      <img id="visionneuseImage" src="" alt="">
    </div>
  </div>

  <script is:inline define:vars={{ apercusData: {
    'page-unique': { src: apercuPageUnique.src, titre: apercus['page-unique'].titre, detail: apercus['page-unique'].detail, formule: 'Page unique' },
    'vitrine': { src: apercuVitrine.src, titre: apercus['vitrine'].titre, detail: apercus['vitrine'].detail, formule: 'Site vitrine' },
    'boutique': { src: apercuBoutique.src, titre: apercus['boutique'].titre, detail: apercus['boutique'].detail, formule: 'Boutique en ligne' },
    'sur-mesure': { src: apercuSurMesure.src, titre: apercus['sur-mesure'].titre, detail: apercus['sur-mesure'].detail, formule: 'Site sur mesure' },
  } }}>
    (function () {
      var vue = document.getElementById('visionneuse');
      if (!vue) return;
      var img = document.getElementById('visionneuseImage');
      var nom = document.getElementById('visionneuseNom');
      var det = document.getElementById('visionneuseDetail');
      var corps = vue.querySelector('.visionneuse-corps');
      var declencheur = null;

      function ouvrir(cle, bouton) {
        var d = apercusData[cle];
        if (!d) return;
        declencheur = bouton;
        img.src = d.src;
        img.alt = "Aperçu complet du site de démonstration : " + d.titre;
        nom.textContent = d.formule + ", " + d.titre;
        det.textContent = d.detail;
        corps.scrollTop = 0;
        vue.setAttribute('open', '');
        document.body.style.overflow = 'hidden';
        document.getElementById('visionneuseFermer').focus();
      }
      function fermer() {
        vue.removeAttribute('open');
        document.body.style.overflow = '';
        if (declencheur) declencheur.focus();
      }

      document.querySelectorAll('.apercu-ouvrir').forEach(function (b) {
        b.addEventListener('click', function () { ouvrir(b.dataset.apercu, b); });
      });
      document.getElementById('visionneuseFermer').addEventListener('click', fermer);
      vue.addEventListener('click', function (e) { if (e.target === vue || e.target === corps) fermer(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && vue.hasAttribute('open')) fermer();
      });
    })();
  </script>

</BaseLayout>
