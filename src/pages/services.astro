  <!-- ── Visionneuse des aperçus ── -->
  <div class="visionneuse" id="visionneuse" role="dialog" aria-modal="true" aria-labelledby="visionneuseTitre">
    <div class="visionneuse-tete">
      <p class="visionneuse-titre" id="visionneuseTitre">
        <span id="visionneuseNom">Aperçu</span>
        <b id="visionneuseDetail">Site de démonstration</b>
      </p>
      <div class="visionneuse-actions">
        <a class="visionneuse-parcourir" id="visionneuseParcourir" href="#" target="_blank" rel="noopener">
          <span>Parcourir le site</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
        </a>
        <button type="button" class="visionneuse-fermer" id="visionneuseFermer">Fermer</button>
      </div>
    </div>
    <div class="visionneuse-corps">
      <!-- Placeholder transparent d'1px : un src="" se résout contre l'URL de la
           page et provoque une requête parasite. Le script remplit src et alt
           à l'ouverture de la visionneuse. alt vide tant qu'aucun aperçu n'est
           chargé : l'image n'a alors rien à décrire. -->
      <img id="visionneuseImage" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" decoding="async">
    </div>
  </div>

  <script is:inline define:vars={{ apercusData: {
    'page-unique': { src: apercuPageUnique.src, titre: apercus['page-unique'].titre, detail: apercus['page-unique'].detail, formule: 'Page unique', demo: apercus['page-unique'].demo },
    'vitrine': { src: apercuVitrine.src, titre: apercus['vitrine'].titre, detail: apercus['vitrine'].detail, formule: 'Site vitrine', demo: apercus['vitrine'].demo },
    'boutique': { src: apercuBoutique.src, titre: apercus['boutique'].titre, detail: apercus['boutique'].detail, formule: 'Boutique en ligne', demo: apercus['boutique'].demo },
    'sur-mesure': { src: apercuSurMesure.src, titre: apercus['sur-mesure'].titre, detail: apercus['sur-mesure'].detail, formule: 'Site sur mesure', demo: apercus['sur-mesure'].demo },
  } }}>
    (function () {
      var vue = document.getElementById('visionneuse');
      if (!vue) return;
      var img = document.getElementById('visionneuseImage');
      var nom = document.getElementById('visionneuseNom');
      var det = document.getElementById('visionneuseDetail');
      var parcourir = document.getElementById('visionneuseParcourir');
      var corps = vue.querySelector('.visionneuse-corps');
      var declencheur = null;

      function ouvrir(cle, bouton) {
        var d = apercusData[cle];
        if (!d) return;
        declencheur = bouton;
        img.src = d.src;
        img.alt = "Aperçu complet du site de démonstration : " + d.titre;
        nom.textContent = d.formule + ", " + d.titre;
        det.textContent = d.detail;
        if (d.demo) {
          parcourir.href = d.demo;
          parcourir.setAttribute('aria-label', 'Parcourir le site de démonstration, ' + d.titre + ', dans un nouvel onglet');
          parcourir.style.display = '';
        } else {
          parcourir.style.display = 'none';
        }
        corps.scrollTop = 0;
        vue.setAttribute('open', '');
        document.body.style.overflow = 'hidden';
        document.getElementById('visionneuseFermer').focus();
      }
      function fermer() {
        vue.removeAttribute('open');
        document.body.style.overflow = '';
        if (declencheur) declencheur.focus();
      }

      document.querySelectorAll('.apercu-ouvrir').forEach(function (b) {
        b.addEventListener('click', function () { ouvrir(b.dataset.apercu, b); });
      });
      document.getElementById('visionneuseFermer').addEventListener('click', fermer);
      vue.addEventListener('click', function (e) { if (e.target === vue || e.target === corps) fermer(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && vue.hasAttribute('open')) fermer();
      });
    })();
  </script>

</BaseLayout>
