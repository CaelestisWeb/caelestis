      transform: translateY(-2px);
    }
    .tf-card-accent {
      background: #255C41;
      border-color: #255C41;
    }
    .tf-card-accent:hover {
      border-color: #1B4733;
      box-shadow: 0 14px 34px rgba(27, 71, 51, 0.24);
    }

    .tf-kicker {
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 500;
      color: #2E7452;
    }
    .tf-card-accent .tf-kicker { color: rgba(252, 251, 248, 0.74); }

    .tf-nom {
      font-family: var(--font-display, 'Satoshi', system-ui, sans-serif);
      font-weight: 300;
      font-size: 1.6rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: #255C41;
      margin-top: 10px;
    }
    .tf-card-accent .tf-nom { color: #FCFBF8; }

    .tf-prix {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
      padding-top: 18px;
      border-top: 1px solid #E6E4DC;
    }
    .tf-card-accent .tf-prix { border-top-color: rgba(252, 251, 248, 0.2); }
    .tf-num {
      font-family: var(--font-display, 'Satoshi', system-ui, sans-serif);
      font-weight: 300;
      font-size: clamp(2rem, 3.6vw, 2.5rem);
      line-height: 1;
      letter-spacing: -0.03em;
      font-variant-numeric: lining-nums tabular-nums;
      color: #255C41;
    }
    .tf-card-accent .tf-num { color: #FCFBF8; }
    .tf-from {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #5C6259;
    }
    .tf-card-accent .tf-from { color: rgba(252, 251, 248, 0.72); }
    /* 0,68rem tombe à 10,88px, trop peu pour un écran tenu en main. Placé après
       la règle de base : à spécificité égale, une media query ne l'emporte pas,
       seul l'ordre compte. */
    @media (max-width: 767px), (hover: none) and (pointer: coarse) {
      .tf-from { font-size: 0.75rem; }
    }

    .tf-desc {
      font-size: 0.92rem;
      line-height: 1.65;
      color: #5C6259;
      margin-top: 16px;
    }
    .tf-card-accent .tf-desc { color: rgba(252, 251, 248, 0.84); }

    .tf-ul {
      list-style: none;
      display: grid;
      gap: 10px;
      margin-top: 18px;
    }
    .tf-ul li {
      display: flex;
      gap: 11px;
      font-size: 0.88rem;
      line-height: 1.55;
      color: #5C6259;
    }
    .tf-card-accent .tf-ul li { color: rgba(252, 251, 248, 0.88); }
    .tf-check {
      flex: 0 0 auto;
      width: 16px;
      height: 16px;
      margin-top: 4px;
      border-radius: 50%;
      border: 1px solid rgba(46, 116, 82, 0.55);
      position: relative;
    }
    .tf-check::after {
      content: '';
      position: absolute;
      inset: 0;
      margin: auto;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #2E7452;
    }
    .tf-card-accent .tf-check { border-color: rgba(252, 251, 248, 0.45); }
    .tf-card-accent .tf-check::after { background: rgba(252, 251, 248, 0.8); }

    /* L'aperçu pousse le lien en bas : les quatre blocs gardent la même hauteur. */
    .tf-apercu {
      display: block;
      width: 100%;
      margin-top: 24px;
      text-align: left;
    }
    .tf-legende {
      font-size: 0.78rem;
      line-height: 1.5;
      color: #5C6259;
      margin-top: 10px;
    }
    .tf-card-accent .tf-legende { color: rgba(252, 251, 248, 0.76); }

    .tf-lien {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      padding-top: 22px;
      font-size: 0.88rem;
      font-weight: 500;
      color: #2E7452;
      transition: gap 0.25s ease;
    }
    .tf-lien:hover { gap: 14px; }
    .tf-card-accent .tf-lien { color: #FCFBF8; }
    .tf-lien:focus-visible {
      outline: 2px solid #255C41;
      outline-offset: 3px;
      border-radius: 3px;
    }
    .tf-card-accent .tf-lien:focus-visible { outline-color: #FCFBF8; }

    @media (max-width: 640px) {
      .tf-card { padding: 26px 22px; }
    }
  </style>

  <!-- ── Tarif — trois typologies ── -->
