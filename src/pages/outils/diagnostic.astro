---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Diagnostic de site internet',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Navigateur web',
  url: 'https://caelestis.fr/outils/diagnostic',
  description:
    "Audit gratuit et immédiat d'un site internet : plus de 65 points de contrôle répartis en huit familles, vitesse, affichage mobile, sécurité, référencement, contenu, conversion, lisibilité et conformité, avec une note sur 100.",
  inLanguage: 'fr-FR',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  // Rattaché à l'entité unique du site plutôt qu'à une organisation anonyme :
  // les moteurs relient ainsi l'outil à l'entreprise qui le propose.
  provider: { '@id': 'https://caelestis.fr/#business' },
};

const filArianeDiagnostic = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Diagnostic de site', item: 'https://caelestis.fr/outils/diagnostic' },
  ],
};
---

<BaseLayout
  title="Diagnostic gratuit de votre site internet, Caelestis"
  description="Plus de 65 points de contrôle en quelques secondes : vitesse, référencement, mobile, conformité. Une note sur 100 et les corrections à faire."
  canonical="https://caelestis.fr/outils/diagnostic"
  schema={[schema, filArianeDiagnostic]}
>

  <!-- ─── EN-TÊTE ─── -->
  <section class="pt-20 pb-10 md:pt-24 px-6 md:px-10 lg:px-20">
    <div class="max-w-3xl mx-auto text-center">

      <p class="inline-block font-body text-xs tracking-[0.22em] uppercase text-sauge border border-sauge/40 rounded-full px-4 py-1.5 mb-8">
        Diagnostic gratuit
      </p>

      <h1 class="font-display text-3xl md:text-5xl text-brun leading-[1.08] mb-6">
        Votre site tient-il la route ?
      </h1>

      <p class="font-body text-lg text-brun-mid leading-relaxed max-w-[58ch] mx-auto">
        Entrez son adresse. En quelques secondes, plus de 65 points de contrôle
        sont passés sur huit familles, de la vitesse à la conformité légale,
        et chacune reçoit sa note. Rien à installer, aucune inscription.
      </p>

    </div>
  </section>

  <!-- ─── FORMULAIRE ─── -->
  <section class="px-6 md:px-10 lg:px-20 pb-16">
    <div class="max-w-2xl mx-auto">

      <form id="diagForm" class="diag-form" novalidate>
        <label for="diagUrl" class="sr-only">Adresse de votre site internet</label>
        <input
          type="text"
          id="diagUrl"
          name="url"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          placeholder="mon-entreprise.fr"
          aria-describedby="diagAide"
          required
        />
        {/* Volontairement type="button" : un envoi de formulaire est capté par le
            routeur de transitions de vue, qui recharge la page et efface le
            résultat. On déclenche donc l'analyse au clic, la touche Entrée
            étant gérée explicitement sur le champ. */}
        <button type="button" id="diagBtn">
          <span class="diag-btn-label">Analyser</span>
        </button>
      </form>

      <p id="diagAide" class="font-body text-xs text-brun-mid text-center mt-4">
        L'analyse porte sur la page d'accueil publique. Aucune donnée n'est conservée.
      </p>

      <div id="diagStatut" role="status" aria-live="polite" class="font-body text-sm text-center mt-6"></div>

    </div>
  </section>

  <!-- ─── RÉSULTATS ─── -->
  <section id="diagResultats" class="px-6 md:px-10 lg:px-20 pb-20" hidden>
    <div class="max-w-3xl mx-auto">

      <div id="diagEntete" class="pb-6 mb-8 border-b border-cream-dark"></div>
      <div id="diagNote" class="diag-note" hidden></div>
      <ul id="diagFamilles" class="diag-familles" hidden></ul>
      <p id="diagBrut" class="diag-brut" hidden></p>
      <div id="diagConstats"></div>

      <div class="mt-12 pt-10 border-t border-cream-dark">
        <div class="text-center">
          <h2 class="font-display text-2xl md:text-3xl text-brun leading-tight mb-4">
            Vous voulez que je m'en occupe ?
          </h2>
          <p class="font-body text-base text-brun-mid max-w-[52ch] mx-auto mb-8">
            Chacun de ces points se corrige. Laissez-moi votre adresse et je vous
            renvoie l'ordre dans lequel les traiter, avec le temps que cela demande.
          </p>
        </div>

        <form id="leadForm" class="lead-form" novalidate>
          <div class="lead-champs">
            <label class="sr-only" for="leadNom">Votre nom ou celui de votre entreprise</label>
            <input type="text" id="leadNom" name="nom" autocomplete="organization" placeholder="Votre nom ou votre entreprise" />

            <label class="sr-only" for="leadEmail">Votre adresse email</label>
            <input type="email" id="leadEmail" name="email" autocomplete="email" placeholder="vous@votre-entreprise.fr" required />
          </div>
          <button type="button" id="leadBtn"><span class="lead-btn-label">Recevoir les priorités</span></button>
        </form>

        <p id="leadStatut" role="status" aria-live="polite" class="font-body text-sm text-center mt-4"></p>

        <p class="font-body text-xs text-brun-mid text-center mt-3 max-w-[52ch] mx-auto">
          Votre adresse ne sert qu'à vous répondre. Aucune inscription à une liste,
          aucune revente, et vous pouvez demander sa suppression à tout moment.
        </p>

        <div class="text-center mt-8">
          <Button href="/contact" variant="outline">Ou me parler directement</Button>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── CE QUE L'ANALYSE REGARDE ─── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark section-ambient">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display text-2xl md:text-3xl text-brun leading-tight mb-4 text-center">
        Les huit familles passées au crible
      </h2>
      <p class="font-body text-base text-brun-mid text-center max-w-[54ch] mx-auto mb-10">
        Chaque famille est notée sur 100. Un point relevé coûte des points à sa
        famille selon sa gravité, et la note générale en découle.
      </p>
      <ul class="diag-criteres font-body">
        <li><b>Vitesse</b> : temps de réponse, poids de la page, compression, scripts qui retardent l'affichage, services extérieurs appelés, format des images.</li>
        <li><b>Mobile</b> : affichage adapté au téléphone, zoom autorisé, largeur figée, mise en page dépassée, images qui font sauter le contenu au chargement.</li>
        <li><b>Sécurité</b> : connexion chiffrée, certificat valide et pas près d'expirer, éléments encore chargés sans protection, redirection de l'ancienne adresse non sécurisée, versions de logiciels laissées en clair.</li>
        <li><b>Référencement</b> : présence dans Google (autorisée ou bloquée sans le savoir), titre et description affichés dans les résultats, bonne adresse déclarée, plan du site, fiche d'informations, lien vers votre fiche Google, accès des moteurs de réponse comme ChatGPT.</li>
        <li><b>Contenu</b> : volume de texte, ville et zone d'intervention, avis et références, réalisations, textes d'exemple oubliés, fraîcheur des mentions.</li>
        <li><b>Conversion</b> : moyens de vous contacter, téléphone cliquable, bouton visible sans faire défiler, longueur du formulaire, horaires, adresse, repères de prix.</li>
        <li><b>Lisibilité</b> : description des images, libellés de formulaire, langue de la page déclarée, cartes et vidéos intégrées, code laissé à l'abandon.</li>
        <li><b>Confiance</b> : mentions légales, accord demandé avant les traceurs, politique de confidentialité, conditions de vente, polices et vidéos chargées chez des tiers.</li>
      </ul>
      <p class="font-body text-sm text-brun-mid mt-10 text-center max-w-[56ch] mx-auto">
        Chaque point est mesuré sur votre page, aucun n'est une appréciation de goût.
        L'analyse porte sur la page d'accueil et sur les fichiers techniques du site.
        Un audit complet examine ensuite chaque page, les concurrents et les chiffres de fréquentation.
      </p>

      <div class="diag-astuce font-body">
        <p class="diag-astuce-titre">Vérifier vous-même votre présence dans Google</p>
        <p>
          Le diagnostic contrôle si Google a le droit d'afficher votre site et si
          rien ne l'en empêche à votre insu. Pour voir les pages qu'il connaît déjà,
          tapez dans la barre de recherche Google&nbsp;:
          <span class="diag-code">site:votre-domaine.fr</span>. Le nombre de résultats
          correspond aux pages actuellement présentes dans Google. Aucun résultat pour
          un site en ligne depuis plusieurs semaines signale un blocage à lever en
          priorité, et c'est justement ce que le diagnostic cherche à repérer.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  .diag-form { display: flex; gap: .6rem; flex-wrap: wrap; }

  .diag-form input {
    flex: 1 1 16rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: .95rem 1.15rem;
    color: var(--color-encre);
    background: var(--color-cream);
    border: 1px solid var(--color-cream-dark);
    border-radius: 2px;
    transition: border-color .3s ease;
  }
  /* Le contour système est remplacé, jamais supprimé : un simple changement
     de teinte de bordure ne suffit pas (WCAG 2.4.11, contraste 3:1 attendu
     pour un indicateur de focus). L'anneau reprend le vert de la charte. */
  .diag-form input:focus-visible {
    outline: 2px solid var(--color-sauge-text);
    outline-offset: 2px;
    border-color: var(--color-sauge-text);
  }
  .diag-form input::placeholder { color: color-mix(in srgb, var(--color-brun-mid) 60%, transparent); }

  .diag-form button {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-size: .95rem;
    padding: .95rem 2rem;
    color: var(--color-cream);
    background: var(--color-brun);
    border: 1px solid var(--color-brun);
    border-radius: 2px;
    cursor: pointer;
    transition: background-color .3s ease, opacity .3s ease;
  }
  .diag-form button:hover:not(:disabled) { background: var(--color-ocre-dark); }
  .diag-form button:disabled { opacity: .55; cursor: progress; }
  /* Le champ hérite des 10px d'arrondi imposés à tous les champs du site par
     global.css, règle plus spécifique que le `border-radius: 2px` ci-dessus.
     Le bouton, lui, gardait ses angles vifs : accolés c'était déjà bancal, mais
     une fois empilés sur mobile la paire devenait franchement dépareillée.
     Sur mobile le bouton prend aussi toute la largeur : à 122px et aligné à
     gauche sous un champ pleine largeur, il avait l'air inachevé. */
  .diag-form button { border-radius: 10px; }
  @media (max-width: 639px) {
    .diag-form button { flex: 1 1 100%; }
  }

  /* Note générale : le seul chiffre de la page qui a droit à cette taille.
     C'est ce que le visiteur retient, et ce qui donne son sens au reste. */
  .diag-note {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem 2rem;
    padding: 1.6rem 1.75rem;
    border: 1px solid var(--color-cream-dark);
    border-left-width: 4px;
    border-radius: 2px;
    margin-bottom: 1.75rem;
  }
  .diag-note[data-niveau="bon"]    { border-left-color: var(--color-sauge-text); }
  .diag-note[data-niveau="moyen"]  { border-left-color: #A8722A; }
  .diag-note[data-niveau="faible"] { border-left-color: #9C3226; }

  /* Huit familles, deux lignes de quatre sur grand écran. */
  .diag-familles {
    list-style: none; padding: 0; margin: 0 0 1.25rem;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem;
  }
  @media (min-width: 640px) { .diag-familles { grid-template-columns: repeat(4, 1fr); } }

  .diag-brut {
    font-family: var(--font-body);
    font-size: .78rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    margin: 0 0 2.75rem;
  }

  .lead-form {
    display: flex; gap: .6rem; flex-wrap: wrap;
    max-width: 42rem; margin-inline: auto;
  }
  .lead-champs { display: grid; gap: .6rem; flex: 1 1 20rem; min-width: 0; }
  @media (min-width: 640px) { .lead-champs { grid-template-columns: 1fr 1fr; } }

  .lead-form input {
    font-family: var(--font-body);
    font-size: .95rem;
    padding: .85rem 1.05rem;
    color: var(--color-encre);
    background: var(--color-cream);
    border: 1px solid var(--color-cream-dark);
    border-radius: 2px;
    min-width: 0;
    transition: border-color .3s ease;
  }
  .lead-form input:focus-visible { outline: none; border-color: var(--color-sauge-text); }
  .lead-form input::placeholder { color: color-mix(in srgb, var(--color-brun-mid) 60%, transparent); }

  .lead-form button {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-size: .95rem;
    padding: .85rem 1.8rem;
    color: var(--color-cream);
    background: var(--color-brun);
    border: 1px solid var(--color-brun);
    border-radius: 2px;
    cursor: pointer;
    transition: background-color .3s ease, opacity .3s ease;
  }
  .lead-form button:hover:not(:disabled) { background: var(--color-ocre-dark); }
  .lead-form button:disabled { opacity: .55; cursor: progress; }

  .diag-criteres { display: grid; gap: .85rem; }
  .diag-criteres li {
    position: relative; padding-left: 1.5rem;
    color: var(--color-brun-mid); line-height: 1.6;
  }
  .diag-criteres li::before {
    content: ''; position: absolute; left: 0; top: .62em;
    width: .5rem; height: 1px; background: var(--color-sauge-text);
  }
  .diag-criteres b { color: var(--color-brun); font-weight: 500; }

  /* Encart d'aide sur l'indexation. Le diagnostic ne peut pas interroger l'index
     de Google de façon fiable depuis un serveur (Google bloque ces requêtes
     automatiques) : plutôt qu'un chiffre incertain, on donne au visiteur la
     méthode que les professionnels emploient eux-mêmes pour le vérifier. */
  .diag-astuce {
    max-width: 40rem;
    margin: 2.5rem auto 0;
    padding: 1.25rem 1.4rem;
    background: var(--color-cream);
    border: 1px solid var(--color-cream-dark);
    border-left: 3px solid var(--color-sauge-text);
    border-radius: 2px;
    color: var(--color-brun-mid);
    line-height: 1.6;
    font-size: .95rem;
  }
  .diag-astuce-titre {
    color: var(--color-brun);
    font-weight: 500;
    margin: 0 0 .5rem;
  }
  .diag-astuce p:last-child { margin: 0; }
  .diag-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .88em;
    background: var(--color-cream-dark);
    color: var(--color-brun);
    padding: .1rem .4rem;
    border-radius: 3px;
    white-space: nowrap;
  }
</style>

<!-- Les éléments de résultat sont créés en JavaScript : ils ne portent donc pas
     l'attribut de portée ajouté par Astro, et des styles scopés ne s'y
     appliqueraient jamais. Ces règles sont globales, mais toutes cantonnées
     sous les conteneurs de la page pour ne rien déborder ailleurs. -->
<style is:global>
  /* ── Note générale ── */
  #diagNote .diag-note-chiffre {
    display: flex; align-items: baseline; gap: .5rem;
    flex: 0 0 auto;
  }
  #diagNote .diag-note-chiffre b {
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 400;
    line-height: .9;
    color: var(--color-brun);
  }
  @media (min-width: 640px) { #diagNote .diag-note-chiffre b { font-size: 4.2rem; } }
  #diagNote[data-niveau="moyen"] .diag-note-chiffre b  { color: #A8722A; }
  #diagNote[data-niveau="faible"] .diag-note-chiffre b { color: #9C3226; }
  #diagNote .diag-note-chiffre span {
    font-family: var(--font-body);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-brun-mid);
  }
  #diagNote .diag-note-verdict {
    flex: 1 1 18rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-brun);
    margin: 0;
  }

  /* ── Cases des huit familles ── */
  #diagFamilles li {
    border: 1px solid var(--color-cream-dark);
    border-top-width: 3px;
    border-radius: 2px;
    padding: .8rem .9rem .85rem;
  }
  #diagFamilles li[data-niveau="bon"]    { border-top-color: var(--color-sauge-text); }
  #diagFamilles li[data-niveau="moyen"]  { border-top-color: #A8722A; }
  #diagFamilles li[data-niveau="faible"] { border-top-color: #9C3226; }

  #diagFamilles b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-brun);
    margin-bottom: .35rem;
  }
  #diagFamilles li[data-niveau="moyen"] b  { color: #A8722A; }
  #diagFamilles li[data-niveau="faible"] b { color: #9C3226; }

  #diagFamilles .diag-f-nom {
    display: block;
    font-family: var(--font-body);
    font-size: .66rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-brun);
  }
  #diagFamilles .diag-f-detail {
    display: block;
    font-family: var(--font-body);
    font-size: .72rem;
    line-height: 1.3;
    color: var(--color-brun-mid);
    margin-top: .2rem;
  }

  /* ── Groupes de constats, une section par famille ── */
  #diagConstats .diag-groupe { margin-bottom: 2.25rem; }
  #diagConstats .diag-groupe-titre {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem;
    padding-bottom: .5rem;
    margin: 0 0 .5rem;
    border-bottom: 1px solid var(--color-cream-dark);
  }
  #diagConstats .diag-groupe-nom {
    font-family: var(--font-body);
    font-size: .72rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-brun);
  }
  #diagConstats .diag-groupe-note {
    font-family: var(--font-body);
    font-size: .72rem;
    color: var(--color-brun-mid);
    white-space: nowrap;
  }
  #diagConstats .diag-groupe[data-niveau="faible"] .diag-groupe-note { color: #9C3226; }
  #diagConstats .diag-groupe-reste {
    font-family: var(--font-body);
    font-size: .82rem;
    color: var(--color-brun-mid);
    margin: .6rem 0 0 1.05rem;
  }

  #diagConstats .diag-constat {
    padding: 1rem 0 1rem 1.05rem;
    border-left: 3px solid var(--color-cream-dark);
    margin-bottom: .85rem;
  }
  #diagConstats .diag-constat[data-gravite="critique"] { border-left-color: #9C3226; }
  #diagConstats .diag-constat[data-gravite="moyen"]    { border-left-color: #A8722A; }
  /* Points de réglage : relevés, mais sans effet sur la note. Le trait de
     gauche s'efface pour que l'œil aille d'abord à ce qui compte. */
  #diagConstats .diag-constat[data-gravite="reglage"]  { border-left-style: dotted; opacity: .82; }

  #diagConstats .diag-etiquette {
    display: inline-block;
    font-family: var(--font-body);
    font-size: .65rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-brun-mid);
    margin-bottom: .3rem;
  }
  #diagConstats .diag-constat[data-gravite="critique"] .diag-etiquette { color: #9C3226; }
  #diagConstats .diag-constat[data-gravite="moyen"] .diag-etiquette    { color: #A8722A; }

  #diagConstats .diag-fait {
    font-family: var(--font-body);
    color: var(--color-brun);
    font-weight: 500;
    margin: 0 0 .2rem;
  }
  #diagConstats .diag-consequence {
    font-family: var(--font-body);
    color: var(--color-brun-mid);
    font-size: .93rem;
    margin: 0;
    line-height: 1.55;
  }
</style>

<script>
/* Le branchement est enveloppé dans une fonction rappelée à chaque navigation :
   le routeur de transitions de vue remplace le DOM, les écouteurs posés une
   seule fois au chargement initial seraient perdus dès la première navigation
   interne. */
function brancherDiagnostic() {
  const form      = document.getElementById('diagForm') as HTMLFormElement | null;
  const champ     = document.getElementById('diagUrl') as HTMLInputElement | null;
  const bouton    = document.getElementById('diagBtn') as HTMLButtonElement | null;
  const statut    = document.getElementById('diagStatut');
  const resultats = document.getElementById('diagResultats');
  const entete    = document.getElementById('diagEntete');
  const noteBloc  = document.getElementById('diagNote');
  const familles  = document.getElementById('diagFamilles');
  const brut      = document.getElementById('diagBrut');
  const constats  = document.getElementById('diagConstats');

  if (!form || !champ || !bouton || !statut || !resultats || !entete) return;
  if (!noteBloc || !familles || !brut || !constats) return;
  if (form.dataset.branche === 'oui') return;
  form.dataset.branche = 'oui';

  /* « Réglage » désigne un point exact que la note ne sanctionne pas : il
     manque à la très grande majorité des sites, y compris bien construits. */
  const LIBELLE = { critique: 'Bloquant', moyen: 'Important', mineur: 'À corriger', reglage: 'Réglage, sans effet sur la note' } as const;
  /* Au-delà de ce nombre, les points restants d'une même famille sont annoncés
     sans être détaillés : une liste de trente lignes ne se lit plus. */
  const PLAFOND_PAR_FAMILLE = 8;
  const niveau = (note: number) => (note >= 80 ? 'bon' : note >= 50 ? 'moyen' : 'faible');

  /* Contexte de la dernière analyse, joint à la demande de rappel : sans lui,
     un email arrive sans qu'on sache de quel site il parle. */
  let dernierSite = '';
  let dernierResume = '';

  brancherRappel(() => ({ site: dernierSite, resume: dernierResume }));

  const message = (texte: string, erreur = false) => {
    statut.textContent = texte;
    statut.style.color = erreur ? '#9C3226' : 'var(--color-brun-mid)';
  };

  /* Le contenu vient du serveur mais reste inséré via textContent :
     aucune chaîne renvoyée par l'analyse n'est interprétée comme du HTML. */
  const bloc = (tag: string, classe: string, texte: string) => {
    const el = document.createElement(tag);
    el.className = classe;
    el.textContent = texte;
    return el;
  };

  /* Ceinture et bretelles : si un envoi de formulaire survenait malgré
     le bouton non soumettant, il ne doit jamais recharger la page. */
  form.addEventListener('submit', (evenement) => {
    evenement.preventDefault();
    evenement.stopPropagation();
    lancerAnalyse();
  });

  champ.addEventListener('keydown', (evenement) => {
    if (evenement.key === 'Enter') {
      evenement.preventDefault();
      lancerAnalyse();
    }
  });

  bouton.addEventListener('click', lancerAnalyse);

  async function lancerAnalyse() {
    /* Redondant avec la garde d'entrée, mais nécessaire : une déclaration de
       fonction étant remontée, le compilateur ne peut pas savoir qu'elle ne
       s'exécute qu'après la vérification ci-dessus. */
    if (!champ || !bouton || !resultats || !entete || !constats) return;
    if (!noteBloc || !familles || !brut) return;

    const url = champ.value.trim();
    if (!url) { message("Indiquez l'adresse de votre site.", true); champ.focus(); return; }

    bouton.disabled = true;
    const libelle = bouton.querySelector('.diag-btn-label');
    if (libelle) libelle.textContent = 'Analyse en cours';
    message('Mesure en cours, cela prend quelques secondes.');
    resultats.hidden = true;

    try {
      const reponse = await fetch('/api/diagnostic', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const donnees = await reponse.json();

      if (!reponse.ok && donnees?.erreur) { message(donnees.erreur, true); return; }
      if (donnees?.etat === 'refuse') { message(donnees.raison, true); return; }

      message('');
      entete.textContent = '';
      noteBloc.textContent = '';
      familles.textContent = '';
      brut.textContent = '';
      constats.textContent = '';
      noteBloc.hidden = true;
      familles.hidden = true;
      brut.hidden = true;

      entete.appendChild(bloc('p', 'font-body text-xs tracking-[0.22em] uppercase text-sauge mb-2', 'Résultat'));
      entete.appendChild(bloc('h2', 'font-display text-2xl md:text-3xl text-brun leading-tight', donnees.hote ?? url));

      const liste: any[] = donnees.constats ?? [];
      const bloquants = liste.filter((c: any) => c.gravite === 'critique').length;

      dernierSite = donnees.hote ?? url;
      if (donnees.etat === 'injoignable') {
        dernierResume = 'adresse injoignable';
      } else if (donnees.etat === 'ok') {
        const plusFaibles = [...(donnees.familles ?? [])]
          .sort((a: any, b: any) => a.note - b.note)
          .slice(0, 3)
          .map((f: any) => `${f.libelle} ${f.note}`)
          .join(', ');
        dernierResume =
          `Note générale ${donnees.note} sur 100. ${liste.length} point(s) relevé(s) sur ` +
          `${donnees.mesures?.controles ?? 0} contrôles, dont ${bloquants} bloquant(s). ` +
          `Familles les plus basses : ${plusFaibles}.`;
      } else {
        dernierResume = `${liste.length} point(s) relevé(s), dont ${bloquants} bloquant(s)`;
      }

      if (donnees.etat === 'injoignable') {
        entete.appendChild(bloc('p', 'font-body text-base text-brun-mid mt-3', donnees.raison));
        resultats.hidden = false;
        resultats.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      if (donnees.etat === 'ok') {
        /* ── Note générale et verdict ── */
        noteBloc.setAttribute('data-niveau', niveau(donnees.note));
        const chiffre = document.createElement('div');
        chiffre.className = 'diag-note-chiffre';
        chiffre.appendChild(bloc('b', '', String(donnees.note)));
        chiffre.appendChild(bloc('span', '', 'sur 100'));
        noteBloc.appendChild(chiffre);
        noteBloc.appendChild(bloc('p', 'diag-note-verdict', donnees.verdict ?? ''));
        noteBloc.hidden = false;

        /* ── Les huit familles ── */
        for (const f of donnees.familles ?? []) {
          const li = document.createElement('li');
          li.setAttribute('data-niveau', niveau(f.note));
          li.appendChild(bloc('b', '', String(f.note)));
          li.appendChild(bloc('span', 'diag-f-nom', f.libelle));
          const detail = f.points === 0
            ? 'rien à signaler'
            : f.bloquants > 0
              ? `${f.points} point${f.points > 1 ? 's' : ''}, dont ${f.bloquants} bloquant${f.bloquants > 1 ? 's' : ''}`
              : `${f.points} point${f.points > 1 ? 's' : ''}`;
          li.appendChild(bloc('span', 'diag-f-detail', detail));
          familles.appendChild(li);
        }
        familles.hidden = false;

        /* ── Mesures brutes, en une phrase pour ne pas concurrencer les notes ── */
        const m = donnees.mesures;
        if (m) {
          const p = (n: number, singulier: string, pluriel = singulier + 's') =>
            `${n} ${n > 1 ? pluriel : singulier}`;
          brut.textContent =
            `Page reçue en ${(m.duree / 1000).toFixed(1).replace('.', ',')} seconde${m.duree >= 2000 ? 's' : ''}, ` +
            `${Math.round(m.poids / 1024)} Ko de code, ${p(m.balises, 'balise')}, ${p(m.mots, 'mot')}, ` +
            `${p(m.images, 'image')} dont ${m.imagesSansAlt} sans description, ${p(m.scripts, 'script')}, ` +
            `${p(m.domainesTiers, 'serveur extérieur', 'serveurs extérieurs')}, ` +
            `${p(m.pages, 'page')} ${m.pages > 1 ? 'atteignables' : 'atteignable'} depuis l'accueil. ` +
            (m.pagesLues > 1 ? `${p(m.pagesLues, 'page')} ouverte${m.pagesLues > 1 ? 's' : ''} et lue${m.pagesLues > 1 ? 's' : ''}. ` : '') +
            `${p(m.controles, 'contrôle')} passé${m.controles > 1 ? 's' : ''}.`;
          brut.hidden = false;
        }
      }

      /* Les points de réglage sont annoncés à part : ils ne pèsent pas sur la
         note, et les mêler au décompte donnerait une liste plus alarmante
         qu'elle ne l'est. */
      const reglages = liste.filter((c: any) => c.gravite === 'reglage').length;
      const comptes = liste.length - reglages;
      const titre = liste.length === 0
        ? "Aucun défaut relevé sur les points contrôlés."
        : comptes === 0
          ? `${reglages} point${reglages > 1 ? 's' : ''} de réglage, sans effet sur la note.`
          : `${comptes} point${comptes > 1 ? 's' : ''} relevé${comptes > 1 ? 's' : ''}${bloquants ? `, dont ${bloquants} bloquant${bloquants > 1 ? 's' : ''}` : ''}` +
            (reglages ? `, plus ${reglages} réglage${reglages > 1 ? 's' : ''} sans effet sur la note` : '');
      constats.appendChild(bloc('h3', 'font-display text-xl md:text-2xl text-brun mb-6', titre));

      const carte = (c: any) => {
        const item = document.createElement('div');
        item.className = 'diag-constat';
        item.setAttribute('data-gravite', c.gravite);
        item.appendChild(bloc('span', 'diag-etiquette', LIBELLE[c.gravite as keyof typeof LIBELLE] ?? ''));
        item.appendChild(bloc('p', 'diag-fait', c.fait));
        item.appendChild(bloc('p', 'diag-consequence', c.consequence));
        return item;
      };

      if (donnees.etat === 'ok') {
        /* Regroupement par famille : le visiteur voit de quel côté son site
           décroche, au lieu d'une liste continue où tout se vaut. */
        for (const f of donnees.familles ?? []) {
          const propres = liste.filter((c: any) => c.famille === f.cle);
          if (propres.length === 0) continue;

          const groupe = document.createElement('section');
          groupe.className = 'diag-groupe';
          groupe.setAttribute('data-niveau', niveau(f.note));

          const enteteGroupe = document.createElement('h4');
          enteteGroupe.className = 'diag-groupe-titre';
          enteteGroupe.appendChild(bloc('span', 'diag-groupe-nom', f.libelle));
          enteteGroupe.appendChild(bloc('span', 'diag-groupe-note', `${f.note} sur 100`));
          groupe.appendChild(enteteGroupe);

          for (const c of propres.slice(0, PLAFOND_PAR_FAMILLE)) groupe.appendChild(carte(c));

          const reste = propres.length - PLAFOND_PAR_FAMILLE;
          if (reste > 0) {
            groupe.appendChild(bloc('p', 'diag-groupe-reste',
              `Et ${reste} autre${reste > 1 ? 's' : ''} point${reste > 1 ? 's' : ''} de moindre importance dans cette famille.`));
          }
          constats.appendChild(groupe);
        }
      } else {
        for (const c of liste) constats.appendChild(carte(c));
      }

      resultats.hidden = false;
      resultats.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch {
      message("L'analyse n'a pas abouti. Vérifiez l'adresse et réessayez.", true);
    } finally {
      bouton.disabled = false;
      const libelleFin = bouton.querySelector('.diag-btn-label');
      if (libelleFin) libelleFin.textContent = 'Analyser';
    }
  }
}

/**
 * Demande de rappel, affichée sous les résultats.
 *
 * Même contrainte que le formulaire d'analyse : le bouton n'est pas soumettant,
 * un envoi de formulaire serait capté par le routeur de transitions de vue.
 */
function brancherRappel(contexte: () => { site: string; resume: string }) {
  const form = document.getElementById('leadForm') as HTMLFormElement | null;
  const champNom = document.getElementById('leadNom') as HTMLInputElement | null;
  const champEmail = document.getElementById('leadEmail') as HTMLInputElement | null;
  const bouton = document.getElementById('leadBtn') as HTMLButtonElement | null;
  const statut = document.getElementById('leadStatut');

  if (!form || !champNom || !champEmail || !bouton || !statut) return;
  if (form.dataset.branche === 'oui') return;
  form.dataset.branche = 'oui';

  const dire = (texte: string, erreur = false) => {
    statut.textContent = texte;
    statut.style.color = erreur ? '#9C3226' : 'var(--color-sauge-text)';
  };

  async function envoyer() {
    const email = champEmail!.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) {
      dire('Indiquez une adresse email valide.', true);
      champEmail!.focus();
      return;
    }

    bouton!.disabled = true;
    const libelle = bouton!.querySelector('.lead-btn-label');
    if (libelle) libelle.textContent = 'Envoi';
    dire('');

    const { site, resume } = contexte();

    try {
      const reponse = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, nom: champNom!.value.trim(), site, resume }),
      });
      const donnees = await reponse.json();

      if (!reponse.ok) {
        dire(donnees?.erreur ?? "L'envoi n'a pas abouti.", true);
        return;
      }

      form!.hidden = true;
      dire('Merci. Je vous réponds sous 48h ouvrées, avec l’ordre dans lequel traiter ces points.');
    } catch {
      dire("L'envoi n'a pas abouti. Réessayez dans un instant.", true);
    } finally {
      bouton!.disabled = false;
      const fin = bouton!.querySelector('.lead-btn-label');
      if (fin) fin.textContent = 'Recevoir les priorités';
    }
  }

  form.addEventListener('submit', (evenement) => {
    evenement.preventDefault();
    evenement.stopPropagation();
    envoyer();
  });
  champEmail.addEventListener('keydown', (evenement) => {
    if (evenement.key === 'Enter') { evenement.preventDefault(); envoyer(); }
  });
  bouton.addEventListener('click', envoyer);
}

brancherDiagnostic();
document.addEventListener('astro:page-load', brancherDiagnostic);
</script>
