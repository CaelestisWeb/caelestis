---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PriceSimulator from '../../components/PriceSimulator.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil',                      item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Simulateur de prix site internet', item: 'https://caelestis.fr/outils/simulateur' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Simulateur de prix : création de site internet',
  applicationCategory: 'BusinessApplication',
  url: 'https://caelestis.fr/outils/simulateur',
  description: 'Outil gratuit pour estimer le coût de création de votre site internet en 2 minutes. Pour artisans, producteurs, praticiens et indépendants en Auvergne-Rhône-Alpes.',
  operatingSystem: 'Any',
  inLanguage: 'fr-FR',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Estimation gratuite et sans engagement',
  },
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://caelestis.fr/#business',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
    telephone: '+33769362727',
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'Drôme',
      addressCountry: 'FR',
    },
  },
};
---

<BaseLayout
  title="Combien coûte un site internet ? Simulateur gratuit"
  description="Estimez le budget de votre site en 2 minutes. Une fourchette de prix envoyée par email, pour artisans, producteurs et indépendants."
  canonical="https://caelestis.fr/outils/simulateur"
  schema={[breadcrumbSchema, webAppSchema]}
>

  <!-- ── Fond décoratif subtil ── -->
  <div aria-hidden="true" style="position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;">
    <div style="position:absolute;top:-10%;right:-8%;width:420px;height:420px;background:radial-gradient(circle,rgba(184, 196, 187,0.07) 0%,transparent 70%);border-radius:50%;"></div>
    <div style="position:absolute;bottom:5%;left:-6%;width:340px;height:340px;background:radial-gradient(circle,rgba(37, 92, 65,0.05) 0%,transparent 70%);border-radius:50%;"></div>
  </div>

  <div style="position:relative;z-index:1;">

    <!-- ── En-tête de page ── -->
    <section class="pt-20 pb-4 md:pt-24 px-6 md:px-10 lg:px-20 text-center">
      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-5" data-reveal>
        Estimation gratuite, sans engagement
      </p>
      <h1
        class="font-display font-light text-brun leading-tight tracking-tight mb-5"
        style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
        data-reveal data-delay="1"
      >
        Combien coûte<br>
        <em class="not-italic" style="color:var(--color-sauge-vif);">votre site internet&nbsp;?</em>
      </h1>
      <p
        class="font-body text-sm text-brun-mid max-w-md mx-auto leading-relaxed mb-2"
        data-reveal data-delay="2"
      >
        Quelques questions, moins de 2 minutes. Recevez votre fourchette de prix par email.
      </p>
    </section>

    <!-- ── Simulateur ── -->
    <section class="px-6 md:px-10 lg:px-20 pb-16 pt-10">
      <div class="max-w-lg mx-auto">
        <div
          style="
            background: rgba(255,252,245,0.55);
            border: 1.5px solid rgba(207,192,160,0.55);
            border-radius: 16px;
            padding: clamp(28px, 5vw, 52px) clamp(24px, 5vw, 48px);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
          "
          data-reveal data-delay="3"
        >
          <PriceSimulator />
        </div>
        <p class="font-body text-xs text-brun-mid text-center mt-6 leading-relaxed" data-reveal>
          Gratuit, sans engagement
        </p>
        <!-- Sorties de page. Le simulateur était un cul-de-sac : il recevait des
             visiteurs venus chercher un prix et ne leur proposait aucune suite
             tant qu'ils n'entraient pas leur email. Les deux liens répondent à la
             même question sous une autre forme, la grille pour nos formules,
             le guide pour les prix du marché. -->
        <p class="font-body text-xs text-brun-mid text-center mt-3 leading-relaxed" data-reveal>
          Vous préférez lire les chiffres ? Voir <a href="/services" class="underline decoration-sauge/40 underline-offset-2 hover:text-brun transition-colors">le détail des formules et de leurs prix</a> ou <a href="/ressources/tarifs" class="underline decoration-sauge/40 underline-offset-2 hover:text-brun transition-colors">ce que coûte un site en 2026</a>.
        </p>
      </div>
    </section>

  </div>

</BaseLayout>
