---
/**
 * Page de travail, hors navigation et hors index : trois rendus du schéma du
 * territoire, à comparer avant d'en retenir un pour la page régionale.
 * Motif : la liste réelle des zones desservies, relevée sur la fiche Google le
 * 07/08/2026, compte dix-neuf entrées dont douze à moins d'une heure. Le schéma
 * radial d'origine en affichait neuf choisies à la main, dont trois qui ne sont
 * pas desservies (Chambéry, Annecy, Clermont-Ferrand). À supprimer une fois le
 * choix fait.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { ZONES, COURONNES, duree, position } from '../data/zones';

const grandes = ZONES.filter((z) => z.grande && !z.horsRegion);
const enRegion = ZONES.filter((z) => !z.horsRegion);
const maxHeures = Math.max(...enRegion.map((z) => z.heures));

/* Variante A : le radial d'origine, nourri des seules villes repères. */
const A_CENTRE = 210;
const A_PX_HEURE = 74;
const aVilles = grandes.map((z) => {
  const p = position(z, A_CENTRE, A_PX_HEURE);
  // Orientation de l'étiquette : vers l'extérieur du cercle, par quadrant.
  const a = z.azimut;
  const pos = a >= 315 || a < 45 ? 'n' : a < 135 ? 'e' : a < 225 ? 's' : 'o';
  return { ...z, ...p, pos };
});

/* Variante C : l'échelle verticale. Les villes sont accrochées à leur temps de
   route sur un axe gradué, sans direction : rien n'y est faux, seule la
   distance parle. */
const C_HAUTEUR = 520;
const C_ECART_MIN = 25; // hauteur d'une étiquette, en pixels

/* Les villes sont triées par temps de route, puis alternées de part et d'autre
   de l'axe : deux voisines dans le temps ne tombent jamais du même côté. Sur
   chaque côté, une étiquette qui arriverait à moins de 25 px de la précédente
   est repoussée, faute de quoi Chabeuil et Valence, séparées de cinq minutes,
   se recouvrent. Le trait de rappel reste accroché au temps réel. */
const cVilles = [...enRegion]
  .sort((a, b) => a.heures - b.heures)
  .map((z, i) => ({ ...z, top: Math.round((z.heures / maxHeures) * C_HAUTEUR), cote: i % 2 }));

for (const cote of [0, 1]) {
  let dernier = -Infinity;
  for (const v of cVilles.filter((x) => x.cote === cote)) {
    if (v.top - dernier < C_ECART_MIN) v.top = dernier + C_ECART_MIN;
    dernier = v.top;
  }
}
---

<BaseLayout
  title="Variantes du schéma du territoire, page de travail"
  description="Page de travail interne : trois rendus du schéma des zones desservies."
  noindex={true}
>

  <section class="pt-20 pb-10 md:pt-24 px-6 md:px-10 lg:px-20">
    <div class="max-w-4xl mx-auto">
      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-4">Page de travail</p>
      <h1 class="font-display font-light text-brun leading-tight mb-6" style="font-size: clamp(1.9rem, 4vw, 3rem);">
        Trois rendus du territoire.
      </h1>
      <p class="font-body text-base text-brun-mid leading-relaxed max-w-2xl">
        Les {ZONES.length} zones desservies relevées sur la fiche Google, dont
        {ZONES.filter((z) => z.heures < 1).length} à moins d'une heure de Crest.
        Trois façons de les montrer, la même donnée dans les trois.
      </p>
    </div>
  </section>

  <!-- ════════ A. Le radial, avec les villes repères ════════ -->
  <section class="py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
    <div class="max-w-5xl mx-auto">
      <p class="var-etiquette font-body">Variante A</p>
      <h2 class="var-titre font-display">Le radial, réduit aux villes repères</h2>
      <p class="var-note font-body">
        Le principe d'origine : direction réelle, distance réelle, un anneau par
        heure. Ne peut porter que les {grandes.length} villes qu'un visiteur
        extérieur au département reconnaît. Les {enRegion.length - grandes.length}
        autres zones sont dans la liste, pas sur le dessin.
      </p>

      <div class="terr" data-reveal>
        <div class="terr-schema" aria-hidden="true">
          <svg viewBox="0 0 420 420" fill="none">
            {[1, 2].map((h) => (
              <circle cx={A_CENTRE} cy={A_CENTRE} r={String(h * A_PX_HEURE)} class="terr-anneau" />
            ))}
            {aVilles.map((v) => (
              <line x1={A_CENTRE} y1={A_CENTRE} x2={String(v.x)} y2={String(v.y)} class="terr-rayon" />
            ))}
            <text x={A_CENTRE} y={String(A_CENTRE - A_PX_HEURE + 12)} class="terr-legende" text-anchor="middle">1 h</text>
            <text x={A_CENTRE} y={String(A_CENTRE - 2 * A_PX_HEURE + 12)} class="terr-legende" text-anchor="middle">2 h</text>
          </svg>
          <span class="terr-centre font-body"><span class="terr-point" aria-hidden="true"></span>Crest</span>
          {aVilles.map((v) => (
            <span class={`terr-ville font-body est-${v.pos}`} style={`left:${(v.x / 420) * 100}%; top:${(v.y / 420) * 100}%`}>{v.nom}</span>
          ))}
        </div>

        <div class="terr-texte">
          <p class="terr-tete font-body">Depuis Crest, par la route</p>
          <ul class="terr-liste font-body" role="list">
            {grandes.map((z) => <li><span>{z.nom}</span><b>{duree(z.heures)}</b></li>)}
          </ul>
          <p class="terr-note font-body">
            Également desservies : {enRegion.filter((z) => !z.grande).map((z) => z.nom).join(', ')}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════ B. Les couronnes ════════ -->
  <section class="py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark bg-sauge-pale">
    <div class="max-w-5xl mx-auto">
      <p class="var-etiquette font-body">Variante B</p>
      <h2 class="var-titre font-display">Les couronnes de proximité</h2>
      <p class="var-note font-body">
        Toutes les zones, groupées par temps de route. Aucune direction n'est
        montrée, donc rien n'est faux, et les dix-neuf tiennent. Survolez un
        groupe : son anneau s'allume.
      </p>

      <div class="cour">
        <div class="cour-schema" aria-hidden="true">
          <svg viewBox="0 0 300 300" fill="none">
            {COURONNES.map((c, i) => (
              <circle cx="150" cy="150" r={String(34 + i * 36)} class="cour-anneau" data-anneau={String(i)} />
            ))}
            <circle cx="150" cy="150" r="4.5" class="cour-noyau" />
          </svg>
          <span class="cour-centre font-body">Crest</span>
        </div>

        <div class="cour-groupes">
          {COURONNES.map((c, i) => (
            <div class="cour-groupe" data-groupe={String(i)}>
              <p class="cour-titre font-body">{c.titre}</p>
              <ul class="cour-liste" role="list">
                {c.zones.map((z) => <li class="font-body">{z.nom}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <p class="var-pied font-body">
        Aix-en-Provence figure sur la fiche Google mais se trouve hors
        Auvergne-Rhône-Alpes : à ranger dans « au-delà », avec le reste de la France.
      </p>
    </div>
  </section>

  <!-- ════════ C. L'échelle ════════ -->
  <section class="py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
    <div class="max-w-5xl mx-auto">
      <p class="var-etiquette font-body">Variante C</p>
      <h2 class="var-titre font-display">L'échelle des temps de route</h2>
      <p class="var-note font-body">
        Un axe gradué, chaque ville accrochée à son temps. Toutes les zones
        tiennent, l'ordre saute aux yeux, et la densité du haut montre d'elle-même
        que l'essentiel est à portée immédiate.
      </p>

      <div class="ech">
        <div class="ech-axe">
          {[0.5, 1, 1.5, 2].map((h) => (
            <span class="ech-grad font-body" style={`top:${(h / maxHeures) * C_HAUTEUR}px`}>{duree(h)}</span>
          ))}
          {cVilles.map((v) => (
            <span class={`ech-ville font-body ${v.cote ? 'est-droite' : 'est-gauche'}`} style={`top:${v.top}px`}>
              <b>{v.nom}</b><i>{duree(v.heures)}</i>
            </span>
          ))}
          <span class="ech-depart font-body">Crest</span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .var-etiquette {
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: 8px;
  }
  .var-titre {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 300;
    color: var(--color-brun);
    line-height: 1.2;
    margin-bottom: 10px;
  }
  .var-note {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    max-width: 46rem;
    margin-bottom: 34px;
  }
  .var-pied {
    font-size: 0.8rem;
    color: var(--color-brun-mid);
    margin-top: 24px;
    opacity: 0.85;
  }

  /* ── A : radial (styles repris de la page régionale) ── */
  .terr { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .terr { grid-template-columns: 1fr 20rem; gap: 56px; } }
  .terr-schema { position: relative; width: 100%; max-width: 420px; margin: 0 auto; aspect-ratio: 1; }
  .terr-schema svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .terr-anneau { stroke: var(--color-cream-dark); stroke-width: 1; }
  .terr-rayon { stroke: var(--color-sauge); stroke-width: 0.8; opacity: 0.42; }
  .terr-legende { font-family: var(--font-body); font-size: 9px; letter-spacing: 0.12em; fill: var(--color-brun-mid); opacity: 0.6; }
  .terr-centre {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, 6px);
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    font-size: 0.82rem; font-weight: 500; color: var(--color-brun); white-space: nowrap;
  }
  .terr-point { position: absolute; top: -10px; width: 9px; height: 9px; border-radius: 50%; background: var(--color-brun); }
  .terr-ville {
    position: absolute; font-size: 0.7rem; color: var(--color-brun-mid);
    white-space: nowrap; transform: translate(-50%, -50%);
  }
  .terr-ville::before {
    content: ""; position: absolute; left: 50%; top: 50%;
    width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px;
    border-radius: 50%; background: var(--color-sauge-text);
  }
  .terr-ville.est-n { transform: translate(-50%, -160%); }
  .terr-ville.est-s { transform: translate(-50%, 60%); }
  .terr-ville.est-e { transform: translate(14px, -50%); }
  .terr-ville.est-o { transform: translate(calc(-100% - 14px), -50%); }
  .terr-ville.est-n::before { top: 160%; }
  .terr-ville.est-s::before { top: -60%; }
  .terr-ville.est-e::before { left: -14px; }
  .terr-ville.est-o::before { left: calc(100% + 14px); }
  .terr-tete { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-sauge-text); margin-bottom: 14px; }
  .terr-liste { list-style: none; margin: 0; padding: 0; }
  .terr-liste li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 14px;
    padding: 9px 0; border-bottom: 1px solid var(--color-cream-dark);
    font-size: 0.9rem; color: var(--color-brun-mid);
  }
  .terr-liste li:last-child { border-bottom: 0; }
  .terr-liste b { color: var(--color-brun); font-weight: 500; white-space: nowrap; }
  .terr-note { margin-top: 18px; font-size: 0.8rem; line-height: 1.6; color: var(--color-brun-mid); opacity: 0.85; }

  /* ── B : couronnes ── */
  .cour { display: grid; gap: 36px; align-items: center; }
  @media (min-width: 860px) { .cour { grid-template-columns: 300px 1fr; gap: 48px; } }
  .cour-schema { position: relative; width: 100%; max-width: 300px; margin: 0 auto; aspect-ratio: 1; }
  .cour-schema svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cour-anneau { stroke: var(--color-sauge); stroke-width: 1.2; opacity: 0.4; transition: stroke-width 0.25s ease, opacity 0.25s ease; }
  .cour-anneau.est-actif { stroke: var(--color-sauge-text); stroke-width: 2.4; opacity: 1; }
  .cour-noyau { fill: var(--color-brun); }
  .cour-centre {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, 12px);
    font-size: 0.78rem; font-weight: 500; color: var(--color-brun);
  }
  .cour-groupes { display: grid; gap: 22px; }
  .cour-groupe { padding-left: 16px; border-left: 2px solid var(--color-cream-dark); transition: border-color 0.25s ease; }
  .cour-groupe.est-actif { border-left-color: var(--color-sauge-text); }
  .cour-titre { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-sauge-text); margin-bottom: 9px; }
  .cour-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .cour-liste li {
    font-size: 0.82rem; color: var(--color-brun);
    border: 1px solid var(--color-cream-dark); border-radius: 999px;
    padding: 4px 11px; background: var(--color-cream);
  }

  /* ── C : échelle ── */
  .ech { display: flex; justify-content: center; padding: 20px 0 40px; }
  .ech-axe {
    position: relative;
    width: 100%; max-width: 640px;
    height: 560px;
    border-left: 1px solid var(--color-cream-dark);
    margin-left: 50%;
  }
  .ech-axe::before {
    content: ""; position: absolute; left: -1px; top: 0; bottom: 0; width: 1px;
    background: linear-gradient(180deg, var(--color-sauge-text), var(--color-cream-dark));
  }
  .ech-depart {
    position: absolute; left: 0; top: -26px; transform: translateX(-50%);
    font-size: 0.82rem; font-weight: 500; color: var(--color-brun);
  }
  .ech-grad {
    position: absolute; left: 0; transform: translate(-50%, -50%);
    font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-brun-mid); background: var(--color-cream);
    padding: 2px 6px; opacity: 0.75;
  }
  .ech-ville {
    position: absolute; display: flex; align-items: baseline; gap: 8px;
    transform: translateY(-50%); white-space: nowrap;
  }
  .ech-ville b { font-size: 0.86rem; font-weight: 400; color: var(--color-brun); }
  .ech-ville i { font-style: normal; font-size: 0.72rem; color: var(--color-brun-mid); }
  .ech-ville::before {
    content: ""; width: 16px; height: 1px; background: var(--color-sauge); flex: none;
  }
  .ech-ville.est-gauche { right: calc(100% + 0px); flex-direction: row-reverse; text-align: right; }
  .ech-ville.est-droite { left: 0; }
</style>

<script>
  /* Variante B : le survol d'un groupe allume son anneau. */
  document.addEventListener('astro:page-load', () => {
    const groupes = document.querySelectorAll<HTMLElement>('.cour-groupe');
    const anneaux = document.querySelectorAll<SVGElement>('.cour-anneau');
    if (!groupes.length) return;
    const allume = (i: number | null) => {
      groupes.forEach((g) => g.classList.toggle('est-actif', g.dataset.groupe === String(i)));
      anneaux.forEach((a) => a.classList.toggle('est-actif', a.getAttribute('data-anneau') === String(i)));
    };
    groupes.forEach((g) => {
      g.addEventListener('mouseenter', () => allume(Number(g.dataset.groupe)));
      g.addEventListener('mouseleave', () => allume(null));
    });
  });
</script>
