---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const canonical = 'https://caelestis.fr/creation-site-internet-auvergne-rhone-alpes';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet en Auvergne-Rhône-Alpes',
  serviceType: 'Création de site internet et référencement naturel',
  description: "Création de sites internet sur mesure et référencement naturel pour les producteurs, artisans, créateurs et associations d'Auvergne-Rhône-Alpes. Agence web indépendante basée dans la Drôme.",
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://caelestis.fr/#business',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
    address: { '@type': 'PostalAddress', addressLocality: 'Crest', addressRegion: 'Drôme', postalCode: '26400', addressCountry: 'FR' },
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'AdministrativeArea', name: 'Drôme' },
    { '@type': 'AdministrativeArea', name: 'Ardèche' },
    { '@type': 'AdministrativeArea', name: 'Isère' },
    { '@type': 'AdministrativeArea', name: 'Rhône' },
    { '@type': 'AdministrativeArea', name: 'Loire' },
    { '@type': 'AdministrativeArea', name: 'Puy-de-Dôme' },
  ],
};

/* Page d'atterrissage régionale : les questions qui s'y posent sont celles de
   la distance. Un artisan de Haute-Savoie veut savoir s'il sera traité comme
   un client de la Drôme, et si travailler à distance change quelque chose. */
const faq = [
  {
    q: "Faut-il être en Auvergne-Rhône-Alpes pour travailler avec vous ?",
    a: "Non. Nous sommes installés à Crest, dans la Drôme, et nous créons des sites pour toute la France. La région est simplement celle que nous connaissons le mieux, et celle où nous nous déplaçons le plus volontiers.",
  },
  {
    q: "Est-ce que vous vous déplacez ?",
    a: "Dans la Drôme et l'Ardèche, oui, avec plaisir. Au-delà, tout se fait par téléphone et par visio, et cela fonctionne très bien : la plupart des projets se déroulent ainsi de bout en bout, sans jamais nuire au résultat.",
  },
  {
    q: "Un site créé à distance est-il aussi bon qu'un site fait sur place ?",
    a: "Le résultat est identique. Ce qui compte est le temps passé à comprendre votre métier, pas les kilomètres parcourus. Un premier appel de trente minutes, une maquette que vous validez, des échanges réguliers : la distance ne change rien à cette méthode.",
  },
  {
    q: "Connaissez-vous mon secteur d'activité ?",
    a: "Nous travaillons surtout avec des artisans, des producteurs, des praticiens du bien-être et des métiers liés à la nature. Si votre activité sort de ce cadre, nous vous le disons dès le premier échange plutôt que d'accepter un projet que nous servirions mal.",
  },
  {
    q: "Le référencement local fonctionne-t-il si vous êtes loin de chez moi ?",
    a: "Oui, car il dépend de votre adresse à vous, pas de la nôtre. Ce sont votre fiche Google, votre ville et vos contenus qui déterminent votre position dans les recherches locales, et tout cela se travaille à distance.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Création de site internet en Auvergne-Rhône-Alpes', item: canonical },
  ],
};

// Départements de la région (mention naturelle, pas de pages dédiées)

/* Les villes du schéma du territoire. Repère SVG de 420 par 420, Crest au
   centre (210, 210), 62 px pour une heure de route, angle réel depuis Crest :
   x = 210 + r·sin(angle), y = 210 − r·cos(angle). Les durées sont relevées par
   la route et arrondies au quart d'heure. Le champ « pos » oriente l'étiquette
   autour de son point (n, s, e, o) pour éviter les chevauchements ; ajouter une
   ville demande de recalculer sa position et de vérifier qu'aucune étiquette
   n'en recouvre une autre à 380 px de large, la plus étroite des trois. */
const VILLES = [
  { nom: 'Valence', duree: '30 min', x: 190, y: 186, pos: 'o' },
  { nom: 'Montélimar', duree: '35 min', x: 210, y: 247, pos: 's' },
  { nom: 'Privas', duree: '50 min', x: 157, y: 212, pos: 'o' },
  { nom: 'Grenoble', duree: '1 h 20', x: 264, y: 146, pos: 'e' },
  { nom: 'Saint-Étienne', duree: '1 h 45', x: 133, y: 133, pos: 'o' },
  { nom: 'Lyon', duree: '1 h 45', x: 191, y: 103, pos: 'n' },
  // Étiquette au nord et non à l'est : Chambéry et Annecy partagent presque le
  // même azimut depuis Crest (25 et 32 degrés), leurs deux étiquettes posées à
  // droite se recouvraient. Les points, eux, restent à leur place exacte.
  { nom: 'Chambéry', duree: '2 h', x: 262, y: 98, pos: 'n' },
  { nom: 'Annecy', duree: '2 h 30', x: 292, y: 79, pos: 'e' },
  { nom: 'Clermont-Ferrand', duree: '3 h', x: 95, y: 63, pos: 'n' },
];

const departements = [
  'Drôme', 'Ardèche', 'Isère', 'Rhône', 'Loire', 'Savoie',
  'Haute-Savoie', 'Ain', 'Puy-de-Dôme', 'Cantal', 'Haute-Loire', 'Allier',
];
---

<BaseLayout
  title="Création de site internet en Auvergne-Rhône-Alpes, Caelestis"
  description="Votre site créé depuis la Drôme, pour toute la région : Valence, Lyon, Grenoble, Annecy. Devis gratuit sous 48h, tarifs affichés dès 1 000 €."
  canonical={canonical}
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- ── Hero ── -->
  <section class="pt-20 pb-16 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-24 w-[420px] h-[420px]"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <div class="inline-flex items-center gap-2 mb-6" data-reveal>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Auvergne-Rhône-Alpes</p>
      </div>
      <h1
        class="font-display font-light text-brun leading-[1.08] tracking-tight max-w-3xl mx-auto"
        style="font-size: clamp(2rem, 5vw, 3.8rem);"
        data-reveal data-delay="1"
      >
        Création de site internet<br class="hidden sm:block"> en <span class="text-sauge">Auvergne-Rhône-Alpes</span>
      </h1>
      <p class="font-body text-lg text-brun-mid mt-8 max-w-2xl leading-relaxed mx-auto" data-reveal data-delay="2">
        Basés dans la Drôme, nous créons des sites soignés et bien référencés pour les producteurs, artisans, créateurs et associations engagées de toute la région. Du Vercors aux volcans d'Auvergne, votre savoir-faire mérite d'être trouvé.
      </p>
      <div class="cta-pair mt-9 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4" data-reveal data-delay="2">
        <Button href="/contact#devis" variant="primary">Demander un devis</Button>
        <Button href="/outils/simulateur" variant="outline">Estimer mon projet</Button>
      </div>
    </div>
  </section>

  <!-- ── Le territoire, à l'échelle du temps de route ──
       Posé le 07/08/2026. La section énumérait douze départements et huit villes
       en deux paragraphes centrés, sans rien montrer, et la section suivante
       traitait à part l'objection de la distance. Le schéma répond aux deux :
       Crest au centre, les villes placées dans leur direction réelle et à leur
       distance de route, trois anneaux d'une heure. Le lecteur voit d'un coup
       que la moitié de la région est à moins de deux heures.
       Ce n'est pas une carte géographique et cela ne prétend pas l'être : les
       contours des départements ne sont pas tracés, seules comptent la direction
       et la durée, qui sont vraies. Durées relevées par la route, arrondies au
       quart d'heure. Les mettre à jour si une ville est ajoutée. -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20" aria-labelledby="territoire-title">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Votre territoire</p>
        <h2 id="territoire-title" class="font-display font-light text-brun leading-[1.15] mb-6" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Douze départements, un seul interlocuteur.
        </h2>
        <p class="font-body text-base text-brun-mid leading-relaxed max-w-2xl mx-auto">
          Nous sommes à Crest, dans la Drôme. Tout se fait à distance quand il le
          faut, un premier échange en visio, des points réguliers, un site livré
          sans que vous ayez à vous déplacer. Et si vous êtes à moins de deux
          heures, on peut se rencontrer.
        </p>
      </div>

      <div class="terr" data-reveal data-delay="1">

        <!-- Le schéma. Décoratif : les mêmes villes et les mêmes durées sont
             listées juste en dessous, en toutes lettres. -->
        <div class="terr-schema" aria-hidden="true">
          <svg viewBox="0 0 420 420" fill="none">
            {[1, 2, 3].map((h) => (
              <circle cx="210" cy="210" r={String(h * 62)} class="terr-anneau" />
            ))}
            {VILLES.map((v) => (
              <line x1="210" y1="210" x2={String(v.x)} y2={String(v.y)} class="terr-rayon" />
            ))}
            <text x="210" y="152" class="terr-legende" text-anchor="middle">1 h</text>
            <text x="210" y="90" class="terr-legende" text-anchor="middle">2 h</text>
            <text x="210" y="28" class="terr-legende" text-anchor="middle">3 h</text>
          </svg>

          <span class="terr-centre font-body">
            <span class="terr-point" aria-hidden="true"></span>
            Crest
          </span>

          {VILLES.map((v) => (
            <span class={`terr-ville font-body est-${v.pos}`} style={`left:${(v.x / 420) * 100}%; top:${(v.y / 420) * 100}%`}>
              {v.nom}
            </span>
          ))}
        </div>

        <!-- Les villes en clair : c'est ce que lisent les lecteurs d'écran et ce
             qu'indexe Google, le schéma n'est qu'une mise en forme. -->
        <div class="terr-texte">
          <p class="terr-tete font-body">Depuis Crest, par la route</p>
          <ul class="terr-liste font-body" role="list">
            {VILLES.map((v) => (
              <li><span>{v.nom}</span><b>{v.duree}</b></li>
            ))}
          </ul>
          <p class="terr-note font-body">
            Les {departements.length} départements de la région sont couverts :
            {departements.slice(0, -1).join(', ')} et {departements[departements.length - 1]}.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Pour qui ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 bg-brun text-cream section-dark-depth">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Pour qui</p>
        <h2 class="font-display font-light leading-[1.2]" style="font-size: clamp(1.6rem, 2.8vw, 2.3rem); color: rgba(252, 251, 248,0.92);">
          Les métiers de passion de la région.
        </h2>
      </div>
      <p class="font-body text-base leading-relaxed text-center max-w-2xl mx-auto" style="color: rgba(252, 251, 248,0.80)" data-reveal data-delay="1">
        Nous travaillons avec les métiers de la nature, du terroir et de la main. Vous cultivez, vous élevez, vous fabriquez, vous accueillez : artisans, producteurs, créateurs et indépendants, dès lors que votre métier se voit, se goûte ou se touche. Maraîchers et apiculteurs, boulangers et brasseurs, ébénistes et charpentiers, paysagistes et pépiniéristes, gîtes et écuries, praticiens du bien-être et associations environnementales. Des métiers de passion, souvent peu visibles en ligne, qui méritent un site à la hauteur de leur savoir-faire.
      </p>
    </div>
  </section>

  <!-- ── Être trouvé près de chez vous ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark section-ambient">
    <div class="max-w-4xl mx-auto" data-reveal>
      <div class="text-center mb-10">
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Référencement local</p>
        <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Être trouvé près de chez vous.
        </h2>
      </div>
      <p class="font-body text-base text-brun-mid leading-relaxed text-center max-w-2xl mx-auto" data-reveal data-delay="1">
        Un beau site ne sert à rien si personne ne le trouve. Nous optimisons chaque site pour le référencement naturel et local : structure technique saine, contenus pensés pour vos mots-clés, et signaux géographiques qui aident vos clients de la région à tomber sur vous quand ils cherchent votre métier sur Google.
      </p>
    </div>
  </section>

  <!-- ── FAQ : les questions de la distance ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="faq-aura">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Questions fréquentes</p>
        <h2 id="faq-aura" class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Ce qu'on nous demande souvent.
        </h2>
      </div>

      <div class="seo-faq" data-reveal data-delay="1">
        {faq.map((f) => (
          <details class="seo-faq-item">
            <summary class="seo-faq-q">
              <span>{f.q}</span>
              <span class="seo-faq-marque" aria-hidden="true"></span>
            </summary>
            <p class="seo-faq-a">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="font-body text-sm text-brun-mid text-center mt-10" data-reveal data-delay="1">
        Votre question n'y est pas ? <a href="/contact" class="text-sauge underline underline-offset-2 hover:text-brun transition-colors">Écrivez-nous</a>, réponse sous 48h.
      </p>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="relative py-16 md:py-20 px-6 md:px-10 lg:px-20 overflow-hidden section-ambient border-t border-cream-dark" data-reveal>
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-12 right-1/4 w-64 h-64"></div>
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute -bottom-8 left-1/3 w-56 h-56"></div>

    <div class="max-w-2xl mx-auto text-center relative">
      <h2 class="font-display text-3xl md:text-4xl font-light text-brun mb-6 leading-[1.1]">
        Prêt à donner vie à<br><span class="text-sauge">votre projet&nbsp;?</span>
      </h2>
      <div class="cta-pair flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <Button href="/contact#devis" variant="primary">Demander un devis</Button>
        <Button href="/outils/simulateur" variant="outline">Estimer mon projet</Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ═══ Le territoire, à l'échelle du temps de route ═══
     Un schéma radial, pas une carte : Crest au centre, chaque ville dans sa
     direction réelle et à sa distance de route, un anneau par heure. Les
     étiquettes sont posées en pourcentage du carré, donc elles suivent le
     schéma à toutes les tailles. */
  .terr { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .terr { grid-template-columns: 1fr 20rem; gap: 56px; }
  }

  .terr-schema {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 1;
  }
  .terr-schema svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  .terr-anneau { stroke: var(--color-cream-dark); stroke-width: 1; }
  .terr-rayon { stroke: var(--color-sauge); stroke-width: 0.8; opacity: 0.42; }
  .terr-legende {
    font-family: var(--font-body);
    font-size: 9px;
    letter-spacing: 0.12em;
    fill: var(--color-brun-mid);
    opacity: 0.6;
  }

  .terr-centre {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, 6px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-brun);
    white-space: nowrap;
  }
  .terr-point {
    position: absolute;
    top: -10px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-brun);
  }

  .terr-ville {
    position: absolute;
    font-size: 0.7rem;
    color: var(--color-brun-mid);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }
  /* Le point de la ville, et l'étiquette poussée vers l'extérieur du cercle. */
  .terr-ville::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 50%;
    background: var(--color-sauge-text);
  }
  .terr-ville.est-n { transform: translate(-50%, -160%); }
  .terr-ville.est-s { transform: translate(-50%, 60%); }
  .terr-ville.est-e { transform: translate(14px, -50%); }
  .terr-ville.est-o { transform: translate(calc(-100% - 14px), -50%); }
  .terr-ville.est-n::before { top: 160%; }
  .terr-ville.est-s::before { top: -60%; }
  .terr-ville.est-e::before { left: -14px; }
  .terr-ville.est-o::before { left: calc(100% + 14px); }

  .terr-tete {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: 14px;
  }
  .terr-liste { list-style: none; margin: 0; padding: 0; }
  .terr-liste li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-cream-dark);
    font-size: 0.9rem;
    color: var(--color-brun-mid);
  }
  .terr-liste li:last-child { border-bottom: 0; }
  .terr-liste b { color: var(--color-brun); font-weight: 500; white-space: nowrap; }
  .terr-note {
    margin-top: 18px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-brun-mid);
    opacity: 0.85;
  }
</style>


<style>
  .seo-faq { border-top: 1px solid var(--color-cream-dark); }
  .seo-faq-item { border-bottom: 1px solid var(--color-cream-dark); }
  .seo-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--color-brun);
    transition: color 0.2s ease;
  }
  .seo-faq-q::-webkit-details-marker { display: none; }
  .seo-faq-q:hover { color: var(--color-sauge-text); }
  .seo-faq-marque {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .seo-faq-marque::before,
  .seo-faq-marque::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-sauge-text);
    transition: transform 0.3s ease;
  }
  .seo-faq-marque::before { width: 14px; height: 1.5px; }
  .seo-faq-marque::after  { width: 1.5px; height: 14px; }
  .seo-faq-item[open] .seo-faq-marque::after { transform: rotate(90deg); }
  .seo-faq-a {
    padding: 0 4px 20px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    max-width: 60ch;
  }
  .seo-faq-q:focus-visible {
    outline: 2px solid var(--color-sauge-text);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
