---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { SUR_CARTE, HORS_CARTE, duree, placerEtiquettes } from '../data/zones';

const canonical = 'https://caelestis.fr/creation-site-internet-auvergne-rhone-alpes';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet en Auvergne-Rhône-Alpes',
  serviceType: 'Création de site internet et référencement naturel',
  description: "Création de sites internet sur mesure et référencement naturel pour les producteurs, artisans, créateurs et associations d'Auvergne-Rhône-Alpes. Agence web indépendante basée dans la Drôme.",
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://caelestis.fr/#business',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
    address: { '@type': 'PostalAddress', addressRegion: 'Drôme', addressCountry: 'FR' },
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'AdministrativeArea', name: 'Drôme' },
    { '@type': 'AdministrativeArea', name: 'Ardèche' },
    { '@type': 'AdministrativeArea', name: 'Isère' },
    { '@type': 'AdministrativeArea', name: 'Rhône' },
    { '@type': 'AdministrativeArea', name: 'Loire' },
    { '@type': 'AdministrativeArea', name: 'Puy-de-Dôme' },
  ],
};

/* Page d'atterrissage régionale : les questions qui s'y posent sont celles de
   la distance. Un artisan de Haute-Savoie veut savoir s'il sera traité comme
   un client de la Drôme, et si travailler à distance change quelque chose. */
const faq = [
  {
    q: "Faut-il être en Auvergne-Rhône-Alpes pour travailler avec vous ?",
    a: "Nous sommes installés dans la Drôme, et nous créons des sites pour toute la France. La région est simplement celle que nous connaissons le mieux, et celle où nous nous déplaçons le plus volontiers.",
  },
  {
    q: "Est-ce que vous vous déplacez ?",
    a: "Dans la Drôme et l'Ardèche, oui, avec plaisir. Au-delà, tout se fait par téléphone et par visio, et cela fonctionne très bien : la plupart des projets se déroulent ainsi de bout en bout, avec le même résultat.",
  },
  {
    q: "Un site créé à distance est-il aussi bon qu'un site fait sur place ?",
    a: "Le résultat est identique. Ce qui compte est le temps passé à comprendre votre métier, bien avant les kilomètres parcourus. Un premier appel de trente minutes, une maquette que vous validez, des échanges réguliers : cette méthode tient à toute distance.",
  },
  {
    q: "Connaissez-vous mon secteur d'activité ?",
    a: "Nous travaillons surtout avec des artisans, des producteurs, des praticiens du bien-être et des métiers liés à la nature, qu'ils exercent en indépendant, en TPE ou en petite PME. Si votre activité sort de ce cadre, nous vous le disons dès le premier échange plutôt que d'accepter un projet que nous servirions mal.",
  },
  {
    q: "Le référencement local fonctionne-t-il si vous êtes loin de chez moi ?",
    a: "Oui, car il dépend de votre adresse à vous. Ce sont votre fiche Google, votre ville et vos contenus qui déterminent votre position dans les recherches locales, et tout cela se travaille à distance.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Création de site internet en Auvergne-Rhône-Alpes', item: canonical },
  ],
};

// Départements de la région (mention naturelle, pas de pages dédiées)

/* Le schéma du périmètre lit src/data/zones.ts, seule source des villes, des
   temps de route et des azimuts. Ne jamais recopier une durée ici. */
const PX_HEURE = 56;

/* Graduations « 1 h » et « 2 h » : posées vers l'est-sud-est (azimut 120°),
   dans le grand secteur vide entre Die et Nyons, et non plus au nord où
   s'accumulent Lyon, Saint-Étienne et Romans. Chaque libellé est posé 11 px à
   l'extérieur de son anneau, le long de ce rayon, juste au-delà du tracé. */
const GRAD_AZ = (120 * Math.PI) / 180;
const grad = (h: number) => ({
  x: Math.round((210 + (h * PX_HEURE + 11) * Math.sin(GRAD_AZ)) * 10) / 10,
  y: Math.round((210 - (h * PX_HEURE + 11) * Math.cos(GRAD_AZ)) * 10) / 10,
});
const grad1 = grad(1);
const grad2 = grad(2);

/* Les graduations deviennent des obstacles du placement : aucune étiquette de
   ville ne doit venir se coller au « 1 h » ni au « 2 h ». */
const surCarte = placerEtiquettes(SUR_CARTE, 210, PX_HEURE, [
  { x: grad1.x, y: grad1.y, l: 22 },
  { x: grad2.x, y: grad2.y, l: 22 },
]);


/* Les quatre gestes de la niche, et les metiers qu ils recouvrent. Ils
   reprennent les verbes de l accroche « vous cultivez, vous elevez, vous
   fabriquez, vous accueillez », deja employes sur l accueil : c est le meme
   ciblage, dit deux fois de la meme facon, ce qui est voulu. */
const GESTES = [
  { verbe: "Vous cultivez",  metiers: ["Maraîchers", "Pépiniéristes", "Paysagistes", "Vignerons"] },
  { verbe: "Vous élevez",    metiers: ["Apiculteurs", "Écuries", "Éleveurs"] },
  { verbe: "Vous fabriquez", metiers: ["Boulangers", "Brasseurs", "Ébénistes", "Charpentiers", "Céramistes"] },
  { verbe: "Vous accueillez", metiers: ["Gîtes", "Praticiens du bien-être", "Associations"] },
];

const departements = [
  'Drôme', 'Ardèche', 'Isère', 'Rhône', 'Loire', 'Savoie',
  'Haute-Savoie', 'Ain', 'Puy-de-Dôme', 'Cantal', 'Haute-Loire', 'Allier',
];
---

<BaseLayout
  title="Création de site internet en Auvergne-Rhône-Alpes, Caelestis"
  description="Votre site créé depuis la Drôme, pour toute la région : Valence, Lyon, Grenoble, Avignon. Devis gratuit sous 48h, tarifs affichés dès 1 000 €."
  canonical={canonical}
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- ── Hero ── -->
  <section class="pt-20 pb-16 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-24 w-[420px] h-[420px]"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <div class="inline-flex items-center gap-2 mb-6" data-reveal>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Auvergne-Rhône-Alpes</p>
      </div>
      <h1
        class="font-display font-light text-brun leading-[1.08] tracking-tight max-w-3xl mx-auto"
        style="font-size: clamp(2rem, 5vw, 3.8rem);"
        data-reveal data-delay="1"
      >
        Création de site internet<br class="hidden sm:block"> en <span class="text-sauge">Auvergne-Rhône-Alpes</span>
      </h1>
      <p class="font-body text-lg text-brun-mid mt-8 max-w-2xl leading-relaxed mx-auto" data-reveal data-delay="2">
        Basés dans la Drôme, nous créons des sites soignés et bien référencés pour les producteurs, artisans, créateurs et associations engagées de toute la région. Du Vercors aux volcans d'Auvergne, on connaît le terrain sur lequel vous travaillez.
      </p>
      <div class="cta-pair mt-9 flex items-center justify-center" data-reveal data-delay="2">
        <Button href="/contact#devis" variant="primary">Demander un devis</Button>
      </div>
    </div>
  </section>

  <!-- ── Notre périmètre ──
       Variante A retenue par Célestin le 07/08/2026 parmi les trois rendus
       comparés sur la page de travail : le radial, direction et distance
       réelles, un anneau par heure. Les deux autres pistes, les couronnes de
       proximité et l'échelle des temps de route, portaient les dix-neuf zones
       mais perdaient l'orientation, qui est justement ce que le schéma apporte.
       Le tri par « villes repères » est ce qui le rend lisible : douze
       étiquettes au maximum, au-delà elles se recouvrent.
       Deux périmètres à ne pas confondre, et c'est tout l'objet du texte :
       le déplacement s'arrête à deux heures de route, le service ne s'arrête
       nulle part puisqu'il se fait à distance. -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20" aria-labelledby="perimetre-title">
    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Votre territoire</p>
        <h2 id="perimetre-title" class="font-display font-light text-brun leading-[1.15] mb-6" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Notre périmètre.
        </h2>
        <p class="font-body text-base text-brun-mid leading-relaxed max-w-2xl mx-auto">
          Nous sommes à Crest, dans la Drôme. Jusqu'à deux heures de route, nous
          venons vous voir. Au-delà, et partout en France, le projet se mène à
          distance : un premier échange en visio, des points réguliers, un site livré depuis chez vous.
        </p>
      </div>

      <div class="terr" data-reveal data-delay="1">

        <!-- Le schéma. Décoratif : les villes et les durées sont reprises en
             clair dans la liste, c'est elle que lisent les lecteurs d'écran et
             c'est elle qu'indexe Google. -->
        <div class="terr-schema" aria-hidden="true">
          <svg viewBox="0 0 420 420" fill="none">
            {[1, 2].map((h) => (
              <circle cx="210" cy="210" r={String(h * PX_HEURE)} class="terr-anneau" />
            ))}
            {surCarte.map((v) => (
              <line x1="210" y1="210" x2={String(v.x)} y2={String(v.y)} class="terr-rayon" />
            ))}
            <text x={String(grad1.x)} y={String(grad1.y)} class="terr-legende" text-anchor="middle">1 h</text>
            <text x={String(grad2.x)} y={String(grad2.y)} class="terr-legende" text-anchor="middle">2 h</text>
          </svg>

          <span class="terr-centre font-body">
            <span class="terr-point" aria-hidden="true"></span>
            Crest
          </span>

          {surCarte.map((v) => (
            <span class="terr-pt" style={`left:${(v.x / 420) * 100}%; top:${(v.y / 420) * 100}%`}></span>
          ))}

          {surCarte.map((v) => (
            <span class="terr-ville font-body" style={`left:${(v.ex / 420) * 100}%; top:${(v.ey / 420) * 100}%`}>
              {v.nom}
            </span>
          ))}
        </div>

        <div class="terr-texte">
          <p class="terr-tete font-body">Depuis Crest, par la route</p>
          <ul class="terr-liste font-body" role="list">
            {surCarte.map((v) => (
              <li><span>{v.nom}</span><b>{duree(v.heures)}</b></li>
            ))}
          </ul>
          <p class="terr-note font-body">
            Également dans le périmètre : {HORS_CARTE.map((z) => z.nom).join(', ')}.
          </p>
        </div>

      </div>

      <!-- Le rappel des départements. Il annonçait « les douze départements de
           la région sont couverts », ce que le schéma contredisait : les villes
           du périmètre tiennent dans six départements. La phrase distingue
           désormais ce qui est vrai du déplacement et ce qui est vrai du
           service, sans rien retirer à la couverture régionale. -->
      <p class="font-body text-sm text-brun-mid leading-relaxed text-center max-w-3xl mx-auto mt-14" data-reveal data-delay="2">
        Ce périmètre de déplacement traverse la Drôme, l'Ardèche, l'Isère, la Loire,
        le Rhône et le Vaucluse. La création de site et le référencement, eux, se mènent à toute distance : nous travaillons pour les
        {departements.length} départements de la région, et pour le reste de la
        France, sans que cela change ni la méthode ni le résultat.
      </p>

    </div>
  </section>

  <!-- ── Pour qui ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 bg-brun text-cream section-dark-depth">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Pour qui</p>
        <h2 class="font-display font-light leading-[1.2]" style="font-size: clamp(1.6rem, 2.8vw, 2.3rem); color: rgba(252, 251, 248,0.92);">
          Les métiers de passion de la région.
        </h2>
      </div>
      <!-- Les quatre gestes. Posés le 07/08/2026 : la section était un unique
           paragraphe centré de 89 mots où quatorze métiers se noyaient au
           milieu d'une phrase. Ce sont pourtant eux que cherche le visiteur,
           qui veut se reconnaître. Les quatre verbes de l'accroche deviennent
           la structure, chaque métier se lit d'un coup, et l'ensemble reste une
           énumération ouverte, jamais une liste fermée.
           À la différence de l'accueil, où les métiers nommés ont été remplacés
           par des statuts larges le 01/08 pour n'exclure personne, cette page
           est celle de la niche revendiquée : ici, nommer sert. -->
      <ul class="gestes" role="list">
        {GESTES.map((g) => (
          <li class="geste">
            <p class="geste-verbe font-display">{g.verbe}</p>
            <ul class="geste-metiers font-body" role="list">
              {g.metiers.map((m) => <li>{m}</li>)}
            </ul>
          </li>
        ))}
      </ul>
      <p class="font-body text-sm leading-relaxed text-center max-w-2xl mx-auto mt-12" style="color: rgba(252, 251, 248,0.75)" data-reveal data-delay="2">
        La liste reste ouverte : dès lors que votre métier se voit, se goûte
        ou se touche, il a de quoi remplir un site. Ce sont souvent les activités les plus discrètes en ligne qui gagnent le plus à y être bien montrées.
      </p>
    </div>
  </section>

  <!-- ── Être trouvé près de chez vous ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark section-ambient">
    <div class="max-w-4xl mx-auto" data-reveal>
      <div class="text-center mb-10">
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Référencement local</p>
        <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Être trouvé près de chez vous.
        </h2>
      </div>
      <p class="font-body text-base text-brun-mid leading-relaxed text-center max-w-2xl mx-auto" data-reveal data-delay="1">
        Quand quelqu'un tape votre métier suivi du nom de sa commune, il faut que ce soit vous qui sortiez. Nous optimisons chaque site pour le référencement naturel et local : structure technique saine, contenus pensés pour vos mots-clés, et signaux géographiques qui aident vos clients de la région à tomber sur vous quand ils cherchent votre métier sur Google.
      </p>
    </div>
  </section>

  <!-- ── FAQ : les questions de la distance ── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="faq-aura">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Questions fréquentes</p>
        <h2 id="faq-aura" class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Ce qu'on nous demande souvent.
        </h2>
      </div>

      <div class="seo-faq" data-reveal data-delay="1">
        {faq.map((f) => (
          <details class="seo-faq-item">
            <summary class="seo-faq-q">
              <span>{f.q}</span>
              <span class="seo-faq-marque" aria-hidden="true"></span>
            </summary>
            <p class="seo-faq-a">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="font-body text-sm text-brun-mid text-center mt-10" data-reveal data-delay="1">
        Votre question porte sur autre chose ? <a href="/contact" class="text-sauge underline underline-offset-2 hover:text-brun transition-colors">Écrivez-nous</a>, réponse sous 48h.
      </p>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="relative py-16 md:py-20 px-6 md:px-10 lg:px-20 overflow-hidden section-ambient border-t border-cream-dark" data-reveal>
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-12 right-1/4 w-64 h-64"></div>
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute -bottom-8 left-1/3 w-56 h-56"></div>

    <div class="max-w-2xl mx-auto text-center relative">
      <h2 class="font-display text-3xl md:text-4xl font-light text-brun mb-6 leading-[1.1]">
        On regarde votre projet<br><span class="text-sauge">ensemble&nbsp;?</span>
      </h2>
      <div class="cta-pair flex items-center justify-center">
        <Button href="/contact#devis" variant="primary">Demander un devis</Button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ═══ Le territoire, à l'échelle du temps de route ═══
     Un schéma radial, pas une carte : Crest au centre, chaque ville dans sa
     direction réelle et à sa distance de route, un anneau par heure. Les
     étiquettes sont posées en pourcentage du carré, donc elles suivent le
     schéma à toutes les tailles. */
  .terr { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .terr { grid-template-columns: 1fr 18rem; gap: 56px; }
  }

  .terr-schema {
    position: relative;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    aspect-ratio: 1;
  }
  /* Schéma décoratif masqué sur téléphone : trop petit pour coller onze noms
     sans qu'ils se chevauchent. La liste « Depuis Crest, par la route » en
     dessous porte la même information (villes + durées). */
  @media (max-width: 560px) {
    .terr-schema { display: none; }
  }
  .terr-schema svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  .terr-anneau { stroke: var(--color-cream-dark); stroke-width: 1; }
  .terr-rayon { fill: none; stroke: var(--color-sauge); stroke-width: 0.8; opacity: 0.5; }
  .terr-legende {
    font-family: var(--font-body);
    font-size: 9px;
    letter-spacing: 0.12em;
    fill: var(--color-brun-mid);
    opacity: 0.6;
  }

  .terr-centre {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, 6px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-brun);
    white-space: nowrap;
  }
  .terr-point {
    position: absolute;
    top: -10px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-brun);
  }

  /* L'étiquette est posée à la position calculée au build par
     placerEtiquettes(), qui l'écarte du centre jusqu'à ce qu'elle ne croise
     plus aucune voisine. Le point de la ville, lui, est un élément à part,
     resté à sa coordonnée exacte : le rayon tracé en SVG relie les deux. */
  .terr-ville {
    position: absolute;
    font-size: 0.66rem;
    color: var(--color-brun);
    white-space: nowrap;
    transform: translate(-50%, -50%);
    background: var(--color-cream);
    padding: 1px 4px;
    border-radius: 3px;
  }
  .terr-pt {
    position: absolute;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--color-sauge-text);
    box-shadow: 0 0 0 3px var(--color-cream);
  }
  /* Le point de la ville, posé sur le rayon qui va du centre jusqu'à
     l'étiquette : le trait relie donc désormais Crest, le point et son nom d'un
     seul geste, pour qu'aucune étiquette ne flotte détachée de son point. Le
     halo crème détache le point des rayons qu'il croise. */

  .terr-tete {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: 14px;
  }
  .terr-liste { list-style: none; margin: 0; padding: 0; }
  .terr-liste li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-cream-dark);
    font-size: 0.9rem;
    color: var(--color-brun-mid);
  }
  .terr-liste li:last-child { border-bottom: 0; }
  .terr-liste b { color: var(--color-brun); font-weight: 500; white-space: nowrap; }
  .terr-note {
    margin-top: 18px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-brun-mid);
    opacity: 0.85;
  }

  .seo-faq { border-top: 1px solid var(--color-cream-dark); }
  .seo-faq-item { border-bottom: 1px solid var(--color-cream-dark); }
  .seo-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--color-brun);
    transition: color 0.2s ease;
  }
  .seo-faq-q::-webkit-details-marker { display: none; }
  .seo-faq-q:hover { color: var(--color-sauge-text); }
  .seo-faq-marque {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .seo-faq-marque::before,
  .seo-faq-marque::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-sauge-text);
    transition: transform 0.3s ease;
  }
  .seo-faq-marque::before { width: 14px; height: 1.5px; }
