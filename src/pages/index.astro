<style>
  /* ── Hero plein écran — dvh évite le débordement sous la barre d'URL mobile ── */
  .hero-screen {
    min-height: 100vh;       /* fallback navigateurs anciens */
    min-height: 100dvh;      /* hauteur dynamique réelle (mobile) */
  }
  /* Sans photo, un premier écran pleine hauteur laisse trop d'air autour du
     texte sur grand écran. On le raccourcit pour que la section suivante
     affleure : le vide est réduit et le scroll devient une invitation. */
  @media (min-width: 1024px) {
    .hero-screen { min-height: min(88vh, 820px); }
  }

  /* Le titre n'a plus aucun `whitespace-nowrap` : chaque bloc `.sl` se replie
     librement dès que la largeur manque. La règle qui rétablissait le retour à
     la ligne sous 360px décrivait la version à trois lignes et n'avait plus
     d'effet, elle a été retirée le 01/08/2026 avec le passage à deux lignes. */

  /* Téléphones courts (iPhone SE, iPhone 8 et assimilés, 667px de haut).
     Le titre y tient sur trois lignes et le sous-titre sur quatre : avec les
     marges d'origine, le filet de réassurance tombe 33px sous la ligne de
     flottaison, alors que ce sont ses quatre arguments qui décident le
     visiteur. Le resserrement porte sur les seules marges verticales, rien sur
     le texte, et laisse 27px sous le filet. Borné en largeur ET en hauteur :
     les téléphones hauts et le desktop gardent la respiration d'origine. */
  @media (max-width: 767px) and (max-height: 720px) {
    .hero-eyebrow { margin-bottom: 1rem; }
    .hero-title { margin-bottom: 1.25rem; }
    .hero-sub { margin-bottom: 1.25rem; }
    .trust { margin-top: 1.75rem; padding-top: 1.25rem; }
  }

  /* ── Fil botanique — visible desktop uniquement ── */
  .vine-wrap {
    position: absolute;
    left: clamp(6px, 1.8vw, 22px);
    top: 0;
    bottom: 0;
    width: 50px;
    pointer-events: none;
    z-index: 2;
    display: none;
  }
  #vine-path {
    stroke: #B8C4BB;
    opacity: 0.35;
  }
  @media (min-width: 1024px) {
    .vine-wrap { display: block; }
  }
  .vine-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 50px;
    height: 100%;
  }

  /* ── Scroll indicator ── */
  /* Trait fixe : une pulsation en boucle dans le hero empêche Lighthouse de
     considérer la page comme stabilisée, pour un gain visuel nul. */
  .scroll-line {
    transform-origin: left;
    opacity: 0.35;
  }

  /* ── Planche d'élévations, schémas des formules ──
     Le cadre représente le site produit par la formule : bandes pleines pour
     ce qui est acquis, pointillés pour ce qui se définit avec le client. */
  .plan-frame {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 6px;
    border: 1px solid #B8C4BB;
    border-radius: 4px;
    background: #FCFBF8;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .plan-item:hover .plan-frame,
  .plan-item:focus-visible .plan-frame {
    border-color: #255C41;
    transform: translateY(-3px);
  }
  .plan-item:hover h3 { color: #2E7452; }
  .plan-item h3 { transition: color 0.3s ease; }

  @media (prefers-reduced-motion: reduce) {
    .plan-frame { transition: border-color 0.3s ease; }
    .plan-item:hover .plan-frame,
    .plan-item:focus-visible .plan-frame { transform: none; }
  }

  /* ── Lignes de prestation, alternative éditoriale à la carte ── */
  .offre-ligne { transition: background-color 0.3s ease; }
  .offre-ligne:hover,
  .offre-ligne:focus-visible { background: rgba(227, 239, 232, 0.5); }
  .offre-ligne h3 { transition: color 0.3s ease; }
  .offre-ligne:hover h3 { color: #2E7452; }
  .offre-lien { transition: gap 0.3s ease, color 0.3s ease; }
  .offre-ligne:hover .offre-lien,
  .offre-lien:hover { gap: 0.75rem; color: #255C41; }

  /* ── Carte paragraphe luxe ── */
  .para-card {
    position: relative;
    background: rgba(37, 92, 65, 0.85);
    border-radius: 24px;
    padding: 2rem 1.25rem;
    text-align: center;
    overflow: hidden;
    box-shadow:
      0 40px 90px rgba(42, 61, 24, 0.35),
      0 8px 24px rgba(42, 61, 24, 0.20),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  @media (min-width: 640px) {
    .para-card { padding: 3rem 3.5rem; }
  }
  .para-card p {
    color: rgba(252, 251, 248, 0.90);
    font-size: 1rem;
    line-height: 1.95;
    letter-spacing: 0.012em;
  }

  /* NE PAS réintroduire content-visibility sur cette page. Testé le 27/07/2026 :
     le gain était réel (2 points Lighthouse), mais tant que le contenu reste hors
     écran sa hauteur n'est qu'estimée, la page est donc plus courte qu'en réalité
     et le défilement maximum s'en trouve plafonné. Résultat mesuré : le lien
     « Voir comment nous procédons » s'arrêtait à 2704 px au lieu de 5550, et même
     scrollIntoView() natif échouait. Une ancre cassée coûte plus cher que 2 points. */

  /* ══ Méthode : 3 cartes puis 2 centrées dessous ══ */
  .etapes {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    list-style: none;
    padding: 0;
    text-align: center;
  }
  .etapes li {
    grid-column: span 2;
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    border-radius: 18px;
    padding: clamp(24px, 2.6vw, 32px);
    transition: transform 0.4s cubic-bezier(.16,1,.3,1), box-shadow 0.4s;
  }
  .etapes li:nth-child(4) { grid-column: 2 / 4; }
  .etapes li:nth-child(5) { grid-column: 4 / 6; }
  .etapes li:hover { transform: translateY(-4px); box-shadow: 0 4px 10px rgba(18,22,15,.05), 0 22px 52px rgba(18,22,15,.10); }
  .et-n {
    width: 42px; height: 42px; margin: 0 auto 16px;
    border-radius: 13px; background: var(--color-brun); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
  }
  .et-duree {
    display: inline-block; margin-bottom: 12px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-brun); background: #E3EFE8;
    padding: 5px 12px; border-radius: 999px;
  }
  .etapes h3 { font-size: 1.0625rem; margin-bottom: 9px; }
  .etapes p { font-size: 0.9375rem; color: var(--color-brun-mid); line-height: 1.6; }
  .et-vous {
    margin-top: 14px; padding-top: 13px;
    border-top: 1px solid var(--color-cream-dark);
    font-size: 0.875rem; color: var(--color-brun-mid);
  }
  .et-vous b {
    display: block; color: var(--color-encre); font-weight: 700;
    font-size: 0.6875rem; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 4px;
  }
  @media (max-width: 940px) {
    .etapes { grid-template-columns: 1fr; }
    .etapes li, .etapes li:nth-child(4), .etapes li:nth-child(5) { grid-column: auto; }
  }

  /* ══ Comparateur avant / après ══ */
  .ba { max-width: 920px; margin-inline: auto; }
  .ba-legend { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 0 4px; }
  .ba-legend span {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 999px;
    background: #fff; border: 1px solid var(--color-cream-dark); color: var(--color-brun-mid);
  }
  .ba-legend span.r { background: var(--color-brun); border-color: var(--color-brun); color: #fff; }

  .ba-stage {
    position: relative; aspect-ratio: 1280 / 1080;
    border-radius: 16px; overflow: hidden; background: #fff;
    border: 1px solid var(--color-cream-dark);
    box-shadow: 0 1px 2px rgba(18,22,15,.03), 0 10px 32px rgba(18,22,15,.06);
    touch-action: pan-y;
  }
  .ba-shot { position: absolute; inset: 0; text-align: left; user-select: none; overflow: hidden; }
  .ba-shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .ba-new { clip-path: inset(0 0 0 var(--x, 38%)); }
  .ba-range {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; margin: 0; cursor: ew-resize; z-index: 6;
    -webkit-appearance: none; appearance: none; background: transparent;
  }
  .ba-range:focus-visible { outline: none; }
  .ba-range:focus-visible ~ .ba-handle .ba-knob { box-shadow: 0 0 0 4px #E3EFE8, 0 6px 18px rgba(18,22,15,.22); }
  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--x, 38%);
    width: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(18,22,15,.12);
    z-index: 5; pointer-events: none;
  }
  .ba-knob {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 46px; height: 46px; border-radius: 50%;
    background: var(--color-brun); color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 18px rgba(18,22,15,.22);
  }
  .ba-knob svg { width: 20px; height: 20px; }

  /* Déclaré AVANT la media query : à spécificité égale, c'est la dernière règle
     écrite qui gagne. Placé après, ce `none` annulait la version mobile. */
  .only-mob { display: none; }

  /* Sous 700px le comparateur s'empile : deux pages entières, sans curseur */
  @media (max-width: 700px) {
    .ba-legend, .ba-range, .ba-handle { display: none; }
    .ba-stage { height: auto; aspect-ratio: auto; border: 0; box-shadow: none; background: transparent; display: flex; flex-direction: column; gap: 14px; }
    .ba-shot {
      position: relative; inset: auto; aspect-ratio: 1280 / 1080; border-radius: 14px;
      border: 1px solid var(--color-cream-dark);
      box-shadow: 0 1px 2px rgba(18,22,15,.03), 0 10px 32px rgba(18,22,15,.06);
    }
    .ba-shot img { position: absolute; inset: 0; }
    .ba-new { clip-path: none; }
    .ba-shot::before {
      content: attr(data-label); position: absolute; top: 11px; left: 11px; z-index: 3;
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 999px;
      background: #fff; border: 1px solid var(--color-cream-dark); color: var(--color-brun-mid);
    }
    .ba-new::before { background: var(--color-brun); border-color: var(--color-brun); color: #fff; }
    .only-desk { display: none; }
    /* Sous 700px le comparateur n'est plus côte à côte mais empilé : la consigne
       « à gauche / à droite » devenait fausse, elle est remplacée par sa version
       verticale. */
    .only-mob { display: inline; }
  }

  /* ── Bénéfice au premier scroll : 3 repères, pas un paragraphe ── */
  .benefices {
