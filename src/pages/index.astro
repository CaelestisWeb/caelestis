    top: 0;
    bottom: 0;
    width: 50px;
    pointer-events: none;
    z-index: 2;
    display: none;
  }
  #vine-path {
    stroke: #B8C4BB;
    opacity: 0.35;
  }
  @media (min-width: 1024px) {
    .vine-wrap { display: block; }
  }
  .vine-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 50px;
    height: 100%;
  }

  /* ── Scroll indicator ── */
  /* Trait fixe : une pulsation en boucle dans le hero empêche Lighthouse de
     considérer la page comme stabilisée, pour un gain visuel nul. */
  .scroll-line {
    transform-origin: left;
    opacity: 0.35;
  }

  /* ── Service cards — état actif ── */
  .service-card.active {
    border-color: #B8C4BB;
    background: rgba(184, 196, 187, 0.06);
  }

  /* ── Carte paragraphe luxe ── */
  .para-card {
    position: relative;
    background: rgba(37, 92, 65, 0.85);
    border-radius: 24px;
    padding: 2rem 1.25rem;
    text-align: center;
    overflow: hidden;
    box-shadow:
      0 40px 90px rgba(42, 61, 24, 0.35),
      0 8px 24px rgba(42, 61, 24, 0.20),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  @media (min-width: 640px) {
    .para-card { padding: 3rem 3.5rem; }
  }
  .para-card p {
    color: rgba(252, 251, 248, 0.90);
    font-size: 1rem;
    line-height: 1.95;
    letter-spacing: 0.012em;
  }

  /* NE PAS réintroduire content-visibility sur cette page. Testé le 27/07/2026 :
     le gain était réel (2 points Lighthouse), mais tant que le contenu reste hors
     écran sa hauteur n'est qu'estimée, la page est donc plus courte qu'en réalité
     et le défilement maximum s'en trouve plafonné. Résultat mesuré : le lien
     « Voir comment nous procédons » s'arrêtait à 2704 px au lieu de 5550, et même
     scrollIntoView() natif échouait. Une ancre cassée coûte plus cher que 2 points. */

  /* ══ Méthode : 3 cartes puis 2 centrées dessous ══ */
  .etapes {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    list-style: none;
    padding: 0;
    text-align: center;
  }
  .etapes li {
    grid-column: span 2;
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    border-radius: 18px;
    padding: clamp(24px, 2.6vw, 32px);
    transition: transform 0.4s cubic-bezier(.16,1,.3,1), box-shadow 0.4s;
  }
  .etapes li:nth-child(4) { grid-column: 2 / 4; }
  .etapes li:nth-child(5) { grid-column: 4 / 6; }
  .etapes li:hover { transform: translateY(-4px); box-shadow: 0 4px 10px rgba(18,22,15,.05), 0 22px 52px rgba(18,22,15,.10); }
  .et-n {
    width: 42px; height: 42px; margin: 0 auto 16px;
    border-radius: 13px; background: var(--color-brun); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
  }
  .et-duree {
    display: inline-block; margin-bottom: 12px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-brun); background: #E3EFE8;
    padding: 5px 12px; border-radius: 999px;
  }
  .etapes h3 { font-size: 1.0625rem; margin-bottom: 9px; }
  .etapes p { font-size: 0.9375rem; color: var(--color-brun-mid); line-height: 1.6; }
  .et-vous {
    margin-top: 14px; padding-top: 13px;
    border-top: 1px solid var(--color-cream-dark);
    font-size: 0.875rem; color: var(--color-brun-mid);
  }
  .et-vous b {
    display: block; color: var(--color-encre); font-weight: 700;
    font-size: 0.6875rem; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 4px;
  }
  @media (max-width: 940px) {
    .etapes { grid-template-columns: 1fr; }
    .etapes li, .etapes li:nth-child(4), .etapes li:nth-child(5) { grid-column: auto; }
  }

  /* ══ Comparateur avant / après ══ */
  .ba { max-width: 860px; margin-inline: auto; }
  .ba-legend { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 0 4px; }
  .ba-legend span {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 999px;
    background: #fff; border: 1px solid var(--color-cream-dark); color: var(--color-brun-mid);
  }
  .ba-legend span.r { background: var(--color-brun); border-color: var(--color-brun); color: #fff; }

  .ba-stage {
    position: relative; height: clamp(300px, 44vh, 420px);
    border-radius: 16px; overflow: hidden; background: #fff;
    border: 1px solid var(--color-cream-dark);
    box-shadow: 0 1px 2px rgba(18,22,15,.03), 0 10px 32px rgba(18,22,15,.06);
    touch-action: pan-y;
  }
  .ba-shot { position: absolute; inset: 0; text-align: left; user-select: none; overflow: hidden; }
  .ba-new { clip-path: inset(0 0 0 var(--x, 38%)); }
  .ba-range {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; margin: 0; cursor: ew-resize; z-index: 6;
    -webkit-appearance: none; appearance: none; background: transparent;
  }
  .ba-range:focus-visible { outline: none; }
  .ba-range:focus-visible ~ .ba-handle .ba-knob { box-shadow: 0 0 0 4px #E3EFE8, 0 6px 18px rgba(18,22,15,.22); }
  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--x, 38%);
    width: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(18,22,15,.12);
    z-index: 5; pointer-events: none;
  }
  .ba-knob {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 46px; height: 46px; border-radius: 50%;
    background: var(--color-brun); color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 18px rgba(18,22,15,.22);
  }
  .ba-knob svg { width: 20px; height: 20px; }

  /* Wireframes */
  .mk { height: 100%; padding: clamp(13px, 1.9vw, 20px); display: flex; flex-direction: column; gap: clamp(8px, 1.1vw, 12px); }
  .mk-bar { display: flex; align-items: center; gap: 9px; }
  .mk-bar b { font-size: 12px; letter-spacing: -0.02em; }
  .mk-bar i { display: block; height: 7px; border-radius: 3px; background: currentColor; opacity: 0.22; }
  .mk-bar i:nth-of-type(1) { width: 34px; } .mk-bar i:nth-of-type(2) { width: 26px; } .mk-bar i:nth-of-type(3) { width: 30px; }
  .mk-l { display: block; height: 8px; border-radius: 4px; background: currentColor; opacity: 0.16; }
  .mk-row { display: flex; gap: clamp(8px, 1.1vw, 12px); flex: 1; min-height: 0; }
  .mk-row > div { flex: 1; height: 100%; }
  .mk-cta { display: inline-block; font-size: 11px; font-weight: 700; padding: 7px 15px; }

  /* Avant : dense, terne, sans hiérarchie */
  .mk-old { background: #EFEFEA; color: #3A3D38; font-family: serif; }
  .mk-old .mk-bar { border-bottom: 2px solid #9AA3A0; padding-bottom: 8px; margin-bottom: 2px; }
  .mk-old .mk-bar b { color: #2B4E6E; }
  .mk-old .mk-h { background: #2B4E6E; color: #fff; font-size: 13px; font-weight: 700; padding: 12px 10px; text-align: center; }
  .mk-old .mk-l { height: 6px; opacity: 0.3; }
  .mk-old .mk-box { background: #DEDED8; border: 1px solid #C2C2BA; height: 100%; min-height: 52px; }
  .mk-old .mk-cta { background: #C9CCC6; color: #3A3D38; border: 1px solid #A9ADA6; align-self: flex-start; }
  .mk-old .mk-foot { margin-top: auto; font-size: 9.5px; color: #797E78; }

  /* Après : aéré, hiérarchisé, à la charte */
  .mk-new { background: var(--color-cream); color: var(--color-encre); text-align: center; align-items: center; }
  .mk-new .mk-bar { width: 100%; justify-content: center; }
  .mk-new .mk-bar b { color: var(--color-encre); font-weight: 700; letter-spacing: -0.045em; }
  .mk-new .mk-bar i { opacity: 0.14; }
  .mk-new .mk-h { font-size: clamp(17px, 2.4vw, 25px); font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; margin-top: clamp(10px, 1.6vw, 18px); }
  .mk-new .mk-h em { font-style: normal; color: var(--color-brun); }
  .mk-new .mk-sub { font-size: 11.5px; color: var(--color-brun-mid); max-width: 34ch; margin-inline: auto; }
  .mk-new .mk-row { width: 100%; }
  .mk-new .mk-box { background: #E6E4DC; border-radius: 11px; height: 100%; min-height: 58px; position: relative; overflow: hidden; }
  .mk-new .mk-box::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 12px; height: 7px; border-radius: 4px; background: var(--color-brun); opacity: 0.2; }
  .mk-new .mk-cta { background: var(--color-brun); color: #fff; border-radius: 999px; align-self: center; }
  .mk-new .mk-pill { align-self: center; font-size: 10px; font-weight: 600; color: var(--color-brun); background: #E3EFE8; padding: 5px 11px; border-radius: 999px; }
  .mk-new .mk-foot { margin-top: auto; display: flex; gap: 7px; align-items: center; justify-content: center; font-size: 10px; color: var(--color-brun-mid); }
  .mk-new .mk-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-brun); display: block; }

  /* Sous 700px le comparateur s'empile : deux pages entières, sans curseur */
  @media (max-width: 700px) {
    .ba-legend, .ba-range, .ba-handle { display: none; }
    .ba-stage { height: auto; border: 0; box-shadow: none; background: transparent; display: flex; flex-direction: column; gap: 14px; }
    .ba-shot {
      position: relative; inset: auto; height: 330px; border-radius: 14px;
      border: 1px solid var(--color-cream-dark);
      box-shadow: 0 1px 2px rgba(18,22,15,.03), 0 10px 32px rgba(18,22,15,.06);
    }
    .ba-new { clip-path: none; }
    .ba-shot::before {
      content: attr(data-label); position: absolute; top: 11px; left: 11px; z-index: 3;
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 999px;
      background: #fff; border: 1px solid var(--color-cream-dark); color: var(--color-brun-mid);
    }
    .ba-new::before { background: var(--color-brun); border-color: var(--color-brun); color: #fff; }
    .ba-shot .mk { padding-top: 46px; }
    .ba-shot .mk-foot { flex-shrink: 0; padding-top: 4px; }
    .only-desk { display: none; }
  }

  /* ── Bénéfice au premier scroll : 3 repères, pas un paragraphe ── */
  .benefices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 26px);
    list-style: none;
    padding: 0;
    margin: clamp(38px, 5vh, 58px) auto 0;
    max-width: 980px;
    text-align: center;
  }
  .benefices li {
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    border-radius: 18px;
    padding: clamp(24px, 2.6vw, 32px) clamp(18px, 2vw, 26px);
    transition: transform 0.4s cubic-bezier(.16,1,.3,1), box-shadow 0.4s;
  }
  .benefices li:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 10px rgba(18,22,15,.05), 0 20px 46px rgba(18,22,15,.09);
  }
  .b-i {
    width: 44px; height: 44px; margin: 0 auto 16px;
    border-radius: 14px; background: #E3EFE8; color: var(--color-brun);
    display: flex; align-items: center; justify-content: center;
  }
  .b-i svg { width: 20px; height: 20px; }
  .benefices h3 { font-size: 1.0625rem; margin-bottom: 8px; }
  .benefices p { font-size: 0.9375rem; color: var(--color-brun-mid); line-height: 1.6; }
  @media (max-width: 860px) {
    .benefices { grid-template-columns: 1fr; max-width: 460px; }
  }

  /* ── Réassurance du hero ── */
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    list-style: none;
    padding: 0;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brun-mid);
    line-height: 1.3;
  }
  .trust svg {
    width: 14px;
    height: 14px;
    color: var(--color-brun);
    flex-shrink: 0;
  }

  /* ── Ligne métiers : pastilles statiques centrées, sur toutes les tailles.
     Aucun défilement : le bandeau en boucle est banni de la charte, et une
     animation infinie dans le viewport empêche Lighthouse de considérer la
     page comme stabilisée (Speed Index dégradé). ── */
  .metiers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 880px;
    margin-inline: auto;
    list-style: none;
    padding: 0;
  }
  .metiers li {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brun-mid);
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    padding: 7px 15px;
    border-radius: 999px;
    line-height: 1.2;
  }

  /* ── Galerie bento ── */
  .bento-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 160px 160px;
    gap: 8px;
  }
  /* Mobile : 2×2 simple, toutes les cellules dans l'ordre naturel */
  .bento-jardin  { grid-column: 1; grid-row: 1; }
  .bento-yoga    { grid-column: 2; grid-row: 1; }
  .bento-artisan { grid-column: 1; grid-row: 2; }
  .bento-bougies { grid-column: 2; grid-row: 2; }

  /* Desktop : bento avec yoga portrait pleine hauteur */
  @media (min-width: 768px) {
    .bento-gallery {
      grid-template-columns: 1fr 1fr 1fr;
      grid-template-rows: 210px 180px;
      gap: 10px;
    }
    .bento-jardin  { grid-column: 1 / 3; grid-row: 1; }
    .bento-yoga    { grid-column: 3;     grid-row: 1 / 3; }
    .bento-artisan { grid-column: 1;     grid-row: 2; }
    .bento-bougies { grid-column: 2;     grid-row: 2; }
  }

  .bento-cell {
    border-radius: 6px;
    box-shadow: 0 2px 12px rgba(37, 92, 65, 0.10);
    outline: 1px solid rgba(37, 92, 65, 0.07);
    outline-offset: -1px;
  }

  /* ── FAQ accordéon ── */
  .faq-item.open .faq-answer { max-height: 360px; }
  .faq-item.open .faq-plus-v { transform: scaleY(0); opacity: 0; }
  .faq-item.open .faq-icon   { border-color: #B8C4BB; color: #B8C4BB; }
  .faq-btn:hover .faq-icon   { border-color: #B8C4BB; color: #B8C4BB; }
</style>

<script>
  /* Ré-attaché après chaque navigation View Transitions (cloneNode purge les anciens listeners) */
  function bindServiceCards() {
    document.querySelectorAll<HTMLButtonElement>('.service-card').forEach((card) => {
      const clone = card.cloneNode(true) as HTMLButtonElement;
      card.parentNode?.replaceChild(clone, card);
      clone.addEventListener('click', () => {
        const isActive = clone.classList.contains('active');
        document.querySelectorAll('.service-card').forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-pressed', 'false');
        });
        if (!isActive) {
          clone.classList.add('active');
          clone.setAttribute('aria-pressed', 'true');
        }
      });
    });
  }
  bindServiceCards();
  document.addEventListener('astro:page-load', bindServiceCards);

  /* ── FAQ ── */
  function bindFaq() {
    document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
      const clone = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(clone, btn);
      clone.addEventListener('click', () => {
        const item = clone.closest('.faq-item')!;
        const open = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach((i) => {
          i.classList.remove('open');
          i.querySelector('.faq-btn')?.setAttribute('aria-expanded', 'false');
        });
        if (!open) {
          item.classList.add('open');
          clone.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
  bindFaq();
  document.addEventListener('astro:page-load', bindFaq);

  /* ── Comparateur avant / après ── */
  function bindComparateur() {
    const range = document.getElementById('baRange') as HTMLInputElement | null;
    const apres = document.getElementById('baNew');
    const poignee = document.getElementById('baHandle');
    if (!range || !apres || !poignee) return;
    const clone = range.cloneNode(true) as HTMLInputElement;
    range.parentNode?.replaceChild(clone, range);
    const maj = () => {
      const v = clone.value + '%';
      apres.style.setProperty('--x', v);
      poignee.style.left = v;
    };
    clone.addEventListener('input', maj);
    maj();
  }
  bindComparateur();
  document.addEventListener('astro:page-load', bindComparateur);
</script>
