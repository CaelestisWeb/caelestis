---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Image, getImage } from 'astro:assets';
import imgArtisan     from '../assets/images/atelier-botanique.jpg';
import imgBougies     from '../assets/images/bougies-artisan.jpg';
import imgYoga        from '../assets/images/yoga-soleil.jpg';
import imgJardin      from '../assets/images/jardin-communautaire.jpg';
import imgAvant       from '../assets/images/comparateur/avant.jpg';
import imgApres       from '../assets/images/comparateur/apres.jpg';
import { realisations } from '../data/realisations';
import { euros, formule, MAINTENANCE_MIN, MAINTENANCE_MOIS_OFFERTS, MAINTENANCE_MOIS_OFFERTS_LETTRES } from '../utils/tarifs';

/* Ce que le site réunit. Réécrit le 02/08/2026, affiné le 04/08/2026 avec
   Célestin : le schéma montrait au départ les canaux concurrents du site (fiche
   Google, Instagram, carte de visite), donc ses rivaux. Il montre son contenu,
   ce qui en fait un moyeu et non une destination. La liste a ensuite été arrêtée
   pastille par pastille : « Réalisations » a été retiré, jugé trop proche de
   « Prestations » ; les huit entrées sont désormais de longueur voisine, pour
   des pastilles de taille identique et sur une seule ligne.

   Deux repères par entrée : x et y placent la pastille en pourcentage du carré,
   sx et sy sont le même point dans le repère du SVG des traits (viewBox 400×400,
   centre 200,200). Les deux jeux doivent rester d'accord, sans quoi les traits
   ne rejoignent plus les pastilles. Règle : sx = x × 4, sy = y × 4.

   Huit positions régulières sur une ellipse, de 45 en 45 degrés à partir du
   haut, rayon 32 % en largeur et 40 % en hauteur. L'ellipse n'est pas un choix
   esthétique : à 320 px, une pastille posée à 40 % en largeur déborde du carré,
   parce que les libellés sont des groupes de mots et non des noms de marque.
   Les 32 % laissent la place au texte, les 40 % en hauteur maintiennent l'écart
   avec le noyau, qui occupe 30 % du carré (28 % sous 420 px).

   Les huit pastilles sont identiques au repos, aucun accent permanent. Le vert
   n'apparaît qu'au survol, une pastille à la fois (décision de Célestin le
   07/08/2026 ; l'ancien accent vert fixe sur Identité visuelle et Singularité
   est retiré). Effet purement décoratif, sans équivalent tactile : sans
   conséquence, les pastilles étant reprises en toutes lettres pour les lecteurs
   d'écran juste sous le schéma.

   Ordre horaire depuis le haut : identité, puis l'offre (clientèle, prestations,
   tarifs), puis la preuve et l'accès (avis, contact, adresse). Le titre ne
   compte plus les pastilles, on peut en ajouter une sans le réécrire. */
const REUNIT = [
  { nom: 'Identité visuelle',   x: 50,   y: 10,   sx: 200, sy: 40  },
  { nom: 'Singularité',         x: 72.6, y: 21.7, sx: 290, sy: 87  },
  { nom: 'Votre clientèle',     x: 82,   y: 50,   sx: 328, sy: 200 },
  { nom: 'Prestations',         x: 72.6, y: 78.3, sx: 290, sy: 313 },
  { nom: 'Tarifs',              x: 50,   y: 90,   sx: 200, sy: 360 },
  { nom: 'Avis clients',        x: 27.4, y: 78.3, sx: 110, sy: 313 },
  { nom: 'Contact et réseaux',  x: 18,   y: 50,   sx: 72,  sy: 200 },
  { nom: 'Adresse et horaires', x: 27.4, y: 21.7, sx: 110, sy: 87  },
];

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://caelestis.fr/#business',
  parentOrganization: { '@id': 'https://caelestis.fr/#organization' },
  name: 'Caelestis',
  alternateName: 'CaelestisWeb',
  description: 'Développeur web freelance et agence web indépendante. Création de sites internet sur mesure et référencement naturel pour artisans, producteurs et indépendants en Auvergne-Rhône-Alpes. Basé à Crest (26400), dans la Drôme.',
  url: 'https://caelestis.fr',
  email: 'contact@caelestis.fr',
  telephone: '+33769362727',
  image: 'https://caelestis.fr/og-image.jpg',
  logo: 'https://caelestis.fr/favicon.svg',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Crest',
    addressRegion: 'Drôme',
    postalCode: '26400',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '44.7308',
    longitude: '5.0197',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
  },
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Virement bancaire, Carte bancaire',
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'AdministrativeArea', name: 'Drôme' },
    { '@type': 'AdministrativeArea', name: 'Ardèche' },
    { '@type': 'Country', name: 'France' },
  ],
  knowsAbout: ['Création de site web', 'Référencement naturel', 'SEO local Auvergne-Rhône-Alpes', 'Agence web Auvergne-Rhône-Alpes', 'Développement Astro', 'Création site internet Drôme'],
  sameAs: [
    'https://share.google/IKYSIPaXxlTN0W5Zz',
    'https://www.facebook.com/CaelestisWeb',
    'https://www.instagram.com/caelestis_web/',
  ],
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: '44.7308', longitude: '5.0197' },
    geoRadius: '220000',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations Caelestis',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Création de site une page',
          description: 'Un site professionnel en une seule page. La solution accessible pour démarrer, visible sur Google.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '1000',
          priceCurrency: 'EUR',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Création de site vitrine',
          description: 'Site web soigné, visible sur Google, adapté à votre activité. Idéal pour artisans, producteurs et indépendants.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '2000',
          priceCurrency: 'EUR',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Création de boutique en ligne',
          description: 'Boutique e-commerce avec catalogue, paiement sécurisé et gestion des commandes.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '2500',
          priceCurrency: 'EUR',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Site sur mesure',
          description: 'Site entièrement conçu selon vos besoins, votre identité et vos objectifs.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '3500',
          priceCurrency: 'EUR',
        },
      },
    ],
  },
};

/* Le publisher est une RÉFÉRENCE (@id) vers l'Organization déclarée plus bas, pas
   une copie : un objet complet recréait un quatrième nœud Organization anonyme,
   en doublon de #organization. Caelestis étant un homonyme (mot latin, projet
   européen, société d'investissement), un graphe consolidé aide Google à
   rattacher la marque à une entité unique. */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://caelestis.fr/#website',
  name: 'Caelestis',
  alternateName: 'CaelestisWeb',
  url: 'https://caelestis.fr',
  description: 'Création de site web et référencement naturel pour artisans et indépendants en Auvergne-Rhône-Alpes.',
  inLanguage: 'fr-FR',
  publisher: { '@id': 'https://caelestis.fr/#organization' },
};

// FAQ — source unique : alimente le schema FAQPage (SEO) ET l'affichage
/* Déroulé d'un projet. Chaque étape porte sa durée ET ce que le client a à faire :
   ce qui fait reculer un prospect est l'inconnu, pas le prix. */
const etapesMethode = [
  {
    n: '01', duree: '30 minutes', titre: 'Premier échange',
    texte: 'Un appel pour comprendre votre métier et ce que le site doit vous apporter.',
    vous: 'Nous raconter votre activité.',
  },
  {
    n: '02', duree: 'Sous 48h', titre: 'Devis détaillé',
    texte: 'Une proposition écrite : pages prévues, contenu, délais et prix ferme.',
    vous: 'Lire et poser vos questions.',
  },
  {
    n: '03', duree: '1 semaine', titre: "Maquette de l'accueil",
    texte: "Nous dessinons votre page d'accueil. La suite démarre une fois qu'elle vous plaît.",
    vous: 'Nous dire ce que vous en pensez.',
  },
  {
    n: '04', duree: '1 à 6 semaines', titre: 'Conception du site',
    texte: 'Rédaction, pages, photos, référencement, tests. Un point d\'avancement chaque semaine.',
    vous: 'Valider textes et visuels.',
  },
  {
    n: '05', duree: 'Le jour J, puis après', titre: 'Mise en ligne et suivi',
    texte: 'Nous publions le site, connectons votre nom de domaine, et restons joignables.',
    vous: 'Nous appeler dès que besoin.',
  },
];

const faqs = [
  {
    q: 'Quel est le délai pour créer un site internet ?',
    a: 'En général, un site internet est livré en 2 à 8 semaines selon la complexité du projet et la rapidité de transmission des contenus (textes, photos et autres). Nous vous accompagnons à chaque étape avec un planning clair dès le départ.',
  },
  {
    q: 'Les prix affichés sont-ils hors taxes ?',
    a: "Non, ce sont des prix nets : il n'y a pas de TVA à ajouter. Caelestis relève de la franchise en base de TVA (article 293 B du Code général des impôts), donc le montant annoncé est exactement celui que vous réglez. La plupart des agences affichent des tarifs hors taxes, auxquels s'ajoutent 20 % : un site annoncé à 1 990 € hors taxes est facturé 2 388 €.",
  },
  {
    q: 'Et si je n\'ai pas encore mes textes ni mes photos ?',
    a: 'C\'est très fréquent, et ce n\'est pas un frein. Nous vous accompagnons pour structurer vos contenus, nous pouvons rédiger les textes à partir de nos échanges et vous orienter sur les visuels. Pas besoin d\'arriver avec un dossier complet pour démarrer.',
  },
  {
    q: 'Faites-vous la refonte d\'un site internet existant ?',
    a: 'Oui, c\'est une bonne partie de notre travail. Si votre site actuel est vieillissant, lent ou ne vous ressemble plus, nous le refondons entièrement : nouveau design, performances et meilleure visibilité sur Google. Quand c\'est possible, la refonte conserve vos adresses de pages, pour ne pas perdre le référencement déjà acquis.',
  },
  {
    q: 'À qui appartient le site une fois payé ?',
    a: 'À vous, entièrement. Le nom de domaine est déposé à votre nom, les contenus et le site vous appartiennent. Le jour où vous souhaitez confier votre site à quelqu\'un d\'autre, nous transmettons l\'ensemble des accès.',
  },
  {
    q: 'Suis-je engagé sur la durée ?',
    a: `La création se règle une seule fois, en deux versements : 30 % à la signature, le solde à la mise en ligne. La maintenance est offerte les ${MAINTENANCE_MOIS_OFFERTS_LETTRES} premiers mois, puis devient un abonnement mensuel dès ${euros(MAINTENANCE_MIN)} €, résiliable quand vous le souhaitez avec un mois de préavis.`,
  },
  {
    q: 'Combien de temps ce projet va-t-il me demander ?',
    a: 'Comptez environ deux heures au total, réparties sur l\'ensemble du projet : le premier échange, la validation de la maquette, puis la relecture des textes. Nous nous chargeons de tout le reste.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://caelestis.fr/#organization',
  name: 'Caelestis',
  alternateName: 'CaelestisWeb',
  url: 'https://caelestis.fr',
  logo: {
    '@type': 'ImageObject',
    url: 'https://caelestis.fr/og-image.jpg',
    width: 1200,
    height: 630,
  },
  description: 'Développeur web freelance et agence web indépendante, spécialisé dans la création de sites internet sur mesure et le référencement naturel pour artisans, producteurs et indépendants en Auvergne-Rhône-Alpes. Basé à Crest (26400), dans la Drôme.',
  email: 'contact@caelestis.fr',
  telephone: '+33769362727',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Crest',
    addressRegion: 'Drôme',
    postalCode: '26400',
    addressCountry: 'FR',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'AdministrativeArea', name: 'Drôme' },
    { '@type': 'AdministrativeArea', name: 'Ardèche' },
    { '@type': 'Country', name: 'France' },
  ],
  foundingDate: '2024',
  founder: {
    '@type': 'Person',
    name: 'Célestin Fruleux',
    jobTitle: 'Développeur web & consultant SEO',
    url: 'https://caelestis.fr/a-propos',
  },
  knowsAbout: ['Création de site web', 'Développement Astro', 'Référencement naturel', 'SEO local Drôme', 'Agence web Drôme', 'Création site internet Crest'],
  sameAs: [
    'https://share.google/IKYSIPaXxlTN0W5Zz',
    'https://www.facebook.com/CaelestisWeb',
    'https://www.instagram.com/caelestis_web/',
  ],
};

// ── Hero mobile (LCP) ──


---
<BaseLayout
  title="Caelestis, agence web en Auvergne-Rhône-Alpes"
  description="Création de site internet et référencement pour artisans et indépendants en Auvergne-Rhône-Alpes. Dès 1 000 €, en ligne en 2 à 8 semaines."
  schema={[localBusiness, organizationSchema, websiteSchema, faqSchema]}
>

  <!-- ─── FIL BOTANIQUE ─── -->
  <div class="vine-wrap" aria-hidden="true">
    <svg
      id="vine"
      class="vine-svg"
      viewBox="0 0 50 1000"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        id="vine-path"
        d="M 25,0
           C 48,38 2,90 18,148
           C 48,208 2,255 30,312
           C 50,368 1,418 15,474
           C 47,532 2,582 30,638
           C 50,692 1,742 18,796
           C 48,848 3,894 25,944
           C 41,968 9,992 25,1000"
        stroke-width="1.8"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </div>


  <!-- ─── HERO ─── -->
  <section class="hero-screen flex flex-col justify-center px-6 md:px-10 lg:px-20 pt-8 md:pt-20 pb-16 relative overflow-hidden">

    <!-- Lumière ambiante organique -->
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="light-blob light-blob-sauge absolute w-[600px] h-[600px]"
           style="top: -8%; left: -12%; opacity: 0.7;"></div>
      <div class="light-blob light-blob-ocre absolute w-[420px] h-[420px]"
           style="bottom: 5%; right: -8%; opacity: 0.55;"></div>
      <div class="light-blob light-blob-cream absolute w-[300px] h-[300px]"
           style="top: 40%; left: 38%; opacity: 0.4;"></div>
    </div>

    <!-- Premier écran typographique : aucune photo. La respiration vient des
         halos de lumière et du blanc généreux, pas d'une image d'illustration.
         Décision de Célestin le 29/07/2026, après relevé sur sept sites d'agence.
         Depuis le 04/08/2026, le premier écran ne porte plus que quatre éléments,
         eyebrow, titre, sous-titre et boutons : la réassurance est partie sur
         /services. La composition est centrée dans la hauteur d'écran. -->
    <!-- Bloc à 48rem (max-w-3xl) : le titre plafonne à 604 px et le sous-titre
         à 543 px, tout tient dans cette largeur. -->
    <div class="max-w-3xl mx-auto w-full text-center relative z-10">

      <!-- Eyebrow. `whitespace-nowrap` sur le nom de région : sans lui, à 375px
           la ligne se coupait au tiret et affichait « AUVERGNE- » puis
           « RHÔNE-ALPES » seul en dessous. Le retour se fait maintenant avant
           « Auvergne », entre deux mots. -->
      <p class="hero-eyebrow font-body text-xs tracking-[0.22em] uppercase mb-10 md:mb-14 text-sauge [text-wrap:balance]" data-reveal>
        Création de site web en <a href="/creation-site-internet-auvergne-rhone-alpes" class="whitespace-nowrap underline decoration-sauge/30 underline-offset-2 hover:decoration-sauge transition-colors">Auvergne-Rhône-Alpes</a>
      </p>

      <!-- H1 retenu le 01/08/2026 par Célestin. L'ancienne version, « Un site web
           qui valorise votre savoir-faire et attire vos futurs clients », finissait
           sur l'acquisition, que le sous-titre porte désormais entièrement : le
           hero annonçait deux fois la même promesse. Le titre prend donc la
           fierté du métier, le sous-titre garde la mécanique commerciale.
           « Valoriser » et « votre activité » ont été écartés en chemin, l'un
           parce qu'aucun visiteur ne se représente ce que fait un site qui
           valorise, l'autre parce que c'est un mot de déclaration administrative.
           Deux blocs `.sl`, l'accent sauge sur le savoir-faire.
           Taille : le titre ne mesure plus que 604 px à son plafond, contre 967
           avant, d'où le plafond remonté à 4,25 rem (68 px, la limite fixée pour
           les titres du site). La pente 9vw amène ce plafond dès 756 px de large
           et garantit deux lignes jusqu'à 320 px : la ligne la plus longue y
           mesure 256 px pour 272 disponibles. -->
      <h1
        class="font-display font-light text-brun leading-[1.05] tracking-[-0.03em] mb-10 md:mb-14 hero-title"
        style="font-size: clamp(1.75rem, 9vw, 4.25rem);"
      >
        <span class="sl"><span>Un site web digne</span></span>
        <span class="sl"><span class="text-sauge">de votre savoir-faire.</span></span>
      </h1>

      <!-- Sous-titre. Réécrit le 01/08/2026, première phrase resserrée le
           04/08/2026 (choix de Célestin : « on recherche, on compare, on
           choisit », sans les « vous » ni le « puis », rythme ternaire plus
           net). Il ne doit ni redire le H1, qui porte déjà les deux leviers
           d'un site (être trouvé, convaincre), ni nommer la cible, dont la
           section « pour qui » se charge juste en dessous. Il pose le mécanisme
           de décision du visiteur, la comparaison. Aucune mention de refonte ni
           de première mise en ligne, aucune supposition sur la notoriété du
           client : la formule doit valoir pour une vitrine comme pour une
           boutique. La seconde phrase répond au constat de la première ; les
           deux lignes ne se lisent jamais séparément. Deux temps et pas trois :
           une version intermédiaire posait une question au visiteur entre le
           constat et la réponse, retirée le 01/08 pour tenir en deux lignes.
           Largeur 42rem. -->
      <p class="hero-sub font-body text-base md:text-lg leading-relaxed max-w-[42rem] mb-10 md:mb-12 text-brun-mid mx-auto [text-wrap:balance]" data-reveal data-delay="1">
        Sur internet, on recherche, on compare, on choisit.<br>
        Nous faisons de vous, le choix évident.
      </p>

      <!-- Boutons CTA. Point d'ancrage bas de la composition depuis le
           04/08/2026 : les quatre cases de réassurance qui suivaient ont été
           déplacées vers /services (elles alourdissaient le premier écran). Le
           hero est redevenu une composition purement typographique, centrée
           dans la hauteur d'écran, et les CTA en referment le bas. -->
      <div class="cta-pair flex flex-col sm:flex-row items-center justify-center gap-3" data-reveal data-delay="2">
        <Button href="/contact" variant="primary">Parler de mon projet</Button>
        <Button href="/outils/simulateur" variant="outline">Estimer mon projet</Button>
      </div>

    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator absolute bottom-8 left-6 md:left-10 lg:left-20 hidden sm:flex items-center gap-3" aria-hidden="true">
      <div class="scroll-line w-8 h-px bg-brun opacity-35"></div>
    </div>

  </section>


  <!-- ─── POUR QUI ─── -->
  <!-- Le padding bas est repassé à 56 px le 04/08/2026 : les 24 px précédents
       suffisaient sous des cartes blanches, qui portaient leur propre marge
       intérieure. La chute qui les remplace est du texte nu, elle a besoin de
       la même respiration que le haut de section. Blanc inter-sections obtenu :
       120 px en mobile, dans la plage 88 à 160 px du barème du 03/08. -->
  <section class="bg-sauge-pale py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark section-ambient overflow-hidden" aria-labelledby="pourqui-title">
    <div class="max-w-6xl mx-auto">

      <!-- Titre réservé aux lecteurs d'écran : la section n'en porte pas de
           visible, et sans lui elle n'est annoncée ni comme région ni dans le
           sommaire des titres. -->
      <h2 id="pourqui-title" class="sr-only">Pour qui nous créons des sites</h2>

      <!-- Accroche de ciblage : les gestes avant les métiers, pour n'exclure personne -->
      <p class="font-body text-center text-sm tracking-[0.2em] uppercase text-sauge mb-4" data-reveal>
        Vous cultivez, vous élevez, vous fabriquez, vous accueillez
      </p>

      <!-- Ligne métiers : cinq familles larges, volontairement englobantes.
           La liste nominative de 14 métiers a été retirée le 01/08/2026 : elle
           tenait sur cinq lignes en mobile et fermait la porte à tout métier non
           cité. Les statuts remplacent les métiers ; ce sont les quatre verbes
           de l'accroche au-dessus qui portent encore le geste, donc un maraîcher
           ou un apiculteur se reconnaît là, pas dans les pastilles. Ne pas
           rallonger : au-delà de six, le retour à la ligne mobile redevient
           illisible. -->
      <ul role="list" class="metiers font-body mb-10" data-reveal>
        <li>Artisans</li>
        <li>Commerçants</li>
        <li>Indépendants</li>
        <li>Lieux d'accueil</li>
        <li>Métiers de passion</li>
      </ul>

      <!-- Galerie portfolio : 4 photos, toutes en portrait, affichées en portrait.
           Frise de 4 colonnes sur desktop, 2×2 sur mobile : chaque sujet est visible
           en entier, aucune source portrait n'est écrasée dans une cellule paysage.
           La cinquième (bureau au jardin) a été retirée : réserve de pixels sous le
           seuil (0,93), floue par construction. Ne réintroduire une photo ici qu'à
           réserve de pixels ≥ 4 à la taille d'affichage. -->
      <div class="bento-gallery" data-reveal data-delay="1">

        <!-- Jardin communautaire -->
        <div class="bento-cell bento-jardin img-zoom overflow-hidden">
          <Image
            src={imgJardin}
