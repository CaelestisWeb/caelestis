    color: var(--color-brun-mid);
    max-width: 46ch;
    margin-bottom: 1.1rem;
  }
  /* La chute est posée sur un filet vertical, pas sur un aplat : c'est le seul
     ornement de la colonne de texte, et il ne rejoue pas la carte verte. */
  .conv-exergue {
    margin-top: 1.9rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-sauge);
