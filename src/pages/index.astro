    -webkit-appearance: none; appearance: none; background: transparent;
  }
  .ba-range:focus-visible { outline: none; }
  .ba-range:focus-visible ~ .ba-handle .ba-knob { box-shadow: 0 0 0 4px #E3EFE8, 0 6px 18px rgba(18,22,15,.22); }
  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--x, 38%);
    width: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(18,22,15,.12);
    z-index: 5; pointer-events: none;
  }
  .ba-knob {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 46px; height: 46px; border-radius: 50%;
    background: var(--color-brun); color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 18px rgba(18,22,15,.22);
  }
  .ba-knob svg { width: 20px; height: 20px; }

  /* Déclaré AVANT la media query : à spécificité égale, c'est la dernière règle
     écrite qui gagne. Placé après, ce `none` annulait la version mobile. */
  .only-mob { display: none; }

  /* Sous 700px le comparateur s'empile : deux pages entières, sans curseur */
  @media (max-width: 700px) {
    .ba-legend, .ba-range, .ba-handle { display: none; }
    .ba-stage { height: auto; aspect-ratio: auto; border: 0; box-shadow: none; background: transparent; display: flex; flex-direction: column; gap: 14px; }
    .ba-shot {
      position: relative; inset: auto; aspect-ratio: 1280 / 1080; border-radius: 14px;
      border: 1px solid var(--color-cream-dark);
      box-shadow: 0 1px 2px rgba(18,22,15,.03), 0 10px 32px rgba(18,22,15,.06);
    }
    .ba-shot img { position: absolute; inset: 0; }
    .ba-new { clip-path: none; }
    .ba-shot::before {
      content: attr(data-label); position: absolute; top: 11px; left: 11px; z-index: 3;
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 999px;
      background: #fff; border: 1px solid var(--color-cream-dark); color: var(--color-brun-mid);
    }
    .ba-new::before { background: var(--color-brun); border-color: var(--color-brun); color: #fff; }
    .only-desk { display: none; }
    /* Sous 700px le comparateur n'est plus côte à côte mais empilé : la consigne
       « à gauche / à droite » devenait fausse, elle est remplacée par sa version
       verticale. */
    .only-mob { display: inline; }
  }

  /* ── Chute de la section « Pour qui » ──
     Le triptyque de cartes blanches qui occupait cette place a été retiré le
     04/08/2026 : il n'avait aucun titre visible, il parlait du résultat dans
     une section qui parle de la cible, et ses trois idées sont démontrées plus
     bas, mieux et avec des preuves (comparateur avant / après, point de
     rencontre, pont diagnostic). Il annonçait ce que la page prouve ensuite.
     Une phrase le remplace, sans cadre ni carte : le texte nu est la rupture,
     puisque tout le reste de la section est en pastilles et en images. */
  .chute-pourqui {
    max-width: 44ch;
    margin: clamp(44px, 6vw, 68px) auto 0;
    text-align: center;
    font-weight: 300;
    font-size: clamp(1.1875rem, 2.1vw, 1.625rem);
    line-height: 1.4;
    color: var(--color-brun);
    text-wrap: balance;
  }
  /* Deux temps, deux couleurs : le constat en vert forêt, le manque en mousse
     foncée (#2E7452, la seule nuance de mousse lisible sur fond clair). */
  .chute-pourqui span {
    display: block;
    color: var(--color-sauge-text);
  }
  /* Signature d'engagement : une ligne plus petite et en corps de texte, posée
     sous la chute. Volontairement plus discrète (olive #5C6259, pas un troisième
     vert d'affilée après les deux temps de la chute) : elle scelle, elle ne
     surenchérit pas. Le corps de texte tranche avec le display de la chute. */
  .chute-engagement {
    text-align: center;
    max-width: 44ch;
    margin: 14px auto 0;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-brun-mid);
  }

  /* ── Ligne métiers : pastilles statiques centrées, sur toutes les tailles.
     Aucun défilement : le bandeau en boucle est banni de la charte, et une
     animation infinie dans le viewport empêche Lighthouse de considérer la
     page comme stabilisée (Speed Index dégradé). ── */
  .metiers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 880px;
    margin-inline: auto;
    list-style: none;
    padding: 0;
  }
  .metiers li {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brun-mid);
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    padding: 8px 13px;
    border-radius: 999px;
    line-height: 1.2;
    /* Chaque famille tient sur une ligne : une pastille coupée en deux mots
       superposés casse la lecture de la rangée. La plus longue, « Métiers de
       passion », mesure 138 px en mobile ; c'est le plafond à ne pas dépasser
       si un libellé change, sinon le pavage ci-dessous casse. */
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .metiers li {
      font-size: 0.9375rem;
      padding: 10px 22px;
    }
  }
  /* Les cinq pastilles réclament environ 815 px de fenêtre pour tenir sur une
     seule rangée. En dessous, la largeur libre en laisse passer quatre et
     abandonne la cinquième seule sur sa ligne, ou trois et en abandonne deux.
     On borne la rangée pour obtenir un franc 3 + 2 sur toute cette plage,
     jusqu'au 2 + 2 + 1 des très petits écrans où 420 px ne s'applique plus. */
  @media (max-width: 840px) {
    .metiers { max-width: 420px; }
  }

  /* ── Galerie bento ── */
  /* Frise de portraits : les quatre sources sont en portrait, on les affiche
     en portrait pour ne rien écraser. Mobile 2×2, desktop 4 colonnes en ligne. */
  .bento-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .bento-cell { aspect-ratio: 3 / 4; }

  /* L'atelier est la plus verticale des sources (0,56) : on recentre pour
     garder les mains et les coupelles dans le cadre. */
  .bento-artisan :global(img) { object-position: center 38%; }

  @media (min-width: 768px) {
    .bento-gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
    .bento-cell { aspect-ratio: 2 / 3; }
  }

  .bento-cell {
    border-radius: 6px;
    box-shadow: 0 2px 12px rgba(37, 92, 65, 0.10);
    outline: 1px solid rgba(37, 92, 65, 0.07);
    outline-offset: -1px;
  }

  /* ── FAQ accordéon ── */
  .faq-item.open .faq-answer { max-height: 360px; }
  .faq-item.open .faq-plus-v { transform: scaleY(0); opacity: 0; }
  .faq-item.open .faq-icon   { border-color: #B8C4BB; color: #B8C4BB; }
  .faq-btn:hover .faq-icon   { border-color: #B8C4BB; color: #B8C4BB; }

  /* ── Réalisations ── */
  .reali-carte {
    display: block;
    border: 1px solid var(--color-cream-dark);
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-cream);
    transition: border-color .35s ease, transform .35s ease;
  }
  .reali-carte:hover,
  .reali-carte:focus-visible { border-color: var(--color-sauge); transform: translateY(-2px); }

  /* La capture est cadrée par le haut : on montre l'en-tête du site, jamais un rognage au centre. */
  .reali-image {
    width: 100%;
    height: auto;
    display: block;
    border-bottom: 1px solid var(--color-cream-dark);
  }

  .reali-corps { padding: 1.6rem 1.5rem 1.75rem; }

  .reali-meta {
    font-size: .7rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: .55rem;
  }

  .reali-delai {
    display: inline-block;
    font-size: .75rem;
    color: var(--color-brun-mid);
    border: 1px solid var(--color-cream-dark);
    border-radius: 999px;
    padding: .2rem .7rem;
    margin-bottom: 1.15rem;
  }

  .reali-lien {
    display: block;
    font-size: .85rem;
    color: var(--color-sauge-text);
  }
  .reali-lien::after {
    content: '';
    display: inline-block;
    width: .9rem;
    height: 1px;
    background: currentColor;
    margin-left: .5rem;
    vertical-align: middle;
    transition: width .35s ease;
  }
  .reali-carte:hover .reali-lien::after { width: 1.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .reali-carte,
    .reali-lien::after { transition: none; }
    .reali-carte:hover { transform: none; }
  }
</style>

<script>
  /* Ré-attaché après chaque navigation View Transitions (cloneNode purge les anciens listeners) */

  /* ── FAQ ── */
  function bindFaq() {
    document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
      const clone = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(clone, btn);
      clone.addEventListener('click', () => {
        const item = clone.closest('.faq-item')!;
        const open = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach((i) => {
          i.classList.remove('open');
          i.querySelector('.faq-btn')?.setAttribute('aria-expanded', 'false');
        });
        if (!open) {
          item.classList.add('open');
          clone.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
  bindFaq();
  document.addEventListener('astro:page-load', bindFaq);

  /* ── Comparateur avant / après ── */
  function bindComparateur() {
    const range = document.getElementById('baRange') as HTMLInputElement | null;
    const apres = document.getElementById('baNew');
    const poignee = document.getElementById('baHandle');
    if (!range || !apres || !poignee) return;
    const clone = range.cloneNode(true) as HTMLInputElement;
    range.parentNode?.replaceChild(clone, range);
    const maj = () => {
      const v = clone.value + '%';
      apres.style.setProperty('--x', v);
      poignee.style.left = v;
    };
    clone.addEventListener('input', maj);
    maj();
  }
  bindComparateur();
  document.addEventListener('astro:page-load', bindComparateur);
</script>
