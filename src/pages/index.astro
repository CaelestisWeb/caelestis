  /* Carré strict : les pastilles sont posées en pourcentage et le SVG des traits
     partage le même repère, donc les deux restent alignés à toutes les largeurs,
     sans média-requête de position. Mesuré sans chevauchement de 320 à 1440 px. */
  .conv-carre {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
  }
  /* Sur petit écran, le schéma reprend les 24 px de marge de la section de
     chaque côté : 48 px de gagnés sur le diamètre, soit 15 %, exactement ce qui
     manquait pour que les pastilles basses cessent de se recouvrir. Le texte,
     lui, garde sa marge : seul le dessin déborde. */
  @media (max-width: 520px) {
    .conv-carre { width: calc(100% + 3rem); max-width: none; margin-inline: -1.5rem; }
  }
  .conv-traits { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Les tirets avancent du canal vers le centre : c'est l'animation qui dit le
     sens de lecture du schéma, tout converge vers le site. */
  .conv-trait {
    stroke: var(--color-sauge);
    stroke-width: 1.2;
    stroke-dasharray: 3 9;
    stroke-linecap: round;
    animation: conv-flux 3.4s linear infinite;
  }
  .conv-trait:nth-child(2) { animation-delay: -0.42s; }
  .conv-trait:nth-child(3) { animation-delay: -0.85s; }
  .conv-trait:nth-child(4) { animation-delay: -1.27s; }
  .conv-trait:nth-child(5) { animation-delay: -1.70s; }
  .conv-trait:nth-child(6) { animation-delay: -2.12s; }
  .conv-trait:nth-child(7) { animation-delay: -2.55s; }
  .conv-trait:nth-child(8) { animation-delay: -2.97s; }
  @keyframes conv-flux { to { stroke-dashoffset: -24; } }

  .conv-orbite { stroke: rgba(37, 92, 65, 0.10); stroke-width: 1; }

  /* Noyau ramené de 34 à 30 % le 04/08/2026 : les pastilles étant désormais
     toutes larges (taille unique), les deux latérales à 3 h et 9 h venaient
     toucher le disque. À 30 %, elles gardent 6 px de jour. Ne pas le regrossir
     sans réduire d'autant la largeur des pastilles. */
  .conv-noyau {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 30%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--color-ocre);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    box-shadow: 0 18px 40px rgba(37, 92, 65, 0.28);
  }
  .conv-noyau svg { width: 26px; height: 26px; }
  .conv-noyau span { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.01em; }

  /* Pastilles de taille rigoureusement identique, texte centré, une seule ligne
     (demande de Célestin, 04/08/2026). Largeur fixe et non max-content : c'est
     la seule façon de garantir qu'elles soient toutes de la même taille quel que
     soit le libellé. La largeur est calée sur le plus long, « Adresse et
     horaires », et le corps du texte est réduit sous 420 px pour que tout tienne
     sans déborder. `nowrap` impose cette discipline : un libellé plus large que
     la pastille sortirait du cadre au lieu de passer à la ligne, donc toute
     entrée ajoutée doit rester dans la largeur. Vérifié de 320 à 1280 px. */
  .conv-canal {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 9rem;
    text-align: center;
    white-space: nowrap;
    background: var(--color-cream);
    border: 1px solid var(--color-cream-dark);
    border-radius: 999px;
    padding: 0.4rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-brun-mid);
    box-shadow: 0 2px 10px rgba(18, 22, 15, 0.05);
    transition: background-color 0.25s ease, border-color 0.25s ease,
                color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  /* Survol : la pastille se remplit du vert du noyau, texte crème, comme si elle
     rejoignait le centre. Une seule à la fois. Effet décoratif (les pastilles ne
     sont pas des liens), donc pas d'état focus clavier. Neutralisé en animations
     réduites, la couleur reste mais le mouvement non. */
  .conv-canal:hover {
    background: #255C41;
    border-color: #255C41;
    color: var(--color-cream);
    box-shadow: 0 8px 20px rgba(37, 92, 65, 0.26);
    transform: translate(-50%, -50%) scale(1.04);
  }
  /* Sous 420 px, le carré ne mesure plus que 323 px : la ligne horizontale doit
     y loger deux pastilles et le noyau. Mesuré au premier jet, 120 + 110 + 120
