  /* ══ Le point de rencontre : texte à gauche, schéma à droite ══
     Remplace la carte paragraphe verte, retirée le 02/08/2026 avec la section
     qu'elle portait. Deux colonnes égales à partir de 940 px : en dessous, le
     schéma passe sous le texte, où il garde tout son sens puisqu'il se lit de
     l'extérieur vers le centre, quel que soit l'ordre de lecture. */
  .conv {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 940px) {
    .conv { grid-template-columns: 1fr 1fr; }
