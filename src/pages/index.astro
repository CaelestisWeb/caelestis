---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Image, getImage } from 'astro:assets';
import imgArtisan     from '../assets/images/atelier-botanique.jpg';
import imgBougies     from '../assets/images/bougies-artisan.jpg';
import imgYoga        from '../assets/images/yoga-soleil.jpg';
import imgJardin      from '../assets/images/jardin-communautaire.jpg';
import imgAvant       from '../assets/images/comparateur/avant.jpg';
import imgApres       from '../assets/images/comparateur/apres.jpg';
import { realisations } from '../data/realisations';
import { euros, formule, MAINTENANCE_MIN, MAINTENANCE_MOIS_OFFERTS, MAINTENANCE_MOIS_OFFERTS_LETTRES } from '../utils/tarifs';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://caelestis.fr/#business',
  name: 'Caelestis',
  alternateName: 'CaelestisWeb',
  description: 'Développeur web freelance et agence web indépendante. Création de sites internet sur mesure et référencement naturel pour artisans, producteurs et indépendants en Auvergne-Rhône-Alpes. Basé à Crest (26400), dans la Drôme.',
  url: 'https://caelestis.fr',
  email: 'contact@caelestis.fr',
  telephone: '+33769362727',
  image: 'https://caelestis.fr/og-image.jpg',
  logo: 'https://caelestis.fr/favicon.svg',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Crest',
    addressRegion: 'Drôme',
    postalCode: '26400',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '44.7308',
    longitude: '5.0197',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
  },
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Virement bancaire, Carte bancaire',
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'AdministrativeArea', name: 'Drôme' },
    { '@type': 'AdministrativeArea', name: 'Ardèche' },
    { '@type': 'Country', name: 'France' },
  ],
  knowsAbout: ['Création de site web', 'Référencement naturel', 'SEO local Auvergne-Rhône-Alpes', 'Agence web Auvergne-Rhône-Alpes', 'Développement Astro', 'Création site internet Drôme'],
  sameAs: [
    'https://share.google/IKYSIPaXxlTN0W5Zz',
    'https://www.facebook.com/CaelestisWeb',
    'https://www.instagram.com/caelestis_web/',
  ],
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: '44.7308', longitude: '5.0197' },
    geoRadius: '220000',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations Caelestis',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Création de site une page',
          description: 'Un site professionnel en une seule page. La solution accessible pour démarrer, visible sur Google.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '1000',
          priceCurrency: 'EUR',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Création de site vitrine',
          description: 'Site web soigné, visible sur Google, adapté à votre activité. Idéal pour artisans, producteurs et indépendants.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '2000',
          priceCurrency: 'EUR',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Création de boutique en ligne',
          description: 'Boutique e-commerce avec catalogue, paiement sécurisé et gestion des commandes.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '2500',
          priceCurrency: 'EUR',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Site sur mesure',
          description: 'Site entièrement conçu selon vos besoins, votre identité et vos objectifs.',
        },
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: '3500',
          priceCurrency: 'EUR',
        },
      },
    ],
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Caelestis',
  url: 'https://caelestis.fr',
  description: 'Création de site web et référencement naturel pour artisans et indépendants en Auvergne-Rhône-Alpes.',
  inLanguage: 'fr-FR',
  publisher: {
    '@type': 'Organization',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
    logo: {
      '@type': 'ImageObject',
      url: 'https://caelestis.fr/favicon.svg',
    },
  },
};

// FAQ — source unique : alimente le schema FAQPage (SEO) ET l'affichage
/* Déroulé d'un projet. Chaque étape porte sa durée ET ce que le client a à faire :
   ce qui fait reculer un prospect est l'inconnu, pas le prix. */
const etapesMethode = [
  {
    n: '01', duree: '30 minutes', titre: 'Premier échange',
    texte: 'Un appel ou une visio pour comprendre votre métier, vos clients et ce que le site doit vous apporter.',
    vous: 'Nous raconter votre activité.',
  },
  {
    n: '02', duree: 'Sous 48h', titre: 'Devis détaillé',
    texte: 'Vous recevez une proposition écrite : pages prévues, contenu, délais et prix ferme. Vous décidez ensuite librement.',
    vous: 'Lire et poser vos questions.',
  },
  {
    n: '03', duree: '1 semaine', titre: "Maquette de l'accueil",
    texte: "Nous concevons votre page d'accueil et vous la présentons. La suite démarre une fois qu'elle vous plaît.",
    vous: 'Nous dire ce que vous en pensez.',
  },
  {
    n: '04', duree: '1 à 6 semaines', titre: 'Conception du site',
    texte: 'Rédaction, pages, photos, référencement et tests sur téléphone comme sur ordinateur. Un point d\'avancement chaque semaine.',
    vous: 'Valider textes et visuels.',
  },
  {
    n: '05', duree: 'Le jour J, puis après', titre: 'Mise en ligne et suivi',
    texte: 'Nous publions le site, connectons votre nom de domaine et restons joignables par téléphone et par e-mail.',
    vous: 'Nous appeler dès que besoin.',
  },
];

const faqs = [
  {
    q: 'Quel est le délai pour créer un site internet ?',
    a: 'En général, un site internet est livré en 2 à 8 semaines selon la complexité du projet et la rapidité de transmission des contenus (textes, photos et autres). Nous vous accompagnons à chaque étape avec un planning clair dès le départ.',
  },
  {
    q: 'Les prix affichés sont-ils hors taxes ?',
    a: "Non, ce sont des prix nets : il n'y a pas de TVA à ajouter. Caelestis relève de la franchise en base de TVA (article 293 B du Code général des impôts), donc le montant annoncé est exactement celui que vous réglez. La plupart des agences affichent des tarifs hors taxes, auxquels s'ajoutent 20 % : un site annoncé à 1 990 € hors taxes est facturé 2 388 €.",
  },
  {
    q: 'Et si je n\'ai pas encore mes textes ni mes photos ?',
    a: 'C\'est très fréquent, et ce n\'est pas un frein. Nous vous accompagnons pour structurer vos contenus, nous pouvons rédiger les textes à partir de nos échanges et vous orienter sur les visuels. Pas besoin d\'arriver avec un dossier complet pour démarrer.',
  },
  {
    q: 'Pourrai-je modifier le contenu de mon site moi-même ?',
    a: 'Par défaut, c\'est nous qui gérons vos modifications : vous nous envoyez vos changements et on s\'en occupe rapidement. Votre site reste ainsi rapide et sécurisé, sans outil technique à gérer. Et si vous préférez être autonome, nous pouvons intégrer un espace simple pour éditer votre site vous-même.',
  },
  {
    q: 'Mon site sera-t-il adapté aux mobiles ?',
    a: 'Oui, systématiquement. Chaque site s\'affiche parfaitement sur mobile, tablette et ordinateur. Comme la majorité de vos visiteurs viennent du téléphone, c\'est une priorité dès la conception.',
  },
  {
    q: 'Mon site sera-t-il visible sur Google ?',
    a: 'Oui. Chaque site repose sur des bases techniques saines, optimisées pour le référencement naturel : structure claire, pages rapides, contenus pensés pour vos mots-clés. Vous pouvez aussi aller plus loin avec un accompagnement SEO dédié pour gagner en visibilité dans le temps.',
  },
  {
    q: 'Pourquoi faire appel à vous plutôt qu\'à un outil comme Wix ?',
    a: 'Un site fait main est plus rapide, mieux référencé et vraiment à votre image, sans les limites ni les abonnements des outils en ligne. Vous gagnez du temps, un résultat professionnel et un interlocuteur unique qui reste disponible après la mise en ligne.',
  },
  {
    q: 'Proposez-vous la maintenance du site après livraison ?',
    a: 'Oui. Nous proposons un accompagnement après la mise en ligne : mises à jour, modifications de contenu, suivi SEO. On en discute ensemble selon vos besoins lors du premier appel.',
  },
  {
    q: 'L\'hébergement est-il inclus ?',
    a: 'Oui. Votre site est hébergé sur une infrastructure rapide et sécurisée, et son maintien en ligne est couvert par votre abonnement de maintenance. Aucun hébergeur séparé à gérer, aucune facture surprise.',
  },
  {
    q: 'Faites-vous la refonte d\'un site internet existant ?',
    a: 'Oui, c\'est une bonne partie de notre travail. Si votre site actuel est vieillissant, lent ou ne vous ressemble plus, nous le refondons entièrement : nouveau design, performances et meilleure visibilité sur Google. Quand c\'est possible, la refonte conserve vos adresses de pages, pour ne pas perdre le référencement déjà acquis.',
  },
  {
    q: 'À qui appartient le site une fois payé ?',
    a: 'À vous, entièrement. Le nom de domaine est déposé à votre nom, les contenus et le site vous appartiennent. Le jour où vous souhaitez confier votre site à quelqu\'un d\'autre, nous transmettons l\'ensemble des accès.',
  },
  {
    q: 'Suis-je engagé sur la durée ?',
    a: `La création se règle une seule fois, en deux versements : 30 % à la signature, le solde à la mise en ligne. La maintenance est offerte les ${MAINTENANCE_MOIS_OFFERTS_LETTRES} premiers mois, puis devient un abonnement mensuel dès ${euros(MAINTENANCE_MIN)} €, résiliable quand vous le souhaitez avec un mois de préavis.`,
  },
  {
    q: 'Combien de temps ce projet va-t-il me demander ?',
    a: 'Comptez environ deux heures au total, réparties sur l\'ensemble du projet : le premier échange, la validation de la maquette, puis la relecture des textes. Nous nous chargeons de tout le reste.',
  },
  {
    q: 'Comment vous joindre pendant le projet ?',
    a: 'Par téléphone au 07 69 36 27 27 et par e-mail, du lundi au samedi, 9h à 18h. Vous gardez le même interlocuteur du premier appel jusqu\'après la mise en ligne.',
  },
  {
    q: 'Comment connaître le prix de mon projet ?',
    a: 'C\'est gratuit et sans engagement. Vous pouvez estimer votre projet en 2 minutes avec notre simulateur, ou nous écrire directement pour un devis personnalisé.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://caelestis.fr/#organization',
  name: 'Caelestis',
  alternateName: 'CaelestisWeb',
  url: 'https://caelestis.fr',
  logo: {
    '@type': 'ImageObject',
    url: 'https://caelestis.fr/og-image.jpg',
    width: 1200,
    height: 630,
  },
  description: 'Développeur web freelance et agence web indépendante, spécialisé dans la création de sites internet sur mesure et le référencement naturel pour artisans, producteurs et indépendants en Auvergne-Rhône-Alpes. Basé à Crest (26400), dans la Drôme.',
  email: 'contact@caelestis.fr',
  telephone: '+33769362727',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Crest',
    addressRegion: 'Drôme',
    postalCode: '26400',
    addressCountry: 'FR',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'AdministrativeArea', name: 'Drôme' },
    { '@type': 'AdministrativeArea', name: 'Ardèche' },
    { '@type': 'Country', name: 'France' },
  ],
  foundingDate: '2024',
  founder: {
    '@type': 'Person',
    name: 'Célestin Fruleux',
    jobTitle: 'Développeur web & consultant SEO',
    url: 'https://caelestis.fr/a-propos',
  },
  knowsAbout: ['Création de site web', 'Développement Astro', 'Référencement naturel', 'SEO local Drôme', 'Agence web Drôme', 'Création site internet Crest'],
  sameAs: [
    'https://share.google/IKYSIPaXxlTN0W5Zz',
    'https://www.facebook.com/CaelestisWeb',
    'https://www.instagram.com/caelestis_web/',
  ],
};

// ── Hero mobile (LCP) ──


---
<BaseLayout
  title="Agence web en Auvergne-Rhône-Alpes, Caelestis"
  description="Création de site internet et référencement pour artisans et indépendants en Auvergne-Rhône-Alpes. Dès 1 000 €, en ligne en 2 à 8 semaines."
  schema={[localBusiness, organizationSchema, websiteSchema, faqSchema]}
>

  <!-- ─── FIL BOTANIQUE ─── -->
  <div class="vine-wrap" aria-hidden="true">
    <svg
      id="vine"
      class="vine-svg"
      viewBox="0 0 50 1000"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        id="vine-path"
        d="M 25,0
           C 48,38 2,90 18,148
           C 48,208 2,255 30,312
           C 50,368 1,418 15,474
           C 47,532 2,582 30,638
           C 50,692 1,742 18,796
           C 48,848 3,894 25,944
           C 41,968 9,992 25,1000"
        stroke-width="1.8"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </div>


  <!-- ─── HERO ─── -->
  <section class="hero-screen flex flex-col justify-center px-6 md:px-10 lg:px-20 pt-8 md:pt-20 pb-16 relative overflow-hidden">

    <!-- Lumière ambiante organique -->
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="light-blob light-blob-sauge absolute w-[600px] h-[600px]"
           style="top: -8%; left: -12%; opacity: 0.7;"></div>
      <div class="light-blob light-blob-ocre absolute w-[420px] h-[420px]"
           style="bottom: 5%; right: -8%; opacity: 0.55;"></div>
      <div class="light-blob light-blob-cream absolute w-[300px] h-[300px]"
           style="top: 40%; left: 38%; opacity: 0.4;"></div>
    </div>

    <!-- Premier écran typographique : aucune photo. La respiration vient des
         halos de lumière et du filet de réassurance, pas d'une image d'illustration.
         Décision de Célestin le 29/07/2026, après relevé sur sept sites d'agence. -->
    <!-- Bloc élargi à 64rem le 01/08/2026 : le titre passe de trois lignes à deux,
         et « Un site web qui valorise votre savoir-faire » mesure 967 px à la taille
         plafond. À 48rem il aurait fallu descendre le titre à 43 px, trop peu pour un
         premier écran sans photo. Le sous-titre et le filet de réassurance gardent
         leur propre largeur juste en dessous. -->
    <div class="max-w-5xl mx-auto w-full text-center relative z-10">

      <!-- Eyebrow. `whitespace-nowrap` sur le nom de région : sans lui, à 375px
           la ligne se coupait au tiret et affichait « AUVERGNE- » puis
           « RHÔNE-ALPES » seul en dessous. Le retour se fait maintenant avant
           « Auvergne », entre deux mots. -->
      <p class="hero-eyebrow font-body text-xs tracking-[0.22em] uppercase mb-8 text-sauge [text-wrap:balance]" data-reveal>
        Création de site web en <a href="/creation-site-internet-auvergne-rhone-alpes" class="whitespace-nowrap underline decoration-sauge/30 underline-offset-2 hover:decoration-sauge transition-colors">Auvergne-Rhône-Alpes</a>
      </p>

      <!-- H1 : promesse orientée client, choisie le 31/07/2026 après relevé des
           heros d'agences web (bénéfice concret « valorise / attire » plutôt que
           description de la prestation). Deux lignes depuis le 01/08/2026 : la
           promesse d'un tenant, puis le bénéfice commercial en sauge. Plafond
           ramené de 3,6 à 3,4 rem, soit 54 px, pour que la première ligne tienne
           dans les 1024 px du bloc avec 57 px de marge. Reste sous les 68 px
           fixés pour les titres. Sous 610 px de large la première ligne se
           répartit d'elle-même sur deux lignes, aucune classe ne l'en empêche.
           Plancher descendu de 1,95 à 1,8 rem : à 31 px, « et attire vos futurs
           clients. » mesurait 346 px pour 327 px disponibles sur un écran de
           375 px et se coupait en deux, ce qui donnait un titre en quatre
           morceaux. À 28,8 px elle tient d'un trait et le titre reste à trois
           lignes sur mobile. -->
      <h1
        class="font-display font-light text-brun leading-[1.05] tracking-[-0.03em] mb-8 hero-title"
        style="font-size: clamp(1.8rem, 4.4vw, 3.4rem);"
      >
        <span class="sl"><span>Un site web qui valorise votre savoir-faire</span></span>
        <span class="sl"><span class="text-sauge">et attire vos futurs clients.</span></span>
      </h1>

      <!-- Sous-titre. Réécrit le 01/08/2026. Il ne doit ni redire le H1, qui
           porte déjà les deux leviers d'un site (être trouvé, convaincre), ni
           nommer la cible, dont la section « pour qui » se charge juste en
           dessous. Il pose donc le mécanisme de décision du visiteur, la
           comparaison, que le filet de réassurance vient alimenter trois lignes
           plus bas avec le délai, le devis et le prix affiché. Aucun chiffre
           ici, ce filet en porte déjà trois. Aucune mention de refonte ni de
           première mise en ligne, aucune supposition sur la notoriété du
           client : la formule doit valoir pour une vitrine comme pour une
           boutique. La seconde phrase prend en charge les trois moments
           énumérés par la première : « des trois » n'a de sens qu'après le
           ternaire, les deux lignes ne se lisent donc jamais séparément.
           Deux temps et pas trois : une version intermédiaire posait une
           question au visiteur entre le constat et la réponse, retirée le
           01/08 pour tenir en deux lignes. Largeur 42rem, la plus longue des
           deux phrases mesurant 543 px. -->
      <p class="hero-sub font-body text-base md:text-lg leading-relaxed max-w-[42rem] mb-9 text-brun-mid mx-auto [text-wrap:balance]" data-reveal data-delay="1">
        Sur internet, on vous cherche, on vous compare, puis on choisit.<br>
        Nous faisons de vous le choix évident.
      </p>

      <!-- Boutons CTA -->
      <div class="cta-pair flex flex-col sm:flex-row items-center justify-center gap-3" data-reveal data-delay="2">
        <Button href="/contact" variant="primary">Parler de mon projet</Button>
        <Button href="/outils/simulateur" variant="outline">Estimer mon projet</Button>
      </div>

      <!-- Réassurance, posée sur un filet : sans photo, c'est ce filet qui
           structure le bas de l'écran. Couleur pleine (sans opacité) pour rester
           au-dessus du seuil de contraste AA à cette taille. Largeur bloquée à
           48rem : le bloc parent est passé à 64rem pour le titre, sans cela le
           filet s'étirerait de 256 px et perdrait son rôle de repère. -->
      <ul class="trust trust-rule font-body mt-12 pt-7 max-w-3xl mx-auto" data-reveal data-delay="2">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Réponse sous 48h</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>En ligne en 2 à 8 semaines</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Devis gratuit, sans engagement</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Tarifs affichés, dès 1 000 €</li>
      </ul>

    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator absolute bottom-8 left-6 md:left-10 lg:left-20 hidden sm:flex items-center gap-3" aria-hidden="true">
      <div class="scroll-line w-8 h-px bg-brun opacity-35"></div>
    </div>

  </section>


  <!-- ─── POUR QUI ─── -->
  <section class="pt-14 pb-6 md:py-14 px-6 md:px-10 lg:px-20 border-t border-cream-dark section-ambient overflow-hidden">
    <div class="max-w-6xl mx-auto">

      <!-- Accroche de ciblage : les gestes avant les métiers, pour n'exclure personne -->
      <p class="font-body text-center text-sm tracking-[0.2em] uppercase text-sauge mb-4" data-reveal>
        Vous cultivez, vous élevez, vous fabriquez, vous accueillez
      </p>

      <!-- Ligne métiers : cinq familles larges, volontairement englobantes.
           La liste nominative de 14 métiers a été retirée le 01/08/2026 : elle
           tenait sur cinq lignes en mobile et fermait la porte à tout métier non
           cité. Les statuts remplacent les métiers ; ce sont les quatre verbes
           de l'accroche au-dessus qui portent encore le geste, donc un maraîcher
           ou un apiculteur se reconnaît là, pas dans les pastilles. Ne pas
           rallonger : au-delà de six, le retour à la ligne mobile redevient
           illisible. -->
      <ul class="metiers font-body mb-10" data-reveal>
        <li>Artisans</li>
        <li>Commerçants</li>
        <li>Indépendants</li>
        <li>Lieux d'accueil</li>
        <li>Métiers de passion</li>
      </ul>

      <!-- Galerie portfolio : 4 photos, toutes en portrait, affichées en portrait.
           Frise de 4 colonnes sur desktop, 2×2 sur mobile : chaque sujet est visible
           en entier, aucune source portrait n'est écrasée dans une cellule paysage.
           La cinquième (bureau au jardin) a été retirée : réserve de pixels sous le
           seuil (0,93), floue par construction. Ne réintroduire une photo ici qu'à
           réserve de pixels ≥ 4 à la taille d'affichage. -->
      <div class="bento-gallery" data-reveal data-delay="1">

        <!-- Jardin communautaire -->
        <div class="bento-cell bento-jardin img-zoom overflow-hidden">
          <Image
            src={imgJardin}
