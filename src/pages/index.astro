  .benefices h3 { font-size: 1.0625rem; margin-bottom: 8px; }
  .benefices p { font-size: 0.9375rem; color: var(--color-brun-mid); line-height: 1.6; }
  @media (max-width: 860px) {
    .benefices { grid-template-columns: 1fr; max-width: 460px; }
  }

  /* ── Réassurance du hero ── */
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    list-style: none;
    padding: 0;
  }
  /* Filet de séparation au-dessus de la réassurance. Il tient lieu de repère
     structurel dans un premier écran sans image, et s'efface vers les bords
     pour ne pas trancher la composition. */
  .trust-rule {
    border-top: 1px solid transparent;
    border-image: linear-gradient(to right, transparent, var(--color-cream-dark) 22%, var(--color-cream-dark) 78%, transparent) 1;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brun-mid);
    line-height: 1.3;
  }
  /* Sur mobile les quatre repères passent chacun sur sa ligne. Centrés
     individuellement, leurs coches se décalaient les unes par rapport aux
     autres. La colonne `max-content` est centrée en bloc, les items restant
     alignés à gauche : les quatre coches se superposent. */
  @media (max-width: 639px) {
    .trust {
      display: grid;
      grid-template-columns: max-content;
      justify-content: center;
      gap: 9px;
    }
  }
  .trust svg {
    width: 14px;
    height: 14px;
    color: var(--color-brun);
    flex-shrink: 0;
  }

  /* ── Ligne métiers : pastilles statiques centrées, sur toutes les tailles.
     Aucun défilement : le bandeau en boucle est banni de la charte, et une
     animation infinie dans le viewport empêche Lighthouse de considérer la
     page comme stabilisée (Speed Index dégradé). ── */
  .metiers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 880px;
    margin-inline: auto;
    list-style: none;
    padding: 0;
  }
  .metiers li {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brun-mid);
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    padding: 8px 13px;
    border-radius: 999px;
    line-height: 1.2;
    /* Chaque famille tient sur une ligne : une pastille coupée en deux mots
       superposés casse la lecture de la rangée. La plus longue, « Métiers de
       passion », mesure 138 px en mobile ; c'est le plafond à ne pas dépasser
       si un libellé change, sinon le pavage ci-dessous casse. */
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .metiers li {
      font-size: 0.9375rem;
      padding: 10px 22px;
    }
  }
  /* Les cinq pastilles réclament environ 815 px de fenêtre pour tenir sur une
     seule rangée. En dessous, la largeur libre en laisse passer quatre et
     abandonne la cinquième seule sur sa ligne, ou trois et en abandonne deux.
     On borne la rangée pour obtenir un franc 3 + 2 sur toute cette plage,
     jusqu'au 2 + 2 + 1 des très petits écrans où 420 px ne s'applique plus. */
  @media (max-width: 840px) {
    .metiers { max-width: 420px; }
  }

  /* ── Galerie bento ── */
  /* Frise de portraits : les quatre sources sont en portrait, on les affiche
     en portrait pour ne rien écraser. Mobile 2×2, desktop 4 colonnes en ligne. */
  .bento-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .bento-cell { aspect-ratio: 3 / 4; }

  /* L'atelier est la plus verticale des sources (0,56) : on recentre pour
     garder les mains et les coupelles dans le cadre. */
  .bento-artisan :global(img) { object-position: center 38%; }

  @media (min-width: 768px) {
    .bento-gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
    .bento-cell { aspect-ratio: 2 / 3; }
  }

  .bento-cell {
    border-radius: 6px;
    box-shadow: 0 2px 12px rgba(37, 92, 65, 0.10);
    outline: 1px solid rgba(37, 92, 65, 0.07);
    outline-offset: -1px;
  }

  /* ── FAQ accordéon ── */
  .faq-item.open .faq-answer { max-height: 360px; }
  .faq-item.open .faq-plus-v { transform: scaleY(0); opacity: 0; }
  .faq-item.open .faq-icon   { border-color: #B8C4BB; color: #B8C4BB; }
  .faq-btn:hover .faq-icon   { border-color: #B8C4BB; color: #B8C4BB; }

  /* ── Réalisations ── */
  .reali-carte {
    display: block;
    border: 1px solid var(--color-cream-dark);
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-cream);
    transition: border-color .35s ease, transform .35s ease;
  }
  .reali-carte:hover,
  .reali-carte:focus-visible { border-color: var(--color-sauge); transform: translateY(-2px); }

  /* La capture est cadrée par le haut : on montre l'en-tête du site, jamais un rognage au centre. */
  .reali-image {
    width: 100%;
    height: auto;
    display: block;
    border-bottom: 1px solid var(--color-cream-dark);
  }

  .reali-corps { padding: 1.6rem 1.5rem 1.75rem; }

  .reali-meta {
    font-size: .7rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: .55rem;
  }

  .reali-delai {
    display: inline-block;
    font-size: .75rem;
    color: var(--color-brun-mid);
    border: 1px solid var(--color-cream-dark);
    border-radius: 999px;
    padding: .2rem .7rem;
    margin-bottom: 1.15rem;
  }

  .reali-lien {
    display: block;
    font-size: .85rem;
    color: var(--color-sauge-text);
  }
  .reali-lien::after {
    content: '';
    display: inline-block;
    width: .9rem;
    height: 1px;
    background: currentColor;
    margin-left: .5rem;
    vertical-align: middle;
    transition: width .35s ease;
  }
  .reali-carte:hover .reali-lien::after { width: 1.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .reali-carte,
    .reali-lien::after { transition: none; }
    .reali-carte:hover { transform: none; }
  }
</style>

<script>
  /* Ré-attaché après chaque navigation View Transitions (cloneNode purge les anciens listeners) */

  /* ── FAQ ── */
  function bindFaq() {
    document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
      const clone = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(clone, btn);
      clone.addEventListener('click', () => {
        const item = clone.closest('.faq-item')!;
        const open = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach((i) => {
          i.classList.remove('open');
          i.querySelector('.faq-btn')?.setAttribute('aria-expanded', 'false');
        });
        if (!open) {
          item.classList.add('open');
          clone.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
  bindFaq();
  document.addEventListener('astro:page-load', bindFaq);

  /* ── Comparateur avant / après ── */
  function bindComparateur() {
    const range = document.getElementById('baRange') as HTMLInputElement | null;
    const apres = document.getElementById('baNew');
    const poignee = document.getElementById('baHandle');
    if (!range || !apres || !poignee) return;
    const clone = range.cloneNode(true) as HTMLInputElement;
    range.parentNode?.replaceChild(clone, range);
    const maj = () => {
      const v = clone.value + '%';
      apres.style.setProperty('--x', v);
      poignee.style.left = v;
    };
    clone.addEventListener('input', maj);
    maj();
  }
  bindComparateur();
  document.addEventListener('astro:page-load', bindComparateur);
</script>
