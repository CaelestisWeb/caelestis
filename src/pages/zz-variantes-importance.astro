---
/* PAGE DE TRAVAIL, À SUPPRIMER APRÈS ARBITRAGE.
   Trois refontes de la section « L'importance d'un site web » de l'accueil,
   texte ET mise en page, rendues dans le vrai style du site pour choisir sur
   pièce. La version en ligne aujourd'hui est reproduite en tête pour comparer.

   Contrainte de fond relevée avant d'écrire : juste au-dessus de cette section,
   l'accueil affiche déjà trois cartes « On vous trouve / On vous comprend /
   On vous contacte ». Aucune des trois variantes ne reprend donc ce triptyque,
   sans quoi la page dirait deux fois la même chose à deux sections d'écart. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

/* Les six points de contact du schéma de la variante 2. Coordonnées en
   pourcentage du carré : six positions régulières sur un cercle de rayon 38 %,
   le SVG des traits partage le même repère (viewBox 400×400, centre 200,200,
   rayon 152) pour que traits et pastilles tombent exactement au même endroit. */
const CANAUX = [
  { nom: 'Fiche Google',    x: 50,   y: 12, sx: 200,   sy: 48  },
  { nom: 'Instagram',       x: 82.9, y: 31, sx: 331.6, sy: 124 },
  { nom: 'Bouche à oreille',x: 82.9, y: 69, sx: 331.6, sy: 276 },
  { nom: 'Carte de visite', x: 50,   y: 88, sx: 200,   sy: 352 },
  { nom: 'Marché, salon',   x: 17.1, y: 69, sx: 68.4,  sy: 276 },
  { nom: 'Facebook',        x: 17.1, y: 31, sx: 68.4,  sy: 124 },
];

/* Variante 1 : quatre rôles du site, en fiche technique. Les intitulés sont des
   verbes courts, tous à la même personne, pour que la colonne de gauche se lise
   seule, en diagonale, sans lire les définitions. */
const ROLES = [
  {
    t: 'Il rassemble',
    d: 'Vos prestations, vos réalisations, vos tarifs, vos horaires, votre adresse. Un lien à donner, au lieu de dix explications à répéter.',
  },
  {
    t: 'Il rassure',
    d: 'On y voit votre travail, vos clients, votre visage. La confiance se joue là, avant le premier appel.',
  },
  {
    t: 'Il relie',
    d: "Fiche Google, réseaux sociaux, carte de visite, bouche à oreille : tout ramène au même endroit, celui où l'on peut vous écrire.",
  },
  {
    t: 'Il ne ferme pas',
    d: "Un dimanche soir, quelqu'un lit votre page. Lundi matin, son message est dans votre boîte.",
  },
];
---

<BaseLayout
  title="Variantes de la section importance, page de travail"
  description="Page de travail interne, trois refontes de la section sur l'importance d'un site web."
  noindex={true}
>

  <!-- ═══════════ EN-TÊTE ═══════════ -->
  <section class="pt-20 pb-10 px-6 md:px-10 lg:px-20">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-4">Page de travail</p>
      <h1 class="font-display font-light text-brun leading-[1.1] mb-4" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">
        Trois façons de dire pourquoi un site compte.
      </h1>
      <p class="font-body text-base text-brun-mid">
        Même fond, trois registres : la fiche éditoriale, le schéma, la bande de nuit.
        Chacune a son propre texte, calibré pour sa mise en page.
      </p>
    </div>
  </section>


  <!-- ═══════════ RAPPEL : CE QUI EST EN LIGNE ═══════════ -->
  <section class="py-12 px-6 md:px-10 lg:px-20 border-t border-cream-dark bg-cream-dark/25">
    <div class="max-w-6xl mx-auto mb-8">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Aujourd'hui en ligne
      </h2>
      <p class="font-body text-sm text-brun-mid max-w-2xl">
        Pastille, titre centré, pavé de texte sur carte verte. Trois reproches :
        le registre est celui de toutes les autres sections de la page, le pavé
        se lit mal en blanc sur vert, et la carte verte n'est plus une rupture
        puisque la page compte déjà deux sections vert forêt plus bas.
      </p>
    </div>

    <div class="max-w-3xl mx-auto text-center opacity-90">
      <p class="inline-block font-body text-xs tracking-[0.22em] uppercase text-sauge border border-sauge/40 rounded-full px-4 py-1.5 mb-8">
        L'importance d'un site web
      </p>
      <h3 class="font-display font-light text-brun leading-[1.15] tracking-tight mb-8" style="font-size: clamp(1.5rem, 2.6vw, 2.1rem);">
        <span class="block">Les fleurs donnent vie à un jardin,</span>
        <span class="block text-sauge">votre site web donne vie à votre entreprise.</span>
      </h3>
      <div class="para-card">
        <p class="font-body text-base leading-relaxed mb-3">
          Aujourd'hui, vos futurs clients se forgent une première impression de votre entreprise bien avant le premier échange. Dans la plupart des cas, cette découverte commence sur Internet.
        </p>
        <p class="font-body text-base leading-relaxed">
          Un site internet professionnel vous permet de présenter votre activité avec clarté, de valoriser ce qui fait votre différence et d'offrir une expérience rassurante à vos prospects. Il devient un véritable levier pour développer votre visibilité, et transformer l'intérêt en une nouvelle opportunité commerciale.
        </p>
      </div>
    </div>
  </section>


  <!-- ═══════════ VARIANTE 1 : LA FICHE ÉDITORIALE ═══════════
       Zéro carte, zéro icône, zéro fond coloré. La rupture vient de la grille :
       la page entière est centrée, celle-ci est calée à gauche sur deux colonnes
       inégales, avec des filets pleine largeur. C'est la variante la moins
       coûteuse à intégrer et la plus proche du registre « métier » du site. -->
  <section class="py-12 px-6 md:px-10 lg:px-20 border-t-2 border-brun/20">
    <div class="max-w-6xl mx-auto mb-10">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Variante 1, la fiche éditoriale
      </h2>
      <p class="font-body text-sm text-brun-mid max-w-2xl">
        Titre calé à gauche, quatre rôles en fiche technique, une phrase seule en
        rupture. Aucun aplat de couleur : c'est la grille qui fait le travail.
      </p>
    </div>

    <div class="v1 max-w-5xl mx-auto">

      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-7">
        L'importance d'un site web
      </p>

      <div class="v1-tete">
        <h3 class="font-display font-light text-brun v1-titre">
          Votre site n'est pas une vitrine.
          <span class="v1-titre-accent">C'est le seul endroit qui vous appartient.</span>
        </h3>
        <p class="font-body v1-chapeau">
          Sur Google, sur les réseaux, on parle de vous avec les règles des autres.
          Chez vous, vous choisissez ce que l'on voit, dans quel ordre, et jusqu'où
          l'on peut aller.
        </p>
      </div>

      <dl class="v1-roles">
        {ROLES.map((r) => (
          <div class="v1-role">
            <dt class="font-body">{r.t}</dt>
            <dd class="font-body">{r.d}</dd>
          </div>
        ))}
      </dl>

      <p class="font-display font-light v1-pivot">
        Sans site, la recherche ne s'arrête pas. Elle continue ailleurs.
      </p>

      <p class="font-body v1-chute">
        Un site se construit une fois et travaille des années. Il ne se loue pas
        au clic, il ne s'éteint pas quand vous coupez le budget publicité :
        il reste, et il grandit avec votre activité.
      </p>

    </div>
  </section>


  <!-- ═══════════ VARIANTE 2 : LE POINT DE RENCONTRE ═══════════
       Dispositif signature : le schéma dit en un coup d'œil ce que le texte de
       la dictée voulait dire par « relié à vos réseaux, à votre fiche Google,
       il devient le point de rencontre ». Aucun logo de marque : libellés en
       texte et traits fins, pour rester dans la charte et hors de tout droit
       d'usage de logos tiers. -->
  <section class="py-12 px-6 md:px-10 lg:px-20 border-t-2 border-brun/20 section-ambient">
    <div class="max-w-6xl mx-auto mb-10">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Variante 2, le point de rencontre
      </h2>
      <p class="font-body text-sm text-brun-mid max-w-2xl">
        Texte à gauche, schéma à droite. Six points de contact convergent vers le
        site. C'est la seule des trois qui donne à la page une image qui n'est
        pas une photo, et la plus mémorable.
      </p>
    </div>

    <div class="v2 max-w-6xl mx-auto">

      <div class="v2-texte">
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-6">
          L'importance d'un site web
        </p>

        <h3 class="font-display font-light text-brun v2-titre">
          Tout ce que l'on trouve de vous
          <span class="v2-titre-accent">devrait mener au même endroit.</span>
        </h3>

        <p class="font-body v2-p">
          Une fiche Google, une page Facebook, un compte Instagram, une carte de
          visite laissée sur un marché : votre présence est éparpillée, et chacun
          de ces points ne raconte qu'un morceau de vous.
        </p>
        <p class="font-body v2-p">
          Votre site les rassemble. Il dit ce que vous faites, montre ce que vous
          avez livré, répond aux questions que l'on vous pose au téléphone, et
          ouvre un seul chemin pour vous joindre.
        </p>

        <p class="font-body v2-exergue">
          Ce qui est éparpillé se perd. Ce qui converge se retient.
        </p>

        <div class="mt-8">
          <Button href="#difference" variant="outline">Voir la différence</Button>
        </div>
      </div>

      <div class="v2-schema" aria-hidden="true">
        <div class="v2-carre">
          <svg class="v2-traits" viewBox="0 0 400 400" fill="none">
            {CANAUX.map((c) => (
              <line x1={c.sx} y1={c.sy} x2="200" y2="200" class="v2-trait" />
            ))}
            <circle cx="200" cy="200" r="118" class="v2-orbite" />
          </svg>

          <div class="v2-noyau">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="4" width="19" height="14" rx="2" />
              <path d="M2.5 8.5h19M6 20h12" />
            </svg>
            <span class="font-body">Votre site</span>
          </div>

          {CANAUX.map((c) => (
            <span class="v2-canal font-body" style={`left:${c.x}%; top:${c.y}%`}>{c.nom}</span>
          ))}
        </div>
      </div>

    </div>

    <p class="max-w-6xl mx-auto font-body text-sm text-brun-mid mt-8 text-center md:text-left">
      Version accessible du schéma, lue par les lecteurs d'écran : fiche Google,
      Instagram, Facebook, bouche à oreille, carte de visite et rencontres en
      salon mènent tous à votre site.
    </p>
  </section>


  <!-- ═══════════ VARIANTE 3 : LA BANDE DE NUIT ═══════════
       Rupture par le fond. Une seule scène racontée en trois temps décalés,
       plutôt qu'un argumentaire. L'arc porte deux repères horaires, collés à ce
       qu'ils prouvent, jamais alignés en rangée de chiffres. -->
  <section class="py-12 px-6 md:px-10 lg:px-20 border-t-2 border-brun/20">
    <div class="max-w-6xl mx-auto mb-10">
      <h2 class="font-display font-light text-brun mb-2" style="font-size: 1.6rem;">
        Variante 3, la bande de nuit
      </h2>
      <p class="font-body text-sm text-brun-mid max-w-2xl">
        Pleine largeur en vert profond, grande typographie, une scène en trois
        temps au lieu d'un argumentaire. À arbitrer en connaissant le voisinage :
        le bandeau du diagnostic, deux sections plus bas, est déjà vert.
      </p>
    </div>

    <div class="v3">
      <svg class="v3-arc" viewBox="0 0 1200 320" fill="none" aria-hidden="true" preserveAspectRatio="none">
        <path d="M0 300 C 300 40, 900 40, 1200 300" class="v3-course" />
      </svg>

      <div class="v3-inner">
        <p class="font-body text-xs tracking-[0.22em] uppercase v3-eyebrow">
          L'importance d'un site web
        </p>

        <h3 class="font-display font-light v3-titre">
          Un dimanche soir, votre site est encore ouvert.
        </h3>

        <div class="v3-temps v3-t1">
          <span class="v3-heure font-body">8 h</span>
          <p class="font-body">
            Vous êtes en atelier, sur un chantier, en livraison. Votre téléphone
            est au fond d'une poche et le répondeur ne rassure personne.
          </p>
        </div>

        <div class="v3-temps v3-t2">
          <p class="font-body">
            Pendant ce temps, quelqu'un cherche votre métier près de chez lui,
            tombe sur votre site, regarde vos réalisations et comprend en une
            minute que c'est vous qu'il lui faut.
          </p>
        </div>

        <div class="v3-temps v3-t3">
          <span class="v3-heure font-body">23 h</span>
          <p class="font-display font-light v3-chute">
            Le lendemain matin, son message vous attend.
          </p>
        </div>

        <p class="font-body v3-note">
          C'est le seul de vos outils qui n'a pas d'horaires, et le seul qui vous
          appartient vraiment. Une fois construit, il travaille sans qu'on le
          relance.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>


<style>
  /* ══════════════════════════════════════════════════════
     Rappel de l'existant : copie de la carte verte en ligne
  ══════════════════════════════════════════════════════ */
  .para-card {
    position: relative;
    background: rgba(37, 92, 65, 0.85);
    border-radius: 24px;
    padding: 2rem 1.25rem;
    text-align: center;
    overflow: hidden;
    box-shadow:
      0 40px 90px rgba(42, 61, 24, 0.35),
      0 8px 24px rgba(42, 61, 24, 0.20),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  @media (min-width: 640px) { .para-card { padding: 3rem 3.5rem; } }
  .para-card p {
    color: rgba(252, 251, 248, 0.90);
    font-size: 1rem;
    line-height: 1.95;
    letter-spacing: 0.012em;
  }


  /* ══════════════════════════════════════════════════════
     VARIANTE 1, la fiche éditoriale
  ══════════════════════════════════════════════════════ */

  /* Titre et chapeau côte à côte : le titre occupe sept colonnes sur douze, le
     chapeau quatre, avec une gouttière franche. C'est ce décalage qui distingue
     la section du reste de la page, entièrement centrée. */
  .v1-tete {
    display: grid;
    gap: 1.5rem 4rem;
    align-items: end;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--color-cream-dark);
  }
  @media (min-width: 900px) {
    .v1-tete { grid-template-columns: 7fr 5fr; }
  }
  .v1-titre {
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-brun);
    max-width: 18ch;
  }
  .v1-titre-accent { display: block; color: var(--color-sauge-vif); }
  .v1-chapeau {
    font-size: 0.9875rem;
    line-height: 1.75;
    color: var(--color-brun-mid);
    max-width: 42ch;
  }

  /* Les quatre rôles. Un filet par entrée plutôt qu'une carte : le texte reste
     posé sur le fond de la page, aucun aplat ne vient concurrencer les photos
     de la section du dessus. */
  .v1-roles { margin: 0; }
  .v1-role {
    display: grid;
    gap: 0.35rem 3rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-cream-dark);
  }
  @media (min-width: 700px) {
    .v1-role { grid-template-columns: 210px 1fr; gap: 0 3rem; align-items: baseline; }
  }
  .v1-role dt {
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-sauge-vif);
    font-weight: 500;
  }
  /* 52ch et non 58 : le glyphe de référence de Satoshi est large, 58ch donnait
     une ligne de 634 px, soit près de 80 signes. À 52ch la ligne tombe à 71,
     dans la plage de lecture confortable. */
  .v1-role dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-brun-mid);
    max-width: 52ch;
  }

  /* La rupture : une phrase seule, en grand, sans filet ni fond. Elle occupe la
     place d'un paragraphe entier et coupe la lecture en deux. */
  .v1-pivot {
    font-size: clamp(1.4rem, 2.9vw, 2.1rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--color-brun);
    max-width: 24ch;
    margin: clamp(2.75rem, 5vw, 4.25rem) 0 clamp(1.75rem, 3vw, 2.5rem);
  }
  .v1-chute {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-brun-mid);
    max-width: 62ch;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-cream-dark);
  }


  /* ══════════════════════════════════════════════════════
     VARIANTE 2, le point de rencontre
  ══════════════════════════════════════════════════════ */
  .v2 {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 940px) {
    .v2 { grid-template-columns: 1fr 1fr; }
  }
  .v2-titre {
    font-size: clamp(1.6rem, 3.2vw, 2.35rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--color-brun);
    margin-bottom: 1.5rem;
  }
  .v2-titre-accent { display: block; color: var(--color-sauge-vif); }
  .v2-p {
    font-size: 1rem;
    line-height: 1.78;
    color: var(--color-brun-mid);
    max-width: 46ch;
    margin-bottom: 1.1rem;
  }
  /* La phrase pivot est posée sur un filet vertical, pas sur un fond : c'est le
     seul ornement de la colonne de texte. */
  .v2-exergue {
    margin-top: 1.9rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-sauge);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-brun);
    max-width: 34ch;
  }

  /* Le schéma. Carré strict : les pastilles sont placées en pourcentage et le
     SVG des traits partage le même repère, donc traits et pastilles restent
     alignés à toutes les largeurs. */
  .v2-carre {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
  }
  .v2-traits { position: absolute; inset: 0; width: 100%; height: 100%; }
  .v2-trait {
    stroke: var(--color-sauge);
    stroke-width: 1.2;
    stroke-dasharray: 3 9;
    stroke-linecap: round;
    animation: v2-flux 3.4s linear infinite;
  }
  .v2-trait:nth-child(2) { animation-delay: -0.5s; }
  .v2-trait:nth-child(3) { animation-delay: -1.1s; }
  .v2-trait:nth-child(4) { animation-delay: -1.7s; }
  .v2-trait:nth-child(5) { animation-delay: -2.3s; }
  .v2-trait:nth-child(6) { animation-delay: -2.9s; }
  @keyframes v2-flux { to { stroke-dashoffset: -24; } }

  .v2-orbite {
    stroke: rgba(37, 92, 65, 0.10);
    stroke-width: 1;
  }

  .v2-noyau {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 34%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--color-ocre);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    box-shadow: 0 18px 40px rgba(37, 92, 65, 0.28);
  }
  .v2-noyau svg { width: 26px; height: 26px; }
  .v2-noyau span {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .v2-canal {
    position: absolute;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    background: var(--color-cream);
    border: 1px solid var(--color-cream-dark);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.75rem;
    color: var(--color-brun-mid);
    box-shadow: 0 2px 10px rgba(18, 22, 15, 0.05);
  }
  @media (max-width: 420px) {
    .v2-canal { font-size: 0.6875rem; padding: 0.32rem 0.6rem; }
    .v2-noyau span { font-size: 0.6875rem; }
    .v2-noyau svg { width: 20px; height: 20px; }
  }


  /* ══════════════════════════════════════════════════════
     VARIANTE 3, la bande de nuit
  ══════════════════════════════════════════════════════ */
  .v3 {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ocre-dark);
    border-radius: 4px;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 5rem);
  }
  /* L'arc traverse la section d'un bord à l'autre. Il ne porte aucune couleur
     pleine : un simple filet, à peine plus clair que le fond. */
  .v3-arc {
    position: absolute;
    left: -5%; right: -5%; top: 8%;
    width: 110%; height: 62%;
    z-index: -1;
    opacity: 0.5;
  }
  .v3-course {
    stroke: var(--color-sauge);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    opacity: 0.45;
  }
  .v3-inner { max-width: 62rem; margin: 0 auto; }
  .v3-eyebrow { color: var(--color-sauge-pale); opacity: 0.75; margin-bottom: 1.5rem; }
  .v3-titre {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 17ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

