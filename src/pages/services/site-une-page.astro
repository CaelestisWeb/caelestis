---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { euros, formule } from '../../utils/tarifs';

const canonical = 'https://caelestis.fr/services/site-une-page';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Page unique',
  serviceType: 'Création de site internet une page',
  description: "Création d'un site internet professionnel en une seule page pour artisans, producteurs et indépendants. L'essentiel de votre activité, soigné et visible sur Google, à partir de 1 000 €.",
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://caelestis.fr/#business',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
    address: { '@type': 'PostalAddress', addressLocality: 'Crest', addressRegion: 'Drôme', postalCode: '26400', addressCountry: 'FR' },
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'Country', name: 'France' },
  ],
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: '1000',
      priceCurrency: 'EUR',
    },
  },
};

/* Les objections propres à cette offre : le doute porte presque toujours sur
   la suffisance d'une seule page, et sur ce qu'on fait le jour où l'activité
   grandit. Y répondre ici évite qu'elles restent muettes jusqu'au devis. */
const faq = [
  {
    q: "Une seule page, est-ce vraiment suffisant ?",
    a: "Pour une activité qui se présente simplement, oui. Un visiteur cherche trois choses : ce que vous faites, ce qui vous distingue, et comment vous joindre. Une page bien construite répond aux trois sans le forcer à naviguer. Si votre activité demande un catalogue, plusieurs lieux ou un blog, le site vitrine sera plus adapté et nous vous le dirons franchement.",
  },
  {
    q: "Pourrai-je passer à un site plus grand plus tard ?",
    a: "Oui, et sans repartir de zéro. Vos textes, vos photos, votre nom de domaine et votre identité visuelle sont conservés. Nous ajoutons les pages nécessaires et vous ne réglez que la différence avec la formule supérieure.",
  },
  {
    q: "Une page unique est-elle bien référencée sur Google ?",
    a: "Elle l'est sur votre activité et votre secteur, ce qui couvre l'essentiel des recherches locales. La limite apparaît quand vous visez plusieurs métiers ou plusieurs villes distinctes : chacun demande alors sa propre page pour se positionner.",
  },
  {
    q: "Combien de temps avant qu'elle soit en ligne ?",
    a: "Comptez deux à trois semaines à partir du moment où nous avons vos contenus. C'est la formule la plus rapide à livrer, puisqu'il n'y a qu'une page à concevoir et à valider.",
  },
  {
    q: "Que se passe-t-il si je veux modifier un texte après la mise en ligne ?",
    a: "Vous nous écrivez, nous le faisons. Les modifications de contenu courantes sont comprises dans l'abonnement de maintenance, sans supplément ni délai d'attente.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Site une page', item: canonical },
  ],
};

// Les 3 temps du projet
const etapes = [
  { n: '01', t: 'On échange', d: 'Un appel pour comprendre votre activité et ce que vous voulez montrer.' },
  { n: '02', t: 'On crée, on ajuste', d: 'On construit votre site, puis on l\'affine avec vous, jusqu\'au moindre détail.' },
  { n: '03', t: 'On met en ligne', d: 'Votre site est publié deux à trois semaines après notre premier échange, prêt à vous faire connaître.' },
];

// Anatomie d'une page unique, de haut en bas (ordre standard, pensé pour la conversion)
const anatomie = [
  { t: 'Bannière', d: 'Votre nom, votre accroche et un bouton de contact. La première impression.' },
  { t: 'Intro courte', d: 'Une phrase forte qui confirme votre promesse et donne envie de descendre. Pas une biographie.' },
  { t: 'Vos services ou produits', d: 'Ce que vous proposez, présenté simplement et clairement.' },
  { t: 'Galerie', d: 'Vos plus belles photos : réalisations, lieu, ambiance, produits.' },
  { t: 'Qui sommes-nous', d: 'L\'humain derrière l\'activité : votre parcours, vos valeurs, votre visage. Pour créer le lien.' },
  { t: 'Avis clients', d: 'Les vrais retours de vos clients, pour inspirer confiance.' },
  { t: 'Questions fréquentes', d: 'Les réponses qui lèvent les derniers doutes avant de vous contacter.' },
  { t: 'Contact', d: 'Formulaire, téléphone, e-mail et itinéraire, à portée de clic.' },
  { t: 'Pied de page', d: 'Vos informations essentielles, horaires et liens utiles.' },
];
---

<BaseLayout
  title="Page unique, site une page dès 1 000 €, Caelestis"
  description="La Page unique : un site professionnel en une seule page, dès 1 000 €. L'essentiel de votre activité, soigné et visible sur Google."
  canonical={canonical}
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- ── Hero ── -->
  <section class="pt-20 pb-16 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-24 w-[420px] h-[420px]"></div>
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/4 w-56 h-56"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <div class="inline-flex items-center gap-2 mb-6" data-reveal>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Page unique, pour démarrer</p>
      </div>
      <h1
        class="font-display font-light text-brun leading-[1.06] tracking-tight max-w-3xl mx-auto"
        style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
        data-reveal data-delay="1"
      >
        Une seule page suffit<br class="hidden sm:block"> pour <span class="text-sauge">exister en ligne.</span>
      </h1>
      <p class="font-body text-lg text-brun-mid mt-8 max-w-2xl leading-relaxed mx-auto" data-reveal data-delay="2">
        Un site professionnel, sur une seule page. Visible sur Google et prêt en deux à trois semaines, sans gros budget.
      </p>

      <!-- Prix -->
      <div class="mt-9 inline-flex flex-col items-center" data-reveal data-delay="2">
        <p class="font-body text-xs tracking-[0.16em] uppercase text-brun-mid mb-1">À partir de</p>
        <p class="font-display font-light text-brun leading-none" style="font-size: clamp(2.6rem, 6vw, 3.6rem); letter-spacing: -0.025em;">
          <span class="text-sauge">{euros(formule('page-unique').prix)}</span><span class="text-bois-mid text-2xl ml-1">€</span>
        </p>
      </div>

      <div class="cta-pair mt-9 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4" data-reveal data-delay="3">
        <Button href="/contact#devis" variant="primary">Demander un devis</Button>
        <Button href="#inclus" variant="outline">Voir ce qui est inclus</Button>
      </div>
    </div>
  </section>

  <!-- ── En clair : c'est quoi ? ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20" style="background-color: #F4F2EC;">
    <div class="max-w-4xl mx-auto" data-reveal>
      <div class="text-center mb-10">
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">En clair</p>
        <h2 class="font-display font-light text-brun leading-[1.15] mb-6" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Un site complet, en plus simple.
        </h2>
        <p class="font-body text-base text-brun-mid leading-relaxed max-w-2xl mx-auto">
          Un site à page unique, c'est un site internet à part entière : tout tient sur une seule page qui défile. Votre visiteur y découvre qui vous êtes, ce que vous proposez et comment vous joindre, sans menus compliqués ni pages à chercher.
        </p>
        <p class="font-body text-base text-brun-mid leading-relaxed max-w-2xl mx-auto mt-5">
          C'est l'offre idéale pour les artisans, producteurs et indépendants qui démarrent. On s'occupe de toute la technique : nom de domaine, mise en ligne, réglages. Vous n'avez qu'à nous parler de votre métier.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Ce que contient votre page (anatomie, fond vert) ── -->
  <section id="inclus" class="py-20 px-6 md:px-10 lg:px-20 bg-brun text-cream section-dark-depth relative overflow-hidden">
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute top-24 -left-24 w-72 h-72"></div>
    <div aria-hidden="true" class="light-blob light-blob-bois pointer-events-none absolute -bottom-10 right-0 w-80 h-80"></div>

    <div class="max-w-3xl mx-auto relative">
      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">L'anatomie de votre page</p>
        <h2 class="font-display font-light leading-[1.15] mb-5" style="font-size: clamp(1.7rem, 3vw, 2.4rem); color: rgba(252, 251, 248,0.94);">
          Ce que contient votre page.
        </h2>
        <p class="font-body text-base leading-relaxed max-w-xl mx-auto" style="color: rgba(252, 251, 248,0.78);">
          De haut en bas, voici les sections que découvre votre visiteur en faisant défiler votre page.
        </p>
      </div>

      <div class="anat-list max-w-lg mx-auto space-y-2.5" data-reveal data-delay="1">
        {anatomie.map((s, i) => (
          <button type="button" class={`anat-block ${i === 0 ? 'is-selected' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="anat-title">{s.t}</span>
            <span class="anat-desc">{s.d}</span>
          </button>
        ))}
      </div>

      <p class="text-center font-body text-sm mt-8 max-w-xl mx-auto" style="color: rgba(252, 251, 248,0.80);" data-reveal data-delay="2">
        On choisit ensemble les sections utiles à votre activité. Certaines sont optionnelles : votre page reste simple et lisible.
      </p>
    </div>
  </section>

  <!-- ── Simple, rapide & au juste prix ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
    <div class="max-w-4xl mx-auto" data-reveal>
      <div class="text-center mb-12">
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Comment ça se passe</p>
        <h2 class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Simple, rapide, sans surprise.
        </h2>
      </div>

      <!-- 3 temps -->
      <div class="grid sm:grid-cols-3 gap-5 lg:gap-6 mb-12" data-reveal data-delay="1">
        {etapes.map((e) => (
          <div class="text-center">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-full font-display text-base text-cream mb-4" style="background: #255C41; box-shadow: 0 6px 16px rgba(37, 92, 65,0.22);">{e.n}</span>
            <h3 class="font-display text-lg font-light text-brun mb-2">{e.t}</h3>
            <p class="font-body text-sm text-brun-mid leading-relaxed">{e.d}</p>
          </div>
        ))}
      </div>

      <!-- Le périmètre clair -->
      <div class="max-w-2xl mx-auto bg-cream border border-cream-dark rounded-2xl p-7 lg:p-8 text-center" data-reveal data-delay="2">
        <p class="font-display font-light text-brun leading-none" style="font-size: clamp(2.2rem, 5vw, 3rem); letter-spacing: -0.02em;">
          <span class="text-sauge">{euros(formule('page-unique').prix)}&nbsp;€</span>
        </p>
        <p class="font-body text-sm text-brun-mid mt-2">votre page, prête en deux à trois semaines</p>

        <ul class="mt-7 space-y-3 text-left max-w-md mx-auto">
          <li class="flex items-start gap-3 font-body text-sm text-brun-mid leading-relaxed">
            <span class="sup-check shrink-0 mt-0.5" aria-hidden="true"></span>
            <span>On la peaufine ensemble jusqu'à ce qu'elle vous plaise.</span>
          </li>
          <li class="flex items-start gap-3 font-body text-sm text-brun-mid leading-relaxed">
            <span class="sup-check shrink-0 mt-0.5" aria-hidden="true"></span>
            <span>30&nbsp;% pour démarrer, le solde une fois votre site en ligne.</span>
          </li>
          <li class="flex items-start gap-3 font-body text-sm text-brun-mid leading-relaxed">
            <span class="sup-check shrink-0 mt-0.5" aria-hidden="true"></span>
            <span>Maintenance <strong class="font-semibold text-brun">obligatoire</strong> à <a href="/maintenance" class="text-[#2E7452] hover:text-brun underline decoration-sauge/40 underline-offset-2 transition-colors">7,99 € / mois</a>&nbsp;: votre site reste en ligne, rapide et sécurisé.</span>
          </li>
        </ul>

        <p class="font-body text-sm text-brun-mid mt-7 pt-6 border-t border-cream-dark">
          Besoin de plus un jour (boutique, pages en plus) ? On passe à un <a href="/services" class="text-[#2E7452] hover:text-brun underline decoration-sauge/40 underline-offset-2 transition-colors">site vitrine ou une boutique</a>, sur devis.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FAQ : les objections propres à la formule ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="faq-page-unique">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Questions fréquentes</p>
        <h2 id="faq-page-unique" class="font-display font-light text-brun leading-[1.15]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
          Ce qu'on nous demande souvent.
        </h2>
      </div>

      <div class="seo-faq" data-reveal data-delay="1">
        {faq.map((f) => (
          <details class="seo-faq-item">
            <summary class="seo-faq-q">
              <span>{f.q}</span>
              <span class="seo-faq-marque" aria-hidden="true"></span>
            </summary>
            <p class="seo-faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <AppelFinal
    titre="Prêt à exister"
    titreAccent="en ligne ?"
    texte="Décrivez votre activité en quelques lignes, on revient vers vous sous 48h. On peut même vous préparer un aperçu gratuit de votre futur site avant que vous décidiez."
    href="/contact#devis"
    libelle="Demander un devis"
  />

</BaseLayout>

<style>
  .seo-faq { border-top: 1px solid var(--color-cream-dark); }
  .seo-faq-item { border-bottom: 1px solid var(--color-cream-dark); }
  .seo-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--color-brun);
    transition: color 0.2s ease;
  }
  .seo-faq-q::-webkit-details-marker { display: none; }
  .seo-faq-q:hover { color: var(--color-sauge-text); }
  .seo-faq-marque {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .seo-faq-marque::before,
  .seo-faq-marque::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--color-sauge-text);
    transition: transform 0.3s ease;
  }
  .seo-faq-marque::before { width: 14px; height: 1.5px; }
  .seo-faq-marque::after  { width: 1.5px; height: 14px; }
  .seo-faq-item[open] .seo-faq-marque::after { transform: rotate(90deg); }
  .seo-faq-a {
    padding: 0 4px 20px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-brun-mid);
    max-width: 60ch;
  }
  .seo-faq-q:focus-visible {
    outline: 2px solid var(--color-sauge-text);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Pastille check sauge des fonctionnalités */
  .sup-check {
    display: block;
    width: 20px;
    height: 20px;
    background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='8' cy='8' r='7.25' stroke='%23889063' stroke-width='1.5'/%3E%3Cpath d='M4.5 8.2 L6.8 10.5 L11.5 5.5' stroke='%23889063' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-size: contain;
  }

  /* ── Anatomie : cases sélectionnables au clic ── */
  .anat-block {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    border-left: 3px solid #B8C4BB;
    border-radius: 12px;
    padding: 14px 20px;
    background: #FCFBF8;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: background 0.45s ease,
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.45s ease,
                border-color 0.3s ease,
                border-left-width 0.25s ease;
  }
  .anat-block .anat-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: #255C41;
    transition: color 0.3s ease;
  }
  .anat-block .anat-desc {
    display: block;
    margin-top: 3px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.45;
    color: #5C6259;
    transition: color 0.3s ease;
  }
  .anat-block:hover:not(.is-selected) {
    border-left-width: 6px;
    transform: translateX(3px);
  }
  .anat-block.is-selected {
    background: #255C41;
    border-left-color: transparent;
    transform: scale(1.025);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.24);
  }
  .anat-block.is-selected .anat-title { color: #FCFBF8; }
  .anat-block.is-selected .anat-desc { color: rgba(252, 251, 248, 0.95); }
  .anat-block:focus-visible {
    outline: 2px solid #FCFBF8;
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .anat-block {
      transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    }
    .anat-block:hover:not(.is-selected),
    .anat-block.is-selected { transform: none; }
  }
</style>

<script>
  /* Anatomie : une seule section sélectionnée à la fois.
     Délégation sur document : survit aux navigations View Transitions,
     liée une seule fois grâce au flag window. */
  if (!(window as Window & { __anatBound?: boolean }).__anatBound) {
    (window as Window & { __anatBound?: boolean }).__anatBound = true;
    document.addEventListener('click', (e) => {
      const block = (e.target as HTMLElement).closest('.anat-block');
      if (!block) return;
      const list = block.closest('.anat-list');
      if (!list) return;
      list.querySelectorAll('.anat-block').forEach((x) => {
        x.classList.remove('is-selected');
        x.setAttribute('aria-pressed', 'false');
      });
      block.classList.add('is-selected');
      block.setAttribute('aria-pressed', 'true');
    });
  }
</script>
