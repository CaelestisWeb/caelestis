---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { euros, formule } from '../../utils/tarifs';

const canonical = 'https://caelestis.fr/services/boutique-en-ligne';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: 'Boutique en ligne',
  serviceType: 'Création de boutique en ligne',
  description:
    "Création d'une boutique en ligne pour producteurs, artisans et commerçants : catalogue, paiement sécurisé et suivi des commandes. À partir de 2 500 €.",
  url: canonical,
  provider: { '@id': 'https://caelestis.fr/#business' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Auvergne-Rhône-Alpes' },
    { '@type': 'Country', name: 'France' },
  ],
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: '2500',
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
      description: 'Prix de départ',
    },
  },
};

/* Les questions qui reviennent avant de se lancer dans la vente en ligne :
   la charge de travail au quotidien, l'argent qui arrive vraiment sur le
   compte, et ce qui coûte en plus du site. Les taire ne les fait pas
   disparaître, elles ressortent au moment de signer. */
const faq = [
  {
    q: 'Combien de produits puis-je vendre ?',
    a: "Il n'y a pas de plafond technique. Le prix de départ couvre un catalogue courant, de quelques dizaines de références organisées en catégories. Au-delà de plusieurs centaines de produits, ou avec des variantes nombreuses (tailles, couleurs, contenances), le travail de structuration augmente et nous l'annonçons dans le devis.",
  },
  {
    q: 'Comment mes clients paient-ils, et quand je reçois l\'argent ?',
    a: "Le paiement se fait par carte bancaire sur votre boutique, via un prestataire agréé. L'argent arrive sur votre compte bancaire, en général sous quelques jours ouvrés. Chaque prestataire prélève une commission par transaction : elle n'est pas facturée par nous, elle est prélevée directement et nous vous indiquons son montant exact avant de choisir la solution.",
  },
  {
    q: 'Qui gère les commandes et les stocks au quotidien ?',
    a: "Vous. C'est votre commerce, et une commande qui arrive doit vous parvenir directement. Le rôle de la boutique est de rendre ce suivi simple : vous recevez chaque commande par e-mail, vous la retrouvez dans une interface claire, et vous mettez un produit en rupture en une manipulation. La prise en main se fait ensemble à la livraison.",
  },
  {
    q: 'Combien de temps avant que la boutique ouvre ?',
    a: "Comptez cinq à huit semaines. Le délai dépend surtout de vos fiches produits : photos, descriptions, prix, poids pour la livraison. C'est le poste qui prend le plus de temps, et c'est vous qui le tenez. Plus vos contenus sont prêts, plus la boutique ouvre tôt.",
  },
  {
    q: 'Que dois-je prévoir en plus du prix du site ?',
    a: "Trois postes récurrents : la commission du prestataire de paiement sur chaque vente, l'hébergement et la maintenance, et le transport de vos colis. Ils sont chiffrés dans le devis, sans surprise après coup. Nous vous dirons aussi franchement si votre volume de ventes prévu ne justifie pas encore une boutique.",
  },
  {
    q: 'Et si je préfère vendre sans boutique en ligne ?',
    a: "C'est parfois le bon choix. Une créatrice qui vend sur les marchés et par message n'a pas besoin d'un tunnel de paiement : un site vitrine avec une galerie soignée lui rapporte davantage, pour moins cher et moins de travail. Nous le disons quand c'est le cas, y compris quand cela nous fait vendre une formule moins chère.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://caelestis.fr/services' },
    { '@type': 'ListItem', position: 3, name: 'Boutique en ligne', item: canonical },
  ],
};

/* Le parcours d'achat, du côté du client. Chaque étape est un endroit où une
   vente se perd si elle est mal traitée. */
const parcours = [
  { t: 'Le catalogue', d: 'Vos produits classés par catégories, avec des filtres quand il y en a beaucoup. Trouvable en deux clics.' },
  { t: 'La fiche produit', d: 'Photos, description précise, prix, et les frais de livraison annoncés dès cet écran. Une information manquante fait fermer la page.' },
  { t: 'Le panier', d: 'Le total, les frais et le délai, sans surprise à la dernière étape.' },
  { t: 'Le paiement', d: 'Carte bancaire, sécurisé, en quelques champs. Aucun compte à créer obligatoirement.' },
  { t: 'La confirmation', d: 'Un e-mail récapitulatif avec la référence de commande, pour votre client comme pour vous.' },
];

const inclus = [
  'Votre catalogue de produits en ligne, organisé par catégories.',
  'Paiement sécurisé par carte bancaire pour vos clients.',
  'Commandes simples à suivre au quotidien.',
  'Frais et délais de livraison affichés dès la fiche produit.',
  'Sauvegarde automatique de votre catalogue et de vos commandes.',
  'Prise en main faite ensemble à la livraison.',
];
---

<BaseLayout
  title="Boutique en ligne, vendre vos produits en direct, Caelestis"
  description="Catalogue, paiement sécurisé et suivi des commandes, simple à tenir au quotidien. Ouverte en cinq à huit semaines, sans commission de plateforme."
  canonical={canonical}
  schema={[schema, breadcrumb, faqSchema]}
>

  <!-- ── Hero ── -->
  <section class="pt-20 pb-16 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark section-ambient overflow-hidden relative" style="isolation: isolate;">
    <div aria-hidden="true" class="light-blob light-blob-sauge pointer-events-none absolute -top-20 -right-24 w-[420px] h-[420px]"></div>
    <div aria-hidden="true" class="light-blob light-blob-ocre pointer-events-none absolute bottom-0 left-1/4 w-56 h-56"></div>

    <div class="max-w-4xl mx-auto relative text-center">
      <div class="inline-flex items-center gap-2 mb-6" data-reveal>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sauge"></span>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge">Boutique en ligne, pour vendre</p>
      </div>
      <h1
        class="font-display font-light text-brun leading-[1.06] tracking-tight max-w-3xl mx-auto"
        style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
        data-reveal data-delay="1"
      >
        Vos produits en vente,<br class="hidden sm:block"> <span class="text-sauge">jour et nuit.</span>
      </h1>
      <p class="font-body text-lg text-brun-mid mt-8 max-w-2xl leading-relaxed mx-auto" data-reveal data-delay="2">
        Vendez directement sur votre site grâce à une boutique simple, claire et facile à tenir au quotidien. Sans commission prélevée par une plateforme sur chacune de vos ventes.
      </p>

      <!-- Prix -->
      <div class="mt-9 inline-flex flex-col items-center" data-reveal data-delay="2">
        <p class="font-body text-xs tracking-[0.16em] uppercase text-brun-mid mb-1">À partir de</p>
        <p class="font-display font-light text-brun leading-none" style="font-size: clamp(2.6rem, 6vw, 3.6rem); letter-spacing: -0.025em;">
          <span class="text-sauge">{euros(formule('boutique-en-ligne').prix)}</span><span class="text-bois-mid text-2xl ml-1">€</span>
        </p>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-4" data-reveal data-delay="3">
        <Button href="/contact#devis" variant="primary">Demander un devis</Button>
        <Button href="/outils/simulateur" variant="outline">Estimer mon projet</Button>
      </div>
    </div>
  </section>

  <!-- ── En clair : c'est quoi ? ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-b border-cream-dark">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display font-light text-brun leading-tight mb-8" style="font-size: clamp(1.7rem, 3.4vw, 2.6rem);" data-reveal>
        Votre commerce,<br class="hidden sm:block"> sans intermédiaire.
      </h2>
      <div class="space-y-5 font-body text-base text-brun-mid leading-relaxed" data-reveal data-delay="1">
        <p>
          Une miellerie qui vend sur une place de marché en ligne y laisse une commission sur chaque pot.
          Sur sa propre boutique, elle garde sa marge, ses clients et ses adresses e-mail.
          C'est ce que change une boutique : vous cessez de louer votre commerce à quelqu'un d'autre.
        </p>
        <p>
          Techniquement, c'est un <a href="/services/site-vitrine" class="text-sauge underline underline-offset-4 decoration-sauge/40 hover:decoration-sauge transition-colors">site vitrine</a>
          auquel s'ajoutent un catalogue, un panier et un paiement. Vous gardez donc tout ce qui fait un bon site,
          et vous y ajoutez la vente.
        </p>
        <p>
          La question à se poser avant de se lancer n'est pas technique, elle est commerciale :
          avez-vous assez de volume pour que la boutique se rembourse ? Nous en parlons franchement au cadrage,
          et il nous arrive de recommander une formule moins chère.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Le parcours d'achat ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 bg-brun text-cream section-dark-depth">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-display font-light leading-tight mb-4" style="font-size: clamp(1.7rem, 3.4vw, 2.6rem);" data-reveal>
        Le chemin jusqu'à la vente.
      </h2>
      <p class="font-body text-base text-cream/70 leading-relaxed mb-12 max-w-2xl" data-reveal data-delay="1">
        Cinq étapes, cinq endroits où une vente se perd quand c'est mal fait. Chacune est traitée avec le même soin.
      </p>

      <ol class="space-y-0" role="list">
        {parcours.map((p, i) => (
          <li class="grid grid-cols-[auto_1fr] gap-6 py-6 border-b border-cream/15" data-reveal data-delay={String(i % 3)}>
            <span class="font-display text-cream/35 text-xl leading-none pt-1" style="font-variant-numeric: tabular-nums;">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display text-lg text-cream mb-1.5">{p.t}</h3>
              <p class="font-body text-sm text-cream/70 leading-relaxed">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Ce qui est compris ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-b border-cream-dark">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display font-light text-brun leading-tight mb-10" style="font-size: clamp(1.7rem, 3.4vw, 2.6rem);" data-reveal>
        Ce qui est compris.
      </h2>

      <ul class="space-y-4 mb-12" role="list">
        {inclus.map((item, i) => (
          <li class="flex items-start gap-4 font-body text-base text-brun-mid leading-relaxed" data-reveal data-delay={String(i % 3)}>
            <svg aria-hidden="true" class="shrink-0 mt-1.5" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-sauge, #6B8F71);">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <div class="border-t border-cream-dark pt-8">
        <p class="font-body text-sm text-brun-mid leading-relaxed">
          <strong class="text-brun font-medium">Cinq à huit semaines</strong> entre le premier échange et l'ouverture,
          selon le nombre de produits et la disponibilité de vos fiches. Le devis annonce un prix ferme et une date.
          Voir <a href="/realisations" class="text-sauge underline underline-offset-4 decoration-sauge/40 hover:decoration-sauge transition-colors">ce que nous avons déjà livré</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FAQ : les objections propres à la formule ── -->
  <section class="py-20 px-6 md:px-10 lg:px-20 border-b border-cream-dark">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display font-light text-brun leading-tight mb-10" style="font-size: clamp(1.7rem, 3.4vw, 2.6rem);" data-reveal>
        Ce qu'on nous demande souvent.
      </h2>

      <div class="divide-y divide-cream-dark border-y border-cream-dark">
        {faq.map((f, i) => (
          <details class="group py-5" data-reveal data-delay={String(i % 3)}>
            <summary class="flex items-start justify-between gap-6 cursor-pointer list-none font-display text-lg text-brun leading-snug">
              <span>{f.q}</span>
              <span aria-hidden="true" class="shrink-0 mt-1 text-sauge transition-transform duration-300 group-open:rotate-45">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="font-body text-base text-brun-mid leading-relaxed mt-4 pr-10">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <AppelFinal
    titre="Prêt à vendre"
    titreAccent="en direct ?"
    texte="Parlons de vos produits, de vos volumes et de votre calendrier. Devis gratuit, réponse sous 48 heures."
    href="/contact#devis"
    libelle="Demander un devis"
  />

</BaseLayout>
