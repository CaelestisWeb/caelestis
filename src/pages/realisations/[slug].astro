---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import { realisations } from '../../data/realisations';

export function getStaticPaths() {
  return realisations.map((realisation) => ({
    params: { slug: realisation.slug },
    props: { realisation },
  }));
}

const { realisation } = Astro.props;
const {
  nom, metier, ville, url, annee, titre, accroche, situation,
  besoins, reponses, livre, temoignage, images,
} = realisation;

const pageUrl = `https://caelestis.fr/realisations/${realisation.slug}`;

// Une étude de cas est le contenu le plus cité par les moteurs IA quand on
// leur demande « qui a déjà fait ce genre de site ». Elle est donc décrite
// finement : qui a fait le travail (Caelestis, par identifiant partagé avec
// toutes les autres pages), pour qui, où, avec quoi, et ce qui est en service.
// Le témoignage n'est volontairement PAS balisé en Review : un avis publié sur
// son propre site à son propre sujet n'est pas reconnu par les moteurs, et le
// baliser ainsi serait au mieux ignoré, au pire trompeur.
const etudeDeCas = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${pageUrl}#etude-de-cas`,
  name: titre,
  headline: titre,
  description: situation,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  inLanguage: 'fr-FR',
  dateCreated: `${annee}-01-01`,
  datePublished: `${annee}-01-01`,
  ...(images[0] ? { image: new URL(images[0].src.src, 'https://caelestis.fr').href } : {}),
  creator: { '@id': 'https://caelestis.fr/#business' },
  author: { '@id': 'https://caelestis.fr/#business' },
  // Mots-clés du métier et du territoire, pas de la technique employée : c'est
  // ainsi qu'un futur client formule sa recherche, et la stack n'intéresse
  // personne d'autre que celui qui l'a écrite.
  keywords: [metier, ville, 'création de site internet', 'Drôme'].join(', '),
  about: {
    '@type': 'LocalBusiness',
    name: nom,
    description: metier,
    url,
    address: {
      '@type': 'PostalAddress',
      addressLocality: ville,
      addressRegion: 'Drôme',
      addressCountry: 'FR',
    },
  },
  // Ce qui est réellement en service aujourd'hui, constatable par n'importe qui.
  workExample: livre.map((element) => ({ '@type': 'CreativeWork', name: element })),
};

const filAriane = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Réalisations', item: 'https://caelestis.fr/realisations' },
    { '@type': 'ListItem', position: 3, name: nom, item: pageUrl },
  ],
};

const schema = [etudeDeCas, filAriane];

/* Le métier est saisi capitalisé dans les données (« Prothésiste ongulaire »).
   Il passe ici au milieu d'une phrase, donc en minuscule, avec l'élision qui
   s'impose devant une voyelle : « site internet d'apiculteur », jamais
   « de apiculteur ». Le h muet est traité comme une voyelle (« d'horticulteur »). */
const metierEnPhrase = metier.charAt(0).toLowerCase() + metier.slice(1);
const article = /^[aàâeéèêëiîïoôuùûyh]/i.test(metierEnPhrase) ? "d'" : 'de ';
---

<!-- Gabarits de title et de description calibrés pour rester sous 60 et 155
     caractères, y compris avec un nom de commune long.

     Le MÉTIER ouvre le title, avant le nom du client : c'est le mot que tape
     un prospect (« site internet de prothésiste »), et personne ne cherche le
     nom d'une enseigne qu'il ne connaît pas encore. Chaque étude de cas
     devient ainsi la page métier de son métier, sans qu'aucune page ait à
     être inventée : la couverture s'étend d'elle-même à chaque client livré.
     Décision de Célestin, 01/08/2026.

     La ville sort du title faute de place, mais elle n'est pas perdue : les
     accroches la portent déjà (« à Crest », « dans la Drôme »), donc elle
     reste dans la description. Vérifier ce point en écrivant toute nouvelle
     accroche. -->
<BaseLayout
  title={`Site internet ${article}${metierEnPhrase}, ${nom}`}
  description={`${accroche} Étude de cas ${annee}, le site est en ligne.`}
  canonical={`https://caelestis.fr/realisations/${realisation.slug}`}
  schema={schema}
>

  <!-- ─── EN-TÊTE ─── -->
  <section class="pt-20 pb-14 md:pt-24 px-6 md:px-10 lg:px-20">
    <div class="max-w-4xl mx-auto">

      <nav aria-label="Fil d'ariane" class="font-body text-xs text-brun-mid mb-8">
        <a href="/" class="hover:text-sauge-text transition-colors">Accueil</a>
        <span class="mx-2 text-cream-dark" aria-hidden="true">/</span>
        <a href="/realisations" class="hover:text-sauge-text transition-colors">Réalisations</a>
        <span class="mx-2 text-cream-dark" aria-hidden="true">/</span>
        <span class="text-brun">{nom}</span>
      </nav>

      <p class="inline-block font-body text-xs tracking-[0.22em] uppercase text-sauge border border-sauge/40 rounded-full px-4 py-1.5 mb-7">
        {metier}, {ville}
      </p>

      <h1 class="font-display text-3xl md:text-5xl text-brun leading-[1.08] mb-6">
        {titre}
      </h1>

      <p class="font-body text-lg text-brun-mid max-w-[62ch] leading-relaxed">
        {situation}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href={url} variant="primary">Voir le site en ligne</Button>
        <span class="font-body text-sm text-brun-mid">{annee}</span>
      </div>

    </div>
  </section>

  <!-- ─── VISUEL PRINCIPAL ─── -->
  {images.length > 0 && (
    <section class="px-6 md:px-10 lg:px-20 pb-16">
      <figure class="max-w-5xl mx-auto">
        <Image
          src={images[0].src}
          alt={images[0].alt}
          widths={[640, 960, 1440]}
          sizes="(max-width: 1024px) 100vw, 1024px"
          class="w-full h-auto rounded-sm border border-cream-dark"
          loading="eager"
        />
        <figcaption class="font-body text-sm text-brun-mid mt-3">{images[0].legende}</figcaption>
      </figure>
    </section>
  )}

  <!-- ─── LA BASCULE : le problème en regard de la réponse ───
       Posé le 07/08/2026. Les deux listes vivaient dans deux sections
       successives, séparées par un filet et 160 px de blanc : le lecteur les
       lisait l'une après l'autre sans jamais voir que la seconde répond à la
       première. Mises en regard, la correspondance se lit d'un coup d'œil.
       Les deux listes n'ont pas le même nombre d'items (cinq besoins pour sept
       réponses chez Fée des Ongles) et c'est voulu : une contrainte appelle
       parfois deux réponses. Elles ne sont donc pas appariées ligne à ligne, la
       colonne de gauche pose l'état de départ, celle de droite ce qui a été
       construit. Ne pas forcer un appariement strict dans les données, il
       obligerait à réécrire le contenu de chaque réalisation à venir.
       Gain de hauteur mesuré : 1 126 px pour les deux anciennes sections,
       contre une seule ici. -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark section-ambient" aria-labelledby="bascule-title">
    <div class="max-w-5xl mx-auto">

      <h2 id="bascule-title" class="sr-only">Le problème de départ et ce qui a été construit</h2>

      <div class="cas-bascule">

        <div class="cas-col cas-col-avant">
          <p class="cas-col-tete font-body">Au départ</p>
          <h3 class="font-display text-brun">Ce qu'il fallait résoudre</h3>
          <ul class="cas-liste cas-liste-avant font-body">
            {besoins.map((besoin) => <li>{besoin}</li>)}
          </ul>
        </div>

        <!-- Le filet de bascule. Décoratif : la lecture reste celle des deux
             colonnes, dans l'ordre du document. -->
        <div class="cas-filet" aria-hidden="true">
          <span class="cas-filet-trait"></span>
          <span class="cas-filet-fleche">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
          <span class="cas-filet-trait"></span>
        </div>

        <div class="cas-col cas-col-apres">
          <p class="cas-col-tete font-body">Ce qui a été fait</p>
          <h3 class="font-display text-brun">Ce qui a été construit</h3>
          <ul class="cas-liste cas-liste-apres font-body">
            {reponses.map((reponse) => <li>{reponse}</li>)}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── SECOND VISUEL ─── -->
  {images.length > 1 && (
    <section class="px-6 md:px-10 lg:px-20 pb-4">
      <figure class="max-w-5xl mx-auto">
        <Image
          src={images[1].src}
          alt={images[1].alt}
          widths={[640, 960, 1440]}
          sizes="(max-width: 1024px) 100vw, 1024px"
          class="w-full h-auto rounded-sm border border-cream-dark"
          loading="lazy"
        />
        <figcaption class="font-body text-sm text-brun-mid mt-3">{images[1].legende}</figcaption>
      </figure>
    </section>
  )}

  <!-- ─── CE QUI TOURNE AUJOURD'HUI ─── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark bg-brun text-cream section-dark-depth mt-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-display text-2xl md:text-3xl mb-8">Ce qui tourne aujourd'hui</h2>
      <ul class="cas-livre font-body">
        {livre.map((ligne) => <li>{ligne}</li>)}
      </ul>
      <p class="font-body text-sm text-cream/60 mt-9">
        Constats vérifiables sur le site en ligne. Aucun chiffre de fréquentation ni de
        chiffre d'affaires n'est avancé ici : ces données appartiennent au client.
      </p>
    </div>
  </section>

  <!-- ─── TÉMOIGNAGE ─── -->
  {temoignage && (
    <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
      <blockquote class="max-w-3xl mx-auto text-center">
        <p class="font-display text-xl md:text-2xl text-brun leading-relaxed">
          « {temoignage.texte} »
        </p>
        <footer class="font-body text-sm text-brun-mid mt-6">{temoignage.auteur}</footer>
      </blockquote>
    </section>
  )}

  <!-- ─── APPEL À L'ACTION ─── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 text-center section-ambient border-t border-cream-dark">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl text-brun leading-tight mb-5">
        Un besoin proche du sien ?
      </h2>
      <p class="font-body text-base text-brun-mid mb-9">
        Décrivez votre activité, je vous dis en un appel ce qui est réalisable,
        dans quel délai et à quel prix.
      </p>
      <Button href="/contact" variant="primary">Parler de mon projet</Button>
    </div>
  </section>

</BaseLayout>

<style>
  .cas-liste { display: grid; gap: 1.05rem; }
  .cas-liste li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--color-brun-mid);
    line-height: 1.6;
  }
  .cas-liste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.55rem;
    height: 1px;
    background: var(--color-sauge-text);
  }

  .cas-livre { display: grid; gap: 0.95rem; }
  .cas-livre li {
    position: relative;
    padding-left: 1.9rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-cream) 88%, transparent);
  }
  .cas-livre li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.85rem;
    height: 0.45rem;
    border-left: 1.5px solid var(--color-sauge);
    border-bottom: 1.5px solid var(--color-sauge);
    transform: rotate(-45deg);
  }

  /* ═══ La bascule : le problème en regard de la réponse ═══
     Deux colonnes séparées par un filet fléché sur desktop ; empilées en
     mobile, où le filet devient horizontal et la flèche pointe vers le bas. */
  .cas-bascule {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 880px) {
    .cas-bascule { grid-template-columns: 1fr auto 1fr; gap: 40px; }
  }

  .cas-col-tete {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-bottom: 10px;
  }
  .cas-col h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.65rem);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 22px;
  }

  /* La colonne de départ est en retrait : c'est l'état que le projet a quitté. */
  .cas-col-avant { opacity: 0.86; }
  .cas-liste-avant li::before { background: var(--color-pierre); }

  /* Celle d'arrivée porte la couleur : c'est ce qui a été construit. */
  .cas-liste-apres li { color: var(--color-brun); }
  .cas-liste-apres li::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    top: 0.52em;
    background: var(--color-sauge-text);
  }

  .cas-filet {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .cas-filet-trait {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-sauge), transparent);
  }
  .cas-filet-fleche {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--color-sauge);
    color: var(--color-sauge-text);
    background: var(--color-cream);
    transform: rotate(90deg);
  }
  .cas-filet-fleche svg { width: 15px; height: 15px; }

  @media (min-width: 880px) {
    .cas-filet { flex-direction: column; align-self: stretch; padding: 46px 0 8px; }
    .cas-filet-trait { flex: 1; width: 1px; height: auto; background: linear-gradient(180deg, transparent, var(--color-sauge), transparent); }
    .cas-filet-fleche { transform: none; }
  }
</style>
