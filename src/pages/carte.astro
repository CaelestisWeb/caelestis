---
/**
 * /carte : la page que vise le code QR de la carte de visite.
 *
 * Un geste, une action. Qui scanne la carte tombe sur des boutons pleine
 * largeur, taillés pour le pouce : appeler, envoyer un message, écrire un
 * courriel, ouvrir le site, voir la fiche Google. Aucune saisie, aucun compte.
 *
 * L'adresse est FIGÉE : une carte imprimée ne se met pas à jour. Tant qu'il
 * reste des cartes en circulation, cette page garde son chemin `/carte`. On
 * peut la réhabiller, jamais la déplacer. C'est ce qui la rend préférable à un
 * QR qui pointerait droit sur la fiche Google : ici, ce que fait la carte se
 * change sans réimprimer, et le SMS comme le courriel restent possibles.
 *
 * noindex : ce n'est pas une page de site, c'est la destination d'un objet
 * imprimé. Elle n'a rien à faire dans les résultats de recherche.
 *
 * Coordonnées : src/data/entite.ts, source unique. Le numéro, le courriel et la
 * fiche de la carte, de la page et des schémas sortent du même endroit.
 *
 * Volontairement dépouillée : une seule colonne, les actions et rien d'autre.
 * Qui scanne veut joindre, pas lire. Les modules latéraux essayés ont été
 * retirés, ils encombraient la seule chose qui compte ici.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, FICHE_GOOGLE_PARTAGE, PROFILS } from '../data/entite';

/* La fiche Google via le lien de PARTAGE officiel (share.google), le seul qui
   ouvre le panneau de façon fiable sur mobile. Les formes construites à la main
   (`kgmid`, `ludocid`, `q=…&ludocid=`) marchaient sur ordinateur mais échouaient
   sur téléphone. Le lien vient de entite.ts (FICHE_GOOGLE_PARTAGE). */
const ficheGoogle = FICHE_GOOGLE_PARTAGE;

/* Les réseaux proposés par la carte dépliante « Réseaux sociaux » sont ceux de
   src/data/entite.ts (PROFILS), la même liste que le schema.org du site : une
   seule source, aucun compte inventé. On y attache le nom et l'ordre d'affichage
   en repérant le domaine ; ajouter un réseau, c'est ajouter son URL à PROFILS.
   LinkedIn apparaîtra dès que son adresse y sera. */
const RESEAUX_CONNUS = [
  { cle: 'instagram.com', nom: 'Instagram' },
  { cle: 'facebook.com', nom: 'Facebook' },
  { cle: 'tiktok.com', nom: 'TikTok' },
  { cle: 'linkedin.com', nom: 'LinkedIn' },
];
const reseaux = RESEAUX_CONNUS
  .map((r) => ({ nom: r.nom, href: PROFILS.find((u) => u.includes(r.cle)) }))
  .filter((r) => r.href);

const actions = [
  { href: `tel:${CONTACT.telephone}`, label: 'Appeler', detail: CONTACT.telephoneAffiche, primaire: true, externe: false, icone: 'telephone' },
  { href: `sms:${CONTACT.telephone}`, label: 'Envoyer un message', detail: CONTACT.telephoneAffiche, primaire: false, externe: false, icone: 'message' },
  { href: `mailto:${CONTACT.email}`, label: 'Envoyer un courriel', detail: CONTACT.email, primaire: false, externe: false, icone: 'courriel' },
  { href: '/', label: 'Visiter le site', detail: 'caelestis.fr', primaire: false, externe: false, icone: 'site' },
  { href: ficheGoogle, label: 'Fiche Google', detail: 'Mon établissement', primaire: false, externe: true, icone: 'lieu' },
];

---
<BaseLayout
  title="Contact, Caelestis"
  description="Joindre Caelestis en un geste : appeler, envoyer un message, écrire un courriel, ouvrir le site ou voir la fiche Google."
  noindex={true}
>
  <section class="flex justify-center px-6 pt-5 pb-10">
    <div class="w-full max-w-md mx-auto text-center">

        <!-- L'Écran planté, la géométrie exacte du signe (identite/marque/signe/
             signe-vert.svg) : écran en contour, col fuselé plein qui plonge de
             quatre unités dans la ligne de sol, sans le trou de l'ancien dessin. -->
        <svg aria-hidden="true" class="mx-auto mb-4" width="46" height="44" viewBox="8.25 4.25 83.5 79.75" fill="none">
          <path d="M12 15A7 7 0 0 1 19 8L81 8A7 7 0 0 1 88 15L88 49A7 7 0 0 1 81 56L19 56A7 7 0 0 1 12 49Z" fill="none" stroke="#255C41" stroke-width="7.5"/>
          <path d="M44.5 56L40.5 80L59.5 80L55.5 56Z" fill="#255C41"/>
          <rect x="16" y="76" width="68" height="8" rx="4" fill="#255C41"/>
        </svg>

        <p class="font-body text-[11px] tracking-[0.22em] uppercase text-sauge-text mb-2">Caelestis</p>
        <p class="font-body text-base text-brun-mid mb-6">
          Création de sites internet, fiches Google et référencement
        </p>

        <nav aria-label="Moyens de contact" class="flex flex-col gap-2 text-left">
          {actions.map((a) => (
            <a
              href={a.href}
              target={a.externe ? '_blank' : undefined}
              rel={a.externe ? 'noopener noreferrer' : undefined}
              class={`carte-action group flex items-center gap-4 rounded-2xl px-5 py-2.5 min-h-[52px] transition-all duration-300 ${
                a.primaire
                  ? 'bg-[#255C41] text-cream hover:bg-[#1B4733]'
                  : 'bg-cream border border-sauge/60 text-brun hover:border-[#255C41]'
              }`}
            >
              <span class={`shrink-0 ${a.primaire ? 'text-cream' : 'text-ocre'}`}>
                {a.icone === 'telephone' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6.5 3.5h3l1.4 4-2 1.4a11 11 0 0 0 5.2 5.2l1.4-2 4 1.4v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"/>
                  </svg>
                )}
                {a.icone === 'message' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 5.5h16v10H8l-4 3.5V5.5Z"/>
                    <path d="M8.5 10.2h7M8.5 12.8h4.5"/>
                  </svg>
                )}
                {a.icone === 'courriel' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3.5" y="5" width="17" height="14" rx="2.2"/>
                    <path d="M4 6.5 12 12l8-5.5"/>
                  </svg>
                )}
                {a.icone === 'site' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.5"/>
                    <path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.3 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.3-3.6-8.5S9.6 5.8 12 3.5Z"/>
                  </svg>
                )}
                {a.icone === 'lieu' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 21s6.5-5.4 6.5-10.5A6.5 6.5 0 0 0 5.5 10.5C5.5 15.6 12 21 12 21Z"/>
                    <circle cx="12" cy="10.3" r="2.4"/>
                  </svg>
                )}
              </span>
              <span class="flex flex-col leading-tight">
                <span class="font-display font-bold text-[17px] tracking-tight">{a.label}</span>
                <span class={`font-body text-[13px] ${a.primaire ? 'text-cream/80' : 'text-brun-mid'}`}>{a.detail}</span>
              </span>
              <span class={`ml-auto shrink-0 transition-transform duration-300 group-hover:translate-x-0.5 ${a.primaire ? 'text-cream/70' : 'text-sauge-text'}`} aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
            </a>
          ))}

          <!-- Carte dépliante : un seul geste ouvre les réseaux, sans quitter
               la page. `<details>` natif, sans script : le chevron pivote à
               l'ouverture, les liens s'ouvrent dans un nouvel onglet. -->
          <details class="reseaux group rounded-2xl border border-sauge/60 bg-cream text-brun overflow-hidden">
            <summary class="flex items-center gap-4 px-5 py-2.5 min-h-[52px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="shrink-0 text-ocre">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="7" cy="12" r="2.4"/>
                  <circle cx="17" cy="6.5" r="2.4"/>
                  <circle cx="17" cy="17.5" r="2.4"/>
                  <path d="M9.1 10.9 14.9 7.6M9.1 13.1 14.9 16.4"/>
                </svg>
              </span>
              <span class="flex flex-col leading-tight">
                <span class="font-display font-bold text-[17px] tracking-tight">Réseaux sociaux</span>
                <span class="font-body text-[13px] text-brun-mid">{reseaux.map((r) => r.nom).join(', ')}</span>
              </span>
              <span class="ml-auto shrink-0 text-sauge-text transition-transform duration-300 group-open:rotate-90" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
            </summary>
            <div class="flex flex-col px-4 pb-3 pt-0.5">
              {reseaux.map((r) => (
                <a
                  href={r.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/lien flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors duration-200 hover:bg-sauge-pale"
                >
                  <span class="shrink-0 text-ocre">
                    {r.nom === 'Instagram' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3.5" y="3.5" width="17" height="17" rx="4.6"/>
                        <circle cx="12" cy="12" r="4"/>
                        <circle cx="17.1" cy="6.9" r="1.1" fill="currentColor" stroke="none"/>
                      </svg>
                    )}
                    {r.nom === 'Facebook' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M14 8.6V6.9c0-.75.22-1.15 1.25-1.15H16.6V3.05C16.2 3 15.35 3 14.45 3c-1.98 0-3.25 1.15-3.25 3.4v2.2H9v2.85h2.2V21h2.8v-9.55h2.35l.37-2.85H14Z"/>
                      </svg>
                    )}
                    {r.nom === 'LinkedIn' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M5.4 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM3.8 8.9h3.2V21H3.8V8.9Zm5.3 0h3.06v1.65h.05c.43-.77 1.47-1.58 3.02-1.58 3.23 0 3.83 2.02 3.83 4.65V21h-3.2v-5.35c0-1.28-.02-2.92-1.9-2.92-1.9 0-2.19 1.4-2.19 2.83V21H9.1V8.9Z"/>
                      </svg>
                    )}
                    {r.nom === 'TikTok' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M16.5 3c.32 2.02 1.5 3.4 3.5 3.6v2.53c-1.28 0-2.48-.4-3.5-1.1v5.87c0 2.9-2.1 5.1-5 5.1s-5-2.2-5-5c0-2.83 2.3-5.1 5.2-4.94v2.6a2.32 2.32 0 1 0 2.3 2.3V3h2.5Z"/>
                      </svg>
                    )}
                  </span>
                  <span class="font-body text-[15px] text-brun">{r.nom}</span>
                  <span class="ml-auto shrink-0 text-sauge-text transition-transform duration-200 group-hover/lien:translate-x-0.5" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7M9 7h8v8"/>
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </details>
        </nav>

        <p class="font-body text-base text-brun-mid mt-7 mb-2">
          Agence web au service du vivant et des métiers de passion, en Auvergne-Rhône-Alpes.
        </p>
        <h1 class="font-display font-bold text-brun leading-[1.1] tracking-tight" style="font-size: clamp(1.9rem, 6vw, 2.5rem);">
          Célestin Fruleux
        </h1>
    </div>
  </section>
</BaseLayout>
