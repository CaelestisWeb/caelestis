---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanteFormulaire from '../components/PlanteFormulaire.astro';
import FormulaireEnvoye from '../components/FormulaireEnvoye.astro';

const breadcrumbContact = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://caelestis.fr/contact' },
  ],
};

// Quand un moteur IA répond « comment les joindre », c'est cette page qu'il
// doit pouvoir citer avec les bonnes coordonnées. Elles sont donc déclarées
// ici, rattachées à l'entité unique du site par son identifiant, et non
// redéclarées en double : une seule entreprise, une seule fiche.
const pageContact = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': 'https://caelestis.fr/contact#page',
  url: 'https://caelestis.fr/contact',
  name: 'Contacter Caelestis',
  description:
    'Demander un devis gratuit pour la création d\'un site internet ou une prestation de référencement naturel. Réponse sous 48h.',
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ProfessionalService',
    '@id': 'https://caelestis.fr/#business',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
    email: 'contact@caelestis.fr',
    telephone: '+33769362727',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Crest',
      addressRegion: 'Drôme',
      postalCode: '26400',
      addressCountry: 'FR',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Demande de devis',
      email: 'contact@caelestis.fr',
      telephone: '+33769362727',
      availableLanguage: 'fr',
      areaServed: 'FR',
    },
  },
};

---
<BaseLayout
  title="Demander un devis gratuit, contacter Caelestis"
  description="Décrivez votre projet en quelques lignes, réponse sous 48h. Par téléphone au 07 69 36 27 27 ou par e-mail, du lundi au samedi, 9h à 18h."
  schema={[breadcrumbContact, pageContact]}
>

  <!-- ─── INTRO ÉDITORIALE ─── -->
  <section class="pt-20 pb-14 md:pt-24 px-6 md:px-10 lg:px-20 border-b border-cream-dark">
    <div class="max-w-6xl mx-auto text-center">

      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-5" data-reveal>Contact</p>
      <h1
        class="font-display font-light text-brun leading-[1.05] tracking-[-0.02em] mb-5"
        style="font-size: clamp(2.1rem, 5vw, 3.9rem);"
        data-reveal data-delay="1"
      >
        Racontez-nous<br>ce que vous faites.
      </h1>
      <p class="font-body text-base text-brun-mid leading-relaxed" data-reveal data-delay="2">
        Parlez-nous de votre projet.<br>On revient vers vous sous 48h.
      </p>

    </div>
  </section>


  <!-- ─── CONTENU ─── -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20">
    <div class="max-w-6xl mx-auto flex flex-col">

      <!-- ── Coordonnées — vertical SOUS le formulaire en mobile, strip horizontal AU-DESSUS en desktop ── -->
      <div class="order-2 sm:order-1 sm:mb-14 sm:pb-14 sm:border-b sm:border-cream-dark">
        <p class="hidden sm:block text-center font-display text-xl sm:text-2xl font-light text-brun mb-10" data-reveal>
          L&rsquo;essentiel pour nous joindre
        </p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-y-7 sm:gap-x-10 mt-14 sm:mt-0 text-center" data-reveal>
        <a href="mailto:contact@caelestis.fr" class="group">
          <span class="block font-body text-[11px] tracking-[0.22em] indent-[0.22em] uppercase text-sauge mb-1.5">Email</span>
          <span class="font-display text-base font-light text-brun group-hover:text-ocre transition-colors duration-200">contact@caelestis.fr</span>
        </a>

        <span class="hidden sm:block w-px h-9 bg-cream-dark" aria-hidden="true"></span>

        <a href="tel:+33769362727" class="group">
          <span class="block font-body text-[11px] tracking-[0.22em] indent-[0.22em] uppercase text-sauge mb-1.5">Téléphone</span>
          <span class="font-display text-base font-light text-brun group-hover:text-ocre transition-colors duration-200">07 69 36 27 27</span>
        </a>

        <span class="hidden sm:block w-px h-9 bg-cream-dark" aria-hidden="true"></span>

        <div>
          <span class="block font-body text-[11px] tracking-[0.22em] indent-[0.22em] uppercase text-sauge mb-1.5">Localisation</span>
          <span class="font-display text-base font-light text-brun">Drôme, France</span>
        </div>

        <span class="hidden sm:block w-px h-9 bg-cream-dark" aria-hidden="true"></span>

        <div>
          <span class="block font-body text-[11px] tracking-[0.22em] indent-[0.22em] uppercase text-sauge mb-1.5">Horaires</span>
          <span class="font-display text-base font-light text-brun">Du lundi au samedi, 9h à 18h</span>
        </div>
        </div>
      </div>

      <!-- ── Formulaire — centré et resserré ── -->
      <div class="max-w-xl w-full min-w-0 mx-auto order-1 sm:order-2" data-reveal data-delay="1">

        <!-- Sélecteur : une question posée, trois réponses qui annoncent
             chacune ce qui se passe ensuite. -->
        <p class="selecteur-titre font-display text-xl sm:text-2xl font-light text-brun">Que préférez-vous&nbsp;?</p>
        <div class="selecteur grid sm:grid-cols-3 gap-3 mb-8" role="tablist" aria-label="Type de contact">
          {[
            { id: 'message', label: 'Écrire un message', detail: 'Écrivez-nous, on vous répond avec plaisir.' },
            { id: 'appel',   label: 'Être rappelé',      detail: 'On vous rappelle quand cela vous arrange.' },
            { id: 'devis',   label: 'Recevoir un devis', detail: 'On vous envoie un devis clair et chiffré sous 48h.' },
          ].map(({ id, label, detail }) => (
            <button
              type="button"
              id={`tab-${id}`}
              data-tab={id}
              role="tab"
              aria-selected={id === 'message' ? 'true' : 'false'}
              aria-controls={`panel-${id}`}
              class={`tab-btn${id === 'message' ? ' is-active' : ''}`}
            >
              <span class="tab-titre">{label}</span>
              <span class="tab-detail">{detail}</span>
            </button>
          ))}
        </div>

        <!-- Wrapper commun -->
        <div class="bg-cream border-2 border-cream-dark rounded-2xl p-5 sm:p-8 md:p-10">

          <!-- ══ FORMULAIRE 1 — Message ══ -->
          <div id="panel-message" role="tabpanel" aria-labelledby="tab-message" class="tab-panel">
            <div class="mb-7 pb-7 border-b border-cream-dark flex items-end justify-between gap-6">
              <div>
                <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-1.5">Message</p>
                <p class="font-display text-2xl font-light text-brun">Écrivez-nous,<br>on vous lit.</p>
              </div>
              <PlanteFormulaire id="plant-message" prefixe="msg" />
            </div>

            <FormulaireEnvoye id="success-message" titre="Message envoyé !" suite="On vous répond sous 48h." />

            <form id="form-message" class="space-y-5" novalidate>
              <input type="hidden" name="formType" value="message" />
              <!-- Honeypot anti-bot : doit rester vide, caché des utilisateurs réels -->
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;width:1px;height:1px;" />
              <!-- Horodatage anti-bot : rempli en JS au chargement, vérifié côté serveur -->
              <input type="hidden" name="ts" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="msg-prenom" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Prénom <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                  <input type="text" id="msg-prenom" name="prenom" autocomplete="given-name" placeholder="Votre prénom" aria-required="true"
                    class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
                </div>
                <div>
                  <label for="msg-nom" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Nom</label>
                  <input type="text" id="msg-nom" name="nom" autocomplete="family-name" placeholder="Votre nom"
                    class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
                </div>
              </div>

              <div>
                <label for="msg-email" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Email <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                <input type="email" id="msg-email" name="email" autocomplete="email" placeholder="votre@email.com" aria-required="true"
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
              </div>

              <div>
                <label for="msg-sujet" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Sujet</label>
                <input type="text" id="msg-sujet" name="sujet" placeholder="En quelques mots…"
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
              </div>

              <div>
                <label for="msg-message" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Message <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                <textarea id="msg-message" name="projet" rows="5" placeholder="Votre message…" aria-required="true"
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200 resize-none"></textarea>
              </div>

              <p id="error-message" role="alert" aria-live="assertive" class="hidden font-body text-xs text-ocre-dark text-center bg-ocre/8 px-4 py-3"></p>

              <p class="font-display text-sm font-light text-brun-mid text-center border-t border-cream-dark pt-5">
                Même une question de détail a sa place ici. Chaque message est lu et traité personnellement.
              </p>

              <button type="submit" class="submit-btn w-full bg-brun text-cream font-body font-medium text-sm py-4 rounded-full hover:bg-ocre transition-colors duration-200 cursor-pointer disabled:opacity-50">
                <span class="submit-label">Envoyer le message</span>
              </button>

              <p class="font-body text-xs text-brun-mid text-center">Réponse sous 48h</p>
              <!-- Notice RGPD art. 13 — obligatoire avant collecte -->
              <p class="font-body text-xs text-brun-mid text-center leading-relaxed">
                Vos données sont traitées par <strong class="text-brun-mid">Caelestis</strong> (Célestin Fruleux) uniquement pour répondre à votre demande. Aucune revente. Durée : 3 ans.
                <a href="/politique-confidentialite" class="underline underline-offset-2 hover:text-brun-mid transition-colors">Politique de confidentialité →</a>
              </p>
            </form>
          </div>

          <!-- ══ FORMULAIRE 2 — Appel ══ -->
          <div id="panel-appel" role="tabpanel" aria-labelledby="tab-appel" class="tab-panel hidden">
            <div class="mb-7 pb-7 border-b border-cream-dark flex items-end justify-between gap-6">
              <div>
                <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-1.5">Appel</p>
                <p class="font-display text-2xl font-light text-brun">Parlons-en<br>directement.</p>
              </div>
              <PlanteFormulaire id="plant-appel" prefixe="appel" />
            </div>

            <FormulaireEnvoye id="success-appel" titre="Demande reçue !" suite="On vous confirme le créneau sous 48h." />

            <form id="form-appel" class="space-y-5" novalidate>
              <input type="hidden" name="formType" value="appel" />
              <!-- Honeypot anti-bot -->
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;width:1px;height:1px;" />
              <!-- Horodatage anti-bot : rempli en JS au chargement, vérifié côté serveur -->
              <input type="hidden" name="ts" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="appel-prenom" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Prénom <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                  <input type="text" id="appel-prenom" name="prenom" autocomplete="given-name" placeholder="Votre prénom" aria-required="true"
                    class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
                </div>
                <div>
                  <label for="appel-tel" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Téléphone <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                  <input type="tel" id="appel-tel" name="telephone" autocomplete="tel" placeholder="+33 6 39 98 12 34" aria-required="true"
                    class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
                </div>
              </div>

              <div>
                <label for="appel-email" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Email <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                <input type="email" id="appel-email" name="email" autocomplete="email" placeholder="votre@email.com" aria-required="true"
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
              </div>

              <!-- Créneau horaire — fieldset pour grouper les radios WCAG 1.3.1 -->
              <fieldset>
                <legend class="font-body text-xs tracking-widest uppercase text-brun-mid mb-3">Moment préféré <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></legend>
                <div class="flex flex-col xs:flex-row gap-2 sm:gap-3">
                  {['Matin (9h à 12h)', 'Après-midi (14h à 18h)', 'Indifférent'].map((slot) => (
                    <label class="slot-label flex-1 flex items-center justify-center text-center px-3 py-2.5 border border-cream-dark bg-white/50 rounded-xl font-body text-xs text-brun-mid cursor-pointer transition-all duration-200 hover:border-sauge/50 has-[:checked]:border-ocre has-[:checked]:bg-ocre/6 has-[:checked]:text-brun min-h-[44px]">
                      <input type="radio" name="creneau" value={slot} class="sr-only" />
                      {slot}
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- Jours disponibles — fieldset pour les checkboxes WCAG 1.3.1 -->
              <fieldset>
                <legend class="font-body text-xs tracking-widest uppercase text-brun-mid mb-3">Jours disponibles</legend>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                  {['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'].map((jour) => (
                    <label class="flex items-center justify-center w-full min-h-[44px] border border-cream-dark bg-white/50 rounded-lg font-body text-xs text-brun-mid cursor-pointer transition-all duration-200 hover:border-sauge/50 has-[:checked]:border-ocre has-[:checked]:bg-ocre/6 has-[:checked]:text-brun">
                      <input type="checkbox" name="jours" value={jour} class="sr-only" />
                      {jour}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="appel-sujet" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Sujet de l'appel <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                <textarea id="appel-sujet" name="projet" rows="3" placeholder="En quelques mots, ce que vous souhaitez aborder…" aria-required="true"
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200 resize-none"></textarea>
              </div>

              <p id="error-appel" role="alert" aria-live="assertive" class="hidden font-body text-xs text-ocre-dark text-center bg-ocre/8 px-4 py-3"></p>

              <p class="font-display text-sm font-light text-brun-mid text-center border-t border-cream-dark pt-5">
                Un quart d'heure suffit pour faire connaissance et voir ce dont vous avez besoin.
              </p>

              <button type="submit" class="submit-btn w-full bg-brun text-cream font-body font-medium text-sm py-4 rounded-full hover:bg-ocre transition-colors duration-200 cursor-pointer disabled:opacity-50">
                <span class="submit-label">Réserver mon créneau</span>
              </button>

              <p class="font-body text-xs text-brun-mid text-center">Appel de 10 à 20 min, gratuit</p>
              <!-- Notice RGPD art. 13 — obligatoire avant collecte -->
              <p class="font-body text-xs text-brun-mid text-center leading-relaxed">
                Vos données sont traitées par <strong class="text-brun-mid">Caelestis</strong> (Célestin Fruleux) uniquement pour répondre à votre demande. Aucune revente. Durée : 3 ans.
                <a href="/politique-confidentialite" class="underline underline-offset-2 hover:text-brun-mid transition-colors">Politique de confidentialité →</a>
              </p>
            </form>
          </div>

          <!-- ══ FORMULAIRE 3 — Devis ══ -->
          <div id="panel-devis" role="tabpanel" aria-labelledby="tab-devis" class="tab-panel hidden">
            <div class="mb-7 pb-7 border-b border-cream-dark flex items-end justify-between gap-6">
              <div>
                <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-1.5">Devis</p>
                <p class="font-display text-2xl font-light text-brun">Parlez-nous<br>de votre activité.</p>
              </div>
              <!-- Plante germinale -->
              <PlanteFormulaire id="form-plant" prefixe="fp" />
            </div>

            <FormulaireEnvoye id="success-devis" titre="Questionnaire envoyé !" suite="Vérifiez votre boîte mail : votre questionnaire de devis vous y attend." />

            <form id="form-devis" class="space-y-5" novalidate>
              <input type="hidden" name="formType" value="devis" />
              <!-- Honeypot anti-bot -->
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;width:1px;height:1px;" />
              <!-- Horodatage anti-bot : rempli en JS au chargement, vérifié côté serveur -->
              <input type="hidden" name="ts" value="" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="devis-prenom" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Prénom <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                  <input type="text" id="devis-prenom" name="prenom" autocomplete="given-name" placeholder="Votre prénom" aria-required="true"
                    class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
                </div>
                <div>
                  <label for="devis-societe" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Entreprise</label>
                  <input type="text" id="devis-societe" name="societe" autocomplete="organization" placeholder="Ferme des Collines…"
                    class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
                </div>
              </div>

              <div>
                <label for="devis-email" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Email <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                <input type="email" id="devis-email" name="email" autocomplete="email" placeholder="votre@email.com" aria-required="true"
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200" />
              </div>

              <!-- Le contexte de l'activité : sans lui, le devis se fait à l'aveugle.
                   Le questionnaire envoyé ensuite par email approfondit, mais le premier
                   échange doit déjà dire de quel métier et de quel projet on parle. -->
              <div>
                <label for="devis-projet" class="font-body text-xs tracking-widest uppercase text-brun-mid block mb-2">Votre activité et votre projet <span class="text-ocre" aria-hidden="true">*</span><span class="sr-only">(requis)</span></label>
                <textarea id="devis-projet" name="projet" rows="5" aria-required="true" aria-describedby="devis-projet-aide"
                  placeholder="Votre métier et votre zone. Ce que vous vendez ou proposez. Ce que vous avez déjà en ligne. Ce que le site devrait changer pour vous."
                  class="w-full bg-white/50 border border-cream-dark rounded-xl px-4 py-3 font-body text-sm text-brun placeholder:text-brun-mid focus:outline-none focus:border-ocre transition-colors duration-200 resize-none"></textarea>
                <p id="devis-projet-aide" class="font-body text-xs text-brun-mid mt-2 leading-relaxed">
                  Quelques phrases suffisent. Plus vous êtes précis, plus le devis sera juste du premier coup.
                </p>
              </div>

              <p id="error-devis" role="alert" aria-live="assertive" class="hidden font-body text-xs text-ocre-dark text-center bg-ocre/8 px-4 py-3"></p>

              <p class="font-display text-sm font-light text-brun-mid text-center border-t border-cream-dark pt-5">
                Vous recevrez ensuite par email un questionnaire plus complet. On établit votre devis sous 48h.
              </p>

              <button type="submit" class="submit-btn w-full bg-brun text-cream font-body font-medium text-sm py-4 rounded-full hover:bg-ocre transition-colors duration-200 cursor-pointer disabled:opacity-50">
                <span class="submit-label">Demander mon devis</span>
              </button>

              <p class="font-body text-xs text-brun-mid text-center">Devis reçu par email, réponse sous 48h</p>
              <!-- Notice RGPD art. 13 — obligatoire avant collecte -->
              <p class="font-body text-xs text-brun-mid text-center leading-relaxed">
                Vos données sont traitées par <strong class="text-brun-mid">Caelestis</strong> (Célestin Fruleux) uniquement pour répondre à votre demande. Aucune revente. Durée : 3 ans.
                <a href="/politique-confidentialite" class="underline underline-offset-2 hover:text-brun-mid transition-colors">Politique de confidentialité →</a>
              </p>
            </form>
          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- ─── RÉASSURANCE ─── -->
  <section class="border-t border-cream-dark py-12 px-6 md:px-10 lg:px-20" data-reveal>
    <div class="max-w-3xl mx-auto text-center">
      <!-- « Réponse sous 48h » ouvrait cette phrase et se lisait à cent pixels
           de la mention posée sous le bouton d'envoi, soit la quatrième fois sur
           la page après le chapeau et la carte du devis. La promesse reste, elle
           n'est plus répétée deux fois de suite. -->
      <p class="font-display text-xl md:text-2xl font-light text-brun leading-relaxed">
        Aucun frais caché. Nous restons avec vous du premier échange jusqu'à la mise en ligne.
      </p>
      <p class="font-body text-sm text-brun-mid mt-5">
        <strong class="font-medium text-sauge">2 % de chaque projet</strong> sont reversés à France Nature Environnement.
      </p>
    </div>
  </section>

  <!-- ─── POPUP REMERCIEMENT ─── -->
  <div
    id="thanks-popup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="thanks-title"
    class="fixed inset-0 z-[99999] items-center justify-center px-6"
    style="display:none"
  >
    <div id="thanks-backdrop" class="absolute inset-0 bg-encre/60 backdrop-blur-sm"></div>
    <div
      id="thanks-card"
      class="relative bg-cream rounded-2xl shadow-2xl max-w-md w-full px-6 sm:px-10 py-10 sm:py-12 text-center"
      style="box-shadow: 0 32px 80px rgba(14,32,24,0.35)"
    >
      <button id="thanks-close" aria-label="Fermer"
        class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-brun-mid hover:text-brun transition-colors duration-200 cursor-pointer">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="w-14 h-14 rounded-full bg-sauge/12 flex items-center justify-center mx-auto mb-7">
        <svg class="w-7 h-7 text-sauge" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
        </svg>
      </div>
      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">Reçu 5 sur 5</p>
      <h2 id="thanks-title" class="font-display text-3xl font-light text-brun mb-4 tracking-[-0.02em]">Envoyé !</h2>
      <p id="thanks-body" class="font-body text-sm text-brun-mid leading-relaxed mb-8">On vous répond sous 48h.</p>
      <div class="w-full h-px bg-cream-dark overflow-hidden rounded-full mb-6">
        <div id="thanks-progress" class="h-full bg-sauge/50 rounded-full" style="width:100%"></div>
      </div>
      <button id="thanks-cta" class="font-body text-sm font-medium text-brun-mid hover:text-brun transition-colors duration-200 cursor-pointer">Fermer</button>
    </div>
  </div>

</BaseLayout>

<style is:global>
  /* ── Sélecteur de contact : trois réponses à « Que préférez-vous ? » ──
     Chaque case annonce ce qui se passe ensuite, l'active passe en fond forêt.

     Le sélecteur est plus large que le formulaire qu'il commande : il déborde
     de part et d'autre pour que les trois phrases tiennent sur deux lignes au
     lieu de trois, ce qui aplatit les cases. La technique du décalage de 50 %
     puis du retrait de la moitié de sa propre largeur le garde centré sur le
     même axe que le formulaire. */
  .selecteur,
  .selecteur-titre {
    width: min(calc(100% + 300px), calc(100vw - 3rem));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .selecteur-titre {
    text-align: center;
    margin-bottom: 14px;
  }

  .tab-btn {
    display: flex;
    flex-direction: column;
    /* Les trois cases font la même hauteur : le texte se cale au milieu pour
       que celles d'une seule ligne ne laissent pas un vide sous elles. */
    justify-content: center;
    align-items: center;
    gap: 3px;
    min-height: 44px;
    padding: 13px 18px;
    text-align: center;
    border: 1px solid #E6E4DC;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
  }
  .tab-btn:hover { border-color: rgba(46, 116, 82, 0.45); transform: translateY(-1px); }
  .tab-btn.is-active { background: #255C41; border-color: #255C41; }
  .tab-btn:focus-visible { outline: 2px solid #255C41; outline-offset: 3px; }

  .tab-titre { font-size: 0.9rem; font-weight: 500; color: #255C41; line-height: 1.35; }
  .tab-btn.is-active .tab-titre { color: #FCFBF8; }
  .tab-detail { font-size: 0.76rem; line-height: 1.4; color: #5C6259; }
  .tab-btn.is-active .tab-detail { color: rgba(252, 251, 248, 0.84); }

  /* Sur mobile le sélecteur reprend la largeur du formulaire : le débordement
     n'aurait plus rien à déborder, et le survol soulevé n'a pas de sens au doigt. */
  @media (max-width: 640px) {
    .selecteur,
    .selecteur-titre {
      width: 100%;
      margin-left: 0;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-btn:hover { transform: none; }
  }

  /* Radio dot visible quand coché */
  label:has(input[type="radio"]:checked) .radio-dot { opacity: 1; }

  /* ── Champ invalide — bordure rouge ── */
  input.field-error,
  textarea.field-error {
    border-color: #b94a2c !important;
    background-color: rgba(185, 74, 44, 0.04) !important;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  fieldset.field-error {
    border: 1px solid #b94a2c;
    border-radius: 10px;
    padding: 6px 8px 8px;
    background-color: rgba(185, 74, 44, 0.03);
    transition: border-color 0.2s ease;
  }
</style>

<script>
  import gsap from 'gsap';

  declare global {
    interface Window {
      caelTrack?: (event: string, params?: Record<string, unknown>) => void;
    }
  }

  /* État partagé entre ré-initialisations (View Transitions) */
  let contactEscBound  = false;
  let activeClosePopup: (() => void) | null = null;
  let activePopupEl:    HTMLElement | null = null;

  /* Ré-initialise toute l'interactivité de la page contact.
     Appelé au chargement initial ET après chaque navigation View Transitions :
     le DOM étant recréé à chaque navigation, on re-sélectionne tous les éléments. */
  function initContactPage() {
    if (!document.getElementById('panel-message')) return;

  /* Honeypot temporel — horodate l'ouverture du formulaire (humain : plusieurs
     secondes ; bot : soumission quasi instantanée). Vérifié côté serveur. */
  document.querySelectorAll<HTMLInputElement>('input[name="ts"]').forEach((el) => {
    el.value = String(Date.now());
  });

  /* ══════════════════════════════════════════
     ONGLETS
  ══════════════════════════════════════════ */
  const tabBtns   = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

  function activateTab(id: string) {
    tabBtns.forEach(btn => {
      const active = btn.dataset.tab === id;
      /* Un seul état à basculer : l'apparence vit dans la feuille de style. */
      btn.classList.toggle('is-active', active);
      /* WCAG 4.1.2 — mise à jour de aria-selected */
      btn.setAttribute('aria-selected', String(active));
    });
    tabPanels.forEach(panel => {
      panel.classList.toggle('hidden', panel.id !== `panel-${id}`);
    });
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => activateTab(btn.dataset.tab ?? 'message'));
  });

  /* Ouverture directe d'un onglet via l'URL (#devis, #appel, #message) —
     permet aux CTA d'autres pages de pointer vers le bon formulaire. */
  const hashTab = (location.hash || '').replace('#', '');
  if (['message', 'appel', 'devis'].includes(hashTab)) activateTab(hashTab);

  /* ══════════════════════════════════════════
     ENVOI GÉNÉRIQUE
  ══════════════════════════════════════════ */
  function bindForm(formId: string, errorId: string, successId: string, popupMsg: string) {
    const form      = document.getElementById(formId)   as HTMLFormElement   | null;
    const errorEl   = document.getElementById(errorId)  as HTMLElement       | null;
    const successEl = document.getElementById(successId) as HTMLElement      | null;
    if (!form) return;

    const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn');
    const submitLbl = form.querySelector<HTMLElement>('.submit-label');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !submitLbl) return;

      /* ── Efface toutes les erreurs précédentes ── */
      form!.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
      form!.querySelectorAll('[aria-invalid="true"]').forEach(el => {
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      });
      hideErr();

      /* Libellé visible d'un champ, lu dans le DOM pour rester synchronisé
         avec le formulaire même si le texte change. La légende du fieldset
         passe avant le label parent : sur un groupe de boutons radio, c'est
         « Moment préféré » qu'il faut annoncer, pas « Matin (9h à 12h) ». */
      function libelleChamp(el: HTMLElement): string {
        const source =
          (el.id ? form!.querySelector(`label[for="${el.id}"]`) : null) ??
          el.closest('fieldset')?.querySelector('legend') ??
          el.closest('label');
        const txt = (source?.textContent ?? '')
          .replace(/\*/g, '')
          .replace(/\(requis\)/gi, '')
          .replace(/\s+/g, ' ')
          .trim();
        return txt.slice(0, 40);
      }

      const champsFautifs: string[] = [];

      /* ── Marque un champ invalide : bordure rouge, aria-invalid et lien vers
         le message d'erreur, pour que le champ fautif soit annoncé et pas
         seulement signalé par la couleur. Tout s'efface à la prochaine saisie. ── */
      function markInvalid(name: string) {
        const el = form!.querySelector(`[name="${name}"]`) as HTMLElement | null;
        if (!el) return;
        const target = el.closest('fieldset') ?? el;
        target.classList.add('field-error');

        /* Un groupe de cases ou de boutons radio porte plusieurs contrôles */
        const controles = Array.from(form!.querySelectorAll<HTMLElement>(`[name="${name}"]`));
        controles.forEach(c => {
          c.setAttribute('aria-invalid', 'true');
          c.setAttribute('aria-describedby', errorId);
        });

        const libelle = libelleChamp(el);
        if (libelle && !champsFautifs.includes(libelle)) champsFautifs.push(libelle);

        const clear = () => {
          target.classList.remove('field-error');
          controles.forEach(c => {
            c.removeAttribute('aria-invalid');
            c.removeAttribute('aria-describedby');
          });
        };
        el.addEventListener('input',  clear, { once: true });
        el.addEventListener('change', clear, { once: true });
      }

      /* ── Lecture des valeurs ── */
      const prenom     = (form.querySelector('[name="prenom"]')              as HTMLInputElement | null)?.value.trim()  ?? '';
      const email      = (form.querySelector('[name="email"]')               as HTMLInputElement | null)?.value.trim()  ?? '';
      const projet     = (form.querySelector('[name="projet"]')              as HTMLTextAreaElement | null)?.value.trim() ?? '';
      const societe    = (form.querySelector('[name="societe"]')             as HTMLInputElement | null)?.value.trim()  ?? '';
      const tel        = (form.querySelector('[name="telephone"]')           as HTMLInputElement | null)?.value.trim()  ?? '';
      const creneau    = (form.querySelector('[name="creneau"]:checked')     as HTMLInputElement | null)?.value ?? '';

      const emailRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;

      /* ── Validation — tous les champs requis en une passe ── */
      let hasError = false;

      if (!prenom || prenom.length > 100)
        { markInvalid('prenom'); hasError = true; }
      if (!email || !emailRegex.test(email) || /[,;\r\n]/.test(email) || email.length > 254)
        { markInvalid('email'); hasError = true; }
      if (form.querySelector('[name="telephone"]') && !tel)
        { markInvalid('telephone'); hasError = true; }
      if (form.querySelector('[name="creneau"]') && !creneau)
        { markInvalid('creneau'); hasError = true; }
      if (form.querySelector('[name="projet"][aria-required="true"]') && !projet)
        { markInvalid('projet'); hasError = true; }
      if (projet.length > 5000)
        { showErr('Message trop long (5 000 caractères max).'); return; }
      if (societe.length > 200)
        { showErr('Nom d\'entreprise trop long (200 caractères max).'); return; }

      if (hasError) {
        /* Le message nomme les champs concernés : l'information ne repose plus
           sur la seule couleur de bordure. */
        showErr(
          champsFautifs.length === 1
            ? `Merci de compléter le champ « ${champsFautifs[0]} ».`
            : champsFautifs.length > 1
              ? `Merci de compléter les champs suivants : ${champsFautifs.join(', ')}.`
              : 'Veuillez remplir tous les champs obligatoires (*).'
        );
        /* Le focus part sur le premier champ fautif : l'utilisateur au clavier
           ou au lecteur d'écran arrive directement dessus. */
        const premier = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        premier?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        premier?.focus({ preventScroll: true });
        return;
      }

      /* Mémorise le label d'origine AVANT de l'écraser */
      const originalLabel = submitLbl.textContent ?? '→';

      submitBtn.disabled    = true;
      submitLbl.textContent = 'Envoi en cours…';
      hideErr();

      try {
        const res  = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
        const json = await res.json() as { success?: boolean; error?: string };

        if (res.ok && json.success) {
          /* GA4 — conversion (ne se déclenche que si le consentement cookies est donné) */
          window.caelTrack?.('generate_lead', {
            lead_source: 'contact',
            form_type: (form.querySelector('[name="formType"]') as HTMLInputElement | null)?.value ?? '',
          });
          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
          /* Met à jour previousFocus vers l'onglet actif AVANT que le formulaire soit masqué,
             car le submitBtn sera display:none et ne pourra pas recevoir le focus au retour */
          const activeTab = document.querySelector<HTMLButtonElement>('[role="tab"][aria-selected="true"]');
          if (activeTab) previousFocus = activeTab;
          showPopup(prenom, popupMsg);
        } else {
          showErr(json.error ?? 'Une erreur est survenue. Veuillez réessayer.');
          submitBtn.disabled    = false;
          submitLbl.textContent = originalLabel;
        }
      } catch (err) {
        console.error('[contact] Erreur réseau :', err);
        showErr('Erreur réseau. Vérifiez votre connexion.');
        submitBtn.disabled    = false;
        submitLbl.textContent = originalLabel;
      }

      function showErr(msg: string) { if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); } }
      function hideErr()            { errorEl?.classList.add('hidden'); }
    });
  }

  bindForm('form-message', 'error-message', 'success-message', 'On vous répond sous 48h.');
  bindForm('form-appel',   'error-appel',   'success-appel',   'On vous confirme le créneau sous 48h.');
  bindForm('form-devis',   'error-devis',   'success-devis',   'Vérifiez votre boîte mail : votre questionnaire de devis vous y attend.');

  /* ══════════════════════════════════════════
     POPUP
  ══════════════════════════════════════════ */
  const popup       = document.getElementById('thanks-popup')    as HTMLElement | null;
  const popupCard   = document.getElementById('thanks-card')     as HTMLElement | null;
  const popupBg     = document.getElementById('thanks-backdrop') as HTMLElement | null;
  const closeBtn    = document.getElementById('thanks-close')    as HTMLButtonElement | null;
  const ctaBtn      = document.getElementById('thanks-cta')      as HTMLButtonElement | null;
  const thanksBody  = document.getElementById('thanks-body')     as HTMLElement | null;
  const progressBar = document.getElementById('thanks-progress') as HTMLElement | null;

  let autoCloseTimer: ReturnType<typeof setTimeout> | null = null;
  let progressAnim:   ReturnType<typeof requestAnimationFrame> | null = null;
  let previousFocus:  HTMLElement | null = null;

  /* ── Piège de focus WCAG 2.1.2 ── */
  function trapFocus(e: KeyboardEvent) {
    if (!popup || popup.style.display === 'none') return;
    const focusable = popup.querySelectorAll<HTMLElement>(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    if (e.key === 'Tab') {
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
      }
    }
  }

  function showPopup(prenom: string, msg: string) {
    if (!popup || !popupCard) return;
    if (thanksBody) thanksBody.textContent = `Merci ${prenom}, ${msg}`;
    /* Mémorise l'élément focalisé avant l'ouverture pour le restaurer à la fermeture */
    previousFocus = document.activeElement as HTMLElement;
    popup.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', trapFocus);
    gsap.fromTo(popup,     { opacity: 0 }, { opacity: 1, duration: 0.28, ease: 'power2.out' });
    gsap.fromTo(popupCard, { opacity: 0, y: 28, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.42, delay: 0.06, ease: 'power3.out',
      onComplete: () => {
        /* WCAG 2.4.3 — focus sur le bouton de fermeture après l'animation */
        closeBtn?.focus();
      }
    });

    if (progressBar) {
      const DURATION = 6000;
      const start    = performance.now();
      const tick = (now: number) => {
        const pct = Math.max(0, 100 - ((now - start) / DURATION) * 100);
        progressBar.style.width = pct + '%';
        if (now - start < DURATION) progressAnim = requestAnimationFrame(tick);
      };
      progressAnim    = requestAnimationFrame(tick);
      autoCloseTimer  = setTimeout(closePopup, DURATION);
    }
  }

  function closePopup() {
    if (!popup || !popupCard) return;
    if (autoCloseTimer) { clearTimeout(autoCloseTimer); autoCloseTimer = null; }
    if (progressAnim)   { cancelAnimationFrame(progressAnim); progressAnim = null; }
    document.removeEventListener('keydown', trapFocus);
    gsap.to(popupCard, { opacity: 0, y: 14, scale: 0.97, duration: 0.26, ease: 'power2.in' });
    gsap.to(popup, { opacity: 0, duration: 0.32, delay: 0.10, ease: 'power2.in',
      onComplete: () => {
        popup.style.display = 'none';
        document.body.style.overflow = '';
        /* WCAG 2.4.3 — restitue le focus à l'élément d'origine */
        previousFocus?.focus();
        previousFocus = null;
      }
    });
  }

  closeBtn?.addEventListener('click',   closePopup);
  ctaBtn?.addEventListener('click',     closePopup);
  popupBg?.addEventListener('click',    closePopup);
  /* Références vers la popup/closePopup de l'init courante */
  activeClosePopup = closePopup;
  activePopupEl    = popup;
  /* Écouteur Escape lié une seule fois sur document (persistant entre navigations) */
  if (!contactEscBound) {
    contactEscBound = true;
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activePopupEl && activePopupEl.style.display !== 'none') {
        activeClosePopup?.();
      }
    });
  }

  /* ══════════════════════════════════════════
     PLANTE GERMINALE — 3 formulaires
  ══════════════════════════════════════════ */
  const SPRING = 'elastic.out(1, 0.48)';
  const EASE   = 'power2.inOut';

  function initPlant(prefix: string) {
    const stem   = document.getElementById(`${prefix}-stem`)   as SVGRectElement    | null;
    const leafL  = document.getElementById(`${prefix}-leaf-l`) as SVGEllipseElement | null;
    const leafR  = document.getElementById(`${prefix}-leaf-r`) as SVGEllipseElement | null;
    const flower = document.getElementById(`${prefix}-flower`) as SVGGElement        | null;
    if (!stem || !leafL || !leafR || !flower) return null;

    gsap.set(stem,   { scaleY: 0, transformOrigin: '50% 100%' });
    gsap.set(leafL,  { scale: 0,  svgOrigin: '38 89' });
    gsap.set(leafR,  { scale: 0,  svgOrigin: '42 66' });
    gsap.set(flower, { scale: 0,  opacity: 0, svgOrigin: '40 18' });

    const state = [false, false, false, false];

    return function update(stage: number, active: boolean) {
      if (state[stage] === active) return;
      state[stage] = active;
      if (stage === 0) active
        ? gsap.to(stem,   { scaleY: 1, duration: 1.1, ease: EASE,   transformOrigin: '50% 100%' })
        : gsap.to(stem,   { scaleY: 0, duration: 0.6, ease: EASE,   transformOrigin: '50% 100%' });
      if (stage === 1) active
        ? gsap.to(leafL,  { scale: 1, duration: 0.75, ease: SPRING, svgOrigin: '38 89' })
        : gsap.to(leafL,  { scale: 0, duration: 0.35, ease: 'power2.in', svgOrigin: '38 89' });
      if (stage === 2) active
        ? gsap.to(leafR,  { scale: 1, duration: 0.75, ease: SPRING, svgOrigin: '42 66' })
        : gsap.to(leafR,  { scale: 0, duration: 0.35, ease: 'power2.in', svgOrigin: '42 66' });
      if (stage === 3) active
        ? gsap.to(flower, { scale: 1, opacity: 1, duration: 0.9,  ease: SPRING,      svgOrigin: '40 18' })
        : gsap.to(flower, { scale: 0, opacity: 0, duration: 0.35, ease: 'power2.in', svgOrigin: '40 18' });
    };
  }

  /* ── Plante formulaire Message ── */
  const updateMsg = initPlant('msg');
  if (updateMsg) {
    const inp = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    inp('msg-sujet')  ?.addEventListener('input', (e) => updateMsg(0, (e.target as HTMLInputElement).value.trim().length > 0));
    inp('msg-prenom') ?.addEventListener('input', (e) => updateMsg(1, (e.target as HTMLInputElement).value.trim().length > 0));
    inp('msg-email')  ?.addEventListener('input', (e) => updateMsg(2, (e.target as HTMLInputElement).value.trim().length > 2));
    inp('msg-message')?.addEventListener('input', (e) => updateMsg(3, (e.target as HTMLTextAreaElement).value.trim().length > 8));
  }

  /* ── Plante formulaire Appel ── */
  const updateAppel = initPlant('appel');
  if (updateAppel) {
    const inp = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    document.querySelectorAll<HTMLInputElement>('[name="creneau"]').forEach(r =>
      r.addEventListener('change', () => updateAppel(0, true)));
    inp('appel-prenom')?.addEventListener('input', (e) => updateAppel(1, (e.target as HTMLInputElement).value.trim().length > 0));
    inp('appel-tel')   ?.addEventListener('input', (e) => updateAppel(2, (e.target as HTMLInputElement).value.trim().length > 5));
    inp('appel-sujet') ?.addEventListener('input', (e) => updateAppel(3, (e.target as HTMLTextAreaElement).value.trim().length > 8));
  }

  /* ── Plante formulaire Devis ── */
  const updateDevis = initPlant('fp');
  if (updateDevis) {
    const inp = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    inp('devis-prenom') ?.addEventListener('input', (e) => updateDevis(0, (e.target as HTMLInputElement).value.trim().length > 0));
    inp('devis-societe')?.addEventListener('input', (e) => updateDevis(1, (e.target as HTMLInputElement).value.trim().length > 0));
    inp('devis-email')  ?.addEventListener('input', (e) => updateDevis(2, (e.target as HTMLInputElement).value.trim().length > 2));
    /* La fleur s'ouvre quand l'activité est décrite : c'est ce qui permet de chiffrer. */
    inp('devis-projet') ?.addEventListener('input', (e) => updateDevis(3, (e.target as HTMLTextAreaElement).value.trim().length > 8));
  }
  }

  initContactPage();
  document.addEventListener('astro:page-load', initContactPage);
</script>
