---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { Image } from 'astro:assets';
import imgBureau from '../assets/images/photo-bureau.jpg';
import { realisations } from '../data/realisations';
import { PROFILS } from '../data/entite';

/* Le nombre d'études de cas se lit dans la source, jamais écrit en dur : la
   page annonçait « deux études de cas » alors que La Coquette avait été
   retirée de la liste le 12/08/2026, et rien ne signalait l'écart. */
const NB_CAS = realisations.length;
const PASSERELLE_PREUVE = NB_CAS > 1
  ? `${NB_CAS} études de cas détaillées, avec l'adresse des sites en ligne pour tout vérifier par vous-même.`
  : "Une étude de cas détaillée, avec l'adresse du site en ligne pour tout vérifier par vous-même.";

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Célestin Fruleux',
  jobTitle: 'Développeur web & consultant SEO',
  description: 'Développeur web freelance et fondateur de Caelestis, agence web basée dans la Drôme. J\'aide artisans, producteurs et indépendants d\'Auvergne-Rhône-Alpes à avoir une présence en ligne claire, soignée et visible sur Google.',
  url: 'https://caelestis.fr/a-propos',
  email: 'contact@caelestis.fr',
  telephone: '+33769362727',
  image: 'https://caelestis.fr/og-image-2026.jpg',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Drôme',
    addressCountry: 'FR',
  },
  worksFor: {
    '@type': 'LocalBusiness',
    '@id': 'https://caelestis.fr/#business',
    name: 'Caelestis',
    url: 'https://caelestis.fr',
  },
  knowsAbout: ['Création de site web', 'Développement Astro', 'Référencement naturel', 'SEO local Drôme et Ardèche', 'UX Design', 'Création site internet Drôme'],
  /* Les profils de Célestin lui-même. Le lien de partage de la fiche
     d'établissement a été retiré le 21/08/2026 : il redirigeait deux fois, et
     une fiche d'entreprise n'identifie pas une personne. */
  sameAs: PROFILS,
};

const breadcrumbApropos = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://caelestis.fr' },
    { '@type': 'ListItem', position: 2, name: 'À propos', item: 'https://caelestis.fr/a-propos' },
  ],
};


/* La démarche, remplaçante des quatre engagements le 12/08/2026 sur retour de
   Célestin. Les engagements (prix fixé, date annoncée, interlocuteur unique,
   propriété du site) étaient des conditions de prestation : leur place est sur
   /services, pas sur la page qui raconte qui je suis. Ici, ce que le lecteur
   vient chercher, c'est comment se passe la rencontre.

   Chaque étape garde le repère de gauche, seule information que le module
   ajoute au texte. Ton convivial, phrases courtes, « on » de réciprocité
   (vous et moi) et non « on » d'agence : la page entière est écrite à la
   première personne, ne pas y glisser un « nous » d'équipe. */
const DEMARCHE = [
  {
    moment: 'On se rencontre',
    titre: 'J\'apprends à connaître votre entreprise',
    texte: "Votre métier, votre parcours, ce qui vous distingue de la maison d'à côté. Je pose beaucoup de questions au départ, tout le reste en découle.",
  },
  {
    moment: 'On dessine',
    titre: 'Une identité fidèle à votre image',
    texte: "Des couleurs, des mots et des photos qui vous ressemblent vraiment. Une identité dessinée pour vous seul.",
  },
  {
    moment: 'On construit',
    titre: 'Un site agréable à parcourir',
    texte: "Fluide, clair, pensé pour amener vos visiteurs jusqu'à vous du premier coup d'œil.",
  },
  {
    moment: 'Du début à la fin',
    titre: 'Je reste joignable',
    texte: "Écoute, disponibilité, transparence. Vous savez toujours où en est votre projet et ce que j'attends de vous.",
  },
];

---
<BaseLayout
  title="Célestin Fruleux, développeur web freelance, Drôme"
  description="Développeur web freelance et référenceur dans la Drôme. J'accompagne artisans, producteurs et indépendants, du premier appel à la mise en ligne."
  schema={[personSchema, breadcrumbApropos]}
>

  <section class="pt-20 pb-16 md:pt-24 md:pb-20 px-6 md:px-10 lg:px-20 overflow-hidden">
    <div class="max-w-6xl mx-auto">

      <div class="grid lg:grid-cols-[1fr_1.5fr] gap-12 md:gap-16 lg:gap-24 items-start">

        <!-- Colonne gauche : placeholder photo + petites infos -->
        <div data-reveal>
          <!-- Portrait au bureau — évoque le travail, la Drôme, le calme -->
          <div class="img-zoom img-editorial aspect-[3/4] mb-4 overflow-hidden max-h-[480px] lg:max-h-none">
            <Image
              src={imgBureau}
              alt="Célestin Fruleux, fondateur de Caelestis, à son bureau, création de site internet dans la Drôme"
              class="w-full h-full object-cover"
              style="object-position: center 20%;"
              data-parallax
              loading="eager"
              fetchpriority="high"
              widths={[480, 768]}
              sizes="(max-width: 1024px) 100vw, 35vw"
              quality={72}
            />
          </div>
          <p class="font-body text-xs text-brun-mid text-center">Célestin, Drôme</p>

          <!-- Petites stats discrètes -->
          <div class="mt-10 space-y-4">
            <div class="flex justify-between items-baseline border-b border-bois-pale/40 pb-3">
              <span class="font-body text-xs tracking-widest uppercase text-bois-mid">Âge</span>
              <span class="font-display text-xl font-light text-brun">22 ans</span>
            </div>
            <div class="flex justify-between items-baseline border-b border-bois-pale/40 pb-3">
              <span class="font-body text-xs tracking-widest uppercase text-bois-mid">Basé à</span>
              <span class="font-display text-xl font-light text-brun">Drôme</span>
            </div>
            <div class="flex justify-between items-baseline border-b border-bois-pale/40 pb-3">
              <span class="font-body text-xs tracking-widest uppercase text-bois-mid">Spécialité</span>
              <span class="font-display text-xl font-light text-brun">Création web</span>
            </div>
            <div class="flex justify-between items-baseline border-b border-bois-pale/40 pb-3">
              <span class="font-body text-xs tracking-widest uppercase text-bois-mid">Réponse</span>
              <span class="font-display text-xl font-light text-brun">Sous 48h</span>
            </div>
          </div>
        </div>

        <!-- Colonne droite : texte -->
        <div>
          <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-6" data-reveal>À propos</p>
          <h1
            class="font-display font-light text-brun leading-[1.05] tracking-tight mb-10"
            style="font-size: clamp(2.25rem, 5vw, 4rem);"
            data-reveal data-delay="1"
          >
            Pourquoi <span class="text-sauge">Caelestis</span>&nbsp;?
          </h1>

          <div class="space-y-6 font-body text-base text-brun-mid leading-relaxed" data-reveal data-delay="2">
            <p>
              Le nom Caelestis est inspiré de mon prénom Célestin, dont l'origine latine évoque le ciel.
            </p>
            <p>
              Je suis Célestin Fruleux, j'ai 22 ans, et je suis passionné par la nature, le bien-être et l'entrepreneuriat.
            </p>
            <p>
              J'ai commencé par créer des sites internet pour mes propres projets. Puis mes proches m'ont demandé de les aider à leur tour. De fil en aiguille, j'ai conçu plusieurs sites, expérimenté différentes approches et développé mes compétences en conception web, image de marque et présence en ligne.
            </p>
            <p>
              Ces expériences m'ont montré une chose : beaucoup d'artisans, d'indépendants et de petites structures (TPE, PME) font un travail remarquable, et presque personne ne le sait. Pas faute de qualité. Faute d'un endroit, en ligne, où ce travail se voie tel qu'il est.
            </p>
            <p>
              Un bon site montre votre métier à ceux qui vous découvrent, et leur donne envie de vous appeler.
            </p>
            <p>
              C'est donc pour cette raison que j'ai créé Caelestis : aider les artisans, indépendants et entrepreneurs à disposer d'une présence en ligne à la hauteur de leur savoir-faire.
            </p>
          </div>

          <!-- La signature de marque, en toutes lettres. Elle remplace le 07/08/2026
               le bloc « moment de marque », une animation en boucle du nom Caelestis
               sur un aplat vert olive #2a3b18, couleur de l'ancienne charte que la
               palette forêt vivante a remplacée. Deux raisons de ne pas l'avoir
               simplement repeint : le bloc ne portait aucune information, il animait
               le nom de la marque sur une page qui l'écrit déjà partout, et la règle
               du site interdit le décor qui remplit. Seule la phrase méritait de
               rester, elle est ici en clair, lisible par tous et par les moteurs. -->
          <p class="font-display font-light leading-snug tracking-tight text-center mx-auto mt-12 text-[#2E7452] text-2xl md:text-3xl max-w-[22ch]" data-reveal data-delay="3">
            Pour ceux qui créent quelque chose de beau.
          </p>

          <div class="mt-12 flex justify-center" data-reveal data-delay="3">
            <Button href="/contact" variant="primary">Réserver un appel</Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── LA DÉMARCHE ───
       Le module de quatre bandes date du 07/08/2026 et il fonctionne : un
       repère à gauche, l'étape à droite, des filets pour séparer sans encadrer.
       Seul son contenu change le 12/08/2026. Il portait les quatre engagements
       commerciaux (prix fixé, date annoncée, interlocuteur unique, propriété du
       site) : de la condition de prestation, qui parle de l'offre et non de la
       personne. Ils ont leur place sur /services. Ce que remplit désormais la
       section, c'est le manque de la page : comment se passe la rencontre.

       Deux règles à ne pas perdre. Le récit des débuts est déjà raconté en haut
       de page, ne pas le redire ici. Et le ton reste celui d'une conversation :
       si un mot ne se dit pas au téléphone, il n'a rien à faire ici. -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 bg-brun section-dark-depth" aria-labelledby="demarche-title">
    <div class="max-w-4xl mx-auto">

      <div class="text-center mb-14" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-4">Ma façon de faire</p>
        <h2 id="demarche-title" class="font-display text-3xl md:text-4xl font-light text-cream leading-[1.1] mb-5">
          D'abord, on apprend à se connaître.
        </h2>
        <p class="font-body text-base max-w-[46ch] mx-auto leading-relaxed" style="color: rgba(252, 251, 248, 0.78)">
          Derrière chaque projet, il y a une rencontre. Je prends le temps de comprendre
          votre activité avant d'ouvrir la moindre page blanche.
        </p>
      </div>

      <ul class="etapes" role="list">
        {DEMARCHE.map((e) => (
          <li class="etape" data-reveal>
            <span class="etape-moment font-body">{e.moment}</span>
            <div class="etape-corps">
              <h3 class="etape-titre font-display">{e.titre}</h3>
              <p class="etape-texte font-body">{e.texte}</p>
            </div>
          </li>
        ))}
      </ul>

      <p class="font-body text-base text-center max-w-[52ch] mx-auto mt-12 leading-relaxed" style="color: rgba(252, 251, 248, 0.78)" data-reveal>
        Un site ne se juge pas à son allure. Il se juge à ce qu'un inconnu
        comprend de vous en trente secondes.
      </p>

    </div>
  </section>

  <!-- ─── ENGAGEMENT NATURE ───
       L'engagement occupait une section entière de l'accueil, sur fond sombre,
       entre l'offre et la méthode. Il en descend le 03/09/2026 : l'accueil le
       mentionne en une phrase à la fin de la méthode, le détail vit ici, sur la
       page qui raconte qui nous sommes. C'est le bon endroit pour un choix qui
       parle de la personne et non de la prestation. -->
  <section class="py-16 md:py-20 px-6 md:px-10 lg:px-20 border-t border-cream-dark" aria-labelledby="nature-title">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-5" data-reveal>Notre engagement</p>
      <h2 id="nature-title" class="font-display text-3xl md:text-4xl font-light text-brun leading-[1.15] mb-6" data-reveal>
        2&nbsp;% de chaque projet reversés à la nature.
      </h2>
      <p class="font-body text-base text-brun-mid leading-relaxed" data-reveal data-delay="1">
        Chaque site que nous créons finance le travail de <a href="https://www.fne.asso.fr" target="_blank" rel="noopener noreferrer" class="text-[#2E7452] underline underline-offset-4 decoration-sauge/50 hover:decoration-[#2E7452] transition-colors">France Nature Environnement<span class="sr-only"> (nouvelle fenêtre)</span></a>, première fédération française de protection de la nature. Nos clients vivent de ce qui pousse et de ce qui vit : autant y contribuer.
      </p>
    </div>
  </section>

  <!-- ─── PASSERELLES : la page À propos était un cul-de-sac, aucun chemin vers la preuve ─── -->
  <section class="py-12 md:py-16 px-6 md:px-10 lg:px-20 border-t border-cream-dark">
    <div class="max-w-4xl mx-auto grid sm:grid-cols-2 gap-8">
      <a href="/realisations" class="group border border-cream-dark rounded-2xl px-7 py-8 hover:border-sauge/60 transition-colors" data-reveal>
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">La preuve</p>
        <h2 class="font-display text-xl text-brun leading-snug mb-2">Voir ce que j'ai livré</h2>
        <p class="font-body text-sm text-brun-mid leading-relaxed mb-4">
          {PASSERELLE_PREUVE}
        </p>
        <span class="font-body text-sm font-medium text-sauge inline-flex items-center gap-2 group-hover:gap-3 transition-all">Les réalisations <span aria-hidden="true">→</span></span>
      </a>
      <a href="/services" class="group border border-cream-dark rounded-2xl px-7 py-8 hover:border-sauge/60 transition-colors" data-reveal data-delay="1">
        <p class="font-body text-xs tracking-[0.22em] uppercase text-sauge mb-3">L'offre</p>
        <h2 class="font-display text-xl text-brun leading-snug mb-2">Trouver la formule qui vous va</h2>
        <p class="font-body text-sm text-brun-mid leading-relaxed mb-4">
          Quatre formules aux prix affichés, de la page unique au site sur mesure, comparées en une page.
        </p>
        <span class="font-body text-sm font-medium text-sauge inline-flex items-center gap-2 group-hover:gap-3 transition-all">Les services <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <!-- ─── APPEL FINAL : la page se terminait sur les passerelles, sans jamais
       inviter au contact. Le CTA « Réserver un appel » du milieu est à deux
       sections d'ici, l'espacement suffit : ce n'est pas un doublon collé mais
       la clôture de conversion que la page n'avait pas. Ajouté le 07/08/2026. -->
  <AppelFinal
    titre="Échangeons sur"
    titreAccent="votre projet ?"
    texte="Décrivez votre activité en quelques lignes, je vous réponds sous 48h. Devis gratuit, vous décidez ensuite."
    href="/contact"
    libelle="Parler de mon projet"
  />

</BaseLayout>

<style>

  /* ═══ Les quatre étapes de la démarche ═══
     Quatre bandes larges séparées par un filet, le repère à gauche et l étape
     à droite. Pas de carte, pas d encadré : sur un fond vert plein, les filets
     suffisent à séparer et laissent respirer. La colonne des repères passe
     au-dessus du titre en mobile, où deux colonnes écraseraient le texte. */
  .etapes { list-style: none; margin: 0; padding: 0; }
  .etape {
    display: grid;
    gap: 6px 34px;
    padding: 26px 0;
    border-top: 1px solid rgba(252, 251, 248, 0.16);
  }
  .etape:last-child { border-bottom: 1px solid rgba(252, 251, 248, 0.16); }
  @media (min-width: 760px) {
    .etape { grid-template-columns: 12.5rem 1fr; padding: 30px 0; }
  }

  .etape-moment {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #B8C4BB;
    padding-top: 0.35rem;
  }
  .etape-titre {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 300;
    line-height: 1.25;
    color: #FCFBF8;
    margin-bottom: 9px;
  }
  .etape-texte {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(252, 251, 248, 0.8);
    max-width: 54ch;
  }

</style>

