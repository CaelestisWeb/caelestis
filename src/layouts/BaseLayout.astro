---
import Header from '../components/Header.astro';
import SearchPalette from '../components/SearchPalette.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

// Préchargement des 2 polices critiques above-the-fold — ?url résout vers le fichier hashé final
import satoshiTitreUrl from '../assets/fonts/satoshi-700.woff2?url';
import satoshiCorpsUrl from '../assets/fonts/satoshi-400.woff2?url';

/* Identifiant du pixel Meta. Tant qu'il est vide, AUCUN script publicitaire
   n'est présent dans la page : ni balise, ni requête, ni cookie. Renseigner
   PUBLIC_META_PIXEL_ID dans Vercel suffit à activer l'ensemble du dispositif
   (bandeau à deux finalités inclus). */
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  image = '/og-image.jpg',
  canonical,
  noindex = false,
  schema,
} = Astro.props;

const siteUrl     = 'https://caelestis.fr';
// Toujours pointer vers le domaine principal — évite les doublons si le site
// est accessible sur plusieurs domaines (Vercel preview, www, etc.)
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const ogImage      = image.startsWith('http') ? image : `${siteUrl}${image}`;

// JSON-LD — accepte un objet unique ou un tableau
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <!-- minimum-scale=1 : empêche le dézoom sous 100 % sur mobile (page toujours pleine),
         SANS bloquer le zoom-avant (accessibilité WCAG 1.4.4 préservée, pas de user-scalable=no) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, viewport-fit=cover" />
    <!-- ── Reveal tactile — anti-flash + failsafe ──
         Sur pointeur grossier (mobile), GSAP n'est pas chargé : on pose .reveal-js
         AVANT le paint pour que les apparitions soient gérées en CSS/IO. Le failsafe
         garantit que le contenu devient visible même si le module d'animation échoue. -->
    <script is:inline>
    (function(){
      try{
        var coarse = matchMedia('(hover: none) and (pointer: coarse)').matches;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if(!coarse || reduce) return;
        document.documentElement.classList.add('reveal-js');
        window.__caelRevealFailsafe = setTimeout(function(){
          if(window.__caelRevealActive) return;
          var els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
          for(var i=0;i<els.length;i++) els[i].classList.add('is-visible');
        }, 2600);
      }catch(_){}
    })();
    </script>
    <!-- ── Failsafe sans JavaScript ──
         Les éléments [data-reveal] partent à opacity:0 et ne sont révélés que
         par le JS (GSAP sur desktop, IntersectionObserver sur mobile). Si le
         script ne s'exécute pas (JS désactivé, moteur qui ne l'exécute pas),
         ce noscript garantit que 100 % du contenu reste visible et lisible. -->
    <noscript>
      <style>[data-reveal]{opacity:1 !important;transform:none !important;}</style>
    </noscript>
    <!-- ── GA4 — chargé uniquement après consentement CNIL ── -->
    <script is:inline>
    (function(){
      var GA='G-CE8L11103N';var loaded=false;
      /* Helper de tracking global — no-op tant que le consentement n'est pas donné (CNIL) */
      window.caelTrack=function(name,params){try{if(typeof window.gtag==='function')window.gtag('event',name,params||{});}catch(e){}};
      function load(){
        if(loaded)return;loaded=true;
        window.dataLayer=window.dataLayer||[];
        window.gtag=function(){window.dataLayer.push(arguments);};
        window.gtag('js',new Date());
        window.gtag('config',GA,{send_page_view:false,anonymize_ip:true});
        var s=document.createElement('script');s.async=true;
        s.src='https://www.googletagmanager.com/gtag/js?id='+GA;
        document.head.appendChild(s);
      }
      /* Lit la finalite MESURE D AUDIENCE, dans le format courant comme dans
         l ancien ({value:'accepted'}), pour ne pas redemander son consentement
         a un visiteur qui l a deja donne. */
      function consentMesure(){
        try{
          var d=JSON.parse(localStorage.getItem('caelestis-cookies')||'null');
          if(!d||!d.exp||Date.now()>=d.exp)return false;
          return typeof d.value==='string'?d.value==='accepted':!!d.mesure;
        }catch(e){return false;}
      }
      if(consentMesure())load();
      window.addEventListener('caelestis:consent-accepted',load);
      document.addEventListener('astro:page-load',function(){
        if(!loaded)return;
        window.gtag('event','page_view',{page_location:location.href,page_title:document.title});
      });
    })();
    </script>

    <!-- ── Traceur publicitaire — inexistant tant qu'aucun identifiant n'est configuré ──
         Le bloc entier n'est rendu que si PUBLIC_META_PIXEL_ID est renseignée dans
         Vercel. Même alors, le script Meta n'est chargé qu'après un consentement
         EXPLICITE à la finalité publicitaire, distinct de la mesure d'audience.
         La CSP de vercel.json autorise déjà connect.facebook.net (script) et
         www.facebook.com (envoi des événements) : tant que la variable reste
         vide, aucune requête n'est émise vers ces domaines. Il ne reste donc
         qu'un seul geste pour activer le dispositif, côté Vercel. -->
    {metaPixelId && (
      <script is:inline set:html={`
      (function(){
        var ID=${JSON.stringify(metaPixelId)};var loaded=false;
        function load(){
          if(loaded)return;loaded=true;
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
          (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init',ID);window.fbq('track','PageView');
        }
        function consentPub(){
          try{
            var d=JSON.parse(localStorage.getItem('caelestis-cookies')||'null');
            if(!d||!d.exp||Date.now()>=d.exp)return false;
            return !!d.pub;
          }catch(e){return false;}
        }
        if(consentPub())load();
        window.addEventListener('caelestis:consent-pub',load);
        document.addEventListener('astro:page-load',function(){
          if(loaded&&window.fbq)window.fbq('track','PageView');
        });
      })();
      `} />
    )}

    <!-- ── SEO de base ── -->
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    <meta name="author" content="Célestin Fruleux, Caelestis" />
    <meta name="theme-color" content="#255C41" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && <link rel="alternate" hreflang="fr" href={canonicalUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}

    <!-- ── Géolocalisation — SEO local Drôme ── -->
    <meta name="geo.region"   content="FR-26" />
    <meta name="geo.placename" content="Crest, Drôme, France" />
    <meta name="geo.position" content="44.7308;5.0197" />
    <meta name="ICBM"         content="44.7308, 5.0197" />

    <!-- ── PWA / mobile ── -->
    <meta name="mobile-web-app-capable"                content="yes" />
    <meta name="apple-mobile-web-app-capable"          content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title"            content="Caelestis" />

    <!-- ── Open Graph ── -->
    <meta property="og:type"         content="website" />
    <meta property="og:url"          content={canonicalUrl} />
    <meta property="og:title"        content={title} />
    <meta property="og:description"  content={description} />
    <meta property="og:image"        content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={title} />
    <meta property="og:locale"       content="fr_FR" />
    <meta property="og:site_name"    content="Caelestis" />

    <!-- ── Twitter / X Card ── -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- ── Satoshi auto-hébergée (aucune requête externe) ── -->
    <!-- Preload des 2 graisses critiques above-the-fold (titres 700 + corps 400) → LCP plus rapide -->
    <link rel="preload" href={satoshiTitreUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={satoshiCorpsUrl} as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- ── Icônes ── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=10" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=10" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=10" />
    <link rel="icon" type="image/png" href="/favicon.png?v=10" />
    <link rel="icon" type="image/x-icon"  href="/favicon.ico?v=10" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=10" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <ClientRouter />

    <!-- ── Slot pour les preloads / ressources spécifiques à une page ── -->
    <slot name="head" />

    <!-- ── JSON-LD Structured Data ── -->
    <!-- Échappement de < > / pour éviter l'injection via </script> dans une valeur JSON -->
    {schemas.map((s) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/\//g, '\\u002f')} />
    ))}
  </head>
  <body>
    <!-- ── Lien "Aller au contenu" — WCAG 2.4.1 (A) ── -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[99999] focus:bg-cream focus:text-brun focus:px-5 focus:py-2.5 focus:rounded-full focus:font-body focus:text-sm focus:font-medium focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-sauge"
    >
      Aller au contenu principal
    </a>

<Header />
    <SearchPalette />


    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Cursor />
    <CookieBanner />

    <!-- ── Barre d'action mobile et tablette ──
         Sous 1024px, le bouton « Parler de mon projet » du header est masqué :
         un visiteur qui descend les dix-huit écrans de l'accueil n'a plus aucun
         moyen d'agir sans ouvrir le menu. Relevé le 31/07/2026 sur qonto.com,
         payfit.com et wedezign.fr : les trois portent une action permanente sur
         mobile. C'est le pilier « CTA à un clic » de la grille de conversion.
         Volontairement le MÊME libellé que partout ailleurs sur le site : un
         CTA unique répété convertit mieux que plusieurs formulations. -->
    <div id="cta-mobile" aria-hidden="true" data-etat="cache">
      <a href="tel:+33769362727" class="cta-mobile-tel" aria-label="Appeler Caelestis au 07 69 36 27 27">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </a>
      <a href="/contact" class="cta-mobile-action">Parler de mon projet</a>
    </div>


    <style is:global>
      /* ── Barre d'action mobile et tablette ── */
      /* Le masquage passe par une media query et NON par la classe `lg:hidden` :
         `#cta-mobile` pèse 1-0-0 en spécificité et écrasait l'utilitaire de
         Tailwind (0-1-0), la barre s'affichait donc aussi en desktop, où le
         header porte déjà son bouton. */
      #cta-mobile { display: none; }
      @media (max-width: 1023px) {
        #cta-mobile { display: flex; }
      }
      #cta-mobile {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9986;            /* sous le bandeau cookies (9990), au-dessus de l'oiseau (9985) */
        align-items: center;
        gap: 10px;
        padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
        background: rgba(252, 251, 248, 0.94);
        backdrop-filter: blur(14px) saturate(1.1);
        -webkit-backdrop-filter: blur(14px) saturate(1.1);
        border-top: 1px solid var(--color-cream-dark);
        box-shadow: 0 -6px 24px rgba(37, 92, 65, 0.07);
        transform: translateY(110%);
        transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
      }
      #cta-mobile[data-etat="visible"] { transform: translateY(0); }

      .cta-mobile-tel {
        flex: none;
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 1px solid var(--color-cream-dark);
        color: #255C41;
        background: #FCFBF8;
      }
      .cta-mobile-action {
        flex: 1;
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: #255C41;
        color: var(--color-cream);
        font-family: var(--font-body);
        font-size: 0.9375rem;
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      /* Placé APRÈS la règle de base : à spécificité égale, une media query ne
         l'emporte pas, seul l'ordre compte. Sur tablette, un bouton étiré sur
         680 px fait bâclé, on borne le groupe et on le centre. */
      @media (min-width: 640px) {
        #cta-mobile {
          justify-content: center;
          padding-inline: 24px;
        }
        .cta-mobile-action { flex: 0 1 22rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        #cta-mobile { transition: none; }
      }
    </style>
  </body>
</html>

<script>
  /* ═══════════════════════════════════════════════════════
     GSAP + Lenis — chargement asynchrone après le rendu
  ═══════════════════════════════════════════════════════ */
  type GsapType = typeof import('gsap')['default'];
  type StType   = typeof import('gsap/ScrollTrigger')['ScrollTrigger'];

  /** Interface minimale de l'instance Lenis dont on se sert */
  interface LenisInstance {
    raf(time: number): void;
    destroy(): void;
    on(event: string, callback: () => void): void;
    scrollTo(cible: HTMLElement | number | string, opts?: { offset?: number; duration?: number }): void;
    resize(): void;
  }

  let gsap: GsapType;
  let ScrollTrigger: StType;
  let Lenis: (new(opts?: { duration?: number; easing?: (t: number) => number; smoothWheel?: boolean; smoothTouch?: boolean; touchMultiplier?: number }) => LenisInstance) | undefined;
  let lenis: LenisInstance | null = null;
  let gsapReady = false;

  /* Tactile (pointeur grossier) : pas de smooth-scroll JS — détecté une seule fois */
  const prefersCoarse = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  /* Référence au ticker pour pouvoir le retirer avant d'en ajouter un nouveau.
     Sans ça, chaque navigation empile un callback supplémentaire → scroll
     2×, 3×, N× trop rapide après plusieurs changements de page. */
  let lenisTicker: ((time: number) => void) | null = null;

  async function loadGsap() {
    if (gsapReady) return;
    const [gsapMod, stMod] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap          = gsapMod.default;
    ScrollTrigger = stMod.ScrollTrigger;
    gsap.registerPlugin(ScrollTrigger);
    /* Lenis (smooth scroll) : desktop à pointeur fin uniquement.
       Sur tactile, le scroll natif est déjà fluide — on évite ~17 Ko de JS. */
    if (!prefersCoarse) {
      const lenisMod = await import('lenis');
      Lenis = lenisMod.default;
    }
    gsapReady = true;
  }

  function initLenis() {
    /* Nettoie l'ancienne instance et son ticker avant tout */
    if (lenisTicker) { gsap.ticker.remove(lenisTicker); lenisTicker = null; }
    if (lenis) { lenis.destroy(); lenis = null; }

    /* Sur écrans tactiles purs (mobile), Lenis n'est même pas chargé :
       le scroll natif iOS/Android est déjà parfaitement fluide et
       Lenis peut introduire de la latence tactile. */
    if (prefersCoarse || !Lenis) return;

    lenis = new Lenis({
      duration:       1.1,   /* réduit vs 1.4 → moins "swimmy" */
      easing:         (t: number) => 1 - Math.pow(1 - t, 4),  /* quartic ease-out : départ vif, fin douce */
      smoothWheel:    true,
      smoothTouch:    false, /* touch natif sur mobiles hybrides */
      touchMultiplier: 1.5,
    });
    lenis.on('scroll', ScrollTrigger.update);

    lenisTicker = (time: number) => { lenis!.raf(time * 1000); };
    gsap.ticker.add(lenisTicker);
    gsap.ticker.lagSmoothing(500, 33); /* laisse GSAP compenser les frames longues */
  }

  /* ── Ancres internes : relais vers Lenis ──
     Lenis pilote le défilement, le saut natif du navigateur est donc ignoré et
     un lien #section s'arrête au mauvais endroit (mesuré : 2704 px au lieu de
     5550). On délègue à Lenis, après un resize() car la page a grandi depuis
     son initialisation (images, reveals). Ce module ne s'exécute qu'une fois, y
     compris à travers les View Transitions : l'écouteur délégué n'est donc jamais
     posé en double. */
  document.addEventListener('click', (e) => {
    const lien = (e.target as HTMLElement)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
    if (!lien || !lenis) return;
    const id = lien.getAttribute('href')?.slice(1);
    if (!id || id === 'main-content') return;   /* le skip-link doit rester natif */
    const cible = document.getElementById(id);
    if (!cible) return;
    e.preventDefault();
    lenis.resize();
    lenis.scrollTo(cible, { offset: -16 });
    history.replaceState(null, '', `#${id}`);
  });

  function initAnimations(isFirstLoad = true) {
    ScrollTrigger.getAll().forEach((t) => t.kill());

    /* Respect prefers-reduced-motion — WCAG 2.3.3 (AAA) / bonne pratique AA */
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      /* Rend tous les éléments visibles sans animation */
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(el => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      document.querySelectorAll<HTMLElement>('.sl > *').forEach(el => {
        (el as HTMLElement).style.transform = 'translateY(0%)';
      });
      return;
    }

    /* ── 1. Scroll reveal — apparition élégante, lente ── */
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
      /* Navigation (pas le 1er chargement) : on affiche directement, sans rejouer
         l'apparition — sinon le contenu repasse par opacity:0 et « flashe » par
         dessus la transition de page (même symptôme que celui corrigé sur mobile). */
      if (!isFirstLoad) { gsap.set(el, { opacity: 1, y: 0 }); return; }
      const delayMap: Record<string, number> = { '0': 0, '1': 0.1, '2': 0.2, '3': 0.32, '4': 0.45, '5': 0.58 };
      const delay = delayMap[el.dataset.delay ?? ''] ?? 0;
      const inlineDelay = el.style.transitionDelay
        ? parseFloat(el.style.transitionDelay)
        : 0;
      gsap.fromTo(el,
        { opacity: 0, y: 34 },
        {
          opacity: 1, y: 0,
          duration: 1.0,
          delay: delay + inlineDelay,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 91%',
            toggleActions: 'play none none none',
          },
        }
      );
    });

    /* ── 2. Split text — éditorial, power4 pour décélération luxe ── */
    document.querySelectorAll<HTMLElement>('[data-split], [data-split-hero]').forEach((el) => {
      const isHero = el.hasAttribute('data-split-hero');
      const baseDelay = isHero ? 0.04 : 0.03;
      el.querySelectorAll<HTMLElement>('.sl > *').forEach((line, i) => {
        gsap.fromTo(line,
          { y: '110%' },
          {
            y: '0%',
            duration: 1.15,
            delay: baseDelay + i * 0.11,
            ease: 'power4.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 95%',
              toggleActions: 'play none none none',
            },
          }
        );
      });
    });

    /* ── 3. Parallax GSAP scrub doux ── */
    document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
      gsap.fromTo(el,
        { yPercent: -8 },
        {
          yPercent: 8,
          ease: 'none',
          scrollTrigger: {
            trigger: el.parentElement ?? el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.2,
          },
        }
      );
    });

    /* ── 4. Light blobs — dérive très lente au scroll ── */
    document.querySelectorAll<HTMLElement>('.light-blob').forEach((blob, i) => {
      const dir = i % 2 === 0 ? -1 : 1;
      gsap.to(blob, {
        yPercent: dir * 18,
        xPercent: dir * 5,
        ease: 'none',
        scrollTrigger: {
          trigger: blob.parentElement ?? blob,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 2,
        },
      });
    });

    /* ── 5. Image zoom GSAP au survol ── */
    document.querySelectorAll<HTMLElement>('.img-zoom').forEach((container) => {
      const img = container.querySelector<HTMLElement>('img');
      if (!img) return;
      container.addEventListener('mouseenter', () => {
        gsap.to(img, { scale: 1.055, duration: 0.9, ease: 'power2.out', overwrite: 'auto' });
      });
      container.addEventListener('mouseleave', () => {
        gsap.to(img, { scale: 1, duration: 0.9, ease: 'power2.inOut', overwrite: 'auto' });
      });
    });

    /* ── 6. Boutons magnétiques ── */
    document.querySelectorAll<HTMLElement>('.btn-magnetic').forEach((btn) => {
      btn.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = (e.clientX - rect.left - rect.width  / 2) * 0.28;
        const y = (e.clientY - rect.top  - rect.height / 2) * 0.36;
        gsap.to(btn, { x, y, duration: 0.18, ease: 'power2.out' });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.38)' });
      });
    });

    /* ── 7. Fil botanique — se trace au scroll ── */
    const vinePath = document.getElementById('vine-path');
    if (vinePath instanceof SVGGeometryElement) {
      const len = vinePath.getTotalLength();
      gsap.set(vinePath, { strokeDasharray: len, strokeDashoffset: len });
      gsap.to(vinePath, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: 'main',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 2.5,
        },
      });
    }

  }

  /* ── Reveal léger sur tactile — remplace GSAP/ScrollTrigger sur mobile ──
     IntersectionObserver vanilla : 0 dépendance, ~110 Ko de JS en moins. */
  type CaelWindow = Window & { __caelRevealActive?: boolean; __caelRevealFailsafe?: number };
  function initRevealMobile() {
    const w = window as CaelWindow;
    w.__caelRevealActive = true;                 /* neutralise le failsafe inline */
    if (w.__caelRevealFailsafe) { clearTimeout(w.__caelRevealFailsafe); w.__caelRevealFailsafe = undefined; }

    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -7% 0px' });
    els.forEach((el) => io.observe(el));
  }

  /* ── Boot : sur tactile, reveal natif sans GSAP ; sur desktop, GSAP complet ── */
  async function boot() {
    if (prefersCoarse) { initRevealMobile(); return; }
    await loadGsap();
    initLenis();
    initAnimations();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  /* ── View Transitions sur tactile : on AFFICHE directement le contenu de la
     nouvelle page, sans rejouer l'animation d'entrée. Rejouer le reveal à
     chaque navigation provoquait un flash / « double affichage » (le contenu
     repassait à opacity:0 puis ré-apparaissait par-dessus la transition de
     page). L'effet d'apparition ne joue donc qu'au tout premier chargement.
     On retire .reveal-js (plus de masquage) et on marque tout comme visible,
     AVANT le paint — donc sans aucun flash. ── */
  document.addEventListener('astro:after-swap', () => {
    if (prefersCoarse) {
      /* Tactile : retire le masquage et marque tout visible. */
      document.documentElement.classList.remove('reveal-js');
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
    } else {
      /* Desktop : révèle directement, AVANT le paint, pour qu'aucune frame ne
         passe par opacity:0 (GSAP, chargé en async, prend la main ensuite mais
         seulement pour les effets de scroll — plus pour l'apparition). */
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
    }
  });

  /* ── Relance après chaque navigation View Transitions ── */
  document.addEventListener('astro:page-load', async () => {
    if (prefersCoarse) return;   /* tactile : déjà géré dans astro:after-swap */
    await loadGsap();
    initLenis();
    initAnimations(false);   /* navigation : pas de ré-animation d'entrée (anti-flash) */
  });

  /* ═══════════════════════════════════════════════════════
     Barre d'action mobile et tablette

     Elle n'apparaît qu'une fois le premier écran dépassé : tant que le CTA du
     hero est visible, la doubler n'apporte rien et mange de la hauteur utile.
     Elle s'efface quand le pied de page ou la section d'appel finale arrive à
     l'écran, pour ne pas recouvrir le vrai bouton, et reste absente tant que le
     bandeau de consentement occupe le bas de l'écran.
  ═══════════════════════════════════════════════════════ */
  (function barreActionMobile() {
    let observateurs: IntersectionObserver[] = [];
    let sentinelle: HTMLElement | null = null;

    function init() {
      const barre = document.getElementById('cta-mobile');
      if (!barre) return;
      /* `astro:page-load` se déclenche AUSSI au premier chargement : sans ce
         nettoyage, chaque navigation empilerait une sentinelle et un jeu
         d'observateurs de plus, et deux états concurrents se disputeraient la
         barre. */
      observateurs.forEach((o) => o.disconnect());
      observateurs = [];
      sentinelle?.remove();
      sentinelle = null;

      /* Sur une page dont le formulaire EST le contenu, la barre ferait doublon. */
      const cheminsExclus = ['/contact', '/questionnaire-client', '/questionnaire-devis'];
      if (cheminsExclus.includes(location.pathname.replace(/\/$/, ''))) {
        barre.dataset.etat = 'cache';
        return;
      }

      let depasseLeHero = false;
      let finEnVue = false;

      const cookiesEnCours = () => {
        const b = document.getElementById('cookie-banner');
        return !!b && !b.classList.contains('translate-y-full');
      };

      const majEtat = () => {
        const visible = depasseLeHero && !finEnVue && !cookiesEnCours();
        barre.dataset.etat = visible ? 'visible' : 'cache';
        /* aria-hidden suit l'état visuel : rien d'annoncé tant que c'est masqué,
           et rien d'atteignable au clavier hors écran. */
        barre.setAttribute('aria-hidden', visible ? 'false' : 'true');
        barre.querySelectorAll('a').forEach((a) => {
          if (visible) a.removeAttribute('tabindex');
          else a.setAttribute('tabindex', '-1');
        });
      };

      /* Sentinelle : un écran de haut, en tête de page. */
      sentinelle = document.createElement('div');
      sentinelle.setAttribute('aria-hidden', 'true');
      sentinelle.dataset.sentinelleCta = '';
      sentinelle.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:88vh;pointer-events:none';
      document.body.appendChild(sentinelle);

      const obsHaut = new IntersectionObserver(([e]) => {
        depasseLeHero = !e.isIntersecting;
        majEtat();
      }, { threshold: 0 });
      obsHaut.observe(sentinelle);
      observateurs.push(obsHaut);

      const fin = document.querySelector('footer');
      if (fin) {
        const obsBas = new IntersectionObserver(([e]) => {
          finEnVue = e.isIntersecting;
          majEtat();
        }, { rootMargin: '0px 0px -25% 0px' });
        obsBas.observe(fin);
        observateurs.push(obsBas);
      }

      window.addEventListener('caelestis:consent-accepted', majEtat);
      document.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement)?.closest?.('#cookie-banner')) setTimeout(majEtat, 60);
      });

      majEtat();
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
