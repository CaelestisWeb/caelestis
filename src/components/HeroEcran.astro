---
/* ─── HERO « le site dans l'écran » ───
   Le premier écran de l'accueil est un moniteur qui affiche le site lui-même.
   On y navigue par le menu (chaque page glisse latéralement), et un glissement
   automatique toutes les 5 s indique au visiteur qu'il peut naviguer dedans.

   Le contenu des pages Services et Réalisations vient des mêmes sources que le
   reste du site (FORMULES dans utils/tarifs, realisations dans data), pour ne
   pas dupliquer les libellés ni les prix. Les autres pages sont un aperçu court.

   Décision de Célestin le 10/08/2026, en remplacement du hero typographique. */
import { FORMULES, euros } from '../utils/tarifs';
import { realisations } from '../data/realisations';

const menu = [
  { key: 'accueil',      label: 'Accueil',      href: '/' },
  { key: 'services',     label: 'Services',     href: '/services' },
  { key: 'realisations', label: 'Réalisations', href: '/realisations' },
  { key: 'outils',       label: 'Outils',       href: '/outils/simulateur' },
  { key: 'ressources',   label: 'Ressources',   href: '/ressources' },
  { key: 'apropos',      label: 'À propos',      href: '/a-propos' },
  { key: 'contact',      label: 'Contact',      href: '/contact' },
];
---

<section class="hero-ecran" aria-label="Aperçu interactif du site Caelestis">
  <div aria-hidden="true" class="halo halo-1"></div>
  <div aria-hidden="true" class="halo halo-2"></div>

  <div class="rig">
    <div class="bezel">
      <div class="glass" data-glass>
        <div class="power" aria-hidden="true"></div>
        <div class="dots">
          {menu.map((m) => (
            <button type="button" class={m.key === 'accueil' ? 'dot on' : 'dot'} data-nav={m.key} aria-label={'Aller à ' + m.label}></button>
          ))}
        </div>
        <div class="browser">
          <nav class="topnav" aria-label="Menu du site présenté">
            <a class="brand" href="/" data-nav="accueil">Caelestis</a>
            <div class="navlinks">
              {menu.map((m) => (
                <a href={m.href} class={m.key === 'accueil' ? 'on' : ''} data-nav={m.key}>{m.label}</a>
              ))}
            </div>
            <div class="navend">
              <svg class="loupe" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><line x1="12.7" y1="12.7" x2="17" y2="17" stroke-linecap="round"/></svg>
              <a class="navcta" href="/contact" data-nav="contact">Parler de mon projet</a>
            </div>
          </nav>

          <div class="stack" data-stack>
            <!-- ACCUEIL : la vraie première section -->
            <section class="view accueil active" data-view="accueil">
              <p class="eyebrow">Création de site web en <b>Auvergne-Rhône-Alpes</b></p>
              <!-- Titre de niveau 1 porté par ARIA et non par une balise de titre :
                   le hero existe en deux exemplaires (ce moniteur en desktop,
                   `.he-mobile` sous 760 px), et deux titres de niveau 1 dans le
                   DOM font une page à deux titres pour les robots. Aucun nom de
                   balise n'est écrit en toutes lettres ici : un chevron dans un
                   commentaire trompe les parseurs à expression régulière, qui
                   sont légion parmi les outils d'audit. Google indexant en
                   mobile-first, la balise <h1> reste sur la version mobile,
                   celle qu'il rend. Pour un lecteur d'écran le résultat est
                   identique : `role=heading aria-level=1` produit le même
                   niveau, et la version masquée est hors de l'arbre
                   d'accessibilité (display:none). -->
              <div class="h-hero" role="heading" aria-level="1">Optez pour un site web,<br><span class="accent">digne de votre <span class="nobreak">savoir-faire.</span></span></div>
              <p class="lead">Sur internet, on recherche, on compare, on choisit.<br><b>Nous faisons de vous, le choix évident.</b></p>
              <a class="btn" href="/contact" data-nav="contact">Parler de mon projet</a>
            </section>

            <!-- SERVICES -->
            <section class="view" data-view="services" aria-hidden="true">
              <p class="eyebrow">Création de site internet</p>
              <p class="h-page">Un site internet qui reflète vraiment votre activité.</p>
              <p class="intro">En 2 à 8 semaines, nous construisons ensemble un site sobre, authentique et durable, qui met en lumière votre travail et transforme les visiteurs en futurs clients.</p>
              <div class="formules">
                {FORMULES.map((f) => (
                  <div class={f.accent ? 'formule reco' : 'formule'}>
                    {f.accent && <span class="badge">Le plus demandé</span>}
                    <div class="t-nom">{f.nom}</div>
                    <p>{f.baseline}</p>
                    <div class="prix">à partir de {euros(f.prix)} €<span>le site</span></div>
                  </div>
                ))}
              </div>
              <p class="note">30 % d'acompte à la signature, solde à la mise en ligne. Les prix sont nets, sans TVA à ajouter.</p>
            </section>

            <!-- RÉALISATIONS -->
            <section class="view" data-view="realisations" aria-hidden="true">
              <p class="h-page">Ce que nous avons livré, et ce que ça change.</p>
              <p class="intro">Chaque étude de cas décrit la même chose : ce qui coinçait avant, ce qui a été construit, et ce qui fonctionne aujourd'hui sans que le client ait à nous rappeler.</p>
              <div class="cas">
                {realisations.map((r, i) => (
                  <div class="case">
                    <div class={i === 0 ? 'shot shot-a' : 'shot shot-b'}>
                      <div class="mini">
                        <div class="mini-bar"><i></i><i></i><i></i><span class="u"></span></div>
                        {i === 0 ? (
                          <div class="mini-body">
                            <div class="mini-title"></div>
                            <div class="mini-line" style="width:80%"></div>
                            <div class="mini-row"><div class="mini-btn"></div><div class="mini-slots"><span class="on"></span><span></span><span class="on"></span><span></span><span></span></div></div>
                          </div>
                        ) : (
                          <div class="mini-body">
                            <div class="mini-title" style="width:44%"></div>
                            <div class="mini-gallery"><span class="on"></span><span></span><span></span><span class="on"></span><span></span><span class="on"></span><span></span><span></span></div>
                          </div>
                        )}
                      </div>
                    </div>
                    <div class="meta">
                      <span class="sect">{r.metier}, {r.ville}</span>
                      <span class="ct">{r.titre}</span>
                      <div class="foot2"><span class="delai">{r.delai}</span><span class="lien">Lire l'étude de cas <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
                    </div>
                  </div>
                ))}
              </div>
            </section>

            <!-- OUTILS -->
            <section class="view" data-view="outils" aria-hidden="true">
              <p class="eyebrow">Outils</p>
              <p class="h-page">Deux outils pour y voir clair.</p>
              <p class="intro">Estimez votre projet et mesurez votre site actuel, en quelques minutes, sans engagement.</p>
              <div class="duo">
                <a class="tuile" href="/outils/simulateur"><div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h4"/></svg></div><div class="t-nom">Estimer mon projet</div><p>Un simulateur qui donne une fourchette de prix adaptée à vos besoins.</p></a>
                <a class="tuile" href="/outils/diagnostic"><div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16 16l5 5"/></svg></div><div class="t-nom">Analyser mon site</div><p>Un diagnostic clair de votre site actuel, ses points forts et ses freins.</p></a>
              </div>
            </section>

            <!-- RESSOURCES -->
            <section class="view" data-view="ressources" aria-hidden="true">
              <p class="eyebrow">Ressources</p>
              <p class="h-page">Les réponses qu'on cherche avant de se lancer.</p>
              <p class="intro">Prix réels, délais, contenus à préparer, visibilité sur Google et dans les assistants IA : des guides complets, écrits sans jargon et sans rien vous vendre.</p>
              <div class="quatre">
                <div class="tuile"><div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5a2.5 2 0 0 1 5 0c0 2-2.5 1.5-2.5 3"/></svg></div><div class="t-nom">Les prix réels d'un site</div><p>Ce que coûte vraiment un site, poste par poste.</p></div>
                <div class="tuile"><div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg></div><div class="t-nom">Les délais</div><p>Combien de temps pour être en ligne, selon la formule.</p></div>
                <div class="tuile"><div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h11l3 3v13H5z"/><path d="M9 12h6M9 16h6"/></svg></div><div class="t-nom">Le contenu à préparer</div><p>Textes, photos, infos : ce qu'on vous demandera.</p></div>
                <div class="tuile"><div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></div><div class="t-nom">Visible sur Google et les IA</div><p>Être trouvé au bon moment, humains comme assistants.</p></div>
              </div>
            </section>

            <!-- À PROPOS -->
            <section class="view" data-view="apropos" aria-hidden="true">
              <p class="eyebrow">À propos</p>
              <p class="h-page">Pourquoi Caelestis ?</p>
              <div class="apropos">
                <dl class="fiche">
                  <div><dt>Âge</dt><dd>22 ans</dd></div>
                  <div><dt>Basé à</dt><dd>Drôme</dd></div>
                  <div><dt>Spécialité</dt><dd>Création web</dd></div>
                  <div><dt>Réponse</dt><dd>Sous 48h</dd></div>
                </dl>
                <p>Le nom Caelestis est inspiré de mon prénom Célestin, dont l'origine latine évoque le ciel.</p>
                <p><b>Je suis Célestin Fruleux, j'ai 22 ans, et je suis passionné par la nature, le bien-être et l'entrepreneuriat.</b></p>
                <p>Un bon site internet ne change pas votre activité. Il la valorise. Il la rend visible, crédible et facile à trouver, et devient un véritable outil de croissance.</p>
                <p class="signature">Pour ceux qui créent quelque chose de beau.</p>
                <a class="btn" href="/contact" data-nav="contact">Réserver un appel</a>
              </div>
            </section>

            <!-- CONTACT -->
            <section class="view" data-view="contact" aria-hidden="true">
              <p class="eyebrow">Contact</p>
              <p class="h-page">Faites rayonner ce que vous créez.</p>
              <p class="intro">Parlez-nous de votre projet. On revient vers vous sous 48h.</p>
              <div class="contact-grid">
                <div class="coord">
                  <div class="row"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><span><span class="lbl">Email</span><br><span class="val">contact@caelestis.fr</span></span></div>
                  <div class="row"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span><span><span class="lbl">Téléphone</span><br><span class="val">07 69 36 27 27</span></span></div>
                  <div class="row"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 0 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span><span class="lbl">Localisation</span><br><span class="val">Drôme, France</span></span></div>
                  <div class="row"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><span class="lbl">Horaires</span><br><span class="val">Du lundi au samedi, 9h à 18h</span></span></div>
                </div>
                <div class="form2" aria-hidden="true">
                  <div class="field"><span class="flabel">Prénom</span><span class="finput">Votre prénom</span></div>
                  <div class="field"><span class="flabel">Nom</span><span class="finput">Votre nom</span></div>
                  <div class="field full"><span class="flabel">Email</span><span class="finput">votre@email.com</span></div>
                  <div class="field full"><span class="flabel">Votre projet</span><span class="finput tall">En quelques mots…</span></div>
                  <div class="full"><span class="btn ghost-btn">Envoyer le message</span></div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
    <div class="stand" aria-hidden="true"></div>
    <div class="foot" aria-hidden="true"></div>
    <div class="foot-sh" aria-hidden="true"></div>

    <!-- Sans cette ligne, la navigation au clavier n'existe pas pour le visiteur :
         il n'essaiera pas une touche dont rien n'annonce l'effet. Elle s'efface
         dès qu'il a pris la main, au clavier comme à la souris. -->
    <p class="he-clavier" data-he-hint>
      <kbd aria-hidden="true">←</kbd><kbd aria-hidden="true">→</kbd>
      <span>Les flèches du clavier font défiler les pages.</span>
    </p>

    <!-- Indicateur de défilement, sous le pied du moniteur. Purement décoratif :
         le moniteur occupe tout le premier écran, rien n'indiquait qu'il y avait
         une suite. Trois chevrons qui s'allument en cascade vers le bas. -->
    <div class="he-scroll" aria-hidden="true">
      <svg viewBox="0 0 28 32" width="28" height="32">
        <path class="ch1" d="M2 2 L14 11 L26 2"/>
        <path class="ch2" d="M2 11 L14 20 L26 11"/>
        <path class="ch3" d="M2 20 L14 29 L26 20"/>
      </svg>
    </div>
  </div>

  <!-- Version mobile : le moniteur en petit est illisible, on le remplace par un
       hero épuré (accroche + bouton). Affiché sous 760px, le .rig est masqué. -->
  <div class="he-mobile">
    <p class="hm-eyebrow">Création de site web en<br><b>Auvergne-Rhône-Alpes</b></p>
    <div class="hm-core">
      <!-- Trois lignes forcées, comme pour le sous-titre : sous 330 px de large,
           la police descend assez bas pour que « digne de votre savoir-faire. »
           se recompose sur une seule ligne et que le titre perde son étagement. -->
      <h1 class="hm-title">Optez pour un site web,<br><span class="accent">digne de votre<br><span class="nobreak">savoir-faire.</span></span></h1>
      <!-- Les deux retours forcés donnent trois lignes qui cassent sur les
           virgules. Sans eux, la première ligne se termine par « on » et le mot
           « compare » se retrouve seul en tête de deuxième ligne. -->
      <p class="hm-sub">Sur internet, on recherche,<br>on compare, on choisit.<br><b>Nous faisons de vous, le choix évident.</b></p>
      <a class="hm-cta" href="/contact">Parler de mon projet</a>
    </div>
    <div class="hm-reassure">
      <div class="hm-r"><span class="hm-ric"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M9 13l2 2 4-4"/></svg></span><span class="hm-rl">Devis gratuit</span></div>
      <div class="hm-r"><span class="hm-ric"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l8-8h6a2 2 0 0 1 2 2v6l-8 8z"/><circle cx="15.5" cy="8.5" r="1.3"/></svg></span><span class="hm-rl">Dès 1 000 €</span></div>
      <div class="hm-r"><span class="hm-ric"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg></span><span class="hm-rl">En 2 à 8 semaines</span></div>
    </div>
  </div>
</section>

<style>
  .hero-ecran{position:relative;min-height:calc(100svh - 4rem);display:grid;place-items:center;overflow:hidden;
    padding:clamp(1.5rem,4vh,3rem) clamp(1rem,4vw,2.5rem)}
  .halo{position:absolute;border-radius:50%;pointer-events:none;filter:blur(52px)}
  .halo-1{width:min(56vw,720px);height:min(56vw,720px);top:-12%;left:-6%;background:radial-gradient(circle,rgba(184,196,187,.38),transparent 66%)}
  .halo-2{width:min(48vw,600px);height:min(48vw,600px);bottom:-14%;right:-5%;background:radial-gradient(circle,rgba(207,187,153,.32),transparent 66%)}

  .rig{width:min(1180px,96vw);position:relative;z-index:1}
  .he-mobile{display:none}
  .bezel{background:#16180f;border:3px solid #24271c;border-radius:16px;padding:12px;box-shadow:0 46px 84px -32px rgba(18,22,15,.5)}
  /* 60vh et non 64vh depuis l'ajout des chevrons de défilement le 12/08/2026 :
     sur un écran de 768 px de haut, les quatre derniers vh manquaient et le
     troisième chevron passait sous la ligne de flottaison. */
  .glass{position:relative;border-radius:8px;overflow:hidden;background:var(--color-cream);height:min(58vw,60vh);min-height:420px}
  .power{position:absolute;inset:0;background:#0a0c07;z-index:20;animation:he-power .45s ease .05s forwards}
  @keyframes he-power{to{opacity:0;visibility:hidden}}
  .stand{width:12%;height:34px;background:linear-gradient(#1f2318,#2b3020);margin:-2px auto 0;border-radius:0 0 5px 5px}
  .foot{width:26%;height:11px;background:#1f2318;border-radius:100px;margin:0 auto}
  .foot-sh{width:32%;height:18px;border-radius:50%;background:rgba(18,22,15,.16);filter:blur(12px);margin:9px auto 0}

  .browser{position:absolute;inset:0;display:flex;flex-direction:column;background:var(--color-cream)}
  .topnav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:clamp(8px,1.3vw,20px);padding:13px clamp(14px,2vw,34px);border-bottom:1px solid var(--color-cream-dark);flex:none;z-index:5;background:rgba(252,251,248,.72);backdrop-filter:blur(6px)}
  .brand{font-weight:700;font-size:clamp(15px,1.4vw,19px);color:var(--color-ocre);letter-spacing:-.02em;cursor:pointer}
  .navend{display:flex;align-items:center;gap:clamp(8px,1.2vw,14px);justify-self:end}
  .navlinks{display:flex;gap:clamp(8px,1.15vw,18px);justify-self:center}
  .navlinks a{font-family:inherit;background:none;border:0;font-size:clamp(10px,.92vw,13px);font-weight:500;color:var(--color-brun-mid);cursor:pointer;position:relative;padding:0 0 3px;transition:color .2s;white-space:nowrap}
  .navlinks a::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:1.5px;background:var(--color-sauge);transform:scaleX(0);transform-origin:right;transition:transform .3s}
  .navlinks a:hover{color:var(--color-ocre)}
  .navlinks a.on{color:var(--color-ocre)}
  .navlinks a.on::after,.navlinks a:hover::after{transform:scaleX(1);transform-origin:left}
  .loupe{width:17px;height:17px;stroke:var(--color-brun-mid);fill:none;stroke-width:1.7;flex:none}
  .navcta{font-family:inherit;background:var(--color-ocre);color:var(--color-cream);border:0;font-size:clamp(10px,.92vw,12.5px);font-weight:500;padding:.55em 1.05em;border-radius:100px;cursor:pointer;transition:background .2s;white-space:nowrap;flex:none}
  .navcta:hover{background:var(--color-ocre-dark)}
  @media(max-width:1000px){.navlinks{display:none}}

  .stack{position:relative;flex:1;overflow:hidden}
  .view{position:absolute;inset:0;overflow-y:auto;transform:translateX(100%);pointer-events:none;transition:transform .55s cubic-bezier(.7,0,.18,1);padding:clamp(18px,4vh,42px) clamp(20px,5vw,64px)}
  .view.active{pointer-events:auto}
  .view::-webkit-scrollbar{width:8px}.view::-webkit-scrollbar-thumb{background:rgba(37,92,65,.2);border-radius:10px}

  .eyebrow{font-size:clamp(.62rem,.9vw,.78rem);font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--color-sauge-text);margin-bottom:clamp(.7rem,1.6vh,1.1rem)}
  .h-page{font-family:var(--font-display);font-weight:700;font-size:clamp(1.35rem,2.5vw,2.1rem);line-height:1.08;letter-spacing:-.035em;color:var(--color-ocre);margin-bottom:.6rem;max-width:20ch}
  .intro{color:var(--color-brun-mid);max-width:58ch;margin-bottom:1.6rem;font-size:clamp(.88rem,1.1vw,1rem);line-height:1.6}
  .btn{font-family:inherit;display:inline-block;background:var(--color-ocre);color:var(--color-cream);border:0;font-weight:500;font-size:clamp(.85rem,1.1vw,.96rem);padding:.82em 1.8em;border-radius:100px;cursor:pointer;transition:background .25s,transform .25s;box-shadow:0 12px 26px -12px rgba(37,92,65,.55)}
  .btn:hover{background:var(--color-ocre-dark);transform:translateY(-2px)}

  .accueil{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:100%}
  .accueil .eyebrow{color:var(--color-brun-mid)}
  .accueil .eyebrow b{color:var(--color-ocre);font-weight:500;border-bottom:1px solid rgba(37,92,65,.35);padding-bottom:2px}
  /* `.h-hero` et `.t-nom` remplacent des balises de titre déclassées en div (voir
     les commentaires du balisage). Une div ne reçoit plus les règles globales
     `h1,h2,h3,h4` de global.css : `text-wrap`, `font-feature-settings` et
     `overflow-wrap` sont donc repris ici, sans quoi le rendu changerait de
     quelques pixels sur les libellés qui passent à la ligne. */
  .view .h-hero,.formule .t-nom,.tuile .t-nom{text-wrap:balance;font-feature-settings:"kern" 1,"liga" 1;overflow-wrap:break-word}
  .view .h-hero{font-family:var(--font-display);font-weight:700;font-size:clamp(1.85rem,3.8vw,3.2rem);line-height:1.05;letter-spacing:-.035em;color:var(--color-ocre);margin-bottom:clamp(1rem,2.2vh,1.5rem)}
  .view .h-hero .accent{color:var(--color-sauge-vif)}
  .nobreak{white-space:nowrap}
  .lead{font-size:clamp(.95rem,1.3vw,1.12rem);color:var(--color-brun-mid);max-width:52ch;margin-bottom:clamp(1.2rem,2.6vh,2rem);line-height:1.6}
  .lead b{color:var(--color-encre);font-weight:500}

  .formules{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
  .formule{position:relative;border:1px solid var(--color-cream-dark);border-radius:14px;padding:1.15rem;background:#fff;transition:transform .3s,box-shadow .3s,border-color .3s;display:flex;flex-direction:column}
  .formule:hover{transform:translateY(-5px);box-shadow:0 22px 40px -26px rgba(18,22,15,.32);border-color:var(--color-sauge)}
  .formule.reco{border-color:var(--color-ocre)}
  .badge{position:absolute;top:-10px;left:1.15rem;background:var(--color-ocre);color:var(--color-cream);font-size:.62rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:.28em .7em;border-radius:100px}
  /* `.t-nom` remplace un <h3> : ces libellés dessinent des pages du site à
     l'intérieur du moniteur, ce ne sont pas des sections de la page d'accueil.
     En <h3> ils ouvraient un saut h1 → h3 dans la hiérarchie de titres et
     faisaient passer une illustration pour du plan de page. `line-height` est
     repris de la règle globale `h3,h4` de global.css, que la div ne reçoit plus. */
  .formule .t-nom{font-family:var(--font-display);font-weight:700;font-size:1rem;line-height:1.22;color:var(--color-encre);letter-spacing:-.02em;margin-bottom:.45rem}
  .formule p{font-size:.82rem;color:var(--color-brun-mid);line-height:1.5;margin-bottom:.9rem;flex:1}
  .formule .prix{font-weight:700;color:var(--color-ocre);font-size:.96rem}
  .formule .prix span{display:block;font-weight:500;color:var(--color-brun-mid);font-size:.72rem;margin-top:2px}
  .note{margin-top:1.1rem;font-size:.8rem;color:var(--color-brun-mid)}

  /* auto-fit et non « 1fr 1fr » : depuis le retrait de La Coquette le
     12/08/2026, la liste peut ne contenir qu'une réalisation, et deux colonnes
     en dur laissaient la moitié droite de la maquette vide. */
  .cas{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,330px));justify-content:center;gap:1.2rem}
  .case{border:1px solid var(--color-cream-dark);border-radius:16px;overflow:hidden;background:#fff;display:flex;flex-direction:column;transition:transform .3s,box-shadow .3s}
  .case:hover{transform:translateY(-5px);box-shadow:0 24px 44px -26px rgba(18,22,15,.32)}
  .shot{height:122px;display:flex;align-items:flex-end;justify-content:center;padding:16px 22px 0;overflow:hidden}
  .shot-a{background:var(--color-sauge-pale)}
  .shot-b{background:#EDF1EA}
  .mini{width:100%;max-width:238px;height:100px;overflow:hidden;background:#fff;border-radius:8px 8px 0 0;box-shadow:0 12px 26px -14px rgba(18,22,15,.32)}
  .mini-bar{display:flex;align-items:center;gap:4px;padding:7px 9px;background:#f4f3ed;border-bottom:1px solid var(--color-cream-dark);border-radius:8px 8px 0 0}
  .mini-bar i{width:6px;height:6px;border-radius:50%;background:var(--color-sauge)}
  .mini-bar .u{margin-left:6px;height:7px;flex:1;max-width:96px;background:#e5e4dc;border-radius:3px}
  .mini-body{padding:11px 12px 12px}
  .mini-title{height:8px;width:56%;background:var(--color-ocre);border-radius:3px;margin-bottom:7px}
  .mini-line{height:5px;background:var(--color-cream-dark);border-radius:3px;margin-bottom:8px}
  .mini-row{display:flex;align-items:center;gap:7px}
  .mini-btn{height:13px;width:58px;background:var(--color-ocre);border-radius:100px;flex:none}
  .mini-slots{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;flex:1}
  .mini-slots span{height:12px;border-radius:3px;background:var(--color-sauge-pale);border:1px solid rgba(37,92,65,.18)}
  .mini-slots span.on{background:var(--color-ocre);border-color:var(--color-ocre)}
  .mini-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}
  .mini-gallery span{height:16px;border-radius:4px;background:var(--color-sauge-pale)}
  .mini-gallery span.on{background:var(--color-ocre)}
  .meta{padding:1rem 1.2rem;display:flex;flex-direction:column;gap:.35rem}
  .sect{font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:var(--color-sauge-text);font-weight:600}
  .ct{font-weight:700;color:var(--color-encre);font-size:.96rem;line-height:1.3;letter-spacing:-.01em}
  .foot2{display:flex;align-items:center;justify-content:space-between;margin-top:.4rem}
  .delai{font-size:.78rem;color:var(--color-brun-mid)}
  .lien{font-size:.82rem;font-weight:600;color:var(--color-ocre);display:inline-flex;align-items:center;gap:5px}
  .lien svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.9}

  .duo{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .quatre{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
  .tuile{border:1px solid var(--color-cream-dark);border-radius:14px;padding:1.15rem;background:#fff;transition:transform .3s,box-shadow .3s,border-color .3s;cursor:pointer}
  .tuile:hover{transform:translateY(-5px);box-shadow:0 22px 40px -26px rgba(18,22,15,.3);border-color:var(--color-sauge)}
  .tuile .ic{width:40px;height:40px;border-radius:11px;background:var(--color-sauge-pale);display:flex;align-items:center;justify-content:center;margin-bottom:.85rem}
  .tuile .ic svg{width:20px;height:20px;stroke:var(--color-ocre);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .tuile .t-nom{font-family:var(--font-display);font-weight:700;font-size:.96rem;line-height:1.22;color:var(--color-encre);letter-spacing:-.02em;margin-bottom:.32rem}
  .tuile p{font-size:.82rem;color:var(--color-brun-mid);line-height:1.5}

  .apropos{max-width:64ch}
  .fiche{display:flex;flex-wrap:wrap;gap:1.2rem 2.4rem;padding:1rem 0 1.3rem;border-top:1px solid var(--color-cream-dark);border-bottom:1px solid var(--color-cream-dark);margin-bottom:1.5rem}
  .fiche div{display:flex;flex-direction:column;gap:2px}
  .fiche dt{font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-sauge-text);font-weight:600}
  .fiche dd{font-size:1rem;font-weight:500;color:var(--color-encre)}
  .apropos p{color:var(--color-brun-mid);margin-bottom:.9rem;font-size:clamp(.9rem,1.1vw,1rem);line-height:1.6}
  .apropos p b{color:var(--color-encre);font-weight:500}
  .signature{font-family:var(--font-display);font-weight:700;color:var(--color-ocre);font-size:1.1rem;letter-spacing:-.02em;margin:.4rem 0 1.4rem}

  .contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:2rem}
  .coord{display:flex;flex-direction:column;gap:1rem}
  .coord .row{display:flex;align-items:center;gap:.8rem}
  .coord .ic{width:38px;height:38px;border-radius:10px;background:var(--color-sauge-pale);display:flex;align-items:center;justify-content:center;flex:none}
  .coord .ic svg{width:18px;height:18px;stroke:var(--color-ocre);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .coord .lbl{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--color-brun-mid)}
  .coord .val{font-size:.92rem;font-weight:500;color:var(--color-encre)}
  .form2{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
  .form2 .full{grid-column:1/-1}
  .flabel{display:block;font-size:.78rem;font-weight:500;color:var(--color-encre);margin-bottom:.35rem}
  .finput{display:block;border:1px solid var(--color-cream-dark);border-radius:10px;padding:.62rem .8rem;font-size:.88rem;color:var(--color-brun-mid);background:#fff}
  .finput.tall{padding-bottom:2.2rem}
  .ghost-btn{display:inline-block}

  /* Indice clavier, sous le pied du moniteur. Il entre en fondu une fois le
     moniteur allumé, et sort dès la première navigation : ce n'est pas un
     élément de décor, c'est une consigne qui a servi. */
  .he-clavier{display:flex;align-items:center;justify-content:center;gap:.5rem;
    margin-top:clamp(.6rem,1.4vh,1.1rem);font-size:.78rem;color:var(--color-brun-mid);
    opacity:0;animation:he-hint .6s ease 1.1s forwards;transition:opacity .45s ease,visibility .45s}
  .he-clavier kbd{font-family:inherit;font-size:.74rem;line-height:1;color:var(--color-brun-mid);
    background:rgba(252,251,248,.75);border:1px solid var(--color-cream-dark);border-bottom-width:2px;
    border-radius:5px;padding:.28em .48em}
  .he-clavier.off{opacity:0;visibility:hidden;animation:none}
  @keyframes he-hint{to{opacity:1}}

  /* Chevrons de défilement : centrés sous le moniteur, vert forêt de la charte.
     Ils s'allument du haut vers le bas, ce qui donne la direction sans un mot. */
  .he-scroll{display:flex;justify-content:center;margin-top:clamp(.35rem,.9vh,.7rem)}
  .he-scroll svg{width:clamp(28px,2.4vw,36px);height:auto;fill:none;stroke:var(--color-ocre);
    stroke-width:2;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
  .he-scroll path{opacity:.25;animation:he-chevron 2s ease-in-out infinite}
  .he-scroll .ch2{animation-delay:.18s}
  .he-scroll .ch3{animation-delay:.36s}
  @keyframes he-chevron{
    0%,60%,100%{opacity:.25}
    28%{opacity:1}
  }

  /* Points de pagination : masqués en desktop (navigation par le menu). */
  .dots{display:none}

  /* ── Mobile : le moniteur passe en portrait, navigation par points + swipe ── */
  @media(max-width:760px){
    /* 4,05rem et non 3,5rem : le header mobile mesure 64,8 px, le hero
       réservait 56 px et débordait donc de 9 px sous la ligne de flottaison,
       ce qui rognait l'air prévu sous la réassurance. */
    .hero-ecran{min-height:calc(100svh - 4.05rem);place-items:start center;padding:clamp(.8rem,2.5vh,1.6rem) clamp(.8rem,4vw,1.5rem)}
    .rig{width:93vw;animation:none}
    .bezel{padding:9px;border-radius:22px}
    .glass{height:min(66svh,560px);min-height:430px;border-radius:15px}
    .stand,.foot,.foot-sh{display:none}
    .topnav{padding:12px 16px;gap:10px}
    .navcta{font-size:11px;padding:.5em .85em}
    .view{padding:24px 22px 58px}
    .accueil{padding-bottom:58px}
    .view .h-hero{font-size:clamp(1.5rem,7.4vw,2.05rem);hyphens:manual}
    .h-page{font-size:clamp(1.3rem,6vw,1.7rem)}
    .lead{font-size:1rem;max-width:34ch}
    .intro{font-size:.95rem}
    .formules,.quatre,.cas,.duo,.contact-grid,.form2{grid-template-columns:1fr}
    .fiche{gap:1rem 2rem}
    .dots{display:flex;position:absolute;bottom:12px;left:50%;transform:translateX(-50%);gap:6px;z-index:9;
      background:rgba(252,251,248,.92);padding:7px 11px;border-radius:100px;box-shadow:0 6px 16px -8px rgba(18,22,15,.35);backdrop-filter:blur(6px)}
    .dot{width:7px;height:7px;border-radius:100px;border:0;padding:0;background:var(--color-sauge);cursor:pointer;transition:width .3s,background .3s}
    .dot.on{width:20px;background:var(--color-ocre)}

    /* ── Mobile : le moniteur laisse place à un hero épuré (module A) ──
       Rythme vertical, revu le 14/08/2026. Trois groupes seulement : le
       surtitre (ancré en haut), le cœur du message (titre, sous-titre, bouton)
       et la réassurance (ancrée en bas). L'air se joue dans les deux rangées
       vides, et non plus en space-between : celui-ci partageait le vide à
       parts égales, ce qui posait le cœur trop haut (113 px au-dessus contre
       144 px en dessous, mesuré sur 390 × 844). Les rangées valent 1,55 pour
       une : le bloc central tombe juste sous le milieu de l'écran, là où le
       pouce et le regard arrivent. Les minmax gardent de l'air sur les petits
       écrans, où les fractions se réduisent presque à rien. */
    .rig{display:none}
    .hero-ecran{display:flex;flex-direction:column;align-items:center}
    .he-mobile{display:grid;grid-template-rows:auto minmax(1.4rem,1.55fr) auto minmax(1.1rem,1fr) auto;
      justify-items:center;text-align:center;width:100%;max-width:24rem;flex:1;padding:2rem .5rem 2.4rem}
    .hm-eyebrow{grid-row:1}
    .hm-core{grid-row:3;display:flex;flex-direction:column;align-items:center}
    .hm-reassure{grid-row:5}
    .hm-eyebrow{font-size:.72rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--color-brun-mid);margin:0;line-height:1.75}
    .hm-eyebrow b{color:var(--color-ocre);font-weight:500;border-bottom:1px solid rgba(37,92,65,.35);padding-bottom:1px}
    /* Corps du titre : 8,2vw et non 8,5vw. Mesuré le 14/08/2026, à 8,5vw
       « Optez pour un site web, » ne tenait dans sa ligne qu'à 1 px près sur
       390 px de large, et il manquait 0,7 px sur 360 px, où « web, » tombait
       seul sur une quatrième ligne. 8,2vw laisse 10 à 16 px de marge sur toute
       la plage mobile, pour un corps plus petit d'un pixel à peine. Le plancher
       de 1,6rem couvre les écrans de 320 px.

       Écarts internes : le titre s'interligne à 35 px, sous 2,4rem le
       sous-titre se lirait comme une quatrième ligne de titre. Le bouton se
       détache davantage (3,2rem), c'est une action et non la suite de la
       phrase. Les deux suivent la hauteur de l'écran et non la seule taille du
       texte : sur un petit écran ils se resserrent d'une vingtaine de pixels,
       qui repartent aux respirations entre les trois groupes. */
    .hm-title{font-family:var(--font-display);font-weight:700;font-size:clamp(1.6rem,8.2vw,2.55rem);line-height:1.06;letter-spacing:-.035em;color:var(--color-ocre);margin-bottom:clamp(1.7rem,4.5vh,2.4rem)}
    .hm-title .accent{color:var(--color-sauge-vif)}
    .hm-sub{font-size:1rem;line-height:1.6;color:var(--color-encre);max-width:32ch;margin-bottom:clamp(2.2rem,6vh,3.2rem)}
    .hm-sub b{color:var(--color-encre);font-weight:600}
    .hm-cta{display:inline-block;background:var(--color-ocre);color:var(--color-cream);font-weight:500;font-size:1rem;padding:.95em 2.2em;border-radius:100px;box-shadow:0 14px 30px -12px rgba(37,92,65,.6)}
    .hm-cta:active{background:var(--color-ocre-dark)}
    .hm-reassure{display:flex;justify-content:center;gap:14px}
    .hm-r{display:flex;flex-direction:column;align-items:center;gap:6px;width:92px}
    .hm-ric{width:32px;height:32px;border-radius:50%;background:var(--color-sauge-pale);display:flex;align-items:center;justify-content:center;flex:none}
    .hm-ric svg{width:16px;height:16px;stroke:var(--color-ocre);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .hm-rl{font-size:11px;font-weight:500;color:var(--color-brun-mid);line-height:1.25;text-align:center}
  }

  @media(prefers-reduced-motion:reduce){
    .power{display:none}
    .view{transition:none}
    .he-clavier{animation:none;opacity:1;transition:none}
    .he-scroll path{animation:none;opacity:.55}
  }
</style>

<style is:global>
  /* Sur l'accueil (seule page où vit ce hero), le header reste discret tant qu'on
     n'a pas défilé : le menu « plein » est alors celui du moniteur, ce qui évite
     l'effet de deux barres identiques empilées. Au défilement, .is-scrolled lui
     rend son fond et son ombre. */
  #header:not(.is-scrolled){
    background-color: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
</style>

<script>
  function initHeroEcran(){
    const glass = document.querySelector('[data-glass]');
    const stack = document.querySelector('[data-stack]');
    if(!glass || !stack) return;
    if(glass.offsetParent === null) return;   // moniteur masqué (mobile) : pas d'init
    if(glass.dataset.heInit === '1') return;
    glass.dataset.heInit = '1';

    const views = Array.prototype.slice.call(stack.querySelectorAll('.view'));
    const order = views.map(function(v){ return v.getAttribute('data-view'); });
    const links = Array.prototype.slice.call(glass.querySelectorAll('[data-nav]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function apply(target, animate){
      if(!animate) views.forEach(function(v){ v.style.transition = 'none'; });
      views.forEach(function(v, i){
        v.style.transform = 'translateX(' + ((i - target) * 100) + '%)';
        const on = i === target;
        v.classList.toggle('active', on);
        v.setAttribute('aria-hidden', on ? 'false' : 'true');
        if(on) { v.removeAttribute('inert'); v.scrollTop = 0; } else { v.setAttribute('inert', ''); }
      });
      glass.querySelectorAll('.navlinks [data-nav], .dots .dot').forEach(function(b){
        b.classList.toggle('on', b.getAttribute('data-nav') === order[target]);
      });
      if(!animate){ void stack.offsetWidth; views.forEach(function(v){ v.style.transition = ''; }); }
    }
    function go(key){ const t = order.indexOf(key); if(t >= 0) apply(t, true); }
    function current(){ let c = 0; views.forEach(function(v, i){ if(v.classList.contains('active')) c = i; }); return c; }

    apply(0, false);

    // Clic sur le menu : aperçu qui glisse (clic simple) ; la vraie page reste
    // ouvrable en Ctrl/Cmd-clic ou clic milieu. Toute interaction stoppe la démo.
    links.forEach(function(l){
      l.addEventListener('click', function(e){
        const key = l.getAttribute('data-nav');
        if(!key) return;
        if(e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        e.preventDefault();
        stopAuto(true);
        go(key);
      });
    });

    // Auto-glissement : démonstration bornée (un tour), en pause hors écran,
    // arrêtée définitivement dès que le visiteur prend la main.
    const AUTO_MAX = order.length;
    let auto = null, count = 0, done = reduce, onScreen = true, hovered = false;
    function next(){ count++; apply((current() + 1) % views.length, true); if(count >= AUTO_MAX){ stopAuto(true); } }
    function startAuto(){ if(done || auto || hovered || !onScreen) return; auto = window.setInterval(next, 5000); }
    function stopAuto(permanent){ if(permanent) done = true; if(auto){ clearInterval(auto); auto = null; } }

    glass.addEventListener('mouseenter', function(){ hovered = true; stopAuto(); });
    glass.addEventListener('mouseleave', function(){ hovered = false; startAuto(); });
    glass.addEventListener('focusin', function(){ stopAuto(true); });

    if('IntersectionObserver' in window){
      new IntersectionObserver(function(entries){
        entries.forEach(function(en){ onScreen = en.isIntersecting; if(onScreen){ startAuto(); } else { stopAuto(); } });
      }, { threshold: 0.35 }).observe(glass);
    }

    // Flèches du clavier (ordinateur) : feuilleter le moniteur sans la souris.
    // L'écoute est sur le document, sinon il faudrait d'abord aller chercher le
    // focus dans le moniteur, ce qui annule tout l'intérêt. Trois garde-fous :
    // le moniteur doit être à l'écran, la frappe ne doit pas venir d'un champ ni
    // d'un composant qui pilote déjà les flèches (recherche, curseur du
    // comparateur, menus), et seules les flèches horizontales sont interceptées,
    // donc le défilement vertical de la page n'est jamais confisqué.
    const hint = document.querySelector('[data-he-hint]');
    function fleches(e){
      // Après une navigation Astro, le moniteur de la page précédente n'existe
      // plus : l'écouteur se retire lui-même au lieu de survivre dans le vide.
      if(!glass.isConnected){ document.removeEventListener('keydown', fleches); return; }
      if(e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      if(e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      if(!onScreen) return;
      const cible = e.target;
      if(cible && cible.closest && cible.closest('input, textarea, select, [contenteditable], [role="dialog"], [role="menu"], details[open]')) return;
      e.preventDefault();
      stopAuto(true);
      if(hint) hint.classList.add('off');
      apply(e.key === 'ArrowRight'
        ? (current() + 1) % views.length
        : (current() - 1 + views.length) % views.length, true);
    }
    document.addEventListener('keydown', fleches);

    // L'indice a fait son office dès que le visiteur a navigué lui-même : il
    // s'efface donc aussi au clic dans le moniteur. Le glissement automatique,
    // lui, le laisse en place, puisque le visiteur n'a encore rien fait.
    glass.addEventListener('click', function(){ if(hint) hint.classList.add('off'); });

    // Swipe tactile (mobile) : feuilleter du doigt, et prendre la main.
    let sx = 0, sy = 0, sw = false;
    glass.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; sy = e.touches[0].clientY; sw = true; stopAuto(true); }, { passive: true });
    glass.addEventListener('touchend', function(e){
      if(!sw) return; sw = false;
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if(Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)){
        apply(dx < 0 ? (current() + 1) % views.length : (current() - 1 + views.length) % views.length, true);
      }
    }, { passive: true });

    if(!reduce) startAuto();
  }

  initHeroEcran();
  document.addEventListener('astro:page-load', initHeroEcran);
</script>
