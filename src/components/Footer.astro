---
const year = new Date().getFullYear();

// Réseaux sociaux réellement en ligne. On n'affiche une icône que pour un compte
// qui existe vraiment : lier un réseau inexistant (ou un homonyme) fait fuir.
// Facebook seul pour l'instant ; ajouter Instagram / TikTok / LinkedIn ici dès
// que les comptes sont créés (une ligne par réseau, la mise en page suit).
const socials = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/CaelestisWeb',
    // Glyphe « f » monochrome (simple-icons), conforme à la charte : SVG fin, pas d'emoji.
    path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/caelestis_web/',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z',
  },
];
---
<footer class="bg-brun text-cream">
  <!-- `pb-24` sur mobile : le bouton flottant des sons de forêt est fixé en bas
       à droite et recouvrait la dernière ligne du pied de page, dont le bouton
       « Gérer mes cookies » exigé par la CNIL. La réserve le dégage. -->
  <div class="max-w-6xl mx-auto px-6 md:px-10 pt-9 pb-24 md:py-16">
    <!-- Les trois blocs sont centrés sur leur colonne, jamais poussés vers les
         bords : les colonnes latérales étant de largeur égale, leurs contenus se
         placent alors à distance égale de l'axe de la carte. -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1fr_auto_1fr] gap-6 md:gap-10 lg:gap-12 mb-8 md:mb-12 items-start text-center">

      <!-- Colonne brand -->
      <div>
        <a href="/" class="font-display text-xl font-medium tracking-[-0.02em] block mb-2 hover:text-ocre transition-colors duration-300">
          Caelestis<em class="not-italic" style="color: var(--color-sauge-pale);">.</em>
        </a>
        <p class="font-display text-base font-light mb-2.5 md:mb-4" style="color: rgba(252, 251, 248,0.78)">
          Votre travail mérite d'être trouvé.<br>On s'occupe de le mettre en lumière.
        </p>
        <!-- Largeur bridée puis recentrée : sans cela le paragraphe occupe toute
             la colonne et déborde largement la masse du bloc contact d'en face. -->
        <p class="font-body text-sm leading-relaxed max-w-md md:max-w-xs lg:max-w-[17.5rem] mx-auto" style="color: rgba(252, 251, 248,0.75)">
          Création de site, <a href="/services/referencement-naturel" class="text-cream hover:text-ocre transition-colors duration-200 underline decoration-cream-dark/40 underline-offset-2">référencement naturel</a> et accompagnement pour artisans, praticiens et professionnels engagés. Basé dans la Drôme, au service de toute <a href="/creation-site-internet-auvergne-rhone-alpes" class="text-cream hover:text-ocre transition-colors duration-200 underline decoration-cream-dark/40 underline-offset-2 whitespace-nowrap">l'Auvergne-Rhône-Alpes</a>.
        </p>
      </div>

      <!-- Carte centrée — masquée sur tablette md où elle écrase, visible lg+ -->
      <!-- `mt-1.5` : le rectangle plein démarre à ras de sa boîte alors que les
           textes des deux autres colonnes portent un demi-interligne au-dessus.
           Sans ce décalage, la carte paraît accrochée plus haut qu'elles. -->
      <div class="hidden lg:flex flex-col items-center gap-3 lg:mt-1.5">
        <!-- Repère régional décoratif, dessiné maison (SVG) : aucune iframe
             Google Maps, donc aucune requête tierce ni dépôt de cookie Google
             avant consentement (CNIL), et rien à charger côté performance. Le
             lien vers la carte reste disponible pour qui veut situer la région. -->
        <div class="relative overflow-hidden" style="width: 200px; height: 148px; border-radius: 3px;">
          <a
            href="https://www.google.com/maps/place/Auvergne-Rh%C3%B4ne-Alpes/@45.45,4.55,7z"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Situer l'Auvergne-Rhône-Alpes sur Google Maps (nouvelle fenêtre)"
            class="absolute inset-0 z-20 transition-colors duration-200 hover:bg-white/5"
          ></a>
          <svg viewBox="0 0 200 148" width="200" height="148" aria-hidden="true" style="position:absolute;inset:0;display:block;">
            <rect width="200" height="148" fill="#1B4733"/>
            <g fill="none" stroke="#2E7452" stroke-width="1" opacity="0.45" stroke-linecap="round">
              <path d="M-10 38 C 40 20, 82 52, 132 33 S 210 28, 222 44"/>
              <path d="M-10 66 C 50 52, 92 84, 142 62 S 206 58, 222 70"/>
              <path d="M-10 96 C 45 84, 96 116, 150 92 S 206 90, 222 100"/>
              <path d="M-10 122 C 55 112, 102 138, 156 120 S 206 118, 222 126"/>
            </g>
            <g transform="translate(100,64)">
              <path d="M0 -15 C 8.5 -15, 13 -8.5, 13 -2 C 13 6.5, 0 21, 0 21 C 0 21, -13 6.5, -13 -2 C -13 -8.5, -8.5 -15, 0 -15 Z" fill="#B8C4BB"/>
              <circle cx="0" cy="-2" r="4.2" fill="#1B4733"/>
            </g>
          </svg>
        </div>
        <p class="font-body text-xs tracking-[0.18em] uppercase text-center" style="color: rgba(252, 251, 248,0.78); max-width: 200px;">Auvergne-Rhône-Alpes</p>
      </div>

      <!-- Contact, centré sur sa colonne comme les deux autres blocs. Le retrait
           haut pose la ligne de base de « Contact » sur celle de « Caelestis. » :
           à corps égal les boîtes s'alignent, mais un label en petit corps se
           retrouve sinon 9,6 px plus haut que le logotype d'en face. -->
      <div class="flex justify-center md:pt-[0.6rem]">
        <div>
          <p class="font-body text-xs tracking-widest uppercase mb-3 md:mb-4" style="color: rgba(252, 251, 248,0.75)">Contact</p>
          <div class="flex flex-row flex-wrap justify-center items-center gap-x-4 gap-y-1.5 md:flex-col md:gap-2.5">
            <a href="mailto:contact@caelestis.fr" class="font-body text-sm hover:text-cream transition-colors duration-200" style="color: rgba(252, 251, 248,0.82)">
              contact@caelestis.fr
            </a>
            <a href="tel:+33769362727" class="font-body text-sm hover:text-cream transition-colors duration-200" style="color: rgba(252, 251, 248,0.82)">
              07 69 36 27 27
            </a>
            <p class="font-body text-sm" style="color: rgba(252, 251, 248,0.82)">Drôme, France</p>
            <p class="font-body text-xs lg:text-sm md:mt-1" style="color: rgba(252, 251, 248,0.78)">Du lundi au samedi, 9h à 18h</p>

            {socials.length > 0 && (
              <div class="flex items-center gap-3 mt-2 md:mt-3">
                {socials.map(({ label, href, path }) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Caelestis sur ${label} (nouvelle fenêtre)`}
                    class="inline-flex items-center justify-center w-9 h-9 rounded-full border transition-colors duration-200 hover:bg-cream hover:text-brun"
                    style="border-color: rgba(252, 251, 248,0.30); color: rgba(252, 251, 248,0.82);"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d={path} /></svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

    </div>

    <!-- Navigation : pleine largeur sous la carte, une seule ligne centrée en
         desktop. Le passage à la ligne n'intervient que sur les petits écrans,
         où les libellés se répartissent d'eux-mêmes autour de l'axe central. -->
    <div class="text-center mb-7 md:mb-11">
      <p class="font-body text-xs tracking-widest uppercase mb-3.5 md:mb-5" style="color: rgba(252, 251, 248,0.75)">Navigation</p>
      <nav class="flex flex-row flex-wrap items-center justify-center gap-x-5 gap-y-2.5 md:gap-x-6 lg:gap-x-7 xl:gap-x-9" aria-label="Navigation du site">
        {[
          { href: '/',                      label: 'Accueil'       },
          { href: '/services',              label: 'Services'      },
          { href: '/realisations',          label: 'Réalisations'  },
          { href: '/outils/simulateur',     label: 'Simulateur'    },
          { href: '/outils/diagnostic',     label: 'Diagnostic'    },
          { href: '/services/referencement-naturel', label: 'Référencement' },
          { href: '/services/fiche-google-entreprise', label: 'Fiche Google'  },
          { href: '/ressources',            label: 'Ressources'    },
          { href: '/a-propos',              label: 'À propos'      },
          { href: '/contact',               label: 'Contact'       },
        ].map(({ href, label }, i) => (
          <Fragment>
            <a href={href} class="font-body text-sm whitespace-nowrap hover:text-cream transition-colors duration-200" style="color: rgba(252, 251, 248,0.82)">{label}</a>
            {/* Entre tablette et desktop, la ligne unique ne tient pas : on la coupe
                en deux moitiés égales (5 + 5) plutôt qu'un 7 + 3 bancal. */}
            {i === 4 && <span class="hidden md:block lg:hidden basis-full h-0" aria-hidden="true"></span>}
          </Fragment>
        ))}
      </nav>
    </div>

    <!-- Bandeau CTA -->
    <div class="border-t py-5 md:py-10 flex flex-row md:flex-col items-center justify-center gap-4 md:gap-5" style="border-color: rgba(252, 251, 248,0.08)">
      <p class="font-display text-sm md:text-base font-light text-center" style="color: rgba(252, 251, 248,0.80)">
        Une question, un conseil ?
      </p>
      <a
        href="/contact"
        class="font-body text-sm font-medium px-5 md:px-6 py-2 md:py-2.5 rounded-full border transition-colors duration-200 hover:bg-cream hover:text-brun whitespace-nowrap"
        style="border-color: rgba(252, 251, 248,0.45); color: rgba(252, 251, 248,0.92);"
      >
        Écrivez-nous
      </a>
    </div>

    <!-- Bas de page -->
    <div class="border-t pt-5 md:pt-8 flex flex-col md:flex-row justify-between items-center gap-2.5 md:gap-3" style="border-color: rgba(252, 251, 248,0.08)">
      <p class="font-body text-xs" style="color: rgba(252, 251, 248,0.78)">© {year} Caelestis. Tous droits réservés</p>
      <div class="grid grid-cols-2 justify-items-center gap-x-5 gap-y-2.5 md:flex md:flex-wrap md:justify-end">
        <a href="/mentions-legales" class="font-body text-xs hover:text-cream transition-colors duration-200" style="color: rgba(252, 251, 248,0.78)">Mentions légales</a>
        <a href="/politique-confidentialite" class="font-body text-xs hover:text-cream transition-colors duration-200" style="color: rgba(252, 251, 248,0.78)">Politique de confidentialité</a>
        <a href="/cgv" class="font-body text-xs hover:text-cream transition-colors duration-200" style="color: rgba(252, 251, 248,0.78)">CGV</a>
        <!-- Lien CNIL requis : l'utilisateur doit pouvoir retirer son consentement facilement -->
        <button
          id="footer-cookie-btn"
          class="font-body text-xs hover:text-cream transition-colors duration-200 cursor-pointer bg-transparent border-0 p-0"
          style="color: rgba(252, 251, 248,0.78)"
        >
          Gérer mes cookies
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  /* Délégation sur document (persistant) — survit aux navigations View Transitions
     même si le <footer> est re-rendu à chaque changement de page. */
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#footer-cookie-btn')) return;
    const reset = (window as Window & { caelestisResetCookies?: () => void }).caelestisResetCookies;
    if (typeof reset === 'function') reset();
  });
</script>
