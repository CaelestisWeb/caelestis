---
// ── Moment de marque « Caelestis » ──
// Reprend l'animation de l'ancienne intro (phrase + « Caelestis » à la machine
// à écrire, curseur) mais en BLOC CONTENU (pas plein écran), en boucle tant
// qu'il est visible, sans son. Aucune dépendance (CSS transitions + JS natif).
// Sizing par container queries → net à toute largeur. Coupé si « animations
// réduites ».
---

<figure class="bm-figure">
  <div class="bm-stage">
    <p class="bm-phrase" aria-hidden="true"></p>
    <p class="bm-brand" aria-hidden="true"></p>
    <span class="bm-tagline" aria-hidden="true">Création de site web</span>
  </div>
  <figcaption class="sr-only">Caelestis. Pour ceux qui créent quelque chose de beau.</figcaption>
</figure>

<style is:global>
  .bm-figure {
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(37, 92, 65, 0.15);
    box-shadow: 0 18px 44px rgba(45, 40, 20, 0.18);
    container-type: inline-size;
  }
  .bm-stage {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #2a3b18;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8% 9%;
    text-align: center;
    overflow: hidden;
  }

  .bm-phrase,
  .bm-brand {
    position: absolute;
    left: 9%;
    right: 9%;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: normal;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .bm-phrase {
    font-size: clamp(0.95rem, 5.2cqw, 1.7rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: rgba(252, 251, 248, 0.90);
  }
  .bm-brand {
    font-size: clamp(1.7rem, 11cqw, 3.4rem);
    letter-spacing: -0.04em;
    color: rgba(252, 251, 248, 0.97);
  }

  .bm-cursor {
    display: inline;
    margin-left: 1px;
    color: rgba(184, 196, 187, 0.90);
    font-weight: 300;
    animation: bm-blink 0.70s step-end infinite;
  }
  @keyframes bm-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  .bm-tagline {
    position: absolute;
    bottom: 7%;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-body);
    /* Plancher relevé de 0,58 à 0,6875rem : dans un conteneur étroit (mobile),
       la borne basse s'appliquait et la signature tombait à 9,28px. */
    font-size: clamp(0.6875rem, 2.7cqw, 0.8rem);
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(252, 251, 248, 0.52);
    white-space: nowrap;
  }


  @media (prefers-reduced-motion: reduce) {
    .bm-phrase, .bm-brand { transition: none; }
    .bm-cursor { animation: none; }
  }
</style>

<script>
  (function () {
    if ((window as Window & { __bmBound?: boolean }).__bmBound) return;
    (window as Window & { __bmBound?: boolean }).__bmBound = true;

    const PHRASE = 'Pour ceux qui créent quelque chose de beau.';

    function initBlock(figure: HTMLElement) {
      if (figure.dataset.bmReady) return;
      figure.dataset.bmReady = '1';

      const phraseEl = figure.querySelector('.bm-phrase') as HTMLElement;
      const brandEl  = figure.querySelector('.bm-brand')  as HTMLElement;
      if (!phraseEl || !brandEl) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ── Rendu statique si animations réduites (WCAG 2.3.3) ── */
      if (reduce) {
        brandEl.innerHTML = 'Caelestis';
        brandEl.style.opacity = '1';
        return;
      }

      const wait = (ms: number) => new Promise<void>(r => setTimeout(r, ms));
      let stop = false;
      let running = false;

      async function typeBrand() {
        brandEl.innerHTML = '';
        brandEl.style.opacity = '1';
        const cur = document.createElement('span');
        cur.className = 'bm-cursor'; cur.textContent = '|';
        brandEl.appendChild(cur);
        for (const ch of [...'Caelestis']) {
          if (stop) return;
          await wait(60 + Math.random() * 22);
          brandEl.insertBefore(document.createTextNode(ch), cur);
        }
        await wait(180);
        if (stop) return;
        await wait(700);
        cur.remove();
      }

      async function loop() {
        if (running) return;
        running = true;
        while (!stop) {
          phraseEl.textContent = PHRASE;
          brandEl.innerHTML = '';
          brandEl.style.opacity = '0';
          phraseEl.style.opacity = '0';
          await wait(80);
          if (stop) break;
          phraseEl.style.opacity = '1';
          await wait(1900);
          if (stop) break;
          phraseEl.style.opacity = '0';
          await wait(560);
          if (stop) break;
          await typeBrand();
          await wait(1600);
          if (stop) break;
          brandEl.style.opacity = '0';
          await wait(680);
        }
        running = false;
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { stop = false; loop(); }
          else { stop = true; }
        });
      }, { threshold: 0.35 });
      io.observe(figure);
    }

    const initAll = () => document.querySelectorAll<HTMLElement>('.bm-figure').forEach(initBlock);
    initAll();
    document.addEventListener('astro:page-load', initAll);
  })();
</script>
