---
/**
 * ClientBrief.astro : le questionnaire envoyé au client qui vient de signer.
 *
 * Refait entièrement le 07/08/2026. La version précédente comptait 57 champs,
 * dont 54 cases à cocher, répartis en sept sections. Cinq blocs ont été retirés
 * après relevé, pour des raisons tenues :
 *
 *   — Les neuf « valeurs » à cocher (Proximité, Qualité, Confiance, Innovation,
 *     Transparence, Engagement, Passion, Expertise). Tout le monde coche tout,
 *     et rien de ce qui en ressort n'oriente une décision de conception. Une
 *     question ouverte les remplace : ce qui vous distingue de vos concurrents.
 *   — Les six statuts juridiques, le numéro de TVA. Le SIRET seul suffit :
 *     l'API publique recherche-entreprises rend la raison sociale, le statut et
 *     l'adresse à partir du seul numéro, et Caelestis l'utilise déjà.
 *   — Les sept cases « contenu que vous pouvez fournir ». Elles doublonnaient la
 *     zone d'envoi de fichiers du même formulaire.
 *   — Les sept cases de réseaux sociaux. La zone de texte en dessous demandait
 *     déjà les liens des comptes, soit la même information en plus précis.
 *   — Le bloc boutique (nombre de produits, livraison, cinq modes de paiement).
 *     Cela se décide au cadrage, pas dans un formulaire.
 *
 * Il reste dix champs, dont quatre facultatifs, et cinq minutes de saisie.
 *
 * La page n'est liée depuis aucun endroit du site et porte `noindex` : elle
 * s'envoie à la main, au client, une fois le devis signé. Ne pas y ajouter de
 * lien depuis une page publique.
 */
---

<div class="qc">

  <!-- Progression : un filet qui se remplit à mesure que les champs se
       remplissent. Sobre, il tient lieu d'encouragement sans compter les
       étapes, puisqu'il n'y en a pas. -->
  <div class="qc-jauge" aria-hidden="true"><span id="qc-progres"></span></div>

  <div id="restore-banner" class="qc-reprise hidden" role="alert">
    <div class="qc-reprise-in">
      <p>Vos réponses ont été gardées. Reprendre là où vous en étiez&nbsp;?</p>
      <div class="qc-reprise-btns">
        <button id="restore-btn" type="button" class="qc-reprise-oui">Reprendre</button>
        <button id="discard-btn" type="button" class="qc-reprise-non" aria-label="Repartir de zéro">Repartir de zéro</button>
      </div>
    </div>
  </div>

  <div id="form-container">

    <header class="qc-tete">
      <div class="qc-tete-in">
        <p class="qc-marque">Caelestis</p>
        <h1 class="qc-titre">Donnons vie<br>à votre site.</h1>
        <p class="qc-chapo">
          Votre devis est signé, on peut commencer. Ces quelques questions me
          donnent de quoi démarrer sans vous relancer dix fois. Comptez cinq
          minutes, et vos réponses se gardent toutes seules si vous fermez la page.
        </p>
      </div>
    </header>

    <form id="brief-form" class="qc-form" novalidate>

      <div style="position:absolute;left:-9999px;opacity:0;pointer-events:none;height:0;" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off">
      </div>

      <!-- 01 ─────────────────────────────────────────────── -->
      <section class="qc-bloc">
        <div class="qc-bloc-tete">
          <span class="qc-n" aria-hidden="true">01</span>
          <div>
            <h2 class="qc-h2">Vous joindre</h2>
            <p class="qc-sous">Pour vous écrire pendant le projet, et pour les mentions légales de votre site.</p>
          </div>
        </div>

        <div class="qc-champs">
          <div class="qc-duo">
            <p class="qc-champ">
              <label class="qc-lab" for="email_contact">Votre email <span class="qc-req" aria-label="obligatoire">obligatoire</span></label>
              <input id="email_contact" type="email" name="email_contact" class="qc-in" placeholder="vous@exemple.fr" required autocomplete="email">
            </p>
            <p class="qc-champ">
              <label class="qc-lab" for="telephone">Votre téléphone</label>
              <input id="telephone" type="tel" name="telephone" class="qc-in" placeholder="06 12 34 56 78" autocomplete="tel">
            </p>
          </div>
          <div class="qc-duo">
            <p class="qc-champ">
              <label class="qc-lab" for="nom_entreprise">Nom de votre entreprise</label>
              <input id="nom_entreprise" type="text" name="nom_entreprise" class="qc-in" placeholder="Jardins Dupont">
            </p>
            <p class="qc-champ">
              <label class="qc-lab" for="siret">Votre numéro SIRET</label>
              <input id="siret" type="text" name="siret" class="qc-in" placeholder="123 456 789 00010" inputmode="numeric" maxlength="20">
              <span class="qc-aide">Il me donne votre raison sociale et votre adresse, je n'ai rien d'autre à vous demander pour les mentions légales.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- 02 ─────────────────────────────────────────────── -->
      <section class="qc-bloc">
        <div class="qc-bloc-tete">
          <span class="qc-n" aria-hidden="true">02</span>
          <div>
            <h2 class="qc-h2">Les textes de votre site</h2>
            <p class="qc-sous">C'est le point qui retarde le plus les projets. Autant le régler tout de suite.</p>
          </div>
        </div>

        <div class="qc-champs">
          <fieldset class="qc-choix">
            <legend class="qc-lab">Qui les écrit&nbsp;?</legend>
            <label class="qc-opt">
              <input type="radio" name="textes" value="je_fournis">
              <span class="qc-opt-in">
                <span class="qc-opt-t">Je vous les fournis</span>
                <span class="qc-opt-d">Vous avez déjà vos textes, ou vous comptez les écrire.</span>
              </span>
            </label>
            <label class="qc-opt">
              <input type="radio" name="textes" value="aide">
              <span class="qc-opt-in">
                <span class="qc-opt-t">Je les écris, vous les reprenez</span>
                <span class="qc-opt-d">Vous jetez vos idées, je m'occupe de la forme et de l'orthographe.</span>
              </span>
            </label>
            <label class="qc-opt">
              <input type="radio" name="textes" value="vous_redigez">
              <span class="qc-opt-in">
                <span class="qc-opt-t">Vous écrivez tout</span>
                <span class="qc-opt-d">On en parle au téléphone, je rédige à partir de vos réponses.</span>
              </span>
            </label>
          </fieldset>
        </div>
      </section>

      <!-- 03 ─────────────────────────────────────────────── -->
      <section class="qc-bloc">
        <div class="qc-bloc-tete">
          <span class="qc-n" aria-hidden="true">03</span>
          <div>
            <h2 class="qc-h2">Ce qui vous distingue</h2>
            <p class="qc-sous">La question la plus utile de ce formulaire. Prenez-y trois minutes plutôt qu'une.</p>
          </div>
        </div>

        <div class="qc-champs">
          <p class="qc-champ">
            <label class="qc-lab" for="ce_qui_vous_differencie">
              Pourquoi vos clients viennent chez vous plutôt que chez le concurrent d'à côté&nbsp;?
            </label>
            <textarea id="ce_qui_vous_differencie" name="ce_qui_vous_differencie" rows="5" class="qc-in qc-aire"
              placeholder="Ce que vous faites que personne ne fait pareil, ce qu'on vous dit souvent, ce dont vous êtes fier. Écrivez comme vous le diriez de vive voix, je me charge de la mise en forme."></textarea>
          </p>
        </div>
      </section>

      <!-- 04 ─────────────────────────────────────────────── -->
      <section class="qc-bloc">
        <div class="qc-bloc-tete">
          <span class="qc-n" aria-hidden="true">04</span>
          <div>
            <h2 class="qc-h2">Vos fichiers</h2>
            <p class="qc-sous">Logo, photos, plaquette, textes déjà rédigés. Tout ce que vous avez sous la main.</p>
          </div>
        </div>

        <div class="qc-champs">
          <div class="qc-depot" id="upload-zone">
            <input type="file" id="attachments" name="attachments" multiple
              accept="image/jpeg,image/png,image/webp,image/gif,application/pdf,.doc,.docx"
              class="qc-depot-in" aria-label="Joindre des fichiers">
            <div class="qc-depot-ui">
              <svg width="26" height="26" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <path d="M14 18V7m0 0L9 12m5-5l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 20v1.5A2.5 2.5 0 006.5 24h15a2.5 2.5 0 002.5-2.5V20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              <span class="qc-depot-t">Glissez vos fichiers ici</span>
              <span class="qc-depot-s">ou cliquez pour les choisir. Images, PDF ou Word, 5 Mo par fichier.</span>
            </div>
            <ul id="file-list" class="qc-fichiers" aria-label="Fichiers joints"></ul>
            <p id="upload-error" class="qc-err-champ hidden"></p>
          </div>

          <p class="qc-champ">
            <label class="qc-lab" for="wetransfer_link">Un lien de téléchargement</label>
            <input id="wetransfer_link" type="url" name="wetransfer_link" class="qc-in" placeholder="https://we.tl/…">
            <span class="qc-aide">Si vos fichiers sont trop lourds, passez par WeTransfer ou Google Drive et collez le lien ici.</span>
          </p>

          <p class="qc-champ">
            <label class="qc-lab" for="comptes_reseaux">Vos réseaux sociaux</label>
            <textarea id="comptes_reseaux" name="comptes_reseaux" rows="2" class="qc-in qc-aire"
              placeholder="Collez les adresses de vos pages, je les relierai à votre site."></textarea>
          </p>
        </div>
      </section>

      <!-- 05 ─────────────────────────────────────────────── -->
      <section class="qc-bloc">
        <div class="qc-bloc-tete">
          <span class="qc-n" aria-hidden="true">05</span>
          <div>
            <h2 class="qc-h2">Autre chose&nbsp;?</h2>
            <p class="qc-sous">Facultatif, mais c'est souvent ici que se trouve le détail qui change tout.</p>
          </div>
        </div>

        <div class="qc-champs">
          <p class="qc-champ">
            <label class="qc-lab" for="message_important">Une date, une contrainte, une envie</label>
            <textarea id="message_important" name="message_important" rows="4" class="qc-in qc-aire"
              placeholder="Une échéance à tenir, quelque chose que vous ne voulez surtout pas voir sur votre site, une idée qui vous tient à cœur."></textarea>
          </p>
        </div>
      </section>

      <div id="form-error" class="qc-err hidden" role="alert">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 5v3.5M8 11v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span id="form-error-text"></span>
      </div>

      <div class="qc-envoi">
        <button id="submit-btn" type="submit" class="qc-btn">Envoyer mes réponses</button>
        <p class="qc-envoi-sub">Je vous réponds sous 48 heures pour lancer la création.</p>
      </div>

    </form>
  </div>

  <div id="success-screen" class="qc-merci hidden">
    <div class="qc-merci-in">
      <span class="qc-merci-marque">Caelestis</span>
      <h2 class="qc-merci-titre">Merci,<br>c'est bien reçu.</h2>
      <p class="qc-merci-txt">
        J'ai tout ce qu'il me faut pour commencer. Je lis vos réponses et je
        reviens vers vous sous 48 heures pour lancer la création de votre site.
      </p>
      <p class="qc-merci-pied">
        <a href="tel:+33769362727">07 69 36 27 27</a>
        <a href="https://caelestis.fr">caelestis.fr</a>
      </p>
    </div>
  </div>

</div>

<style>
  /* ═══════════════════════════════════════════════════════════
     Questionnaire client, à la charte forêt vivante.
     Aucune couleur hors palette : la version précédente portait un #665F4B,
     un #e0cd9e et deux #b45309 hérités d'un ancien gabarit.
     Pas de carte à ombre portée : des blocs séparés par un filet et beaucoup
     de blanc, comme le reste du site.
  ═══════════════════════════════════════════════════════════ */
  .qc {
    font-family: var(--font-body);
    background: var(--color-cream);
    color: var(--color-brun);
    min-height: 100vh;
    padding-bottom: 96px;
  }

  /* ── Jauge de progression ── */
  .qc-jauge {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 2px;
    background: var(--color-cream-dark);
  }
  .qc-jauge span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-sauge-text);
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Bandeau de reprise ── */
  .qc-reprise { background: var(--color-brun); color: var(--color-cream); }
  .qc-reprise-in {
    max-width: 46rem;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .qc-reprise p { margin: 0; font-size: 0.875rem; }
  .qc-reprise-btns { display: flex; gap: 8px; flex: none; }
  .qc-reprise-oui, .qc-reprise-non {
    font-family: inherit;
    font-size: 0.8rem;
    border-radius: 999px;
    padding: 7px 16px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .qc-reprise-oui { background: var(--color-cream); color: var(--color-brun); border: 0; font-weight: 500; }
  .qc-reprise-oui:hover { background: #fff; }
  .qc-reprise-non { background: none; border: 1px solid rgba(252, 251, 248, 0.32); color: rgba(252, 251, 248, 0.82); }
  .qc-reprise-non:hover { color: var(--color-cream); border-color: rgba(252, 251, 248, 0.6); }

  /* ── En-tête ── */
  .qc-tete { background: var(--color-brun); color: var(--color-cream); padding: 64px 24px 72px; }
  .qc-tete-in { max-width: 46rem; margin: 0 auto; }
  .qc-marque {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgba(252, 251, 248, 0.7);
    margin: 0 0 28px;
  }
  .qc-titre {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.1rem);
    font-weight: 300;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: #FCFBF8;
    margin: 0 0 22px;
  }
  .qc-chapo {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(252, 251, 248, 0.8);
    max-width: 38rem;
    margin: 0;
  }

  /* ── Blocs ── */
  .qc-form { max-width: 46rem; margin: 0 auto; padding: 0 24px; }
  .qc-bloc { padding: 44px 0; border-bottom: 1px solid var(--color-cream-dark); }
  .qc-bloc:first-of-type { padding-top: 52px; }

  .qc-bloc-tete { display: flex; gap: 16px; margin-bottom: 26px; }
  .qc-n {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-sauge-text);
    padding-top: 0.42rem;
    flex: none;
  }
  .qc-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-brun);
    margin: 0 0 6px;
  }
  .qc-sous { font-size: 0.9rem; line-height: 1.6; color: var(--color-brun-mid); margin: 0; max-width: 40rem; }

  /* ── Champs ── */
  .qc-champs { display: grid; gap: 22px; padding-left: 0; }
  @media (min-width: 640px) { .qc-champs { padding-left: 2.4rem; } }
  .qc-duo { display: grid; gap: 22px; }
  @media (min-width: 640px) { .qc-duo { grid-template-columns: 1fr 1fr; } }
  .qc-champ { margin: 0; display: block; }

  .qc-lab {
    display: block;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--color-brun);
    margin-bottom: 8px;
  }
  .qc-req {
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-sauge-text);
    margin-left: 6px;
  }
  .qc-aide { display: block; font-size: 0.78rem; line-height: 1.55; color: var(--color-brun-mid); margin-top: 7px; }

  .qc-in {
    width: 100%;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-brun);
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    border-radius: 8px;
    padding: 12px 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .qc-in::placeholder { color: var(--color-brun-mid); opacity: 0.62; }
  .qc-in:focus {
    outline: none;
    border-color: var(--color-sauge-text);
    box-shadow: 0 0 0 3px rgba(46, 116, 82, 0.12);
  }
  .qc-aire { resize: vertical; line-height: 1.65; }

  /* ── Choix ── */
  .qc-choix { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .qc-choix legend { padding: 0; margin-bottom: 10px; }
  .qc-opt { display: block; cursor: pointer; }
  .qc-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .qc-opt-in {
    display: block;
    border: 1px solid var(--color-cream-dark);
    border-radius: 10px;
    padding: 14px 16px;
    background: #fff;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .qc-opt:hover .qc-opt-in { border-color: var(--color-sauge); }
  .qc-opt input:focus-visible + .qc-opt-in { outline: 2px solid var(--color-sauge-text); outline-offset: 2px; }
  .qc-opt input:checked + .qc-opt-in {
    border-color: var(--color-sauge-text);
    background: var(--color-sauge-pale);
  }
  .qc-opt-t { display: block; font-size: 0.92rem; font-weight: 500; color: var(--color-brun); }
  .qc-opt-d { display: block; font-size: 0.82rem; line-height: 1.5; color: var(--color-brun-mid); margin-top: 3px; }

  /* ── Dépôt de fichiers ── */
  .qc-depot {
    position: relative;
    border: 1px dashed var(--color-sauge);
    border-radius: 12px;
    background: rgba(227, 239, 232, 0.4);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .qc-depot.est-survole { background: var(--color-sauge-pale); border-color: var(--color-sauge-text); }
  .qc-depot-in { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
  .qc-depot-ui {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    padding: 32px 20px;
    text-align: center;
    color: var(--color-sauge-text);
    pointer-events: none;
  }
  .qc-depot-t { font-size: 0.92rem; font-weight: 500; color: var(--color-brun); }
  .qc-depot-s { font-size: 0.79rem; color: var(--color-brun-mid); max-width: 26rem; }

  .qc-fichiers { list-style: none; margin: 0; padding: 0 12px 12px; display: grid; gap: 6px; position: relative; }
  .qc-fichier {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid var(--color-cream-dark);
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 0.82rem;
  }
  .qc-fichier-nom { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-brun); }
  .qc-fichier-taille { font-size: 0.74rem; color: var(--color-brun-mid); flex: none; }
  .qc-fichier-x {
    flex: none;
    border: 0;
    background: none;
    color: var(--color-brun-mid);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
    padding: 3px 5px;
    border-radius: 4px;
    font-family: inherit;
  }
  .qc-fichier-x:hover { color: var(--color-brun); background: var(--color-sauge-pale); }

  /* ── Erreurs ── */
  .qc-err-champ {
    margin: 0 12px 12px;
    font-size: 0.78rem;
    color: var(--color-ocre-dark);
    background: #fff;
    border-radius: 6px;
    padding: 7px 10px;
    position: relative;
  }
  .qc-err {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--color-sauge-pale);
    border: 1px solid var(--color-sauge);
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 0.875rem;
    color: var(--color-ocre-dark);
    margin-top: 28px;
  }
  .qc-err svg { flex: none; margin-top: 2px; }

  /* ── Envoi ── */
  .qc-envoi { padding: 40px 0 0; text-align: center; }
  .qc-btn {
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    background: var(--color-brun);
    color: var(--color-cream);
    border: 0;
    border-radius: 999px;
    padding: 15px 38px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .qc-btn:hover:not(:disabled) { background: var(--color-ocre-dark); }
  .qc-btn:disabled { opacity: 0.6; cursor: default; }
  .qc-envoi-sub { font-size: 0.82rem; color: var(--color-brun-mid); margin: 14px 0 0; }

  /* ── Écran de fin ── */
  .qc-merci { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 24px; background: var(--color-brun); }
  .qc-merci-in { max-width: 34rem; text-align: center; }
  .qc-merci-marque {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: rgba(252, 251, 248, 0.6);
    display: block;
    margin-bottom: 30px;
  }
  .qc-merci-titre {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5.4vw, 2.8rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #FCFBF8;
    margin: 0 0 20px;
  }
  .qc-merci-txt { font-size: 1rem; line-height: 1.75; color: rgba(252, 251, 248, 0.8); margin: 0; }
  .qc-merci-pied { display: flex; gap: 22px; justify-content: center; margin: 34px 0 0; font-size: 0.85rem; }
  .qc-merci-pied a { color: rgba(252, 251, 248, 0.72); text-decoration: underline; text-underline-offset: 4px; }
  .qc-merci-pied a:hover { color: #FCFBF8; }

  .hidden { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .qc-jauge span, .qc-in, .qc-opt-in, .qc-depot, .qc-btn { transition: none; }
  }
</style>

<script>
  const form          = document.getElementById('brief-form')      as HTMLFormElement | null;
  const restoreBanner = document.getElementById('restore-banner')  as HTMLElement | null;
  const restoreBtn    = document.getElementById('restore-btn')     as HTMLElement | null;
  const discardBtn    = document.getElementById('discard-btn')     as HTMLElement | null;
  const submitBtn     = document.getElementById('submit-btn')      as HTMLButtonElement | null;
  const formContainer = document.getElementById('form-container')  as HTMLElement | null;
  const successScreen = document.getElementById('success-screen')  as HTMLElement | null;
  const formError     = document.getElementById('form-error')      as HTMLElement | null;
  const formErrorText = document.getElementById('form-error-text') as HTMLElement | null;
  const progres       = document.getElementById('qc-progres')      as HTMLElement | null;

  /* Clé v3 : les clés v1 et v2 portent les réponses de l'ancien questionnaire à
     57 champs, dont les noms n'existent plus. Les restaurer remplirait un
     formulaire qui ne les attend pas. */
  const STORAGE_KEY = 'caelestis_creation_v3';

  /* ══ État du formulaire ══ */
  function getFormState(): Record<string, string> {
    if (!form) return {};
    const state: Record<string, string> = {};
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      'input:not([type="radio"]):not([type="file"]), textarea'
    ).forEach((el) => { if (el.name) state[el.name] = el.value; });
    const choisi = form.querySelector<HTMLInputElement>('input[name="textes"]:checked');
    state['textes'] = choisi ? choisi.value : '';
    return state;
  }

  function restoreFormState(state: Record<string, string>): void {
    if (!form) return;
    for (const [nom, valeur] of Object.entries(state)) {
      if (!valeur) continue;
      if (nom === 'textes') {
        const r = form.querySelector<HTMLInputElement>(`input[name="textes"][value="${CSS.escape(valeur)}"]`);
        if (r) r.checked = true;
        continue;
      }
      const el = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${CSS.escape(nom)}"]`);
      if (el && el.type !== 'file') el.value = valeur;
    }
    majProgres();
  }

  /* ══ Sauvegarde ══ */
  let minuteur: ReturnType<typeof setTimeout> | undefined;
  function sauvegarder(): void {
    clearTimeout(minuteur);
    minuteur = setTimeout(() => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(getFormState())); } catch (_) { /* quota ou navigation privée */ }
    }, 600);
  }

  /* ══ Progression ══
     Part des champs remplis, fichiers compris. Aucun champ n'est pondéré :
     le filet encourage, il ne mesure pas une complétude contractuelle. */
  function majProgres(): void {
    if (!progres || !form) return;
    const etat = getFormState();
    const cles = Object.keys(etat).filter((k) => k !== 'website');
    const total = cles.length + 1; // + les fichiers
    const remplis = cles.filter((k) => etat[k].trim() !== '').length + (fichiers.length ? 1 : 0);
    progres.style.width = Math.round((remplis / total) * 100) + '%';
  }

  form?.addEventListener('input', () => { sauvegarder(); majProgres(); });
  form?.addEventListener('change', () => { sauvegarder(); majProgres(); });

  /* ══ Fichiers ══ */
  const zone     = document.getElementById('upload-zone')  as HTMLElement | null;
  const champFic = document.getElementById('attachments')  as HTMLInputElement | null;
  const liste    = document.getElementById('file-list')    as HTMLUListElement | null;
  const errFic   = document.getElementById('upload-error') as HTMLElement | null;

  let fichiers: File[] = [];
  const MAX_FICHIER = 5 * 1024 * 1024;
  const MAX_TOTAL   = 8 * 1024 * 1024;

  const taille = (o: number) => (o < 1024 * 1024 ? Math.round(o / 1024) + ' Ko' : (o / (1024 * 1024)).toFixed(1) + ' Mo');
  /* Les guillemets doivent être échappés eux aussi : le nom de fichier est
     injecté dans l'attribut `aria-label` du bouton de retrait, entre guillemets
     doubles. Sans cette ligne, un fichier nommé avec un guillemet sort de
     l'attribut et peut y greffer un gestionnaire d'événement. Windows interdit
     ce caractère dans un nom de fichier, macOS et Linux l'acceptent. */
  const echap  = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                                 .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

  function afficherFichiers(): void {
    if (!liste) return;
    liste.innerHTML = fichiers.map((f, i) => `
      <li class="qc-fichier">
        <span class="qc-fichier-nom">${echap(f.name)}</span>
        <span class="qc-fichier-taille">${taille(f.size)}</span>
        <button type="button" class="qc-fichier-x" data-i="${i}" aria-label="Retirer ${echap(f.name)}">Retirer</button>
      </li>`).join('');
    liste.querySelectorAll<HTMLButtonElement>('.qc-fichier-x').forEach((b) => {
      b.addEventListener('click', () => {
        fichiers.splice(parseInt(b.dataset.i ?? '0', 10), 1);
        afficherFichiers();
        errFic?.classList.add('hidden');
        majProgres();
      });
    });
    majProgres();
  }

  function ajouterFichiers(liste2: FileList | File[]): void {
    let cumul = fichiers.reduce((s, f) => s + f.size, 0);
    let refuses = 0;
    Array.from(liste2).forEach((f) => {
      if (f.size > MAX_FICHIER || cumul + f.size > MAX_TOTAL) { refuses++; return; }
      fichiers.push(f);
      cumul += f.size;
    });
    if (refuses && errFic) {
      errFic.textContent = refuses === 1
        ? 'Un fichier est trop lourd. Passez par un lien de téléchargement, juste en dessous.'
        : `${refuses} fichiers sont trop lourds. Passez par un lien de téléchargement, juste en dessous.`;
      errFic.classList.remove('hidden');
    }
    afficherFichiers();
  }

  champFic?.addEventListener('change', () => {
    if (champFic.files) ajouterFichiers(champFic.files);
    champFic.value = '';
  });
  zone?.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('est-survole'); });
  ['dragleave', 'dragend'].forEach((ev) => zone?.addEventListener(ev, () => zone.classList.remove('est-survole')));
  zone?.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('est-survole');
    const dt = (e as DragEvent).dataTransfer;
    if (dt?.files) ajouterFichiers(dt.files);
  });

  /* ══ Envoi ══ */
  function erreur(msg: string): void {
    if (!formError || !formErrorText) return;
    formErrorText.textContent = msg;
    formError.classList.remove('hidden');
    formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError?.classList.add('hidden');

    const email = form.querySelector<HTMLInputElement>('input[name="email_contact"]');
    if (!email?.value.trim()) {
      email?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => email?.focus(), 400);
      erreur('Il me faut votre email pour vous répondre.');
      return;
    }

    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Envoi en cours…'; }

    try {
      const fd = new FormData();
      for (const [k, v] of Object.entries(getFormState())) fd.append(k, v);
      fichiers.forEach((f) => fd.append('files', f));

      const res  = await fetch('/api/brief', { method: 'POST', body: fd });
      const data = await res.json() as { success?: boolean; error?: string };

      if (!data.success) throw new Error(data.error ?? "L'envoi n'a pas abouti.");

      try { localStorage.removeItem(STORAGE_KEY); } catch (_) { /* rien à nettoyer */ }
      formContainer?.classList.add('hidden');
      restoreBanner?.classList.add('hidden');
      successScreen?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      erreur((err as Error).message || 'Envoi impossible. Réessayez, ou écrivez à contact@caelestis.fr.');
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Envoyer mes réponses'; }
    }
  });

  /* ══ Reprise ══ */
  (function init() {
    majProgres();
    let garde: Record<string, string> | null = null;
    try {
      const brut = localStorage.getItem(STORAGE_KEY);
      if (brut) garde = JSON.parse(brut) as Record<string, string>;
    } catch (_) { return; }
    if (!garde || !Object.values(garde).some((v) => v.trim() !== '')) return;

    restoreBanner?.classList.remove('hidden');
    restoreBtn?.addEventListener('click', () => {
      restoreFormState(garde!);
      restoreBanner?.classList.add('hidden');
    });
    discardBtn?.addEventListener('click', () => {
      try { localStorage.removeItem(STORAGE_KEY); } catch (_) { /* rien à nettoyer */ }
      restoreBanner?.classList.add('hidden');
    });
  })();
</script>
